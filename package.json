{
  "name": "",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "pnpm test:flashcards && pnpm test:admin-ai && pnpm test:recent-materials",
    "test:flashcards": "node --import ./scripts/register-typescript.mjs tests/flashcards.test.mjs",
    "test:admin-ai": "node --import ./scripts/register-typescript.mjs tests/admin-ai.test.mjs",
    "test:recent-materials": "node --import ./scripts/register-typescript.mjs tests/recent-materials.test.mjs",
    "astro": "astro",
    "seed:firestore": "node scripts/seed-firestore.mjs",
    "schema:sync": "node scripts/sync-firebase-schema.mjs",
    "migrate:contributions": "node scripts/migrate-contributions.mjs",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:all": "firebase deploy --only firestore"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.9",
    "astro": "^7.3.3",
    "cheerio": "^1.2.0",
    "firebase": "^12.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "vercel": "^59.23.2"
  },
  "allowScripts": {
    "esbuild": true,
    "@firebase/util": true,
    "protobufjs": true
  },
  "devDependencies": {
    "@astrojs/vercel": "^11.0.11",
    "sharp": "^0.35.4",
    "wrangler": "^4.147.0"
  }
}
