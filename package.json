{
  "name": "",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "pnpm test:flashcards && pnpm test:admin-ai && pnpm test:admin-quota && pnpm test:recent-materials && pnpm test:auth && pnpm test:search && pnpm test:search-suggestions && pnpm test:perf && pnpm test:cache && pnpm test:collections && pnpm test:video-sources && pnpm test:document-viewer && pnpm test:local-folder && pnpm test:grouping && pnpm test:teacher-grouping && pnpm test:lessons && pnpm test:module-icons && pnpm test:active-module && pnpm test:pwa && pnpm test:middleware && pnpm test:navigation",
    "test:navigation": "node --import ./scripts/register-typescript.mjs tests/navigation-and-material-redirect.test.mjs",
    "test:flashcards": "node --import ./scripts/register-typescript.mjs tests/flashcards.test.mjs",
    "test:admin-ai": "node --import ./scripts/register-typescript.mjs tests/admin-ai.test.mjs",
    "test:admin-quota": "node --import ./scripts/register-typescript.mjs tests/admin-interactive-quota.test.mjs",
    "test:recent-materials": "node --import ./scripts/register-typescript.mjs tests/recent-materials.test.mjs",
    "test:auth": "node --import ./scripts/register-typescript.mjs tests/auth-profile-image.test.mjs",
    "test:search": "node --import ./scripts/register-typescript.mjs tests/search-enhancements.test.mjs",
    "test:search-suggestions": "node --import ./scripts/register-typescript.mjs tests/search-suggestions.test.mjs",
    "test:perf": "node --import ./scripts/register-typescript.mjs tests/performance-materials-api.test.mjs",
    "test:cache": "node --import ./scripts/register-typescript.mjs tests/catalogue-loader-version.test.mjs",
    "test:collections": "node --import ./scripts/register-typescript.mjs tests/collections.test.mjs",
    "test:video-sources": "node --import ./scripts/register-typescript.mjs tests/video-sources.test.mjs",
    "test:document-viewer": "node --import ./scripts/register-typescript.mjs tests/document-viewer.test.mjs",
    "test:local-folder": "node --import ./scripts/register-typescript.mjs tests/local-folder-manager.test.mjs",
    "test:grouping": "node --import ./scripts/register-typescript.mjs tests/materials-grouping.test.mjs",
    "test:teacher-grouping": "node --import ./scripts/register-typescript.mjs tests/teacher-grouping.test.mjs",
    "test:module-icons": "node --import ./scripts/register-typescript.mjs tests/module-icons-and-theme.test.mjs",
    "test:active-module": "node --import ./scripts/register-typescript.mjs tests/active-module-selection.test.mjs",
    "test:pwa": "node --import ./scripts/register-typescript.mjs tests/pwa-install-prompt.test.mjs",
    "test:middleware": "node --import ./scripts/register-typescript.mjs tests/middleware-caching.test.mjs",
    "astro": "astro",
    "seed:firestore": "node scripts/seed-firestore.mjs",
    "schema:sync": "node scripts/sync-firebase-schema.mjs",
    "migrate:contributions": "node scripts/migrate-contributions.mjs",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:all": "firebase deploy --only firestore",
    "test:lessons": "node --import ./scripts/register-typescript.mjs tests/lessons.test.mjs && node --import ./scripts/register-typescript.mjs tests/material-lesson-links.test.mjs && node --import ./scripts/register-typescript.mjs tests/study-flow.test.mjs",
    "materials:telegram": "scripts/telegram-materials/.venv/bin/python scripts/telegram-materials/run.py",
    "materials:asu2learn": "scripts/telegram-materials/.venv/bin/python scripts/asu2learn/run.py",
    "test:asu2learn": "node tests/asu2learn-parser.test.mjs && scripts/telegram-materials/.venv/bin/python -m unittest discover -s scripts/asu2learn -p 'test_*.py' -v",
    "test:telegram-materials": "PYTHONPATH=scripts/telegram-materials scripts/telegram-materials/.venv/bin/python -m unittest discover -s scripts/telegram-materials/tests -v"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.9",
    "astro": "^7.3.3",
    "cheerio": "^1.2.0",
    "firebase": "^12.19.0",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "vercel": "^59.23.2"
  },
  "allowScripts": {
    "esbuild": true,
    "@firebase/util": true,
    "protobufjs": true
  },
  "devDependencies": {
    "@astrojs/vercel": "^11.0.11",
    "sharp": "^0.35.4",
    "wrangler": "^4.147.0"
  }
}
