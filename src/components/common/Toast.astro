---
// src/components/common/Toast.astro
---

<!-- Fixed Toast Container -->
<div
  id="toast-container"
  class="fixed bottom-4 right-4 left-4 sm:left-auto sm:right-6 z-50 flex flex-col gap-2.5 max-w-sm pointer-events-none"
  aria-live="polite"
  aria-atomic="true"
></div>

<template id="toast-template">
  <div
    class="toast-card pointer-events-auto flex items-start gap-3 p-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 shadow-xl shadow-zinc-950/5 dark:shadow-zinc-950/40 text-right transform transition-all duration-300 translate-y-4 opacity-0"
    role="status"
  >
    <!-- Icon Container -->
    <div class="toast-icon-box w-8 h-8 rounded-xl flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
      <!-- Icon inserted dynamically -->
    </div>

    <!-- Content Area -->
    <div class="flex-1 min-w-0 pt-0.5">
      <h4 class="toast-title text-xs font-bold text-zinc-900 dark:text-zinc-100 hidden"></h4>
      <p class="toast-message text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed"></p>

      <!-- Action Button Container -->
      <div class="toast-action-container mt-2.5 hidden flex items-center gap-2">
        <button
          type="button"
          class="toast-action-btn text-xs font-bold px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white transition-colors cursor-pointer shadow-2xs"
        ></button>
        <button
          type="button"
          class="toast-cancel-btn text-xs font-semibold px-2.5 py-1.5 rounded-lg text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 transition-colors cursor-pointer"
          data-i18n="toast.later"
        >
          Later
        </button>
      </div>
    </div>

    <!-- Close Button -->
    <button
      type="button"
      class="toast-close-btn p-1 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 rounded-lg transition-colors shrink-0 cursor-pointer"
      title="Close"
      aria-label="Dismiss notification"
      data-i18n-attr="title:toast.close,aria-label:toast.dismissAria"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</template>

<script>
  import type { ToastOptions, ToastType } from '../../types/toast';

  const icons: Record<ToastType, { bg: string; html: string }> = {
    info: {
      bg: 'bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-400 border border-blue-200/60 dark:border-blue-800/40',
      html: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" /></svg>`
    },
    success: {
      bg: 'bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/40',
      html: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>`
    },
    warning: {
      bg: 'bg-amber-50 text-amber-600 dark:bg-amber-950/60 dark:text-amber-400 border border-amber-200/60 dark:border-amber-800/40',
      html: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>`
    },
    error: {
      bg: 'bg-red-50 text-red-600 dark:bg-red-950/60 dark:text-red-400 border border-red-200/60 dark:border-red-800/40',
      html: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" /></svg>`
    },
    pwa: {
      bg: 'bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/40',
      html: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>`
    }
  };

  export function showToast(options: ToastOptions): HTMLElement | null {
    const container = document.getElementById('toast-container');
    const template = document.getElementById('toast-template') as HTMLTemplateElement | null;
    if (!container || !template) return null;

    // Check if duplicate toast ID is already visible
    if (options.id && document.querySelector(`[data-toast-id="${options.id}"]`)) {
      return null;
    }

    const fragment = template.content.cloneNode(true) as DocumentFragment;
    const toastCard = fragment.querySelector('.toast-card') as HTMLElement;

    if (options.id) {
      toastCard.setAttribute('data-toast-id', options.id);
    }

    const type = options.type || 'info';
    const iconBox = toastCard.querySelector('.toast-icon-box') as HTMLElement;
    if (iconBox) {
      const cfg = icons[type] || icons.info;
      iconBox.className += ` ${cfg.bg}`;
      iconBox.innerHTML = cfg.html;
    }

    const titleEl = toastCard.querySelector('.toast-title') as HTMLElement;
    if (titleEl && options.title) {
      titleEl.textContent = options.title;
      titleEl.classList.remove('hidden');
    }

    const messageEl = toastCard.querySelector('.toast-message') as HTMLElement;
    if (messageEl) {
      messageEl.textContent = options.message;
    }

    const isEn = document.documentElement.lang === 'en';
    toastCard.dir = isEn ? 'ltr' : 'rtl';
    toastCard.classList.remove('text-right', 'text-left');
    toastCard.classList.add(isEn ? 'text-left' : 'text-right');

    const actionContainer = toastCard.querySelector('.toast-action-container') as HTMLElement;
    const actionBtn = toastCard.querySelector('.toast-action-btn') as HTMLButtonElement;
    const cancelBtn = toastCard.querySelector('.toast-cancel-btn') as HTMLButtonElement;

    if (cancelBtn) {
      cancelBtn.textContent = isEn ? 'Later' : 'لاحقاً';
    }

    if (options.action && actionBtn && actionContainer) {
      actionBtn.textContent = options.action.label;
      actionContainer.classList.remove('hidden');
      actionBtn.addEventListener('click', () => {
        options.action?.onClick?.();
        dismiss(toastCard);
      });
      cancelBtn?.addEventListener('click', () => {
        dismiss(toastCard);
      });
    }

    const closeBtn = toastCard.querySelector('.toast-close-btn') as HTMLElement;
    if (closeBtn) {
      closeBtn.setAttribute('title', isEn ? 'Close' : 'إغلاق');
      closeBtn.setAttribute('aria-label', isEn ? 'Dismiss notification' : 'إغلاق التنبيه');
      closeBtn.addEventListener('click', () => dismiss(toastCard));
    }

    function dismiss(card: HTMLElement) {
      card.classList.add('translate-y-4', 'opacity-0');
      card.classList.remove('translate-y-0', 'opacity-100');
      setTimeout(() => {
        card.remove();
      }, 300);
    }

    container.appendChild(toastCard);

    // Trigger smooth enter animation on next frame
    requestAnimationFrame(() => {
      toastCard.classList.remove('translate-y-4', 'opacity-0');
      toastCard.classList.add('translate-y-0', 'opacity-100');
    });

    // Auto dismiss if duration is set (0 means persistent)
    const duration = options.duration !== undefined ? options.duration : 4500;
    if (duration > 0) {
      setTimeout(() => {
        if (toastCard.parentElement) {
          dismiss(toastCard);
        }
      }, duration);
    }

    return toastCard;
  }

  // Attach to window for global access
  (window as any).showToast = showToast;
  window.addEventListener('show-toast', (e: Event) => {
    const custom = e as CustomEvent<ToastOptions>;
    if (custom.detail) {
      showToast(custom.detail);
    }
  });
</script>
