---
// LanguageToggle.astro: Fast language toggle between English and Arabic
---

<button
  type="button"
  id="topbar-language-toggle"
  class="inline-flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-xs font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 cursor-pointer"
  title="Switch language / تبديل اللغة"
  aria-label="Switch language / تبديل اللغة"
>
  <!-- Globe Icon -->
  <svg
    class="w-4 h-4 text-zinc-500 dark:text-zinc-400 shrink-0"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.8"
    stroke="currentColor"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418"
    />
  </svg>

  <span class="lang-toggle-label text-xs font-semibold uppercase tracking-wider">EN</span>
</button>

<script>
  import { toggleLanguage, getCurrentLanguage } from '../../utils/i18n';

  function setupLanguageToggle(): void {
    const btn = document.getElementById('topbar-language-toggle');
    if (!btn) return;

    btn.onclick = () => {
      toggleLanguage();
    };

    function updateLabel(): void {
      const current = getCurrentLanguage();
      const label = btn?.querySelector('.lang-toggle-label');
      if (label) {
        label.textContent = current === 'en' ? 'EN' : 'عربي';
      }
      const titleText = current === 'en' ? 'التبديل إلى العربية' : 'Switch to English';
      btn?.setAttribute('title', titleText);
      btn?.setAttribute('aria-label', titleText);
    }

    updateLabel();
    window.addEventListener('asumed-language-changed', updateLabel);
  }

  setupLanguageToggle();
  document.addEventListener('astro:after-swap', setupLanguageToggle);
</script>
