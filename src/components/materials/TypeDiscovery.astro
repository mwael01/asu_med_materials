---
import type { DiscoveryType } from '../../types/lessons';
import { getAllMaterials } from '../../data/materials';
import { getAllModules } from '../../data/modules';
import { getPublicLessons } from '../../data/catalogue.server';
import { matchesDiscoveryType } from '../../utils/studyContent';
import ModuleDirectory from './ModuleDirectory.astro';
import SavedYearScope from './SavedYearScope.astro';

interface Props { type: DiscoveryType }
const { type } = Astro.props;

const [materials, modules, lessons] = await Promise.all([
  getAllMaterials(),
  getAllModules(),
  getPublicLessons()
]);

// Filter modules for each year: only modules that contain active lessons with materials matching `type`
const modulesWithContent = modules.filter(module => {
  const activeLessons = lessons.filter(l => l.active !== false && l.moduleId === module.id);
  const lessonIds = new Set(activeLessons.map(l => l.id));
  return materials.some(m => m.moduleId === module.id && m.lessonId && lessonIds.has(m.lessonId) && matchesDiscoveryType(m, type));
});

const typeTitles: Record<DiscoveryType, string> = {
  videos: 'Videos',
  pdfs: 'PDFs',
  flashcards: 'Flashcards'
};
---
<section data-saved-year-scope>
  <div class="flex items-center justify-between gap-4 mb-6">
    <h1 class="text-xl font-bold">{typeTitles[type]} <span data-year-label class="text-sm font-normal text-zinc-500 ml-2"></span></h1>
    <button type="button" class="trigger-multistage-selector text-sm text-emerald-600 hover:underline">Change year</button>
  </div>
  {[1, 2, 3, 4, 5].map(year => (
    <div data-scope-year={year} hidden>
      <ModuleDirectory
        modules={modulesWithContent.filter(module => module.year === year)}
        type={type}
      />
    </div>
  ))}
  <p data-year-empty class="text-sm text-zinc-500" hidden>Choose your year to continue.</p>
</section>
<SavedYearScope />
