---
import type { DiscoveryType } from '../../types/lessons';
import { getAllMaterials } from '../../data/materials';
import { getAllModules } from '../../data/modules';
import { getPublicLessons } from '../../data/catalogue.server';
import { matchesDiscoveryType, materialStudyPath } from '../../utils/studyContent';
import ResourceGrid from './ResourceGrid.astro';
import SavedYearScope from './SavedYearScope.astro';
import { subjectToSlug } from '../../utils/slug';
interface Props { type: DiscoveryType }
const { type } = Astro.props;
const [materials, modules, lessons] = await Promise.all([getAllMaterials(), getAllModules(), getPublicLessons()]);
const matching = materials.filter(item => matchesDiscoveryType(item, type));
const hrefs = Object.fromEntries(matching.map(item => [item.id, materialStudyPath(item, lessons, type)]));
const groups = [...new Set(matching.map(item => JSON.stringify([item.year, item.moduleId || '', item.subject || ''])))].map(key => {
  const [year, moduleId, subject] = JSON.parse(key) as [number, string, string];
  const module = modules.find(item => item.id === moduleId);
  const canonicalSubject = module?.subjects.find(item => subjectToSlug(item) === subjectToSlug(subject));
  return { year, title: [module?.title || (moduleId ? 'References' : 'General'), subject].filter(Boolean).join(' / '),
    href: module ? (canonicalSubject ? `/module/${module.id}/${subjectToSlug(canonicalSubject)}` : `/module/${module.id}`) : undefined,
    items: matching.filter(item => item.year === year && (item.moduleId || '') === moduleId && (item.subject || '') === subject) };
}).sort((a,b) => a.title.localeCompare(b.title));
---
<section data-saved-year-scope>
  <div class="flex justify-between items-center mb-5 text-sm">
    <span data-year-label class="text-zinc-500"></span>
    <a href="/" class="text-emerald-600 hover:underline">My modules</a>
  </div>
  <div class="space-y-8">
    {groups.map(group => <section data-scope-year={group.year} hidden><h2 class="text-sm font-semibold mb-3">{group.href ? <a href={group.href} class="hover:text-emerald-600">{group.title}</a> : group.title}</h2><ResourceGrid materials={group.items} hrefs={hrefs} /></section>)}
  </div>
  <p data-year-empty class="text-sm text-zinc-500">Choose your year to continue.</p>
</section>
<SavedYearScope />
