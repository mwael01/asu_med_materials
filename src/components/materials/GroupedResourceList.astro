---
import type { MaterialItem, MaterialCategory } from '../../types/materials';
import ResourceCard from './ResourceCard.astro';

interface Props {
  materials: MaterialItem[];
  showYear?: boolean;
}

const { materials, showYear = false } = Astro.props;

interface GroupConfig {
  key: MaterialCategory;
  titleAr: string;
  titleEn: string;
  icon: string;
  badgeClasses: string;
}

const groupConfigs: GroupConfig[] = [
  {
    key: 'central',
    titleAr: 'درايفات وقنوات الدفعة',
    titleEn: 'Central Drives & Channels',
    icon: 'folder',
    badgeClasses: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-300'
  },
  {
    key: 'lectures',
    titleAr: 'محاضرات وشروحات فيديو',
    titleEn: 'Lectures & Playlists',
    icon: 'video',
    badgeClasses: 'bg-red-100 text-red-800 dark:bg-red-950/70 dark:text-red-300'
  },
  {
    key: 'practical',
    titleAr: 'سكاشن وعملي ومعامل',
    titleEn: 'Practical, Labs & Dissections',
    icon: 'beaker',
    badgeClasses: 'bg-blue-100 text-blue-800 dark:bg-blue-950/70 dark:text-blue-300'
  },
  {
    key: 'summaries',
    titleAr: 'ورق ومذكرات وملخصات',
    titleEn: 'Summaries & Notes',
    icon: 'notes',
    badgeClasses: 'bg-purple-100 text-purple-800 dark:bg-purple-950/70 dark:text-purple-300'
  },
  {
    key: 'exams',
    titleAr: 'امتحانات سابقة وريكولات',
    titleEn: 'Past Exams & Recalls',
    icon: 'exam',
    badgeClasses: 'bg-rose-100 text-rose-800 dark:bg-rose-950/70 dark:text-rose-300'
  },
  {
    key: 'references',
    titleAr: 'كتب ومراجع',
    titleEn: 'Books & References',
    icon: 'book',
    badgeClasses: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950/70 dark:text-indigo-300'
  }
];

// Group the materials
const grouped: { config: GroupConfig; items: MaterialItem[] }[] = [];

for (const config of groupConfigs) {
  const items = materials.filter((m) => (m.category || 'other') === config.key);
  if (items.length > 0) {
    grouped.push({ config, items });
  }
}

// Any uncategorized items
const uncategorized = materials.filter(
  (m) => !m.category || !groupConfigs.some((g) => g.key === m.category)
);
---

<div class="space-y-8" id="grouped-materials-container">
  {materials.length === 0 ? (
    <div class="py-12 text-center border border-dashed border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 bg-white dark:bg-zinc-900/60">
      <div class="w-12 h-12 mx-auto rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-3">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
        </svg>
      </div>
      <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 mb-1">
        لا توجد مصادر مضافة هنا حتى الآن
      </h3>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-4 max-w-sm mx-auto">
        الموقع جاهز لاستقبال مصادرك ودرايفاتك لتوثيقها باسمك ومشاركتها مع زملائك في الكلية.
      </p>
      <a
        href="/contribute"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 text-white hover:bg-emerald-700 text-xs font-bold transition-colors shadow-2xs"
      >
        <span>مشاركة مصدر دراسي</span>
        <svg class="w-3.5 h-3.5 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
        </svg>
      </a>
    </div>
  ) : (
    grouped.map(({ config, items }) => (
      <section class="material-group-section" data-category={config.key}>
        <div class="flex items-center gap-2 mb-3 pb-2 border-b border-zinc-200 dark:border-zinc-800">
          <h3 class="text-base font-bold text-zinc-900 dark:text-zinc-100">
            {config.titleAr}
          </h3>
          <span class="text-xs text-zinc-400 dark:text-zinc-500 font-medium hidden sm:inline">
            ({config.titleEn})
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {items.map((item) => (
            <ResourceCard material={item} showYear={showYear} />
          ))}
        </div>
      </section>
    ))
  )}

  {uncategorized.length > 0 && (
    <section class="material-group-section" data-category="other">
      <div class="flex items-center gap-2 mb-3 pb-2 border-b border-zinc-200 dark:border-zinc-800">
        <h3 class="text-base font-bold text-zinc-900 dark:text-zinc-100">
          مصادر أخرى متنوعة
        </h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {uncategorized.map((item) => (
          <ResourceCard material={item} showYear={showYear} />
        ))}
      </div>
    </section>
  )}
</div>
