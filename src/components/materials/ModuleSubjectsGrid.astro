---
import type { MaterialItem, ModuleInfo } from '../../types/materials';
import { subjectToSlug } from '../../utils/slug';

interface Props {
  module: ModuleInfo;
  materials: MaterialItem[];
}

const { module, materials } = Astro.props;

// Compute counts for each subject
const subjectCounts: Record<string, number> = {};
for (const sub of module.subjects) {
  const slug = subjectToSlug(sub);
  subjectCounts[slug] = materials.filter(
    (m) => m.subject && subjectToSlug(m.subject) === slug
  ).length;
}

// Compute central / batch materials count
const centralCount = materials.filter(
  (m) => !m.subject || m.category === 'central'
).length;

// Map common subjects to SVG paths for visual clarity
function getSubjectIcon(name: string): string {
  const n = name.toLowerCase();
  if (n.includes('patho')) return 'pathology';
  if (n.includes('pharm')) return 'pharmacology';
  if (n.includes('anat') || n.includes('embryo')) return 'anatomy';
  if (n.includes('physio')) return 'physiology';
  if (n.includes('histo')) return 'histology';
  if (n.includes('bioch') || n.includes('genet')) return 'biochemistry';
  if (n.includes('micro') || n.includes('immuno')) return 'microbiology';
  if (n.includes('para')) return 'parasitology';
  if (n.includes('clin') || n.includes('skill')) return 'clinical';
  return 'general';
}
---

<div class="space-y-3">
  <div class="flex items-center justify-between">
    <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
      Module Subjects
    </h3>
    <span class="text-xs text-zinc-400 dark:text-zinc-500">
      {module.subjects.length} subjects
    </span>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
    {/* Central & Batch Drive Card (if available) */}
    {centralCount > 0 && (
      <a
        href={`/module/${module.id}`}
        class="group relative flex flex-col justify-between p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 hover:border-emerald-500/80 dark:hover:border-emerald-500/80 shadow-2xs hover:shadow-md transition-all text-start"
      >
        <div class="flex items-center justify-between gap-2 mb-3">
          <div class="w-8 h-8 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:bg-emerald-600 group-hover:text-white transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 0 0-1.883 2.542l.857 6a2.25 2.25 0 0 0 2.227 1.932H19.05a2.25 2.25 0 0 0 2.227-1.932l.857-6a2.25 2.25 0 0 0-1.883-2.542m-16.5 0V6A2.25 2.25 0 0 1 6 3.75h3.879a1.5 1.5 0 0 1 1.06.44l2.122 2.12a1.5 1.5 0 0 0 1.06.44H18A2.25 2.25 0 0 1 20.25 9v.776" />
            </svg>
          </div>
          <span class="text-[11px] font-semibold px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
            {centralCount}
          </span>
        </div>

        <div>
          <h4 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
            Central & Batch Drives
          </h4>
          <span class="text-[11px] text-zinc-400 dark:text-zinc-500 flex items-center gap-1 mt-0.5">
            <span>Module-wide files</span>
            <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </span>
        </div>
      </a>
    )}

    {/* Subject Cards */}
    {module.subjects.map((sub) => {
      const slug = subjectToSlug(sub);
      const count = subjectCounts[slug] || 0;
      const iconType = getSubjectIcon(sub);

      return (
        <a
          href={`/module/${module.id}/${slug}`}
          class="group relative flex flex-col justify-between p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 hover:border-emerald-500/80 dark:hover:border-emerald-500/80 shadow-2xs hover:shadow-md transition-all text-start"
        >
          <div class="flex items-center justify-between gap-2 mb-3">
            <div class="w-8 h-8 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:bg-emerald-600 group-hover:text-white transition-all">
              {iconType === 'pathology' ? (
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                </svg>
              ) : iconType === 'pharmacology' ? (
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9z" />
                </svg>
              ) : iconType === 'anatomy' ? (
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0zM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                </svg>
              ) : iconType === 'physiology' ? (
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                </svg>
              ) : iconType === 'microbiology' || iconType === 'parasitology' ? (
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 0 1-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 0 1 4.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.942A4.5 4.5 0 0 1 15.91 17H8.09a4.5 4.5 0 0 1-2.32-.658L4.2 15.4M19.8 15.3A2.25 2.25 0 0 0 21 13.35V12a9 9 0 0 0-18 0v1.35a2.25 2.25 0 0 0 1.2 1.95" />
                </svg>
              ) : (
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                </svg>
              )}
            </div>

            <span class="text-[11px] font-semibold px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
              {count}
            </span>
          </div>

          <div>
            <h4 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
              {sub}
            </h4>
            <span class="text-[11px] text-zinc-400 dark:text-zinc-500 flex items-center gap-1 mt-0.5">
              <span>{count === 1 ? '1 resource' : `${count} resources`}</span>
              <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </div>
        </a>
      );
    })}
  </div>
</div>
