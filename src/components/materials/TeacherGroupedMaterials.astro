---
import type { MaterialItem } from '../../types/materials';
import ResourceCard from './ResourceCard.astro';
import { groupMaterialsByTeacher } from '../../utils/teacherGrouping';
import { getInitials } from '../../utils/contributors';

interface Props {
  materials: MaterialItem[];
  showYear?: boolean;
}

const { materials, showYear = false } = Astro.props;
const teacherGroups = groupMaterialsByTeacher(materials);
---

<div class="space-y-10" id="teacher-materials-container">
  {teacherGroups.length === 0 ? (
    <div class="py-12 text-center border border-dashed border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 bg-white dark:bg-zinc-900/60">
      <div class="w-12 h-12 mx-auto rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-3">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
        </svg>
      </div>
      <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 mb-1">
        No resources added here yet
      </h3>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-4 max-w-sm mx-auto">
        Be the first to share study lectures and summaries for this subject.
      </p>
      <a
        href="/contribute"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 text-white hover:bg-emerald-700 text-xs font-bold transition-colors shadow-2xs"
      >
        <span>Share a Study Resource</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
        </svg>
      </a>
    </div>
  ) : (
    teacherGroups.map((group) => (
      <section
        class="teacher-group-section space-y-4"
        data-teacher-id={group.id}
        data-teacher-name={group.name}
      >
        <!-- Teacher / Doctor Header -->
        <div class="flex items-center justify-between pb-2.5 border-b border-zinc-200/80 dark:border-zinc-800">
          <div class="flex items-center gap-2.5">
            {group.isDoctor ? (
              <div class="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-bold text-xs flex items-center justify-center shrink-0 border border-emerald-300/60 dark:border-emerald-800/60">
                {getInitials(group.name.replace(/^(dr|doctor|دكتور|د\.)\s*/i, ''))}
              </div>
            ) : group.isDepartment ? (
              <div class="w-8 h-8 rounded-full bg-indigo-100 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 flex items-center justify-center shrink-0 border border-indigo-300/60 dark:border-indigo-800/60">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 1-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" />
                </svg>
              </div>
            ) : (
              <div class="w-8 h-8 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 flex items-center justify-center shrink-0 border border-zinc-200 dark:border-zinc-700">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                </svg>
              </div>
            )}

            <div>
              <h3 class="text-sm sm:text-base font-extrabold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
                <span>{group.name}</span>
              </h3>
            </div>
          </div>

          <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400">
            {group.count} {group.count === 1 ? 'resource' : 'resources'}
          </span>
        </div>

        <!-- Materials Grid for this Teacher -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 materials-grid">
          {group.items.map((item) => (
            <div
              data-material-id={item.id}
              data-material-type={item.type}
              data-material-category={item.category || 'other'}
              class="teacher-material-card-wrapper"
            >
              <ResourceCard material={item} showYear={showYear} />
            </div>
          ))}
        </div>
      </section>
    ))
  )}
</div>
