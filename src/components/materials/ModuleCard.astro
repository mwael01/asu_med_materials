---
import type { ModuleInfo } from '../../types/materials';
import SubjectIcon from './SubjectIcon.astro';
import { getModuleAppearance } from '../../utils/subjectAppearance';

interface Props {
  module: ModuleInfo;
  resourceCount?: number;
}

const { module } = Astro.props;
const appearance = getModuleAppearance(module);
---

<a
  href={`/module/${module.id}`}
  class="group block bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 rounded-xl p-5 transition-all hover:border-emerald-500/70 shadow-2xs hover:shadow-sm dark:hover:shadow-emerald-950/20 active:scale-[0.99] text-start"
>
  <div class="flex items-center gap-3 mb-3">
    <span class:list={['w-10 h-10 rounded-xl flex items-center justify-center shrink-0', appearance.colors]}>
      <SubjectIcon name={appearance.icon} />
    </span>
    <div class="min-w-0 flex-1">
      <h3
        class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 group-hover:underline group-active:underline group-focus-visible:underline underline-offset-4 decoration-emerald-500 dark:decoration-emerald-400 transition-colors truncate"
      >
        {module.title}
      </h3>
      {module.code && (
        <span class="text-[10px] font-mono text-zinc-400 dark:text-zinc-500">{module.code}</span>
      )}
    </div>
  </div>



  {module.subjects && module.subjects.length > 0 && (
    <div class="flex flex-wrap gap-1 mb-3">
      {module.subjects.slice(0, 4).map((sub) => (
        <span class="text-[10px] px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
          {sub}
        </span>
      ))}
      {module.subjects.length > 4 && (
        <span class="text-[10px] px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-400 dark:text-zinc-500">
          +{module.subjects.length - 4}
        </span>
      )}
    </div>
  )}

  <div class="mt-auto pt-2 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between text-xs font-semibold text-emerald-600 dark:text-emerald-400">
    <span>Browse Module</span>
    <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>
