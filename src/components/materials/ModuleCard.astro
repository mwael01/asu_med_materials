---
import type { ModuleInfo } from '../../types/materials';

interface Props {
  module: ModuleInfo;
  resourceCount?: number;
}

const { module } = Astro.props;
---

<a
  href={`/module/${module.id}`}
  class="group block bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 rounded-xl p-5 transition-all hover:border-emerald-500/70 shadow-2xs hover:shadow-sm dark:hover:shadow-emerald-950/20 active:scale-[0.99] text-start"
>
  <div class="flex items-center justify-between gap-2 mb-2">
    <span class="text-xs font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-300">
      {module.code}
    </span>
  </div>

  <h3
    class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 group-hover:underline group-active:underline group-focus-visible:underline underline-offset-4 decoration-emerald-500 dark:decoration-emerald-400 transition-colors mb-1"
    data-i18n-mod-title-en={module.title}
    data-i18n-mod-title-ar={module.titleAr || module.title}
  >
    {module.title}
  </h3>

  {(module.description || module.descriptionAr) && (
    <p
      class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2 mb-3"
      data-i18n-mod-desc-en={module.description || ''}
      data-i18n-mod-desc-ar={module.descriptionAr || module.description || ''}
    >
      {module.description || module.descriptionAr}
    </p>
  )}

  {module.subjects && module.subjects.length > 0 && (
    <div class="flex flex-wrap gap-1 mb-3">
      {module.subjects.slice(0, 4).map((sub) => (
        <span class="text-[10px] px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
          {sub}
        </span>
      ))}
      {module.subjects.length > 4 && (
        <span class="text-[10px] px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-400 dark:text-zinc-500">
          +{module.subjects.length - 4}
        </span>
      )}
    </div>
  )}

  <div class="mt-auto pt-2 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between text-xs font-semibold text-emerald-600 dark:text-emerald-400">
    <span data-i18n="module.browseModule">Browse Module</span>
    <svg class="w-3.5 h-3.5 rtl:-rotate-180 rtl:group-hover:-translate-x-1 ltr:group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>
