---
import type { MaterialCollection } from '../../types/collections';

interface Props {
  collection: MaterialCollection;
  showYear?: boolean;
}

const { collection, showYear = true } = Astro.props;

const count = collection.materialIds?.length || 0;
const cardHref = `/collection/${collection.id}`;

// Category color mappings
const categoryBadgeClasses: Record<string, string> = {
  practical: 'bg-blue-100 text-blue-800 dark:bg-blue-950/80 dark:text-blue-300 border-blue-200 dark:border-blue-900/60',
  finals: 'bg-rose-100 text-rose-800 dark:bg-rose-950/80 dark:text-rose-300 border-rose-200 dark:border-rose-900/60',
  midterm: 'bg-amber-100 text-amber-800 dark:bg-amber-950/80 dark:text-amber-300 border-amber-200 dark:border-amber-900/60',
  revision: 'bg-purple-100 text-purple-800 dark:bg-purple-950/80 dark:text-purple-300 border-purple-200 dark:border-purple-900/60',
  general: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border-emerald-200 dark:border-emerald-900/60'
};

const badgeClass = categoryBadgeClasses[collection.category] || categoryBadgeClasses.general;
---

<div
  class="group relative flex flex-col justify-between bg-white dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 rounded-2xl p-4 shadow-2xs hover:shadow-md hover:border-emerald-500/70 dark:hover:shadow-emerald-950/20 transition-all text-start cursor-pointer content-auto"
  data-collection-id={collection.id}
  data-material-id={collection.id}
  data-material-year={collection.year}
>
  <div>
    <!-- Top Metadata Header -->
    <div class="flex items-center justify-between gap-2 mb-2.5 relative z-20">
      <div class="flex items-center gap-1.5 flex-wrap">
        <!-- Category Badge -->
        <span
          class:list={[
            'inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-0.5 rounded-lg border',
            badgeClass
          ]}
          data-i18n={`collections.categories.${collection.category}`}
        >
          <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span>{collection.category}</span>
        </span>

        {showYear && (
          <span
            class="text-[11px] font-semibold px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400"
            data-i18n="nav.year"
            data-i18n-params={JSON.stringify({ y: collection.year })}
          >
            Year {collection.year}
          </span>
        )}
      </div>

      <!-- Standard Bookmark Button -->
      <button
        type="button"
        class="bookmark-btn relative z-30 inline-flex items-center gap-1 px-1.5 py-1 -m-1 text-zinc-400 hover:text-amber-500 dark:hover:text-amber-400 rounded-lg hover:bg-amber-50/60 dark:hover:bg-amber-950/40 active:scale-95 transition-all cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500"
        data-id={collection.id}
        data-i18n-attr="title:card.save,aria-label:card.save"
        title="Save to bookmarks"
        aria-label="Save to bookmarks"
      >
        <svg class="w-4.5 h-4.5 bookmark-icon-empty shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
        </svg>
        <svg class="w-4.5 h-4.5 bookmark-icon-filled hidden shrink-0 text-amber-500 fill-amber-500 drop-shadow-2xs" viewBox="0 0 24 24">
          <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
        </svg>
        <span
          class="bookmark-count text-[11px] font-semibold tabular-nums leading-none select-none text-zinc-500 dark:text-zinc-400"
          data-count={collection.bookmarksCount || 0}
        >
          {collection.bookmarksCount || 0}
        </span>
      </button>
    </div>

    <!-- Title with Stretched Link -->
    <h3 class="font-bold text-zinc-900 dark:text-zinc-100 text-sm sm:text-base leading-snug line-clamp-2 mb-1.5 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 group-hover:underline underline-offset-4 decoration-emerald-500 dark:decoration-emerald-400 transition-colors">
      <a href={cardHref} class="focus:outline-none">
        <span class="absolute inset-0 z-0" aria-hidden="true"></span>
        <span
          data-title-ar={collection.title}
          data-title-en={collection.titleEn || collection.title}
        >{collection.title}</span>
      </a>
    </h3>

    <!-- Description -->
    {collection.description && (
      <p
        class="text-xs text-zinc-600 dark:text-zinc-400 line-clamp-2 mb-3"
        data-desc-ar={collection.description}
        data-desc-en={collection.descriptionEn || collection.description}
      >
        {collection.description}
      </p>
    )}
  </div>

  <!-- Footer Tags & Count -->
  <div class="flex items-center justify-between gap-2 pt-2 border-t border-zinc-100 dark:border-zinc-800/80 text-[11px] text-zinc-500 dark:text-zinc-400 relative z-20">
    <div class="flex items-center gap-1.5 truncate">
      {collection.subject && (
        <span class="text-zinc-700 dark:text-zinc-300 font-medium truncate">
          {collection.subject}
        </span>
      )}
    </div>

    <div class="flex items-center gap-1 shrink-0 font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 px-2 py-0.5 rounded-md">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <span data-i18n="collections.resourcesCount" data-i18n-params={JSON.stringify({ n: count })}>
        {count} resources
      </span>
    </div>
  </div>
</div>
