---
import type { MaterialItem } from '../../types/materials';
import TypeBadge from './TypeBadge.astro';
import { subjectToSlug } from '../../utils/slug';
import { getMaterialEnglishTitle, getMaterialEnglishDesc } from '../../i18n/materialsTranslations';

interface Props {
  material: MaterialItem;
  showYear?: boolean;
}

const { material, showYear = false } = Astro.props;

const titleEn = material.titleEn || getMaterialEnglishTitle(material.id, material.title);
const descEn = material.descriptionEn || (material.description ? getMaterialEnglishDesc(material.id, material.description) : undefined);

// Normalize author (who made/prepared the material)
const rawAuthors: string[] = Array.isArray(material.author)
  ? material.author
  : material.author
    ? [material.author]
    : [];

const maxVisible = 2;
const hasMoreThanMax = rawAuthors.length > maxVisible;
const displayedAuthorText = hasMoreThanMax
  ? rawAuthors.slice(0, maxVisible).join('، ') + '...'
  : rawAuthors.join('، ');
const fullAuthorTooltip = rawAuthors.join('، ');

// Normalize addedBy (contributor who added it to the website)
const rawAddedBy: string[] = Array.isArray(material.addedBy)
  ? material.addedBy
  : material.addedBy
    ? [material.addedBy]
    : [];
const displayedAddedByText = rawAddedBy.slice(0, maxVisible).join('، ');
const fullAddedByTooltip = rawAddedBy.join('، ');

const isPlaylist = material.type === 'playlist' || Boolean(material.playlistId) || Boolean(material.videos);
const cardHref = isPlaylist ? `/playlist/${material.id}` : material.url;
const targetAttr = isPlaylist ? '_self' : '_blank';
---

<div
  class="group relative flex flex-col justify-between bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 rounded-xl p-4 shadow-2xs hover:shadow-md hover:border-emerald-500/70 dark:hover:shadow-emerald-950/20 active:scale-[0.99] transition-all text-start"
  data-material-id={material.id}
  data-material-type={material.type}
>
  <div>
    <!-- Top Metadata Header -->
    <div class="flex items-center justify-between gap-2 mb-2.5">
      <TypeBadge type={material.type === 'playlist' ? 'youtube' : material.type} size="sm" />

      <div class="flex items-center gap-1.5 relative z-10">
        {showYear && (
          <span
            class="text-[11px] font-semibold px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400"
            data-i18n="nav.year"
            data-i18n-params={JSON.stringify({ y: material.year })}
          >
            Year {material.year}
          </span>
        )}
        <!-- Archived Badge (Shown dynamically when bookmarked/archived by student) -->
        <span
          class="archived-badge hidden items-center gap-1 text-[11px] font-semibold px-2 py-0.5 rounded bg-amber-50 text-amber-700 dark:bg-amber-950/50 dark:text-amber-400 border border-amber-200 dark:border-amber-800/40"
          data-i18n="card.save"
        >
          Saved
        </span>
        <!-- Bookmark Button -->
        <button
          type="button"
          class="bookmark-btn p-1.5 text-zinc-400 hover:text-amber-500 dark:hover:text-amber-400 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
          data-id={material.id}
          data-i18n-attr="title:card.save,aria-label:card.save"
          title="Save to bookmarks"
          aria-label="Save to bookmarks"
        >
          <svg class="w-4 h-4 bookmark-icon-empty" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
          </svg>
          <svg class="w-4 h-4 bookmark-icon-filled hidden text-amber-500 fill-amber-500" viewBox="0 0 24 24">
            <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Title with Stretched Link -->
    <h3 class="font-bold text-zinc-900 dark:text-zinc-100 text-sm leading-snug line-clamp-2 mb-1.5 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 group-hover:underline group-active:underline group-focus-visible:underline underline-offset-4 decoration-emerald-500 dark:decoration-emerald-400 transition-colors">
      <a href={cardHref} target={targetAttr} rel={isPlaylist ? undefined : "noopener noreferrer"} class="focus:outline-none">
        <span class="absolute inset-0" aria-hidden="true"></span>
        <span
          data-i18n-material-title={material.id}
          data-title-ar={material.title}
          data-title-en={titleEn}
        >{titleEn || material.title}</span>
      </a>
    </h3>

    <!-- Description -->
    {material.description && (
      <p
        class="text-xs text-zinc-600 dark:text-zinc-400 line-clamp-2 mb-3"
        data-i18n-material-desc={material.id}
        data-desc-ar={material.description}
        data-desc-en={descEn}
      >
        {descEn || material.description}
      </p>
    )}

    <!-- Tags & Subject & Author / AddedBy -->
    <div class="flex flex-wrap items-center gap-1.5 text-[11px] font-medium">
      {material.subject && material.moduleId ? (
        <a
          href={`/module/${material.moduleId}/${subjectToSlug(material.subject)}`}
          class="relative z-10 text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800/80 hover:bg-emerald-50 hover:text-emerald-700 dark:hover:bg-emerald-950/60 dark:hover:text-emerald-400 px-2 py-0.5 rounded transition-colors"
          title={material.subject}
        >
          {material.subject}
        </a>
      ) : material.subject ? (
        <span class="text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800/80 px-2 py-0.5 rounded">
          {material.subject}
        </span>
      ) : null}
      {displayedAuthorText && (
        <span
          class="text-zinc-600 dark:text-zinc-300 truncate max-w-[170px]"
          title={fullAuthorTooltip}
        >
          <span data-i18n="card.by">By:</span> {displayedAuthorText}
        </span>
      )}
      {displayedAddedByText && (
        <span
          class="text-zinc-400 dark:text-zinc-500 truncate max-w-[150px]"
          title={fullAddedByTooltip}
        >
          &bull; <span data-i18n="card.addedBy">Added by:</span> {displayedAddedByText}
        </span>
      )}
    </div>
  </div>
</div>
