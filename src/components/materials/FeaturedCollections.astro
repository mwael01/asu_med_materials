---
import CollectionCard from './CollectionCard.astro';
import type { MaterialCollection } from '../../types/collections';
import type { AcademicYear } from '../../types/materials';
import { groupCollectionsByYear } from '../../data/collections';

interface Props {
  collections: MaterialCollection[];
}

const { collections } = Astro.props;
const collectionsByYear = groupCollectionsByYear(collections);
const ACADEMIC_YEARS: AcademicYear[] = [1, 2, 3, 4, 5];

const hasAnyCollections = Object.values(collectionsByYear).some((items) => items.length > 0);
const hasInitialCollections = (collectionsByYear[2]?.length || 0) > 0;
---

{hasAnyCollections && (
  <section
    class:list={['mb-12', !hasInitialCollections && 'hidden']}
    id="home-featured-collections-section"
    aria-labelledby="featured-collections-title"
  >
    <!-- Section Header -->
    <div class="flex items-center justify-between mb-4">
      <div>
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h2 id="featured-collections-title" class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100">
            Featured Study Collections
          </h2>
        </div>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">
          Curated packs for practical OSPE, finals revision, and doctor series
        </p>
      </div>
    </div>

    <!-- Year-Specific Containers -->
    {ACADEMIC_YEARS.map((y) => {
      const allYearItems = collectionsByYear[y] || [];
      // Prioritize explicitly featured items, then others
      const featuredItems = allYearItems.filter((c) => c.featured === true);
      const displayItems = featuredItems.length > 0 ? featuredItems : allYearItems;
      const isInitialActive = y === 2;

      return (
        <div
          data-featured-collections-year={y}
          data-has-items={displayItems.length > 0 ? 'true' : 'false'}
          class:list={['home-featured-collections-wrapper', (!isInitialActive || displayItems.length === 0) && 'hidden']}
        >
          {displayItems.length > 0 && (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {displayItems.map((col) => (
                <CollectionCard collection={col} showYear={false} />
              ))}
            </div>
          )}
        </div>
      );
    })}

    <!-- Zero-Flash Early Pre-Paint Year Setter for Featured Collections -->
    <script is:inline>
      (function () {
        try {
          var y = parseInt(localStorage.getItem('asumed_user_year') || '2', 10);
          var wrappers = document.querySelectorAll('.home-featured-collections-wrapper');
          var section = document.getElementById('home-featured-collections-section');
          var hasMatch = false;
          wrappers.forEach(function (el) {
            var yr = parseInt(el.getAttribute('data-featured-collections-year') || '0', 10);
            if (yr === y) {
              if (el.getAttribute('data-has-items') === 'true') {
                el.classList.remove('hidden');
                hasMatch = true;
              } else {
                el.classList.add('hidden');
              }
            } else {
              el.classList.add('hidden');
            }
          });
          if (section) {
            section.classList.toggle('hidden', !hasMatch);
          }
        } catch (e) {}
      })();
    </script>
  </section>
)}
