---
import { GOOGLE_FEEDBACK_FORM_URL } from '../../utils/surveyBanner';
---

<!-- Slim Non-Disruptive Top Survey Banner -->
<div
  id="survey-top-banner"
  class="hidden w-full bg-emerald-950/35 border-b border-emerald-500/20 text-zinc-200 transition-colors"
  role="region"
  aria-label="Student Feedback Survey"
>
  <div class="max-w-6xl mx-auto px-3 sm:px-6 py-1.5 flex items-center justify-between gap-2 text-xs">
    <button
      type="button"
      id="survey-banner-open-btn"
      class="flex-1 min-w-0 flex flex-wrap items-center justify-center sm:justify-start gap-x-2 gap-y-0.5 text-left sm:text-start py-0.5 cursor-pointer group focus:outline-none"
    >
      <span class="text-zinc-200 font-medium truncate">
        Help us improve <strong class="text-white font-bold">ASU Med</strong> for you &amp; future batches
      </span>
      <span class="inline-flex items-center gap-1 font-bold text-emerald-400 group-hover:text-emerald-300 underline decoration-emerald-500/40 underline-offset-2 shrink-0 transition-colors">
        <span>Share Feedback</span>
        <span aria-hidden="true">&rarr;</span>
      </span>
    </button>

    <button
      type="button"
      id="survey-banner-dismiss-btn"
      class="p-1.5 -mr-1 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800/70 rounded-lg transition-colors shrink-0 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
      title="Dismiss for a month"
      aria-label="Dismiss feedback banner"
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>

<!-- Synchronous Initial Visibility Check to Prevent Flash -->
<script is:inline>
  (function () {
    try {
      var banner = document.getElementById('survey-top-banner');
      if (!banner) return;
      var cleanPath = (window.location.pathname || '/').replace(/\/+$/, '') || '/';
      if (cleanPath === '/admin' || cleanPath.indexOf('/admin/') === 0 || cleanPath === '/feedback') {
        return;
      }
      var completed = localStorage.getItem('asumed_survey_completed') === 'true';
      var dismissedUntil = Number(localStorage.getItem('asumed_survey_dismissed_until') || '0');
      if (!completed && Date.now() >= dismissedUntil) {
        banner.classList.remove('hidden');
      }
    } catch (e) {}
  })();
</script>

<!-- Friendly Animated Thank-You Modal (Small-Mobile Compatible) -->
<div
  id="survey-friendly-modal"
  class="hidden fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/75 backdrop-blur-xs opacity-0 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="survey-modal-title"
>
  <div
    id="survey-modal-card"
    class="relative w-full max-w-sm sm:max-w-md max-h-[calc(100dvh-1.5rem-env(safe-area-inset-top,0px)-env(safe-area-inset-bottom,0px))] overflow-y-auto overscroll-contain rounded-2xl sm:rounded-3xl bg-zinc-900 border border-zinc-800/90 p-5 sm:p-7 text-center shadow-2xl transform scale-95 transition-transform duration-200"
  >
    <!-- Subtle Top Ambient Glow -->
    <div
      class="pointer-events-none absolute -top-20 left-1/2 -translate-x-1/2 w-64 h-36 rounded-full bg-emerald-500/15 blur-2xl"
      aria-hidden="true"
    ></div>

    <!-- Close Corner Button -->
    <button
      type="button"
      id="survey-modal-close-btn"
      class="absolute top-3 right-3 sm:top-4 sm:right-4 p-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 rounded-xl transition-colors cursor-pointer z-10"
      title="Close"
      aria-label="Close dialog"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Custom Animated Medical & Student Gratitude Drawing -->
    <div class="relative mx-auto w-32 h-24 sm:w-44 sm:h-32 mb-2 sm:mb-3 select-none" aria-hidden="true">
      <svg
        viewBox="0 0 220 150"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-full overflow-visible"
      >
        <defs>
          <linearGradient id="surveyBookGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#10b981" stop-opacity="0.28" />
            <stop offset="100%" stop-color="#0d9488" stop-opacity="0.08" />
          </linearGradient>
          <linearGradient id="surveyHeartGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#34d399" />
            <stop offset="100%" stop-color="#10b981" />
          </linearGradient>
          <linearGradient id="surveyPulseGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#10b981" stop-opacity="0" />
            <stop offset="25%" stop-color="#34d399" />
            <stop offset="75%" stop-color="#2dd4bf" />
            <stop offset="100%" stop-color="#10b981" stop-opacity="0" />
          </linearGradient>
        </defs>

        <!-- Soft Base Shadow -->
        <ellipse cx="110" cy="134" rx="64" ry="8" fill="#10b981" fill-opacity="0.12" class="survey-shadow-pulse" />

        <!-- Floating Open Medical Study Book -->
        <g class="survey-float-book">
          <!-- Left Page -->
          <path
            d="M46 58C46 52 74 48 110 56V116C74 108 46 112 46 118V58Z"
            fill="url(#surveyBookGrad)"
            stroke="#34d399"
            stroke-width="2"
            stroke-linejoin="round"
          />
          <!-- Right Page -->
          <path
            d="M174 58C174 52 146 48 110 56V116C146 108 174 112 174 118V58Z"
            fill="url(#surveyBookGrad)"
            stroke="#34d399"
            stroke-width="2"
            stroke-linejoin="round"
          />
          <!-- Book Spine -->
          <path d="M110 56V116" stroke="#6ee7b7" stroke-width="2" stroke-linecap="round" />

          <!-- Subtle Study Lines on Pages -->
          <path d="M62 72C76 70 88 71 98 74" stroke="#34d399" stroke-opacity="0.45" stroke-width="2" stroke-linecap="round" />
          <path d="M62 84C76 82 88 83 98 86" stroke="#34d399" stroke-opacity="0.35" stroke-width="2" stroke-linecap="round" />
          <path d="M122 74C132 71 144 70 158 72" stroke="#34d399" stroke-opacity="0.45" stroke-width="2" stroke-linecap="round" />
          <path d="M122 86C132 83 144 82 158 84" stroke="#34d399" stroke-opacity="0.35" stroke-width="2" stroke-linecap="round" />
        </g>

        <!-- Animated Glowing ECG Heartbeat Wave Across the Scene -->
        <path
          d="M22 96H72L84 78L96 112L110 64L122 104L132 86L142 96H198"
          stroke="url(#surveyPulseGrad)"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="survey-ecg-line"
        />

        <!-- Floating Gratitude Heart Emblem -->
        <g class="survey-float-heart">
          <circle cx="110" cy="34" r="20" fill="#064e3b" fill-opacity="0.7" stroke="#34d399" stroke-width="1.75" />
          <path
            d="M110 44.5C110 44.5 97.5 36.8 97.5 29.2C97.5 25.4 100.5 22.5 104.2 22.5C106.6 22.5 108.8 23.8 110 25.8C111.2 23.8 113.4 22.5 115.8 22.5C119.5 22.5 122.5 25.4 122.5 29.2C122.5 36.8 110 44.5 110 44.5Z"
            fill="url(#surveyHeartGrad)"
          />
        </g>

        <!-- Animated Twinkling Sparkles -->
        <g class="survey-sparkle-1">
          <path d="M42 30L44.5 36.5L51 39L44.5 41.5L42 48L39.5 41.5L33 39L39.5 36.5L42 30Z" fill="#6ee7b7" />
        </g>
        <g class="survey-sparkle-2">
          <path d="M178 24L180 29L185 31L180 33L178 38L176 33L171 31L176 29L178 24Z" fill="#5eead4" />
        </g>
        <circle cx="164" cy="48" r="2.5" fill="#34d399" class="survey-sparkle-3" />
        <circle cx="58" cy="46" r="2" fill="#5eead4" class="survey-sparkle-2" />
      </svg>
    </div>

    <!-- Huge Thank-You Text -->
    <h2
      id="survey-modal-title"
      class="text-2xl xs:text-3xl sm:text-4xl font-black tracking-tight bg-gradient-to-r from-emerald-300 via-emerald-400 to-teal-200 bg-clip-text text-transparent mb-1"
    >
      Thank You!
    </h2>

    <p class="text-xs sm:text-sm font-bold text-emerald-400/90 mb-3">
      Built for students &bull; Forever free for everyone
    </p>

    <!-- Friendly Mission Explanation -->
    <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed mb-5 sm:mb-6">
      This work is made for current and future medical students and will remain <strong class="text-white font-semibold">forever free for everyone</strong>. Your feedback helps us shape it and enhance it further for every batch.
    </p>

    <!-- Thumb-Friendly Mobile Actions -->
    <div class="flex flex-col gap-2">
      <a
        href={GOOGLE_FEEDBACK_FORM_URL}
        target="_blank"
        rel="noopener noreferrer"
        id="survey-modal-cta-link"
        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 sm:py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white font-bold text-xs sm:text-sm shadow-lg shadow-emerald-950/50 transition-all cursor-pointer"
      >
        <span>Fill Feedback Form</span>
        <span aria-hidden="true">&rarr;</span>
      </a>

      <button
        type="button"
        id="survey-modal-later-btn"
        class="w-full py-2 rounded-xl text-xs sm:text-sm font-semibold text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/60 transition-colors cursor-pointer"
      >
        Maybe Later
      </button>
    </div>
  </div>
</div>

<style>
  @keyframes surveyFloatSlow {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @keyframes surveyFloatBook {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-2.5px);
    }
  }

  @keyframes surveyEcgDraw {
    0% {
      stroke-dashoffset: 260;
      opacity: 0.35;
    }
    50% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: -260;
      opacity: 0.35;
    }
  }

  @keyframes surveySparklePulse {
    0%, 100% {
      transform: scale(0.75);
      opacity: 0.4;
    }
    50% {
      transform: scale(1.1);
      opacity: 1;
    }
  }

  .survey-float-heart {
    animation: surveyFloatSlow 3.2s ease-in-out infinite;
    transform-origin: center;
  }

  .survey-float-book {
    animation: surveyFloatBook 4s ease-in-out infinite;
    transform-origin: center;
  }

  .survey-ecg-line {
    stroke-dasharray: 260;
    stroke-dashoffset: 260;
    animation: surveyEcgDraw 3.6s ease-in-out infinite;
  }

  .survey-sparkle-1 {
    transform-origin: 42px 39px;
    animation: surveySparklePulse 2.4s ease-in-out infinite;
  }

  .survey-sparkle-2 {
    transform-origin: 178px 31px;
    animation: surveySparklePulse 2.8s ease-in-out infinite 0.8s;
  }

  .survey-sparkle-3 {
    transform-origin: 164px 48px;
    animation: surveySparklePulse 2.2s ease-in-out infinite 1.4s;
  }

  .survey-shadow-pulse {
    animation: surveySparklePulse 4s ease-in-out infinite;
    transform-origin: 110px 134px;
  }
</style>

<script>
  import {
    shouldShowSurveyBanner,
    markSurveyCompleted,
    snoozeSurveyBanner
  } from '../../utils/surveyBanner';

  declare global {
    interface Window {
      __SURVEY_KEY_LISTENER_BOUND?: boolean;
    }
  }

  function closeSurveyModal(): void {
    const modal = document.getElementById('survey-friendly-modal');
    const card = document.getElementById('survey-modal-card');
    if (!modal) return;

    modal.classList.add('opacity-0');
    modal.classList.remove('opacity-100');
    card?.classList.add('scale-95');
    card?.classList.remove('scale-100');
    document.body.classList.remove('overflow-hidden');

    setTimeout(() => {
      modal.classList.add('hidden');
    }, 200);
  }

  function openSurveyModal(): void {
    const modal = document.getElementById('survey-friendly-modal');
    const card = document.getElementById('survey-modal-card');
    if (!modal) return;

    modal.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');

    requestAnimationFrame(() => {
      modal.classList.remove('opacity-0');
      modal.classList.add('opacity-100');
      card?.classList.remove('scale-95');
      card?.classList.add('scale-100');
    });
  }

  function initSurveyBanner(): void {
    const banner = document.getElementById('survey-top-banner');
    const openBtn = document.getElementById('survey-banner-open-btn');
    const dismissBtn = document.getElementById('survey-banner-dismiss-btn');
    const modal = document.getElementById('survey-friendly-modal');
    const closeBtn = document.getElementById('survey-modal-close-btn');
    const laterBtn = document.getElementById('survey-modal-later-btn');
    const ctaLink = document.getElementById('survey-modal-cta-link');

    if (!banner) return;

    const pathname = window.location.pathname || '/';
    if (shouldShowSurveyBanner(pathname)) {
      banner.classList.remove('hidden');
    } else {
      banner.classList.add('hidden');
    }

    if (openBtn && !openBtn.dataset.bound) {
      openBtn.dataset.bound = 'true';
      openBtn.addEventListener('click', () => {
        openSurveyModal();
      });
    }

    if (dismissBtn && !dismissBtn.dataset.bound) {
      dismissBtn.dataset.bound = 'true';
      dismissBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        snoozeSurveyBanner();
        banner.classList.add('hidden');
        closeSurveyModal();
      });
    }

    if (closeBtn && !closeBtn.dataset.bound) {
      closeBtn.dataset.bound = 'true';
      closeBtn.addEventListener('click', () => {
        closeSurveyModal();
      });
    }

    if (laterBtn && !laterBtn.dataset.bound) {
      laterBtn.dataset.bound = 'true';
      laterBtn.addEventListener('click', () => {
        closeSurveyModal();
      });
    }

    if (modal && !modal.dataset.bound) {
      modal.dataset.bound = 'true';
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeSurveyModal();
        }
      });
    }

    if (ctaLink && !ctaLink.dataset.bound) {
      ctaLink.dataset.bound = 'true';
      ctaLink.addEventListener('click', () => {
        markSurveyCompleted();
        banner.classList.add('hidden');
        closeSurveyModal();
      });
    }

    if (!window.__SURVEY_KEY_LISTENER_BOUND) {
      window.__SURVEY_KEY_LISTENER_BOUND = true;
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const activeModal = document.getElementById('survey-friendly-modal');
          if (activeModal && !activeModal.classList.contains('hidden')) {
            closeSurveyModal();
          }
        }
      });
    }
  }

  initSurveyBanner();
  document.addEventListener('astro:after-swap', initSurveyBanner);
</script>
