---
import type { AuthorEntry } from '../../types/contributors';
import { getInitials } from '../../utils/contributors';
import ContactButtons from './ContactButtons.astro';

interface Props {
  author: AuthorEntry;
}

const { author } = Astro.props;
---

<div class="bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 rounded-2xl p-6 sm:p-8 shadow-2xs hover:border-emerald-500/60 hover:shadow-sm transition-[border-color,box-shadow] duration-200 text-center flex flex-col items-center">
  {author.photo ? (
    <div
      class="relative rounded-full overflow-hidden mb-5 border-2 border-emerald-100 dark:border-emerald-900/50 shrink-0 bg-zinc-100 dark:bg-zinc-800 shadow-2xs aspect-square"
      style="width: 160px; height: 160px; min-width: 160px; min-height: 160px; max-width: 160px; max-height: 160px; border-radius: 50%; -webkit-mask-image: -webkit-radial-gradient(white, black);"
    >
      <img
        src={author.photo}
        alt={author.name}
        width="160"
        height="160"
        loading="eager"
        decoding="sync"
        class="absolute inset-0 w-full h-full object-cover object-center block"
        style="aspect-ratio: 1 / 1; border-radius: 50%; object-fit: cover; object-position: center;"
      />
    </div>
  ) : (
    <div
      class="rounded-full bg-emerald-600 text-white flex items-center justify-center text-4xl font-extrabold mb-5 select-none shrink-0 shadow-2xs aspect-square"
      style="width: 160px; height: 160px; min-width: 160px; min-height: 160px; max-width: 160px; max-height: 160px; border-radius: 50%;"
      aria-hidden="true"
    >
      {getInitials(author.name)}
    </div>
  )}

  <h3 class="font-bold text-base text-zinc-900 dark:text-zinc-100 leading-relaxed">
    {author.name}
  </h3>

  {author.adminRoleDescription && (
    <p class="mt-3 text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-[90%]">
      {author.adminRoleDescription}
    </p>
  )}

  {author.contacts && (
    <div class="mt-5 flex flex-wrap justify-center gap-1.5 w-full">
      <ContactButtons contacts={author.contacts} showLabels={true} />
    </div>
  )}
</div>
