---
<dialog id="year-selector" aria-labelledby="year-selector-title" class="m-auto w-[calc(100%_-_2rem)] max-w-sm rounded-2xl p-6 bg-white dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 backdrop:bg-black/50">
  <div class="flex justify-between items-center gap-4 mb-5">
    <h2 id="year-selector-title" class="text-lg font-bold">Choose your year</h2>
    <button type="button" data-close-year aria-label="Close year selection" class="text-sm text-zinc-500 p-2">Close</button>
  </div>
  <div class="grid gap-2">
    {[1,2,3,4,5].map(year => <button type="button" data-select-year={year} class="text-left rounded-lg px-4 py-3 border border-zinc-200 dark:border-zinc-700 hover:border-emerald-500 focus-visible:outline-emerald-500">Year {year}</button>)}
  </div>
</dialog>
<script>
  import { initYearSelector } from '../../scripts/navigation/yearSelector';
  initYearSelector();
  document.addEventListener('astro:after-swap', initYearSelector);
</script>
