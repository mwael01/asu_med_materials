---
import type { ModuleInfo } from '../../types/materials';
import { resolveYearDestination } from '../../utils/moduleHelpers';
import StudyIllustration from './StudyIllustration.astro';

interface Props { modules: ModuleInfo[]; }
const { modules } = Astro.props;
---
<dialog id="year-selector" aria-labelledby="year-selector-title" class="m-auto w-[calc(100%_-_2rem)] max-w-sm max-h-[calc(100dvh_-_2rem)] overflow-y-auto overscroll-contain rounded-3xl border border-emerald-100 dark:border-emerald-900/60 p-5 sm:p-6 bg-white dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 shadow-2xl backdrop:bg-zinc-950/70 backdrop:backdrop-blur-sm">
  <div class="flex justify-end">
    <button type="button" data-close-year aria-label="Close year selection" class="rounded-lg px-2 py-1 text-xs text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 cursor-pointer focus-visible:outline-2 focus-visible:outline-emerald-500">Close</button>
  </div>
  <StudyIllustration />
  <h2 id="year-selector-title" class="mb-5 text-center text-2xl font-bold tracking-tight">Choose your year</h2>
  <div class="grid gap-2.5">
    {[1, 2, 3, 4, 5].map(year => (
      <button type="button" data-select-year={year} data-year-href={resolveYearDestination(modules, year)} aria-pressed="false" class="year-choice w-full rounded-xl px-4 py-3 text-left text-sm font-semibold border border-zinc-200 dark:border-zinc-700 bg-zinc-50/70 dark:bg-zinc-800/40 hover:border-emerald-500 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500">Year {year}</button>
    ))}
  </div>
</dialog>
<style>
  .year-choice[aria-pressed='true'] {
    border-color: var(--color-emerald-500);
    background-color: var(--color-emerald-600);
    color: white;
  }
  #year-selector[open] { animation: year-appear 180ms ease-out; }
  @keyframes year-appear {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    #year-selector[open] { animation: none; }
    .year-choice { transition: none; }
  }
</style>
<script>
  import { initYearSelector } from '../../scripts/navigation/yearSelector';
  initYearSelector();
  document.addEventListener('astro:after-swap', initYearSelector);
</script>
