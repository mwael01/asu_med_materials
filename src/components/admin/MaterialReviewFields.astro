---
const fields = [
  ['title', 'Title', 'text'],
  ['url', 'Resource URL', 'url'],
  ['year', 'Academic Year', 'select'],
  ['moduleId', 'Module (optional)', 'select'],
  ['subject', 'Subject', 'text'],
  ['lessonId', 'Lesson ID (optional; assign visually in Lessons)', 'text'],
  ['type', 'Resource Type', 'select'],
  ['category', 'Category', 'select'],
  ['author', 'Author (comma-separated)', 'text'],
  ['contributor', 'Contributor', 'text'],
  ['description', 'Description (optional)', 'textarea'],
  ['tags', 'Search Tags (comma-separated)', 'text'],
] as const;
const inputClass = 'w-full px-3 py-2 text-xs bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500';
---
<template id="material-review-template">
  <div class="space-y-3">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {fields.map(([key, label, kind]) => <label class="block min-w-0 space-y-1 text-xs text-zinc-700 dark:text-zinc-300">
        <span>{label}</span>
        {kind === 'select' ? <select data-field={key} class={inputClass}></select> : kind === 'textarea' ? <textarea data-field={key} rows="2" class={inputClass}></textarea> : <input data-field={key} type={kind} class={inputClass} />}
      </label>)}
    </div>
    <a data-resource-link target="_blank" rel="noopener noreferrer" class="hidden text-xs text-emerald-700 dark:text-emerald-400 hover:underline">Open resource</a>
    <div data-playlist class="hidden space-y-2">
      <label class="block text-xs"><span>Playlist ID</span><input data-field="playlistId" class={inputClass} /></label>
      <div data-videos class="space-y-2"></div>
      <button type="button" data-add-video class="text-xs text-emerald-700 dark:text-emerald-400">Add video</button>
    </div>
    <p data-credit class="text-xs text-zinc-500"></p>
    <div data-issues role="status" class="text-xs whitespace-pre-line text-amber-800 dark:text-amber-300"></div>
  </div>
</template>
