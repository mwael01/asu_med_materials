---
const fields = [
  ['title', 'العنوان العربي', 'Arabic title', 'text'],
  ['titleEn', 'العنوان الإنجليزي', 'English title', 'text'],
  ['url', 'الرابط', 'Resource URL', 'url'],
  ['year', 'السنة الدراسية', 'Academic year', 'select'],
  ['moduleId', 'الموديول (اختياري)', 'Module (optional)', 'select'],
  ['subject', 'المادة', 'Subject', 'text'],
  ['type', 'نوع المصدر', 'Resource type', 'select'],
  ['category', 'التصنيف', 'Category', 'select'],
  ['author', 'صانع المحتوى (افصل الأسماء بفاصلة)', 'Author (comma-separated names)', 'text'],
  ['contributor', 'المساهم', 'Contributor', 'text'],
  ['description', 'الوصف العربي', 'Arabic description', 'textarea'],
  ['descriptionEn', 'الوصف الإنجليزي', 'English description', 'textarea'],
  ['tags', 'كلمات البحث (افصل بفاصلة)', 'Search tags (comma-separated)', 'text'],
] as const;
const inputClass = 'w-full px-3 py-2 text-xs bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500';
---
<template id="material-review-template">
  <div class="space-y-3">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {fields.map(([key, ar, en, kind]) => <label class="block min-w-0 space-y-1 text-xs text-zinc-700 dark:text-zinc-300">
        <span data-label-ar={ar} data-label-en={en}>{ar}</span>
        {kind === 'select' ? <select data-field={key} class={inputClass}></select> : kind === 'textarea' ? <textarea data-field={key} rows="2" class={inputClass}></textarea> : <input data-field={key} type={kind} class={inputClass} />}
      </label>)}
    </div>
    <a data-resource-link target="_blank" rel="noopener noreferrer" class="hidden text-xs text-emerald-700 dark:text-emerald-400 hover:underline" data-label-ar="فتح المصدر" data-label-en="Open resource">فتح المصدر</a>
    <div data-playlist class="hidden space-y-2">
      <label class="block text-xs"><span data-label-ar="معرّف قائمة التشغيل" data-label-en="Playlist ID">معرّف قائمة التشغيل</span><input data-field="playlistId" class={inputClass} /></label>
      <div data-videos class="space-y-2"></div>
      <button type="button" data-add-video class="text-xs text-emerald-700 dark:text-emerald-400" data-label-ar="إضافة فيديو" data-label-en="Add video">إضافة فيديو</button>
    </div>
    <p data-credit class="text-xs text-zinc-500"></p>
    <div data-issues role="status" class="text-xs whitespace-pre-line text-amber-800 dark:text-amber-300"></div>
  </div>
</template>
