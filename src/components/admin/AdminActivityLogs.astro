---
// AdminActivityLogs.astro
---

<div class="space-y-4 text-start">
  <div class="flex items-center justify-between border-b border-zinc-200 dark:border-zinc-800 pb-3">
    <div class="text-xs font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-1.5">
      <span data-i18n="admin.activityLogsTitle">Admin Activity Log</span>
      <span class="text-[10px] text-zinc-400 font-normal">سجل العمليات الإدارية الموثقة</span>
    </div>

    <button
      type="button"
      id="logs-refresh-btn"
      class="text-xs text-zinc-500 hover:text-emerald-600 dark:hover:text-emerald-400 flex items-center gap-1 cursor-pointer font-medium"
      title="تحديث"
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
      </svg>
      <span>تحديث</span>
    </button>
  </div>

  <!-- Loading State -->
  <div id="logs-loading" class="py-10 text-center text-xs text-zinc-400">
    <div class="w-6 h-6 border-2 border-emerald-500 border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
    <span>جاري تحميل سجل النشاط...</span>
  </div>

  <!-- Empty State -->
  <div id="logs-empty" class="hidden py-10 text-center space-y-1">
    <p class="text-xs font-bold text-zinc-700 dark:text-zinc-300" data-i18n="admin.noLogs">
      No recorded admin operations yet.
    </p>
    <p class="text-[11px] text-zinc-400">أي إجراء يقوم به أي مسؤول (نشر مادة، اعتماد، ترقية، مراجعة) سيتم تسجيله هنا.</p>
  </div>

  <!-- Logs Feed -->
  <div id="logs-list" class="space-y-2"></div>
</div>

<script>
  import { fetchRecentAdminLogs } from '../../firebase/firestore';

  function initActivityLogs() {
    const listEl = document.getElementById('logs-list');
    const loadingEl = document.getElementById('logs-loading');
    const emptyEl = document.getElementById('logs-empty');
    const refreshBtn = document.getElementById('logs-refresh-btn');

    async function loadLogs() {
      if (!listEl) return;
      loadingEl?.classList.remove('hidden');
      emptyEl?.classList.add('hidden');
      listEl.innerHTML = '';

      const logs = await fetchRecentAdminLogs(50);
      loadingEl?.classList.add('hidden');

      if (logs.length === 0) {
        emptyEl?.classList.remove('hidden');
        return;
      }
      emptyEl?.classList.add('hidden');

      logs.forEach((log) => {
        const item = document.createElement('div');
        item.className =
          'p-3 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 flex flex-col sm:flex-row sm:items-center justify-between gap-2 shadow-2xs';

        let actionText: string = log.action;
        let actionColor = 'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300';

        switch (log.action) {
          case 'publish_material':
            actionText = 'نشر مادة مباشرة';
            actionColor = 'bg-emerald-50 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
            break;
          case 'approve_submission':
            actionText = 'اعتماد مساهمة';
            actionColor = 'bg-emerald-50 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
            break;
          case 'reject_submission':
            actionText = 'رفض مساهمة';
            actionColor = 'bg-amber-50 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
            break;
          case 'resolve_feedback':
            actionText = 'مراجعة ملاحظة';
            actionColor = 'bg-sky-50 text-sky-800 dark:bg-sky-950 dark:text-sky-300';
            break;
          case 'delete_feedback':
            actionText = 'حذف ملاحظة';
            actionColor = 'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300';
            break;
          case 'promote_admin':
            actionText = 'ترقية مسؤول';
            actionColor = 'bg-purple-50 text-purple-800 dark:bg-purple-950 dark:text-purple-300';
            break;
          case 'demote_admin':
            actionText = 'سحب صلاحية';
            actionColor = 'bg-rose-50 text-rose-800 dark:bg-rose-950 dark:text-rose-300';
            break;
          case 'create_module':
            actionText = 'إنشاء موديول';
            actionColor = 'bg-blue-50 text-blue-800 dark:bg-blue-950 dark:text-blue-300';
            break;
          case 'update_module':
            actionText = 'تعديل موديول';
            actionColor = 'bg-blue-50 text-blue-800 dark:bg-blue-950 dark:text-blue-300';
            break;
          case 'toggle_module':
            actionText = 'تفعيل/تعطيل موديول';
            actionColor = 'bg-amber-50 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
            break;
          case 'delete_module':
            actionText = 'حذف موديول';
            actionColor = 'bg-rose-50 text-rose-800 dark:bg-rose-950 dark:text-rose-300';
            break;
          case 'delete_material':
            actionText = 'حذف مادة';
            actionColor = 'bg-rose-50 text-rose-800 dark:bg-rose-950 dark:text-rose-300';
            break;
        }

        const dateStr = log.timestamp
          ? new Date(log.timestamp).toLocaleString('ar-EG', { dateStyle: 'short', timeStyle: 'short' })
          : '';

        item.innerHTML = `
          <div class="flex items-center gap-2.5">
            <span class="text-[10px] px-2 py-0.5 rounded-md font-bold shrink-0 ${actionColor}">${actionText}</span>
            <div class="text-xs text-zinc-800 dark:text-zinc-200">
              <span class="font-bold text-emerald-700 dark:text-emerald-400">@${escapeHtml(log.adminUsername || 'admin')}</span>:
              <span class="text-zinc-600 dark:text-zinc-300">${escapeHtml(log.targetTitle || log.details || '')}</span>
            </div>
          </div>
          <span class="text-[10px] text-zinc-400 shrink-0 font-mono">${dateStr}</span>
        `;

        listEl.appendChild(item);
      });
    }

    function escapeHtml(str: string): string {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    refreshBtn?.addEventListener('click', loadLogs);
    loadLogs();
  }

  initActivityLogs();
  document.addEventListener('astro:after-swap', initActivityLogs);
</script>
