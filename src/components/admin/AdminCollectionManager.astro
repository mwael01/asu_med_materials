---
import type { ModuleInfo } from '../../types/materials';

interface Props {
  modules: ModuleInfo[];
}

const { modules } = Astro.props;
---

<div class="space-y-6 text-zinc-800 dark:text-zinc-200">
  <!-- Top Action & Form Card -->
  <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-sm p-5">
    <div class="flex justify-between items-center mb-4">
      <div>
        <h2 class="text-lg font-bold" data-i18n="admin.tabCollections">إدارة المجموعات والحزم</h2>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">
          تجميع مصادر العملي والفاينل ومراجعات الدكاترة في حزم منسقة بروابط مستقلة قابلة للحفظ والمشاركة.
        </p>
      </div>
      <button
        type="button"
        id="acm-toggle-add-btn"
        class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition-all cursor-pointer shadow-2xs inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        <span>إنشاء حزمة جديدة</span>
      </button>
    </div>

    <!-- Create / Edit Form -->
    <form id="acm-form" class="hidden space-y-4 pt-4 border-t border-zinc-100 dark:border-zinc-800">
      <input type="hidden" id="acm-input-id" value="" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1">اسم الحزمة (بالعربية)</label>
          <input
            type="text"
            id="acm-input-title"
            required
            class="w-full px-3 py-2 bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-start"
            placeholder="مثال: حزمة العملي والمجهر - باثولوجي"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1">اسم الحزمة (بالإنجليزية)</label>
          <input
            type="text"
            id="acm-input-title-en"
            class="w-full px-3 py-2 bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-start"
            placeholder="e.g. Pathology Practical OSPE Kit"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1">الفرقة الدراسية (Year)</label>
          <select
            id="acm-input-year"
            required
            class="w-full px-3 py-2 bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
          >
            <option value="1">الفرقة الأولى (Year 1)</option>
            <option value="2">الفرقة الثانية (Year 2)</option>
            <option value="3">الفرقة الثالثة (Year 3)</option>
            <option value="4">الفرقة الرابعة (Year 4)</option>
            <option value="5">الفرقة الخامسة (Year 5)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1">نوع الحزمة (Category)</label>
          <select
            id="acm-input-category"
            required
            class="w-full px-3 py-2 bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
          >
            <option value="practical">عملي ومعامل OSPE</option>
            <option value="finals">مراجعات الفاينل</option>
            <option value="midterm">الميدتيرم</option>
            <option value="revision">ملخصات وخرائط ذهنية</option>
            <option value="general">عام / منوع</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1">الموديول (Module) - اختياري</label>
          <select
            id="acm-input-module"
            class="w-full px-3 py-2 bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
          >
            <option value="">بدون موديول محدد (عام)</option>
            {modules.map((m) => (
              <option value={m.id} data-year={m.year}>
                [Year {m.year}] {m.title} {m.titleAr ? `(${m.titleAr})` : ''}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1">المادة (Subject) - اختياري</label>
          <input
            type="text"
            id="acm-input-subject"
            class="w-full px-3 py-2 bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-start"
            placeholder="مثال: Pathology أو Anatomy"
          />
        </div>

        <div class="md:col-span-2">
          <label class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1">وصف الحزمة (بالعربية)</label>
          <textarea
            id="acm-input-desc"
            rows="2"
            class="w-full px-3 py-2 bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-start"
            placeholder="اكتب نبذة عن محتويات الحزمة وكيفية الاستفادة منها..."
          ></textarea>
        </div>

        <div class="md:col-span-2">
          <label class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1">وصف الحزمة (بالإنجليزية)</label>
          <textarea
            id="acm-input-desc-en"
            rows="2"
            class="w-full px-3 py-2 bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-start"
            placeholder="Brief description in English..."
          ></textarea>
        </div>

        <div class="md:col-span-2 flex items-center gap-2">
          <input
            type="checkbox"
            id="acm-input-featured"
            class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 cursor-pointer"
          />
          <label for="acm-input-featured" class="text-xs font-medium text-zinc-700 dark:text-zinc-300 cursor-pointer">
            تمييز الحزمة في الصفحة الرئيسية ومقدمة الموديول (Featured Collection)
          </label>
        </div>
      </div>

      <!-- Materials Picker Section -->
      <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800 space-y-3">
        <div class="flex items-center justify-between">
          <label class="block text-xs font-bold text-zinc-800 dark:text-zinc-200">
            المواد المضافة للحزمة (<span id="acm-selected-count">0</span> مواد)
          </label>
          <span class="text-[11px] text-zinc-400">ابحث عن المادة ثم اضغط على زر الإضافة</span>
        </div>

        <!-- Selected Materials Container (Ordered) -->
        <div id="acm-selected-materials" class="min-h-[50px] p-3 rounded-xl border border-dashed border-zinc-200 dark:border-zinc-700 space-y-2 bg-zinc-50/50 dark:bg-zinc-800/30">
          <p id="acm-empty-selected" class="text-xs text-zinc-400 text-center py-2">
            لم يتم اختيار أي مواد بعد. استخدم مربع البحث بالأسفل لإضافة مواد للحزمة.
          </p>
        </div>

        <!-- Material Search Input -->
        <div class="relative">
          <input
            type="text"
            id="acm-picker-search"
            placeholder="ابحث بالعنوان، اسم الدكتور، أو المادة لإضافتها..."
            class="w-full px-3 py-2 bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-start"
          />
          <div id="acm-picker-results" class="hidden absolute top-full start-0 end-0 mt-1 z-30 max-h-60 overflow-y-auto bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl shadow-lg divide-y divide-zinc-100 dark:divide-zinc-700">
            <!-- Dynamic search results populated here -->
          </div>
        </div>
      </div>

      <!-- Form Actions -->
      <div class="flex justify-end gap-2 pt-4 border-t border-zinc-100 dark:border-zinc-800">
        <button
          type="button"
          id="acm-cancel-btn"
          class="px-4 py-2 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 rounded-xl text-xs font-semibold transition-colors cursor-pointer"
        >
          إلغاء
        </button>
        <button
          type="submit"
          id="acm-submit-btn"
          class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition-colors cursor-pointer shadow-2xs"
        >
          حفظ الحزمة
        </button>
      </div>
    </form>
  </div>

  <!-- Filter & Collections List -->
  <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-sm p-5 space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <h3 class="font-bold text-sm">قائمة الحزم المتاحة</h3>
        <span id="acm-collections-count-badge" class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
          0 حزمة
        </span>
      </div>

      <!-- Filters -->
      <div class="flex items-center gap-2 flex-wrap">
        <select
          id="acm-filter-year"
          class="px-2.5 py-1.5 bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-lg text-xs"
        >
          <option value="all">كل السنوات</option>
          <option value="1">الفرقة الأولى</option>
          <option value="2">الفرقة الثانية</option>
          <option value="3">الفرقة الثالثة</option>
          <option value="4">الفرقة الرابعة</option>
          <option value="5">الفرقة الخامسة</option>
        </select>

        <select
          id="acm-filter-category"
          class="px-2.5 py-1.5 bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-lg text-xs"
        >
          <option value="all">كل التصنيفات</option>
          <option value="practical">عملي ومعامل OSPE</option>
          <option value="finals">مراجعات الفاينل</option>
          <option value="midterm">الميدتيرم</option>
          <option value="revision">ملخصات وخرائط</option>
        </select>
      </div>
    </div>

    <!-- Collections Table -->
    <div class="overflow-x-auto">
      <table class="w-full text-xs text-start">
        <thead>
          <tr class="border-b border-zinc-200 dark:border-zinc-800 text-zinc-400 font-medium">
            <th class="py-2.5 px-3 text-start">اسم الحزمة</th>
            <th class="py-2.5 px-3 text-start">السنة والموديول</th>
            <th class="py-2.5 px-3 text-start">النوع</th>
            <th class="py-2.5 px-3 text-start">المواد</th>
            <th class="py-2.5 px-3 text-start">الحالة</th>
            <th class="py-2.5 px-3 text-end">الإجراءات</th>
          </tr>
        </thead>
        <tbody id="acm-table-body" class="divide-y divide-zinc-100 dark:divide-zinc-800/60">
          <tr>
            <td colspan="6" class="py-8 text-center text-zinc-400">
              جاري تحميل الحزم الدراسية...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  import {
    fetchCollectionsFromFirestore,
    saveCollectionToFirestore,
    deleteCollectionFromFirestore,
    logAdminAction
  } from '../../firebase/firestore';
  import { getClientMaterials } from '../../utils/catalogueClient';
  import { getCachedUserProfile } from '../../firebase/auth';
  import type { MaterialCollection } from '../../types/collections';
  import type { MaterialItem } from '../../types/materials';

  function initAdminCollectionManager(): void {
    const toggleBtn = document.getElementById('acm-toggle-add-btn');
    const form = document.getElementById('acm-form') as HTMLFormElement | null;
    const cancelBtn = document.getElementById('acm-cancel-btn');
    const tableBody = document.getElementById('acm-table-body');
    const countBadge = document.getElementById('acm-collections-count-badge');
    const yearFilter = document.getElementById('acm-filter-year') as HTMLSelectElement | null;
    const catFilter = document.getElementById('acm-filter-category') as HTMLSelectElement | null;

    // Form inputs
    const inputId = document.getElementById('acm-input-id') as HTMLInputElement | null;
    const inputTitle = document.getElementById('acm-input-title') as HTMLInputElement | null;
    const inputTitleEn = document.getElementById('acm-input-title-en') as HTMLInputElement | null;
    const inputYear = document.getElementById('acm-input-year') as HTMLSelectElement | null;
    const inputCategory = document.getElementById('acm-input-category') as HTMLSelectElement | null;
    const inputModule = document.getElementById('acm-input-module') as HTMLSelectElement | null;
    const inputSubject = document.getElementById('acm-input-subject') as HTMLInputElement | null;
    const inputDesc = document.getElementById('acm-input-desc') as HTMLTextAreaElement | null;
    const inputDescEn = document.getElementById('acm-input-desc-en') as HTMLTextAreaElement | null;
    const inputFeatured = document.getElementById('acm-input-featured') as HTMLInputElement | null;
    const submitBtn = document.getElementById('acm-submit-btn');

    // Picker elements
    const pickerSearch = document.getElementById('acm-picker-search') as HTMLInputElement | null;
    const pickerResults = document.getElementById('acm-picker-results');
    const selectedContainer = document.getElementById('acm-selected-materials');
    const selectedCount = document.getElementById('acm-selected-count');

    let allCollections: MaterialCollection[] = [];
    let allMaterials: MaterialItem[] = [];
    let selectedMaterialIds: string[] = [];

    // Toggle Form visibility
    toggleBtn?.addEventListener('click', () => {
      form?.classList.toggle('hidden');
      if (!form?.classList.contains('hidden')) {
        resetForm();
      }
    });

    cancelBtn?.addEventListener('click', () => {
      form?.classList.add('hidden');
      resetForm();
    });

    function resetForm(): void {
      if (!form) return;
      form.reset();
      if (inputId) inputId.value = '';
      selectedMaterialIds = [];
      renderSelectedMaterials();
      if (submitBtn) submitBtn.textContent = 'حفظ الحزمة';
    }

    // Load initial data
    async function loadData(): Promise<void> {
      try {
        [allCollections, allMaterials] = await Promise.all([
          fetchCollectionsFromFirestore(),
          getClientMaterials()
        ]);
        renderCollectionsTable();
      } catch (err) {
        console.error('Failed to load collections data:', err);
        if (tableBody) {
          tableBody.innerHTML = `
            <tr>
              <td colspan="6" class="py-6 text-center text-red-500">
                حدث خطأ أثناء تحميل الحزم. يرجى إعادة المحاولة.
              </td>
            </tr>
          `;
        }
      }
    }

    // Material Picker Search
    let pickerTimer: ReturnType<typeof setTimeout> | null = null;
    pickerSearch?.addEventListener('input', () => {
      if (pickerTimer) clearTimeout(pickerTimer);
      pickerTimer = setTimeout(() => {
        const q = pickerSearch.value.trim().toLowerCase();
        if (!q || !pickerResults) {
          pickerResults?.classList.add('hidden');
          return;
        }

        const matches = allMaterials
          .filter((m) => {
            const t = (m.title || '').toLowerCase();
            const s = (m.subject || '').toLowerCase();
            const a = Array.isArray(m.author) ? m.author.join(' ').toLowerCase() : (m.author || '').toLowerCase();
            return t.includes(q) || s.includes(q) || a.includes(q);
          })
          .slice(0, 10);

        if (matches.length === 0) {
          pickerResults.innerHTML = `
            <div class="p-3 text-center text-xs text-zinc-400">
              لا توجد مواد مطابقة للبحث
            </div>
          `;
        } else {
          pickerResults.innerHTML = matches
            .map((m) => {
              const isAdded = selectedMaterialIds.includes(m.id);
              return `
                <div class="p-2.5 flex items-center justify-between gap-3 hover:bg-zinc-50 dark:hover:bg-zinc-700/50 transition-colors">
                  <div class="min-w-0">
                    <p class="font-semibold text-xs text-zinc-900 dark:text-zinc-100 truncate">${escapeHtml(m.title)}</p>
                    <p class="text-[10px] text-zinc-400">السنة ${m.year} • ${escapeHtml(m.type)} ${m.subject ? `• ${escapeHtml(m.subject)}` : ''}</p>
                  </div>
                  <button
                    type="button"
                    data-picker-add="${escapeHtml(m.id)}"
                    class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all cursor-pointer ${
                      isAdded
                        ? 'bg-zinc-200 dark:bg-zinc-700 text-zinc-500 cursor-not-allowed'
                        : 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-2xs'
                    }"
                    ${isAdded ? 'disabled' : ''}
                  >
                    ${isAdded ? 'مضافة' : '+ إضافة'}
                  </button>
                </div>
              `;
            })
            .join('');
        }

        pickerResults.classList.remove('hidden');
      }, 100);
    });

    // Material Picker Add Click Handler
    pickerResults?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-picker-add]') as HTMLButtonElement | null;
      if (!btn) return;
      const matId = btn.getAttribute('data-picker-add');
      if (matId && !selectedMaterialIds.includes(matId)) {
        selectedMaterialIds.push(matId);
        renderSelectedMaterials();
        btn.textContent = 'مضافة';
        btn.disabled = true;
        btn.className = 'px-2.5 py-1 rounded-lg text-xs font-bold bg-zinc-200 dark:bg-zinc-700 text-zinc-500 cursor-not-allowed';
      }
    });

    // Close picker results when clicking outside
    document.addEventListener('click', (e) => {
      if (pickerSearch && pickerResults && !pickerSearch.contains(e.target as Node) && !pickerResults.contains(e.target as Node)) {
        pickerResults.classList.add('hidden');
      }
    });

    function renderSelectedMaterials(): void {
      if (!selectedContainer) return;
      if (selectedCount) selectedCount.textContent = String(selectedMaterialIds.length);

      if (selectedMaterialIds.length === 0) {
        selectedContainer.innerHTML = `
          <p id="acm-empty-selected" class="text-xs text-zinc-400 text-center py-2">
            لم يتم اختيار أي مواد بعد. استخدم مربع البحث بالأسفل لإضافة مواد للحزمة.
          </p>
        `;
        return;
      }

      const matMap = new Map<string, MaterialItem>();
      allMaterials.forEach((m) => matMap.set(m.id, m));

      selectedContainer.innerHTML = selectedMaterialIds
        .map((id, index) => {
          const mat = matMap.get(id);
          const title = mat ? mat.title : id;
          return `
            <div class="flex items-center justify-between gap-2 p-2 rounded-lg bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs">
              <div class="flex items-center gap-2 min-w-0">
                <span class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 font-bold text-[10px] flex items-center justify-center shrink-0">
                  ${index + 1}
                </span>
                <span class="font-medium truncate text-zinc-900 dark:text-zinc-100">${escapeHtml(title)}</span>
              </div>
              <div class="flex items-center gap-1 shrink-0">
                ${
                  index > 0
                    ? `<button type="button" data-move-up="${index}" class="p-1 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 cursor-pointer" title="تحريك لأعلى">▲</button>`
                    : ''
                }
                ${
                  index < selectedMaterialIds.length - 1
                    ? `<button type="button" data-move-down="${index}" class="p-1 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 cursor-pointer" title="تحريك لأسفل">▼</button>`
                    : ''
                }
                <button type="button" data-remove-id="${escapeHtml(id)}" class="p-1 text-red-500 hover:text-red-700 cursor-pointer" title="إزالة من الحزمة">✕</button>
              </div>
            </div>
          `;
        })
        .join('');
    }

    selectedContainer?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const removeBtn = target.closest('[data-remove-id]') as HTMLElement | null;
      if (removeBtn) {
        const id = removeBtn.getAttribute('data-remove-id');
        if (id) {
          selectedMaterialIds = selectedMaterialIds.filter((item) => item !== id);
          renderSelectedMaterials();
        }
        return;
      }

      const moveUpBtn = target.closest('[data-move-up]') as HTMLElement | null;
      if (moveUpBtn) {
        const idx = parseInt(moveUpBtn.getAttribute('data-move-up') || '0', 10);
        if (idx > 0) {
          const temp = selectedMaterialIds[idx];
          selectedMaterialIds[idx] = selectedMaterialIds[idx - 1];
          selectedMaterialIds[idx - 1] = temp;
          renderSelectedMaterials();
        }
        return;
      }

      const moveDownBtn = target.closest('[data-move-down]') as HTMLElement | null;
      if (moveDownBtn) {
        const idx = parseInt(moveDownBtn.getAttribute('data-move-down') || '0', 10);
        if (idx < selectedMaterialIds.length - 1) {
          const temp = selectedMaterialIds[idx];
          selectedMaterialIds[idx] = selectedMaterialIds[idx + 1];
          selectedMaterialIds[idx + 1] = temp;
          renderSelectedMaterials();
        }
      }
    });

    // Form Submit Handler (Create or Update)
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!inputTitle || !inputYear || !inputCategory) return;

      const title = inputTitle.value.trim();
      if (!title) return;

      const user = getCachedUserProfile();
      const isEditing = Boolean(inputId?.value);

      const payload: Partial<MaterialCollection> & { id?: string } = {
        title,
        titleEn: inputTitleEn?.value.trim() || undefined,
        year: parseInt(inputYear.value, 10) as any,
        category: inputCategory.value as any,
        moduleId: inputModule?.value || undefined,
        subject: inputSubject?.value.trim() || undefined,
        description: inputDesc?.value.trim() || undefined,
        descriptionEn: inputDescEn?.value.trim() || undefined,
        featured: inputFeatured?.checked || false,
        materialIds: selectedMaterialIds,
        createdBy: user?.displayName || user?.username || 'admin'
      };

      if (isEditing && inputId?.value) {
        payload.id = inputId.value;
      }

      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.textContent = 'جاري الحفظ...';
      }

      try {
        const savedId = await saveCollectionToFirestore(payload);

        // Audit Log
        if (user) {
          await logAdminAction({
            adminUid: user.uid,
            adminName: user.displayName || 'Admin',
            adminUsername: user.username,
            action: isEditing ? 'edit_module' : 'create_module',
            targetId: savedId,
            targetTitle: title,
            details: `${isEditing ? 'Updated' : 'Created'} collection pack with ${selectedMaterialIds.length} materials`
          });
        }

        form.classList.add('hidden');
        resetForm();
        await loadData();
      } catch (err) {
        console.error('Failed to save collection:', err);
        alert('حدث خطأ أثناء حفظ الحزمة. يرجى التحقق من الاتصال بالإنترنت.');
      } finally {
        if (submitBtn) {
          submitBtn.removeAttribute('disabled');
          submitBtn.textContent = 'حفظ الحزمة';
        }
      }
    });

    // Render Collections Table
    function renderCollectionsTable(): void {
      if (!tableBody) return;

      const yVal = yearFilter?.value || 'all';
      const cVal = catFilter?.value || 'all';

      const filtered = allCollections.filter((c) => {
        const yearMatch = yVal === 'all' || String(c.year) === yVal;
        const catMatch = cVal === 'all' || c.category === cVal;
        return yearMatch && catMatch;
      });

      if (countBadge) countBadge.textContent = `${filtered.length} حزمة`;

      if (filtered.length === 0) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="6" class="py-8 text-center text-zinc-400">
              لا توجد حزم تطابق الفلاتر المحددة.
            </td>
          </tr>
        `;
        return;
      }

      tableBody.innerHTML = filtered
        .map((col) => {
          const matCount = col.materialIds?.length || 0;
          return `
            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-800/40 transition-colors">
              <td class="py-3 px-3">
                <div class="font-bold text-zinc-900 dark:text-zinc-100">${escapeHtml(col.title)}</div>
                ${col.titleEn ? `<div class="text-[11px] text-zinc-400">${escapeHtml(col.titleEn)}</div>` : ''}
              </td>
              <td class="py-3 px-3">
                <span class="px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-semibold">
                  السنة ${col.year}
                </span>
                ${col.moduleId ? `<span class="text-zinc-400 ms-1">${escapeHtml(col.moduleId)}</span>` : ''}
              </td>
              <td class="py-3 px-3">
                <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-300">
                  ${escapeHtml(col.category)}
                </span>
              </td>
              <td class="py-3 px-3 font-semibold text-zinc-700 dark:text-zinc-300">
                ${matCount} مواد
              </td>
              <td class="py-3 px-3">
                ${
                  col.featured
                    ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300">مميزة ★</span>`
                    : `<span class="text-zinc-400">عادية</span>`
                }
              </td>
              <td class="py-3 px-3 text-end">
                <div class="flex items-center justify-end gap-1.5">
                  <a
                    href="/collection/${escapeHtml(col.id)}"
                    target="_blank"
                    class="p-1 text-zinc-500 hover:text-emerald-600 transition-colors cursor-pointer"
                    title="معاينة الصفحة"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                  <button
                    type="button"
                    data-edit-col="${escapeHtml(col.id)}"
                    class="p-1 text-zinc-500 hover:text-blue-600 transition-colors cursor-pointer"
                    title="تعديل الحزمة"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                  </button>
                  <button
                    type="button"
                    data-delete-col="${escapeHtml(col.id)}"
                    data-delete-title="${escapeHtml(col.title)}"
                    class="p-1 text-zinc-500 hover:text-red-600 transition-colors cursor-pointer"
                    title="حذف الحزمة"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          `;
        })
        .join('');
    }

    // Filter change listeners
    yearFilter?.addEventListener('change', renderCollectionsTable);
    catFilter?.addEventListener('change', renderCollectionsTable);

    // Edit & Delete event delegation
    tableBody?.addEventListener('click', async (e) => {
      const editBtn = (e.target as HTMLElement).closest('[data-edit-col]') as HTMLElement | null;
      if (editBtn) {
        const id = editBtn.getAttribute('data-edit-col');
        const col = allCollections.find((c) => c.id === id);
        if (col && form) {
          form.classList.remove('hidden');
          if (inputId) inputId.value = col.id;
          if (inputTitle) inputTitle.value = col.title;
          if (inputTitleEn) inputTitleEn.value = col.titleEn || '';
          if (inputYear) inputYear.value = String(col.year);
          if (inputCategory) inputCategory.value = col.category;
          if (inputModule) inputModule.value = col.moduleId || '';
          if (inputSubject) inputSubject.value = col.subject || '';
          if (inputDesc) inputDesc.value = col.description || '';
          if (inputDescEn) inputDescEn.value = col.descriptionEn || '';
          if (inputFeatured) inputFeatured.checked = Boolean(col.featured);
          selectedMaterialIds = [...(col.materialIds || [])];
          renderSelectedMaterials();
          if (submitBtn) submitBtn.textContent = 'تحديث الحزمة';
          form.scrollIntoView({ behavior: 'smooth' });
        }
        return;
      }

      const delBtn = (e.target as HTMLElement).closest('[data-delete-col]') as HTMLElement | null;
      if (delBtn) {
        const id = delBtn.getAttribute('data-delete-col');
        const title = delBtn.getAttribute('data-delete-title') || id;
        if (!id) return;

        if (confirm(`هل أنت متأكد من حذف الحزمة «${title}» نهائياً؟`)) {
          try {
            await deleteCollectionFromFirestore(id);
            const user = getCachedUserProfile();
            if (user) {
              await logAdminAction({
                adminUid: user.uid,
                adminName: user.displayName || 'Admin',
                adminUsername: user.username,
                action: 'delete_material',
                targetId: id,
                targetTitle: title,
                details: 'Deleted curated collection pack'
              });
            }
            await loadData();
          } catch (err) {
            console.error('Failed to delete collection:', err);
            alert('حدث خطأ أثناء حذف الحزمة.');
          }
        }
      }
    });

    function escapeHtml(str: string): string {
      return (str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    loadData();
  }

  initAdminCollectionManager();
  document.addEventListener('astro:after-swap', initAdminCollectionManager);
</script>
