---
import type { ModuleInfo } from '../../types/materials';

interface Props {
  modules: ModuleInfo[];
}

const { modules } = Astro.props;
---

<div class="space-y-6">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <!-- YouTube Playlist Fetcher -->
    <div class="p-4 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-800/50">
      <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 mb-2">YouTube Playlist</h3>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-3">Fetch video metadata from a YouTube playlist URL</p>
      <input
        type="text"
        id="yt-playlist-url"
        placeholder="https://www.youtube.com/playlist?list=..."
        class="w-full px-3 py-2 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-xs text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 mb-2"
      />
      <button
        type="button"
        id="btn-fetch-playlist"
        class="w-full px-3 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-colors cursor-pointer"
      >
        Fetch Videos
      </button>
      <div id="playlist-results" class="mt-3 space-y-2 max-h-64 overflow-y-auto"></div>
    </div>

    <!-- Google Drive Fetcher -->
    <div class="p-4 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-800/50">
      <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 mb-2">Google Drive</h3>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-3">Fetch file/folder metadata from a Google Drive URL</p>
      <input
        type="text"
        id="drive-url"
        placeholder="https://drive.google.com/drive/folders/..."
        class="w-full px-3 py-2 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-xs text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 mb-2"
      />
      <button
        type="button"
        id="btn-fetch-drive"
        class="w-full px-3 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-colors cursor-pointer"
      >
        Fetch Files
      </button>
      <div id="drive-results" class="mt-3 space-y-2 max-h-64 overflow-y-auto"></div>
    </div>

    <!-- Text Parser -->
    <div class="p-4 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-800/50">
      <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 mb-2">Text Parser</h3>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-3">Parse WhatsApp/Telegram text dumps into material entries</p>
      <textarea
        id="parse-text-input"
        placeholder="Paste text with URLs here..."
        rows="4"
        class="w-full px-3 py-2 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-xs text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 mb-2 resize-none"
      ></textarea>
      <div class="flex gap-2 mb-2">
        <select id="parse-year" class="flex-1 px-2 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-xs text-zinc-900 dark:text-zinc-100">
          <option value="1">Year 1</option>
          <option value="2" selected>Year 2</option>
          <option value="3">Year 3</option>
          <option value="4">Year 4</option>
          <option value="5">Year 5</option>
        </select>
        <select id="parse-module" class="flex-1 px-2 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-xs text-zinc-900 dark:text-zinc-100">
          {modules.map((m) => <option value={m.id}>{m.title}</option>)}
        </select>
      </div>
      <button
        type="button"
        id="btn-parse-text"
        class="w-full px-3 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-colors cursor-pointer"
      >
        Parse Text
      </button>
      <div id="parse-results" class="mt-3 space-y-2 max-h-64 overflow-y-auto"></div>
    </div>
  </div>
</div>

<script>
  interface PlaylistVideo {
    id: string;
    title: string;
    youtubeId: string;
    url: string;
  }

  interface DriveFile {
    id: string;
    name: string;
    mimeType: string;
    url: string;
  }

  interface ParsedMaterial {
    id: string;
    title: string;
    url: string;
    type: string;
    year: number;
    moduleId: string;
    subject: string;
  }

  function initAITools() {
    const btnFetchPlaylist = document.getElementById('btn-fetch-playlist') as HTMLButtonElement | null;
    const btnFetchDrive = document.getElementById('btn-fetch-drive') as HTMLButtonElement | null;
    const btnParseText = document.getElementById('btn-parse-text') as HTMLButtonElement | null;

    btnFetchPlaylist?.addEventListener('click', async () => {
      const input = document.getElementById('yt-playlist-url') as HTMLInputElement | null;
      const results = document.getElementById('playlist-results');
      if (!input || !results) return;

      const url = input.value.trim();
      if (!url) return;

      results.innerHTML = '<p class="text-xs text-zinc-500">Fetching...</p>';

      try {
        const res = await fetch('/api/fetch-playlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ playlistId: url })
        });
        const data = await res.json();

        if (data.error) {
          results.innerHTML = `<p class="text-xs text-red-500">${data.error}</p>`;
          return;
        }

        const videos: PlaylistVideo[] = data.videos || [];
        if (videos.length === 0) {
          results.innerHTML = '<p class="text-xs text-zinc-500">No videos found</p>';
          return;
        }

        results.innerHTML = videos.map((v: PlaylistVideo) => `
          <div class="p-2 rounded-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700">
            <p class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 truncate">${v.title}</p>
            <p class="text-[10px] text-zinc-500 truncate">${v.url}</p>
          </div>
        `).join('');
      } catch (err) {
        results.innerHTML = `<p class="text-xs text-red-500">${err instanceof Error ? err.message : 'Fetch failed'}</p>`;
      }
    });

    btnFetchDrive?.addEventListener('click', async () => {
      const input = document.getElementById('drive-url') as HTMLInputElement | null;
      const results = document.getElementById('drive-results');
      if (!input || !results) return;

      const url = input.value.trim();
      if (!url) return;

      results.innerHTML = '<p class="text-xs text-zinc-500">Fetching...</p>';

      try {
        const res = await fetch('/api/fetch-drive', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ driveUrl: url })
        });
        const data = await res.json();

        if (data.error) {
          results.innerHTML = `<p class="text-xs text-red-500">${data.error}</p>`;
          return;
        }

        const files: DriveFile[] = data.files || [];
        if (files.length === 0) {
          results.innerHTML = '<p class="text-xs text-zinc-500">No files found</p>';
          return;
        }

        results.innerHTML = files.map((f: DriveFile) => `
          <div class="p-2 rounded-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700">
            <p class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 truncate">${f.name}</p>
            <p class="text-[10px] text-zinc-500 truncate">${f.mimeType}</p>
          </div>
        `).join('');
      } catch (err) {
        results.innerHTML = `<p class="text-xs text-red-500">${err instanceof Error ? err.message : 'Fetch failed'}</p>`;
      }
    });

    btnParseText?.addEventListener('click', async () => {
      const input = document.getElementById('parse-text-input') as HTMLTextAreaElement | null;
      const yearSelect = document.getElementById('parse-year') as HTMLSelectElement | null;
      const moduleSelect = document.getElementById('parse-module') as HTMLSelectElement | null;
      const results = document.getElementById('parse-results');
      if (!input || !yearSelect || !moduleSelect || !results) return;

      const text = input.value.trim();
      if (!text) return;

      results.innerHTML = '<p class="text-xs text-zinc-500">Parsing...</p>';

      try {
        const res = await fetch('/api/parse-materials', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            text,
            year: parseInt(yearSelect.value, 10),
            moduleId: moduleSelect.value
          })
        });
        const data = await res.json();

        if (data.error) {
          results.innerHTML = `<p class="text-xs text-red-500">${data.error}</p>`;
          return;
        }

        const items: ParsedMaterial[] = data.items || [];
        if (items.length === 0) {
          results.innerHTML = '<p class="text-xs text-zinc-500">No materials found</p>';
          return;
        }

        results.innerHTML = items.map((item: ParsedMaterial) => `
          <div class="p-2 rounded-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700">
            <p class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 truncate">${item.title}</p>
            <p class="text-[10px] text-zinc-500 truncate">${item.url}</p>
            <span class="inline-block mt-1 px-1.5 py-0.5 rounded text-[10px] font-bold bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300">${item.type}</span>
          </div>
        `).join('');
      } catch (err) {
        results.innerHTML = `<p class="text-xs text-red-500">${err instanceof Error ? err.message : 'Parse failed'}</p>`;
      }
    });
  }

  initAITools();
  document.addEventListener('astro:after-swap', initAITools);
</script>
