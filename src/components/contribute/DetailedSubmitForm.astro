---
import type { ModuleInfo } from '../../types/materials';

interface Props {
  modules: ModuleInfo[];
}

const { modules } = Astro.props;
---

<div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-xs">
  <!-- Form Container -->
  <div id="detail-form-container">
    <div class="mb-3 text-start">
      <h2 class="text-xs font-extrabold text-zinc-900 dark:text-zinc-100 mb-0.5" data-i18n="contribute.detailedTitle">
        Add Specific Study Resource
      </h2>
      <p class="text-[11px] text-zinc-500 dark:text-zinc-400" data-i18n="contribute.detailedSubtitle">
        Enter the resource link with optional year, module, and subject details.
      </p>
    </div>

    <form id="detailed-submission-form" class="space-y-3.5 text-start">
      <!-- Resource URL (Main field) -->
      <div>
        <label for="detail-url" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">
          <span data-i18n="contribute.urlLabel">Resource or Drive URL</span> <span class="text-emerald-600">*</span>
        </label>
        <input
          type="text"
          id="detail-url"
          placeholder="https://drive.google.com/... or https://t.me/... or youtube.com/..."
          data-i18n-attr="placeholder:contribute.urlPlaceholder"
          required
          class="w-full px-3 py-2 text-xs bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-left font-mono"
        />
      </div>

      <!-- Title -->
      <div>
        <label for="detail-title" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">
          <span data-i18n="contribute.titleLabel">Resource Title</span> <span class="text-[10px] text-zinc-400 font-normal" data-i18n="contribute.optional">(Optional)</span>
        </label>
        <input
          type="text"
          id="detail-title"
          placeholder="e.g. Dr. Shireen Blood notes or Batch Drive"
          data-i18n-attr="placeholder:contribute.titlePlaceholder"
          class="w-full px-3 py-2 text-xs bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <!-- Contributor and Prepared-by -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="detail-authors" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">
            <span data-i18n="contribute.doctorLabel">Prepared by</span> <span class="text-[10px] text-zinc-400 font-normal" data-i18n="contribute.doctorHint">(Doctor / Lecturer name)</span>
          </label>
          <input
            type="text"
            id="detail-authors"
            placeholder="e.g. Dr. Shireen, Dr. Nagi"
            data-i18n-attr="placeholder:contribute.doctorPlaceholder"
            class="w-full px-3 py-2 text-xs bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          />
        </div>

        <div>
          <label for="detail-contributor" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">
            <span data-i18n="contribute.contributorLabel">Added by</span> <span class="text-[10px] text-zinc-400 font-normal" data-i18n="contribute.contributorHint">(Your name for attribution)</span>
          </label>
          <input
            type="text"
            id="detail-contributor"
            placeholder="Your name for attribution"
            data-i18n-attr="placeholder:contribute.contributorPlaceholder"
            class="w-full px-3 py-2 text-xs bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          />
        </div>
      </div>

      <!-- Classification: Year, Module, Type -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label for="detail-year" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1" data-i18n="contribute.yearLabel">
            Year of Study
          </label>
          <select
            id="detail-year"
            class="w-full px-3 py-2 text-xs bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          >
            <option value="general" data-i18n="contribute.yearGeneral">General / All Years</option>
            <option value="1" data-i18n="nav.year" data-i18n-params={JSON.stringify({ y: 1 })}>Year 1</option>
            <option value="2" data-i18n="nav.year" data-i18n-params={JSON.stringify({ y: 2 })}>Year 2</option>
            <option value="3" data-i18n="nav.year" data-i18n-params={JSON.stringify({ y: 3 })}>Year 3</option>
            <option value="4" data-i18n="nav.year" data-i18n-params={JSON.stringify({ y: 4 })}>Year 4</option>
            <option value="5" data-i18n="nav.year" data-i18n-params={JSON.stringify({ y: 5 })}>Year 5</option>
          </select>
        </div>

        <div>
          <label for="detail-module" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1" data-i18n="contribute.moduleLabel">
            Module
          </label>
          <select
            id="detail-module"
            class="w-full px-3 py-2 text-xs bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          >
            <option value="general" data-i18n="contribute.moduleGeneral">General / All Year</option>
            {modules.map((m) => (
              <option value={m.code}>{m.code} - {m.title}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="detail-type" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1" data-i18n="contribute.typeLabel">
            Resource Type
          </label>
          <select
            id="detail-type"
            class="w-full px-3 py-2 text-xs bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          >
            <option value="drive">Google Drive</option>
            <option value="telegram">Telegram</option>
            <option value="youtube">YouTube</option>
            <option value="summary" data-i18n="types.summary">Notes & Summaries</option>
            <option value="exam" data-i18n="types.exam">Exams & Recalls</option>
            <option value="book" data-i18n="types.book">Books & References</option>
            <option value="whatsapp">WhatsApp Group</option>
            <option value="other" data-i18n="types.other">Other</option>
          </select>
        </div>
      </div>

      <!-- Status Error Box -->
      <div id="detail-error-box" class="hidden p-3 rounded-xl text-xs bg-rose-50 dark:bg-rose-950/50 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800/40 space-y-1.5"></div>

      <div class="pt-1">
        <button
          type="button"
          id="detail-submit-btn"
          class="w-full py-2.5 px-4 rounded-xl bg-emerald-600 text-white hover:bg-emerald-700 disabled:opacity-50 disabled:cursor-not-allowed font-bold text-xs transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-xs"
        >
          <span id="detail-spinner" class="hidden">
            <svg class="w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </span>
          <span id="detail-btn-text" data-i18n="contribute.submitBtn">إرسال المصدر</span>
          <svg id="detail-btn-icon" class="w-3.5 h-3.5 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
          </svg>
        </button>
      </div>
    </form>
  </div>

  <!-- Dedicated Success Card (Hidden by default) -->
  <div id="detail-success-card" class="hidden text-center py-6 px-4 space-y-3">
    <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 mx-auto flex items-center justify-center">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
    </div>
    <h3 class="text-sm font-extrabold text-zinc-900 dark:text-zinc-100" data-i18n="contribute.successTitle">
      Resource Submitted Successfully!
    </h3>
    <p class="text-xs text-zinc-500 dark:text-zinc-400 max-w-sm mx-auto leading-relaxed" data-i18n="contribute.successDesc">
      Thank you for contributing! Your submission will be reviewed and published to its module shortly.
    </p>
    <div id="detail-success-issue-link" class="pt-1"></div>
    <div class="pt-3">
      <button
        type="button"
        id="detail-reset-btn"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 text-xs font-bold transition-all cursor-pointer"
      >
        <span data-i18n="contribute.submitAnother">Submit Another Resource</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { submitMaterial } from '../../utils/submission';

  function initDetailedForm(): void {
    const formContainer = document.getElementById('detail-form-container');
    const successCard = document.getElementById('detail-success-card');
    const urlInput = document.getElementById('detail-url') as HTMLInputElement | null;
    const titleInput = document.getElementById('detail-title') as HTMLInputElement | null;
    const authorsInput = document.getElementById('detail-authors') as HTMLInputElement | null;
    const contributorInput = document.getElementById('detail-contributor') as HTMLInputElement | null;
    const yearSelect = document.getElementById('detail-year') as HTMLSelectElement | null;
    const moduleSelect = document.getElementById('detail-module') as HTMLSelectElement | null;
    const typeSelect = document.getElementById('detail-type') as HTMLSelectElement | null;
    const submitBtn = document.getElementById('detail-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('detail-btn-text');
    const spinner = document.getElementById('detail-spinner');
    const btnIcon = document.getElementById('detail-btn-icon');
    const errorBox = document.getElementById('detail-error-box');
    const resetBtn = document.getElementById('detail-reset-btn');
    const issueLinkBox = document.getElementById('detail-success-issue-link');

    if (!urlInput || !submitBtn) return;

    submitBtn.addEventListener('click', async () => {
      const isEn = document.documentElement.lang === 'en';
      let url = urlInput.value.trim();
      const title = titleInput?.value.trim() || '';

      if (!url && !title) {
        alert(isEn ? 'Please enter the resource link or title' : 'من فضلك اكتب رابط المصدر أو عنوانه');
        urlInput.focus();
        return;
      }

      if (url && !/^https?:\/\//i.test(url)) {
        url = `https://${url}`;
      }

      const authors = authorsInput?.value.trim() || '';
      const contributor = contributorInput?.value.trim() || '';
      const year = yearSelect?.value || 'general';
      const moduleId = moduleSelect?.value || 'general';
      const type = typeSelect?.value || 'drive';

      // Set Loading State
      submitBtn.disabled = true;
      spinner?.classList.remove('hidden');
      btnIcon?.classList.add('hidden');
      if (btnText) btnText.textContent = isEn ? 'Submitting...' : 'جاري الإرسال...';
      if (errorBox) errorBox.classList.add('hidden');

      const result = await submitMaterial({
        mode: 'single',
        title: title || url,
        url,
        type: type as any,
        year: year as any,
        moduleId,
        author: authors,
        addedBy: contributor
      });

      if (result.success) {
        if (issueLinkBox) {
          const previewText = isEn
            ? `Preview issue on GitHub #${result.issueNumber} &rarr;`
            : `معاينة التذكرة على GitHub #${result.issueNumber} &larr;`;
          issueLinkBox.innerHTML = result.issueUrl
            ? `<a href="${result.issueUrl}" target="_blank" rel="noopener noreferrer" class="text-xs text-emerald-600 dark:text-emerald-400 font-bold underline hover:opacity-80">${previewText}</a>`
            : '';
        }
        formContainer?.classList.add('hidden');
        successCard?.classList.remove('hidden');
        if (titleInput) titleInput.value = '';
        urlInput.value = '';
      } else {
        const fallbackUrl = result.fallbackUrl || '';
        const fallbackText = isEn
          ? 'Open issue directly on GitHub to save your details &rarr;'
          : 'فتح التذكرة على GitHub لحفظ بياناتك مباشرة &larr;';
        const serverError = isEn ? 'Unable to submit via server at this time.' : 'تعذر الإرسال عبر الخادم حالياً.';
        const fallbackBtn = fallbackUrl
          ? `<div class="pt-1"><a href="${fallbackUrl}" target="_blank" rel="noopener noreferrer" class="font-bold underline text-xs">${fallbackText}</a></div>`
          : '';
        if (errorBox) {
          errorBox.classList.remove('hidden');
          errorBox.innerHTML = `<div>⚠️ ${result.error || serverError}</div>${fallbackBtn}`;
        }
      }

      submitBtn.disabled = false;
      spinner?.classList.add('hidden');
      btnIcon?.classList.remove('hidden');
      if (btnText) btnText.textContent = isEn ? 'Submit Resource' : 'إرسال المصدر';
    });

    resetBtn?.addEventListener('click', () => {
      successCard?.classList.add('hidden');
      formContainer?.classList.remove('hidden');
      urlInput.focus();
    });
  }

  initDetailedForm();
  document.addEventListener('astro:after-swap', initDetailedForm);
</script>
