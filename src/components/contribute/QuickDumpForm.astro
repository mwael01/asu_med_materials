---
import type { ModuleInfo } from '../../types/materials';

interface Props {
  modules: ModuleInfo[];
}

const { modules } = Astro.props;
---

<div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-xs">
  <!-- Form Container -->
  <div id="dump-form-container">
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2">
        <span class="text-xs font-extrabold text-zinc-900 dark:text-zinc-100">
          تفريغ سريع للمصادر
        </span>
        <span class="text-[10px] bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-400 font-bold px-2 py-0.5 rounded-full">
          الأسرع
        </span>
      </div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="quick-dump-sample-btn"
          class="text-[11px] text-emerald-600 dark:text-emerald-400 hover:underline cursor-pointer"
        >
          تجربة بنموذج
        </button>
        <span class="text-zinc-300 dark:text-zinc-700">|</span>
        <button
          type="button"
          id="quick-dump-clear-btn"
          class="text-[11px] text-zinc-400 hover:text-rose-600 dark:hover:text-rose-400 transition-colors cursor-pointer"
        >
          مسح
        </button>
      </div>
    </div>

    <form id="quick-dump-form" class="space-y-3.5 text-right">
      <!-- Main Textarea -->
      <div>
        <div class="flex items-center justify-between mb-1 text-[11px]">
          <label for="dump-content" class="font-bold text-zinc-700 dark:text-zinc-300">
            النص أو الروابط المجمعة <span class="text-emerald-600">*</span>
          </label>
          <div id="dump-url-count" class="text-zinc-400 dark:text-zinc-500 font-medium">
            0 رابط
          </div>
        </div>

        <textarea
          id="dump-content"
          rows="6"
          placeholder="الصق هنا رسالة الواتساب، أو رابطاً مع وصف بسيط، أو قائمة مذكرات ودرايفات..."
          required
          class="w-full px-3.5 py-2.5 text-xs bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 resize-y leading-relaxed font-sans"
        ></textarea>

        <!-- Live Platform Tags Container -->
        <div id="dump-platform-tags" class="hidden mt-1.5 flex flex-wrap items-center gap-1.5"></div>
      </div>

      <!-- Optional Contributor Name -->
      <div>
        <label for="dump-contributor" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">
          اسمك أو فريق العمل <span class="text-[10px] text-zinc-400 font-normal">(اختياري - لحفظ حق الإعداد)</span>
        </label>
        <input
          type="text"
          id="dump-contributor"
          placeholder="مثال: د. أحمد سامح (أو اتركه فارغاً إذا كنت تفضل فاعل خير)"
          class="w-full px-3 py-2 text-xs bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <!-- Optional Classification -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="dump-year" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">
            السنة الدراسية <span class="text-[10px] text-zinc-400 font-normal">(اختياري)</span>
          </label>
          <select
            id="dump-year"
            class="w-full px-3 py-2 text-xs bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          >
            <option value="general">عام / غير محدد</option>
            <option value="1">السنة الأولى</option>
            <option value="2">السنة الثانية</option>
            <option value="3">السنة الثالثة</option>
            <option value="4">السنة الرابعة</option>
            <option value="5">السنة الخامسة</option>
          </select>
        </div>

        <div>
          <label for="dump-module" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">
            الموديول المستهدف <span class="text-[10px] text-zinc-400 font-normal">(اختياري)</span>
          </label>
          <select
            id="dump-module"
            class="w-full px-3 py-2 text-xs bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          >
            <option value="general">عام / كل السنة / غير محدد</option>
            {modules.map((m) => (
              <option value={m.code}>{m.code} - {m.titleAr || m.title}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Status Error Box (for network/validation errors) -->
      <div id="dump-error-box" class="hidden p-3 rounded-xl text-xs bg-rose-50 dark:bg-rose-950/50 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800/40 space-y-1.5"></div>

      <!-- Action Button -->
      <div class="pt-1">
        <button
          type="button"
          id="dump-submit-btn"
          class="w-full py-2.5 px-4 rounded-xl bg-emerald-600 text-white hover:bg-emerald-700 disabled:opacity-50 disabled:cursor-not-allowed font-bold text-xs transition-all flex items-center justify-center gap-2 cursor-pointer shadow-xs"
        >
          <span id="dump-spinner" class="hidden">
            <svg class="w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </span>
          <span id="dump-btn-text">إرسال وتفريغ المصادر</span>
          <svg id="dump-btn-icon" class="w-3.5 h-3.5 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
          </svg>
        </button>
      </div>
    </form>
  </div>

  <!-- Dedicated Success Celebration Card (Hidden by default) -->
  <div id="dump-success-card" class="hidden text-center py-6 px-4 space-y-3">
    <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 mx-auto flex items-center justify-center">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
    </div>
    <h3 class="text-sm font-extrabold text-zinc-900 dark:text-zinc-100">
      تم استلام المصادر بنجاح!
    </h3>
    <p class="text-xs text-zinc-500 dark:text-zinc-400 max-w-sm mx-auto leading-relaxed">
      شكراً لمساهمتك لدعم زملائك! سيقوم المشرف بمراجعة الروابط وتنسيقها وإدراجها بالموقع تباعاً.
    </p>
    <div id="dump-success-issue-link" class="pt-1"></div>
    <div class="pt-3">
      <button
        type="button"
        id="dump-reset-btn"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 text-xs font-bold transition-all cursor-pointer"
      >
        <span>إرسال دفعة مصادر أخرى</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { extractUrls, detectPlatformTags, submitMaterial } from '../../utils/submission';

  function initQuickDumpForm(): void {
    const formContainer = document.getElementById('dump-form-container');
    const successCard = document.getElementById('dump-success-card');
    const contentInput = document.getElementById('dump-content') as HTMLTextAreaElement | null;
    const contributorInput = document.getElementById('dump-contributor') as HTMLInputElement | null;
    const yearSelect = document.getElementById('dump-year') as HTMLSelectElement | null;
    const moduleSelect = document.getElementById('dump-module') as HTMLSelectElement | null;
    const submitBtn = document.getElementById('dump-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('dump-btn-text');
    const spinner = document.getElementById('dump-spinner');
    const btnIcon = document.getElementById('dump-btn-icon');
    const errorBox = document.getElementById('dump-error-box');
    const urlCountBadge = document.getElementById('dump-url-count');
    const platformTagsContainer = document.getElementById('dump-platform-tags');
    const sampleBtn = document.getElementById('quick-dump-sample-btn');
    const clearBtn = document.getElementById('quick-dump-clear-btn');
    const resetBtn = document.getElementById('dump-reset-btn');
    const issueLinkBox = document.getElementById('dump-success-issue-link');

    if (!contentInput || !submitBtn) return;

    // Live URL counter & platform tags
    function updateUrlState(): void {
      if (!contentInput || !urlCountBadge || !platformTagsContainer) return;
      const text = contentInput.value;
      const urls = extractUrls(text);
      const count = urls.length;

      if (count > 0) {
        urlCountBadge.textContent = `🔗 ${count} رابط مكتشف`;
        urlCountBadge.className = 'font-bold text-emerald-600 dark:text-emerald-400';

        const platforms = detectPlatformTags(urls);
        platformTagsContainer.innerHTML = platforms
          .map((p) => `<span class="text-[10px] px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-400 font-semibold border border-emerald-200/60 dark:border-emerald-800/40">${p}</span>`)
          .join('');
        platformTagsContainer.classList.remove('hidden');
      } else {
        urlCountBadge.textContent = '0 رابط';
        urlCountBadge.className = 'text-zinc-400 dark:text-zinc-500 font-medium';
        platformTagsContainer.classList.add('hidden');
        platformTagsContainer.innerHTML = '';
      }
    }

    contentInput.addEventListener('input', updateUrlState);

    // Clear action
    clearBtn?.addEventListener('click', () => {
      contentInput.value = '';
      updateUrlState();
      contentInput.focus();
    });

    // Sample message action
    sampleBtn?.addEventListener('click', () => {
      contentInput.value = `السلام عليكم دي تجميعة مصادر مهمة لموديول الدم:
1. درايف مذكرات وسلايدات المحاضرات:
https://drive.google.com/drive/folders/sample_blood_materials

2. تسجيلات وشرح الفسيولوجي د. ناجي:
https://youtube.com/playlist?list=sample_physio_playlist

3. قناة تليجرام بنوك أسئلة وريكولات الباثولوجي:
https://t.me/sample_asu_patho_questions`;

      if (contributorInput && !contributorInput.value) {
        contributorInput.value = 'أحمد سامح، مروان كمال';
      }
      if (yearSelect) yearSelect.value = '2';
      if (moduleSelect) moduleSelect.value = 'MED201';

      updateUrlState();
      contentInput.focus();
    });

    // Keyboard shortcut: Ctrl+Enter / Cmd+Enter to submit
    contentInput.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        submitBtn.click();
      }
    });

    // Submission handler
    submitBtn.addEventListener('click', async () => {
      const content = contentInput.value.trim();
      if (!content) {
        alert('من فضلك الصق رسالة الواتساب أو الروابط أولاً قبل الإرسال.');
        contentInput.focus();
        return;
      }

      const contributor = contributorInput?.value.trim() || '';
      const year = yearSelect?.value || 'general';
      const moduleId = moduleSelect?.value || 'general';

      // Set Loading State
      submitBtn.disabled = true;
      spinner?.classList.remove('hidden');
      btnIcon?.classList.add('hidden');
      if (btnText) btnText.textContent = 'جاري الإرسال...';
      if (errorBox) errorBox.classList.add('hidden');

      const result = await submitMaterial({
        mode: 'dump',
        content,
        contributor,
        year: year as any,
        moduleId
      });

      if (result.success) {
        // Swap to celebratory success view
        if (issueLinkBox) {
          issueLinkBox.innerHTML = result.issueUrl
            ? `<a href="${result.issueUrl}" target="_blank" rel="noopener noreferrer" class="text-xs text-emerald-600 dark:text-emerald-400 font-bold underline hover:opacity-80">معاينة التذكرة على GitHub #${result.issueNumber} &larr;</a>`
            : '';
        }
        formContainer?.classList.add('hidden');
        successCard?.classList.remove('hidden');
        contentInput.value = '';
        updateUrlState();
      } else {
        const fallbackUrl = result.fallbackUrl || '';
        const fallbackBtn = fallbackUrl
          ? `<div class="pt-1"><a href="${fallbackUrl}" target="_blank" rel="noopener noreferrer" class="font-bold underline text-xs">فتح التذكرة على GitHub لحفظ بياناتك مباشرة &larr;</a></div>`
          : '';
        if (errorBox) {
          errorBox.classList.remove('hidden');
          errorBox.innerHTML = `<div>⚠️ ${result.error || 'تعذر الإرسال عبر الخادم حالياً.'}</div>${fallbackBtn}`;
        }
      }

      submitBtn.disabled = false;
      spinner?.classList.add('hidden');
      btnIcon?.classList.remove('hidden');
      if (btnText) btnText.textContent = 'إرسال وتفريغ المصادر';
    });

    // Reset button to show form again
    resetBtn?.addEventListener('click', () => {
      successCard?.classList.add('hidden');
      formContainer?.classList.remove('hidden');
      contentInput.focus();
    });
  }

  initQuickDumpForm();
  document.addEventListener('astro:after-swap', initQuickDumpForm);
</script>
