---
import type { StudyEntry, StudyTab } from '../../types/lessons';
import type { MaterialItem } from '../../types/materials';
import InteractiveDocument from './InteractiveDocument.astro';
import ImageCaption from './ImageCaption.astro';
import DocumentImage from './DocumentImage.astro';
import PdfViewer from './PdfViewer.astro';
interface Props { entries: StudyEntry[]; materials: MaterialItem[] }
const { entries, materials } = Astro.props;
const labels: Record<StudyTab, string> = { videos: 'Videos', audio: 'Audio', pdfs: 'PDFs', interactive: 'Interactive', links: 'Links' };
const tabs = (['videos', 'audio', 'pdfs', 'interactive', 'links'] as const).filter(tab => entries.some(entry => entry.tab === tab));
---
<div data-doctor-player>
  <script type="application/json" data-study-entries set:html={JSON.stringify(entries).replace(/</g, '\\u003c')} />
  {entries.length ? (
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_20rem] gap-5 items-start">
      <section aria-label="Study viewer" class="min-w-0">
        <div data-study-viewport class="rounded-xl overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 relative">
          <iframe data-study-frame title="Study material" class="w-full aspect-video" hidden allow="autoplay; fullscreen; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
          <InteractiveDocument />
          <video data-study-video class="w-full aspect-video" controls playsinline hidden></video>
          <audio data-study-audio class="w-full my-6" controls preload="metadata" hidden></audio>
          <DocumentImage data-study-image alt="Study material" hidden />
          <ImageCaption />
          <PdfViewer id="doctor-pdf-viewer" class="w-full h-[70vh] min-h-[460px]" hidden />
          <div data-study-external class="p-8 text-sm text-zinc-500" hidden>Open this resource using the link below.</div>
        </div>
        <h2 data-study-title class="font-semibold text-base mt-4 break-words"></h2>
        <div class="flex flex-wrap items-center gap-2 mt-4 text-xs font-semibold">
          <a data-study-open target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-emerald-500 hover:text-emerald-600 transition-colors shadow-2xs">Open original &nearr;</a>
          <a data-study-download hidden class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-emerald-500 hover:text-emerald-600 transition-colors cursor-pointer shadow-2xs">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            <span data-study-download-text>Download</span>
          </a>
          <a data-study-reader hidden class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-emerald-500 hover:text-emerald-600 transition-colors cursor-pointer shadow-2xs" title="Open in dedicated document reader">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
            </svg>
            <span>Full Reader</span>
          </a>
          <button type="button" data-study-fullscreen class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-emerald-500 hover:text-emerald-600 transition-colors cursor-pointer shadow-2xs" title="Toggle Fullscreen">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
            </svg>
            <span data-study-fullscreen-text>Expand</span>
          </button>
          <button type="button" data-study-done aria-pressed="false" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-emerald-500 hover:text-emerald-600 transition-colors cursor-pointer shadow-2xs aria-pressed:bg-emerald-50 dark:aria-pressed:bg-emerald-950/50 aria-pressed:text-emerald-700 dark:aria-pressed:text-emerald-400 aria-pressed:border-emerald-500">Mark completed</button>
          <button type="button" data-study-save aria-pressed="false" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-amber-500 hover:text-amber-600 transition-colors cursor-pointer shadow-2xs aria-pressed:bg-amber-50 dark:aria-pressed:bg-amber-950/50 aria-pressed:text-amber-700 dark:aria-pressed:text-amber-400 aria-pressed:border-amber-500">Save</button>
          <button type="button" data-study-share class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-emerald-500 hover:text-emerald-600 transition-colors cursor-pointer shadow-2xs">Copy link</button>
        </div>
        <p data-study-status role="status" class="text-xs text-zinc-500 mt-3"></p>
      </section>
      <aside aria-label="Lesson materials" class="min-w-0 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 overflow-hidden">
        <div role="tablist" aria-label="Material type" class="flex border-b border-zinc-200 dark:border-zinc-800">
          {tabs.map((tab, index) => <button id={`study-tab-${tab}`} type="button" role="tab" data-study-tab={tab} aria-controls={`study-panel-${tab}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} class="flex-1 p-3 text-sm aria-selected:text-emerald-600 aria-selected:font-bold">{labels[tab]}</button>)}
        </div>
        {tabs.map((tab, index) => (
          <div id={`study-panel-${tab}`} role="tabpanel" aria-labelledby={`study-tab-${tab}`} data-study-panel={tab} hidden={index !== 0} class="p-3 max-h-[65vh] overflow-y-auto">
            {materials.map(material => {
              const items = entries.filter(entry => entry.materialId === material.id && entry.tab === tab);
              return items.length > 0 && <section class="mb-4 last:mb-0">
                {items.length > 1 && <h3 class="text-xs font-semibold text-zinc-500 mb-2 px-2">{material.titleEn || material.title}</h3>}
                <div class="space-y-1">{items.map(entry => <button type="button" data-study-item={entry.key} class="w-full text-left text-sm rounded-lg p-2.5 hover:bg-zinc-100 dark:hover:bg-zinc-800 aria-[current=true]:bg-emerald-50 dark:aria-[current=true]:bg-emerald-950/50 aria-[current=true]:text-emerald-700 dark:aria-[current=true]:text-emerald-400 break-words">{entry.title}</button>)}</div>
              </section>;
            })}
          </div>
        ))}
      </aside>
    </div>
  ) : <p class="text-sm text-zinc-500">No materials available for this doctor yet.</p>}
</div>
<script>
  import { initDoctorPlayer } from '../../scripts/study/doctorPlayer';
  initDoctorPlayer();
  document.addEventListener('astro:after-swap', initDoctorPlayer);
</script>

<style>
  [data-study-viewport].study-viewport-fullscreen {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    z-index: 99999 !important;
    border-radius: 0 !important;
    background: #09090b !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
  }
  [data-study-viewport].study-viewport-fullscreen iframe,
  [data-study-viewport].study-viewport-fullscreen video,
  [data-study-viewport].study-viewport-fullscreen [data-pdf-viewer] {
    width: 100vw !important;
    height: 100vh !important;
    max-height: 100vh !important;
    border-radius: 0 !important;
  }
</style>

