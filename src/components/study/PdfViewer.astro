---
interface Props {
  id?: string;
  class?: string;
  hidden?: boolean;
  initialUrl?: string;
  title?: string;
}

const {
  id,
  class: className = '',
  hidden = false,
  initialUrl = '',
  title = ''
} = Astro.props;
---

<div
  id={id}
  class:list={[
    'pdf-viewer-root relative w-full h-full flex flex-col bg-zinc-950 text-zinc-100 select-none overflow-hidden font-sans',
    className
  ]}
  data-pdf-viewer
  data-initial-url={initialUrl}
  data-title={title}
  hidden={hidden}
>
  <!-- Sleek Top Toolbar -->
  <div class="pdf-toolbar flex items-center justify-between gap-2 px-3 py-2 bg-zinc-900/90 border-b border-zinc-800 text-xs backdrop-blur-md z-10 shrink-0">
    <!-- Left: Page Navigation -->
    <div class="flex items-center gap-1 sm:gap-1.5">
      <button
        type="button"
        class="pdf-prev-btn p-1.5 rounded-lg border border-zinc-700 bg-zinc-800 hover:bg-zinc-700 disabled:opacity-30 disabled:cursor-not-allowed text-zinc-200 transition-colors cursor-pointer"
        title="Previous page (Left arrow)"
        aria-label="Previous page"
        disabled
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      </button>

      <div class="flex items-center gap-1 px-1 font-mono text-[11px]">
        <input
          type="number"
          class="pdf-page-input w-11 text-center bg-zinc-800 border border-zinc-700 rounded px-1 py-0.5 text-zinc-100 font-semibold focus:outline-none focus:border-emerald-500"
          value="1"
          min="1"
          max="1"
          aria-label="Current page"
        />
        <span class="text-zinc-500">/</span>
        <span class="pdf-total-pages text-zinc-400 font-semibold">1</span>
      </div>

      <button
        type="button"
        class="pdf-next-btn p-1.5 rounded-lg border border-zinc-700 bg-zinc-800 hover:bg-zinc-700 disabled:opacity-30 disabled:cursor-not-allowed text-zinc-200 transition-colors cursor-pointer"
        title="Next page (Right arrow)"
        aria-label="Next page"
        disabled
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </button>
    </div>

    <!-- Center: Document Title -->
    <div class="hidden sm:flex items-center gap-1.5 text-zinc-400 text-[11px] truncate max-w-[200px] md:max-w-[340px]">
      <span class="pdf-doc-title truncate">{title}</span>
    </div>

    <!-- Right: Zoom & Scaling Controls -->
    <div class="flex items-center gap-1 sm:gap-1.5">
      <button
        type="button"
        class="pdf-zoom-out-btn p-1.5 rounded-lg border border-zinc-700 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 transition-colors cursor-pointer"
        title="Zoom out (-)"
        aria-label="Zoom out"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" />
        </svg>
      </button>

      <span class="pdf-zoom-label font-mono text-[11px] font-semibold text-zinc-300 w-10 text-center select-none">Fit</span>

      <button
        type="button"
        class="pdf-zoom-in-btn p-1.5 rounded-lg border border-zinc-700 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 transition-colors cursor-pointer"
        title="Zoom in (+)"
        aria-label="Zoom in"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </button>

      <button
        type="button"
        class="pdf-fit-width-btn px-2 py-1 rounded-lg border border-zinc-700 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-semibold text-[11px] transition-colors cursor-pointer"
        title="Fit to width"
      >
        Fit
      </button>

      <!-- Fullscreen Toggle Button -->
      <button
        type="button"
        class="pdf-fullscreen-btn p-1.5 rounded-lg border border-zinc-700 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 transition-colors cursor-pointer"
        title="Toggle fullscreen (F)"
        aria-label="Toggle fullscreen"
      >
        <svg class="pdf-fullscreen-enter-icon w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
        </svg>
        <svg class="pdf-fullscreen-exit-icon w-3.5 h-3.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9L3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5l5.25 5.25" />
        </svg>
      </button>
    </div>
  </div>

  <!-- PDF Viewport / Canvas Container (scrollable without negative scroll clipping) -->
  <div class="pdf-viewport flex-1 overflow-auto p-3 sm:p-4 flex flex-col relative outline-none" tabindex="0">
    <!-- Canvas Wrapper with clean shadow (m-auto prevents negative top scroll clipping) -->
    <div class="pdf-canvas-wrapper m-auto relative shadow-2xl transition-transform duration-75 shrink-0 block">
      <canvas class="pdf-canvas block rounded shadow-md max-w-none bg-white"></canvas>
    </div>

    <!-- Loading Overlay -->
    <div class="pdf-loading-overlay absolute inset-0 z-20 flex flex-col items-center justify-center bg-zinc-950/80 backdrop-blur-xs transition-opacity duration-200 pointer-events-none">
      <div class="flex flex-col items-center gap-3 p-4 text-center">
        <svg class="w-7 h-7 text-emerald-500 animate-spin" viewBox="0 0 24 24" fill="none">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span class="pdf-loading-text text-xs font-semibold text-zinc-300">Connecting stream...</span>
      </div>
    </div>

    <!-- Error Banner -->
    <div class="pdf-error-overlay absolute inset-0 z-30 flex flex-col items-center justify-center bg-zinc-950/95 p-6 hidden">
      <div class="max-w-md text-center space-y-3">
        <div class="w-12 h-12 mx-auto rounded-full bg-red-950/50 border border-red-500/30 flex items-center justify-center text-red-400">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-zinc-200">Unable to load PDF document</h3>
        <p class="pdf-error-message text-xs text-zinc-400">The PDF stream could not be loaded or CORS is restricted.</p>
        <div class="flex items-center justify-center gap-2 pt-2">
          <button type="button" class="pdf-retry-btn px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs transition-colors cursor-pointer">
            Retry
          </button>
          <a class="pdf-open-original-btn px-3 py-1.5 rounded-lg border border-zinc-700 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-semibold text-xs transition-colors cursor-pointer" target="_blank" rel="noopener noreferrer">
            Open Original &nearr;
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .pdf-viewer-root.pdf-viewer-fullscreen {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    max-width: 100vw !important;
    max-height: 100vh !important;
    z-index: 99999 !important;
    border-radius: 0 !important;
    margin: 0 !important;
  }
</style>
