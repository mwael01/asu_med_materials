---
import type { Lesson } from '../../types/lessons';
import type { MaterialItem } from '../../types/materials';
import { practicalFolderImages } from '../../utils/practicalImages';
import { lessonPath } from '../../utils/lessons';
interface Props { lesson: Lesson; materials: MaterialItem[] }
const { lesson, materials } = Astro.props;
const folders = lesson.practicalImageFolders || [];
---
{folders.length > 0 && <section class="my-6" aria-label="Practical images">
  <h2 class="text-base font-semibold mb-3">Practical Images</h2>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {folders.map(folder => {
      const image = practicalFolderImages(materials, lesson, folder.id)[0];
      return <a href={`${lessonPath(lesson)}/images/${encodeURIComponent(folder.id)}`} class="flex items-center gap-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-3 hover:border-emerald-500 focus-visible:outline-2 focus-visible:outline-emerald-500">
        {image && <img src={image.thumbnailUrl || image.url} alt="" loading="lazy" width="80" height="64" class="h-16 w-20 object-contain rounded-lg bg-white shrink-0" />}
        <span class="font-semibold text-sm">{folder.title}</span>
      </a>;
    })}
  </div>
</section>}
