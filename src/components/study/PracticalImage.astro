---
interface Props { description?: string; sourceUrls?: string[]; visible?: boolean }
const { description, sourceUrls = [], visible = false } = Astro.props;
---
<section data-practical-image class="space-y-3 p-3" hidden={!visible}>
  <div class="flex flex-wrap gap-2 text-sm">
    <button type="button" data-image-zoom="1.25">Zoom in</button>
    <button type="button" data-image-zoom="0.8">Zoom out</button>
    <button type="button" data-image-reset>Reset</button>
    <button type="button" data-image-fullscreen>Fullscreen</button>
  </div>
  <p data-image-description class="whitespace-pre-wrap text-sm leading-relaxed">{description}</p>
  <div data-image-sources class="flex flex-wrap gap-3 text-xs">{sourceUrls.filter(url => /^https?:\/\//i.test(url)).map((url, i) => <a href={url} target="_blank" rel="noopener noreferrer">Source {i + 1}</a>)}</div>
</section>
<script>
  import { initPracticalImages } from '../../scripts/study/practicalImage';
  initPracticalImages();
  document.addEventListener('astro:page-load', initPracticalImages);
</script>

<style>
  button { padding: .35rem .65rem; border: 1px solid currentColor; border-radius: .5rem; cursor: pointer; }
  button:focus-visible, a:focus-visible { outline: 2px solid #059669; outline-offset: 3px; }
  a { text-decoration: underline; }
</style>
