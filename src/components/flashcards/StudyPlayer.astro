---
import type { FlashcardDeck, FlashcardCard } from '../../types/flashcards';
import ImageViewer from './ImageViewer.astro';

interface Props {
  deck: FlashcardDeck;
  initialCards: FlashcardCard[];
}

const { deck, initialCards } = Astro.props;
---

<div id="study-player-container" class="max-w-2xl mx-auto space-y-4" data-deck={JSON.stringify(deck)} data-initial-cards={JSON.stringify(initialCards)}>
  <!-- Top Header Bar -->
  <div class="p-3.5 sm:p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-2xs flex items-center justify-between gap-3">
    <!-- Back Link & Title -->
    <div class="flex items-center gap-2.5 min-w-0">
      <a
        href={deck.moduleId ? `/module/${deck.moduleId}` : '/'}
        class="p-1.5 rounded-xl text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors shrink-0"
        aria-label="Back to module"
      >
        <svg class="w-4 h-4 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
      </a>

      <div class="min-w-0">
        <h1 class="text-xs sm:text-sm font-bold text-zinc-900 dark:text-zinc-100 truncate">
          {deck.title}
        </h1>
        <div class="flex items-center gap-2 text-[11px] text-zinc-400 dark:text-zinc-500">
          <span id="player-progress-counter">بطاقة 1 من {initialCards.length}</span>
        </div>
      </div>
    </div>

    <!-- Actions (Pause & Reset) -->
    <div class="flex items-center gap-1.5 shrink-0">
      <button
        type="button"
        id="btn-pause-session"
        class="px-2.5 py-1 rounded-lg text-xs font-semibold text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
      >
        <span id="pause-btn-text" data-i18n="flashcards.pause">إيقاف مؤقت</span>
      </button>

      <button
        type="button"
        id="btn-reset-session"
        class="p-1.5 rounded-lg text-zinc-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer"
        title="إعادة ضبط تقدم المجموعة"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Main Card Stage -->
  <div id="card-stage" class="min-h-[360px] sm:min-h-[440px] p-5 sm:p-8 rounded-2xl sm:rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-sm flex flex-col justify-between transition-all duration-150">
    <!-- Card Question Section -->
    <div id="card-question-container" class="space-y-4">
      <div id="card-question-body"></div>
    </div>

    <!-- Divider & Card Answer Section (Revealed with animation) -->
    <div id="card-answer-container" class="hidden mt-6 pt-6 border-t border-zinc-100 dark:border-zinc-800">
      <div id="card-answer-body"></div>
    </div>

    <!-- Bottom Review Controls Bar -->
    <div class="mt-6 sm:mt-8 pt-4 border-t border-zinc-100 dark:border-zinc-800/80">
      <!-- Unrevealed State: Show Answer Button -->
      <div id="controls-unrevealed" class="flex justify-center">
        <button
          type="button"
          id="btn-reveal-answer"
          class="w-full sm:w-auto min-w-[220px] py-3.5 sm:py-3 px-6 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.97] text-white font-bold text-sm shadow-sm transition-all cursor-pointer flex items-center justify-center gap-2"
        >
          <span data-i18n="flashcards.revealAnswer">إظهار الإجابة</span>
          <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] bg-emerald-700/80 rounded border border-emerald-500/40 text-emerald-100 font-mono">
            Space
          </kbd>
        </button>
      </div>

      <!-- Revealed State: Again & Known Buttons -->
      <div id="controls-revealed" class="hidden grid grid-cols-2 gap-3">
        <!-- Again Button -->
        <button
          type="button"
          id="btn-rate-again"
          class="py-3.5 sm:py-3 px-4 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 hover:bg-amber-100 dark:hover:bg-amber-900/50 text-amber-800 dark:text-amber-200 font-bold text-sm active:scale-[0.97] transition-all cursor-pointer flex items-center justify-center gap-2"
        >
          <span data-i18n="flashcards.again">أعد البطاقة</span>
          <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] bg-amber-200/80 dark:bg-amber-900/80 rounded border border-amber-300 dark:border-amber-700 text-amber-900 dark:text-amber-100 font-mono">
            1
          </kbd>
        </button>

        <!-- Known Button -->
        <button
          type="button"
          id="btn-rate-known"
          class="py-3.5 sm:py-3 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.97] text-white font-bold text-sm shadow-sm transition-all cursor-pointer flex items-center justify-center gap-2"
        >
          <span data-i18n="flashcards.known">أعرفها</span>
          <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] bg-emerald-700/80 rounded border border-emerald-500/40 text-emerald-100 font-mono">
            2
          </kbd>
        </button>
      </div>
    </div>
  </div>

  <!-- Session Paused Overlay -->
  <div id="session-paused-screen" class="hidden p-8 sm:p-12 text-center rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-4">
    <h2 class="text-base sm:text-lg font-bold text-zinc-800 dark:text-zinc-200">
      تم إيقاف المذاكرة مؤقتاً
    </h2>
    <p class="text-xs text-zinc-500 dark:text-zinc-400">
      يمكنك استئناف جلستك في أي وقت، تم حفظ موضعك الحالي تلقائياً.
    </p>
    <button
      type="button"
      id="btn-resume-session"
      class="py-2.5 px-6 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs transition-colors cursor-pointer"
      data-i18n="flashcards.resume"
    >
      استئناف المذاكرة
    </button>
  </div>

  <!-- Session Complete Screen -->
  <div id="session-complete-screen" class="hidden p-8 sm:p-12 text-center rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-4">
    <h2 class="text-lg sm:text-xl font-extrabold text-zinc-900 dark:text-zinc-100" data-i18n="flashcards.completedTitle">
      أحسنت! أكملت مراجعة هذه المجموعة 🎉
    </h2>
    <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 max-w-md mx-auto" data-i18n="flashcards.completedSubtitle">
      تم حفظ تقدمك تلقائياً ويمكنك مراجعة جميع بطاقات المجموعة من جديد متى شئت.
    </p>

    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
      <button
        type="button"
        id="btn-review-again"
        class="w-full sm:w-auto py-2.5 px-5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs shadow-2xs transition-colors cursor-pointer"
        data-i18n="flashcards.reviewAgain"
      >
        مراجعة الكل من جديد
      </button>

      <a
        href={deck.moduleId ? `/module/${deck.moduleId}` : '/'}
        class="w-full sm:w-auto py-2.5 px-5 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 font-semibold text-xs transition-colors text-center"
        data-i18n="flashcards.backToModule"
      >
        العودة للموديول
      </a>
    </div>
  </div>

  <!-- Confirmation Dialog for Resetting Progress -->
  <dialog
    id="dialog-confirm-reset"
    class="fixed inset-0 m-auto p-6 max-w-sm rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xl backdrop:bg-black/60 outline-none text-start"
  >
    <div class="space-y-4">
      <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100">
        إعادة ضبط تقدم المجموعة؟
      </h3>
      <p class="text-xs text-zinc-500 dark:text-zinc-400">
        سيتم مسح حالتك للبطاقات في هذه المجموعة والبدء من البطاقة الأولى مجدداً.
      </p>
      <div class="flex items-center justify-end gap-2 pt-2">
        <button
          type="button"
          id="btn-cancel-reset"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 cursor-pointer"
        >
          إلغاء
        </button>
        <button
          type="button"
          id="btn-confirm-reset"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-600 hover:bg-rose-700 text-white cursor-pointer"
        >
          تأكيد إعادة الضبط
        </button>
      </div>
    </div>
  </dialog>

  <!-- Image Viewer Modal Component -->
  <ImageViewer />
</div>

<script>
  import type { FlashcardCard, FlashcardDeck, FlashcardProgress } from '../../types/flashcards';
  import {
    createReviewState,
    currentCard,
    reveal,
    rate,
    togglePaused,
    reviewAll,
    type ReviewState
  } from '../../utils/flashcards/review';
  import {
    loadFlashcardProgress,
    saveFlashcardProgress,
    rateProgress,
    resetProgress
  } from '../../utils/flashcards/persistence';
  import { getCachedUserProfile } from '../../firebase/auth';
  import { getCachedCards } from '../../utils/flashcards/persistence';
  import { cacheDeckImagesOnOpen } from '../../utils/flashcards/caching';

  function initStudyPlayer() {
    const container = document.getElementById('study-player-container');
    if (!container) return;

    const deckData: FlashcardDeck = JSON.parse(container.getAttribute('data-deck') || '{}');
    let cards: FlashcardCard[] = JSON.parse(container.getAttribute('data-initial-cards') || '[]');

    const cardStage = document.getElementById('card-stage');
    const questionBody = document.getElementById('card-question-body');
    const answerContainer = document.getElementById('card-answer-container');
    const answerBody = document.getElementById('card-answer-body');
    const controlsUnrevealed = document.getElementById('controls-unrevealed');
    const controlsRevealed = document.getElementById('controls-revealed');
    const progressCounter = document.getElementById('player-progress-counter');
    const pausedScreen = document.getElementById('session-paused-screen');
    const completeScreen = document.getElementById('session-complete-screen');
    const pauseBtn = document.getElementById('btn-pause-session');
    const pauseBtnText = document.getElementById('pause-btn-text');
    const resumeBtn = document.getElementById('btn-resume-session');
    const resetBtn = document.getElementById('btn-reset-session');
    const reviewAgainBtn = document.getElementById('btn-review-again');

    const resetDialog = document.getElementById('dialog-confirm-reset') as HTMLDialogElement | null;
    const cancelResetBtn = document.getElementById('btn-cancel-reset');
    const confirmResetBtn = document.getElementById('btn-confirm-reset');

    const revealBtn = document.getElementById('btn-reveal-answer');
    const againBtn = document.getElementById('btn-rate-again');
    const knownBtn = document.getElementById('btn-rate-known');

    let reviewState: ReviewState;
    let currentProgress: FlashcardProgress;
    const cachedUser = getCachedUserProfile();
    const uid = cachedUser?.uid || null;

    async function start() {
      // If initialCards was empty (offline), try local IndexedDB cache
      if ((!cards || cards.length === 0) && deckData.activeRevisionId) {
        const cached = await getCachedCards(deckData.id, deckData.activeRevisionId);
        if (cached && cached.length > 0) {
          cards = cached;
        }
      }

      // On-demand caching: Cache images for this specific deck into Cache Storage
      // without imposing network burden during initial website load
      if (cards && cards.length > 0) {
        cacheDeckImagesOnOpen(cards).catch(() => {});
      }

      const savedProgress = await loadFlashcardProgress(uid, deckData.id);
      currentProgress = savedProgress || {
        deckId: deckData.id,
        revisionId: deckData.activeRevisionId || '',
        checkpointIndex: 0,
        resetVersion: 1,
        updatedAt: Date.now(),
        cards: {}
      };

      reviewState = createReviewState(cards, currentProgress);
      render();
    }

    function render() {
      if (!cardStage || !questionBody || !answerBody || !progressCounter) return;

      if (reviewState.completed) {
        cardStage.classList.add('hidden');
        pausedScreen?.classList.add('hidden');
        completeScreen?.classList.remove('hidden');
        progressCounter.textContent = 'مكتملة ✓';
        return;
      }

      completeScreen?.classList.add('hidden');

      if (reviewState.paused) {
        cardStage.classList.add('hidden');
        pausedScreen?.classList.remove('hidden');
        if (pauseBtnText) pauseBtnText.textContent = 'استئناف';
        return;
      }

      cardStage.classList.remove('hidden');
      pausedScreen?.classList.add('hidden');
      if (pauseBtnText) pauseBtnText.textContent = 'إيقاف مؤقت';

      const card = currentCard(reviewState);
      if (!card) return;

      // Update progress counter
      const currentPos = reviewState.currentIndex + 1;
      const totalInQueue = reviewState.queue.length;
      progressCounter.textContent = `بطاقة ${currentPos} من ${totalInQueue}`;

      // Render front question
      const qDir = card.questionDirection || (/[\u0600-\u06FF]/.test(card.questionHtml.replace(/<[^>]+>/g, '')) ? 'rtl' : 'ltr');
      questionBody.setAttribute('dir', qDir);
      questionBody.className = `card-html text-base sm:text-lg leading-relaxed select-text ${qDir === 'rtl' ? 'text-right' : 'text-left'}`;
      questionBody.innerHTML = card.questionHtml;

      // Render answer if revealed
      if (reviewState.revealed) {
        const aDir = card.answerDirection || (/[\u0600-\u06FF]/.test(card.answerHtml.replace(/<[^>]+>/g, '')) ? 'rtl' : 'ltr');
        answerBody.setAttribute('dir', aDir);
        answerBody.className = `card-html text-base sm:text-lg leading-relaxed select-text ${aDir === 'rtl' ? 'text-right' : 'text-left'}`;
        answerBody.innerHTML = card.answerHtml;
        answerContainer?.classList.remove('hidden');
        controlsUnrevealed?.classList.add('hidden');
        controlsRevealed?.classList.remove('hidden');
      } else {
        answerContainer?.classList.add('hidden');
        controlsUnrevealed?.classList.remove('hidden');
        controlsRevealed?.classList.add('hidden');
      }
    }

    let isTransitioning = false;

    function handleReveal() {
      if (reviewState.revealed || reviewState.completed || reviewState.paused) return;
      reviewState = reveal(reviewState);
      render();

      if (answerContainer) {
        answerContainer.classList.remove('answer-revealing');
        void answerContainer.offsetWidth; // trigger reflow
        answerContainer.classList.add('answer-revealing');

        if (window.innerWidth < 640) {
          answerContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }

      if (controlsRevealed) {
        controlsRevealed.classList.remove('controls-pop');
        void controlsRevealed.offsetWidth;
        controlsRevealed.classList.add('controls-pop');
      }
    }

    async function handleRating(rating: 'again' | 'known') {
      if (isTransitioning) return;
      const card = currentCard(reviewState);
      if (!card || !reviewState.revealed) return;

      isTransitioning = true;

      // 1. Play card exit animation
      if (cardStage) {
        cardStage.classList.add(rating === 'known' ? 'card-exit-known' : 'card-exit-again');
      }

      // 2. Save progress in background
      currentProgress = rateProgress(
        currentProgress,
        card.id,
        rating,
        card.contentHash,
        deckData.activeRevisionId || card.revisionId
      );
      currentProgress.checkpointIndex = reviewState.currentIndex + 1;
      saveFlashcardProgress(uid, currentProgress).catch(console.error);

      // 3. Advance state and render new card after exit animation
      setTimeout(() => {
        reviewState = rate(reviewState, rating);
        render();

        if (cardStage) {
          cardStage.classList.remove('card-exit-known', 'card-exit-again');
          cardStage.classList.add('card-enter');
          setTimeout(() => {
            cardStage.classList.remove('card-enter');
            isTransitioning = false;
          }, 180);
        } else {
          isTransitioning = false;
        }

        if (window.innerWidth < 640 && cardStage) {
          cardStage.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }, 120);
    }

    function handlePause() {
      reviewState = togglePaused(reviewState);
      render();
    }

    // Keyboard navigation
    function handleKeydown(e: KeyboardEvent) {
      const target = e.target as HTMLElement | null;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) {
        return;
      }

      if (e.code === 'Space') {
        if (!reviewState.revealed && !reviewState.completed && !reviewState.paused) {
          e.preventDefault();
          handleReveal();
        }
      } else if (e.key === '1') {
        if (reviewState.revealed && !reviewState.completed && !reviewState.paused) {
          e.preventDefault();
          handleRating('again');
        }
      } else if (e.key === '2') {
        if (reviewState.revealed && !reviewState.completed && !reviewState.paused) {
          e.preventDefault();
          handleRating('known');
        }
      }
    }

    revealBtn?.addEventListener('click', handleReveal);
    againBtn?.addEventListener('click', () => handleRating('again'));
    knownBtn?.addEventListener('click', () => handleRating('known'));
    pauseBtn?.addEventListener('click', handlePause);
    resumeBtn?.addEventListener('click', handlePause);

    // Reset progress handling
    resetBtn?.addEventListener('click', () => resetDialog?.showModal());
    cancelResetBtn?.addEventListener('click', () => resetDialog?.close());
    confirmResetBtn?.addEventListener('click', async () => {
      resetDialog?.close();
      currentProgress = resetProgress(currentProgress);
      await saveFlashcardProgress(uid, currentProgress);
      reviewState = createReviewState(cards, currentProgress);
      render();
    });

    reviewAgainBtn?.addEventListener('click', () => {
      reviewState = reviewAll(cards);
      render();
    });

    window.addEventListener('keydown', handleKeydown);

    start();
  }

  initStudyPlayer();
  document.addEventListener('astro:after-swap', initStudyPlayer);
</script>

<style>
  /* Card Transitions */
  .card-exit-known {
    opacity: 0;
    transform: translateX(12px) scale(0.985);
    transition: all 120ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .card-exit-again {
    opacity: 0;
    transform: translateX(-12px) scale(0.985);
    transition: all 120ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .card-enter {
    animation: cardEnterAnim 160ms cubic-bezier(0, 0, 0.2, 1) forwards;
  }

  @keyframes cardEnterAnim {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.99);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Answer Revealing Animation */
  .answer-revealing {
    animation: answerRevealAnim 220ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes answerRevealAnim {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Controls Pop Animation */
  .controls-pop {
    animation: controlsPopAnim 180ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes controlsPopAnim {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-exit-known,
    .card-exit-again,
    .card-enter,
    .answer-revealing,
    .controls-pop {
      animation: none !important;
      transition: opacity 80ms ease !important;
      transform: none !important;
    }
  }
</style>

