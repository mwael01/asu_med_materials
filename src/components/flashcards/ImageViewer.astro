---
// Modal dialog for enlarging medical diagrams and card images
---

<dialog
  id="flashcard-image-modal"
  class="fixed inset-0 m-auto p-4 bg-transparent backdrop:bg-black/80 max-w-4xl max-h-[90vh] z-50 rounded-2xl outline-none"
  aria-label="Image Preview"
>
  <div class="relative flex flex-col items-center justify-center p-2">
    <button
      type="button"
      id="btn-close-image-modal"
      class="absolute top-2 right-2 p-2 rounded-full bg-black/60 hover:bg-black/80 text-white transition-colors cursor-pointer"
      aria-label="Close image preview"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <img
      id="flashcard-modal-img"
      src=""
      alt=""
      class="max-w-full max-h-[80vh] object-contain rounded-xl shadow-2xl"
    />
  </div>
</dialog>

<script>
  function initImageViewer() {
    const dialog = document.getElementById('flashcard-image-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('btn-close-image-modal');

    if (!dialog) return;

    closeBtn?.addEventListener('click', () => dialog.close());

    // Click backdrop outside dialog box to close
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        dialog.close();
      }
    });

    // Delegate document image click listener once
    if (!(window as any).__hasFlashcardImageListener) {
      (window as any).__hasFlashcardImageListener = true;
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (target && target.tagName === 'IMG' && target.closest('.card-html')) {
          // Inside Image Occlusion wrappers, clicking the diagram toggles masks instead of opening the single-image preview modal
          if (target.closest('#io-wrapper, .io-wrapper, #image-occlusion-container, .image-occlusion-container')) {
            return;
          }
          const currentDialog = document.getElementById('flashcard-image-modal') as HTMLDialogElement | null;
          const currentModalImg = document.getElementById('flashcard-modal-img') as HTMLImageElement | null;
          const src = (target as HTMLImageElement).src;
          if (src && currentDialog && currentModalImg) {
            currentModalImg.src = src;
            currentModalImg.alt = (target as HTMLImageElement).alt || 'Diagram preview';
            currentDialog.showModal();
          }
        }
      });
    }
  }

  initImageViewer();
  document.addEventListener('astro:after-swap', initImageViewer);
</script>
