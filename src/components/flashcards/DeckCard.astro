---
import type { FlashcardDeck } from '../../types/flashcards';

interface Props {
  deck: FlashcardDeck;
}

const { deck } = Astro.props;
---

<div
  class="deck-card flex flex-col justify-between p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-2xs hover:border-zinc-300 dark:hover:border-zinc-700 transition-all duration-150"
  data-deck-id={deck.id}
  data-year={deck.year}
  data-module={deck.moduleId}
  data-subject={deck.subject || ''}
  data-unit={deck.unit || ''}
  data-chapter={deck.chapter || ''}
>
  <div class="space-y-2">
    <!-- Header with Subject, Unit, & Card Count -->
    <div class="flex items-center justify-between gap-2 text-xs">
      <div class="flex items-center gap-1.5 flex-wrap">
        {deck.subject ? (
          <span class="px-2 py-0.5 rounded-md font-semibold text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200/60 dark:border-emerald-800/40">
            {deck.subject}
          </span>
        ) : (
          <span class="px-2 py-0.5 rounded-md font-semibold text-zinc-600 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-800 border border-zinc-200/60 dark:border-zinc-700">
            General
          </span>
        )}
        {deck.unit && deck.unit !== 'General' && (
          <span class="px-1.5 py-0.5 rounded text-[11px] font-medium text-zinc-600 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-800">
            {deck.unit}
          </span>
        )}
      </div>

      <span class="text-zinc-500 dark:text-zinc-400 font-medium text-[11px] shrink-0" data-i18n="flashcards.cardsCount" data-i18n-params={JSON.stringify({ n: deck.cardCount })}>
        {deck.cardCount} cards
      </span>
    </div>

    <!-- Deck Title / Chapter -->
    <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 line-clamp-2 leading-snug">
      {deck.chapter && deck.chapter !== 'General' ? deck.chapter : deck.title}
    </h3>

    {deck.author && (
      <p class="text-[11px] text-zinc-400 dark:text-zinc-500 font-medium">
        <span data-i18n="card.by">بواسطة:</span> {deck.author}
      </p>
    )}
  </div>

  <!-- Bottom Action -->
  <div class="mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between">
    <span class="deck-progress-indicator text-[11px] text-zinc-400 dark:text-zinc-500 font-medium">
      <!-- Dynamically updated by client script if in-progress -->
    </span>

    <a
      href={`/flashcards/${deck.id}`}
      class="deck-study-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white transition-all shadow-2xs"
    >
      <span class="deck-study-text" data-i18n="flashcards.startStudy">ابدأ المذاكرة</span>
      <svg class="w-3.5 h-3.5 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
      </svg>
    </a>
  </div>
</div>
