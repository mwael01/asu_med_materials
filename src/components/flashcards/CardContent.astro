---
import { prepareCardHtml } from '../../scripts/flashcards/cardHtml';

interface Props {
  html: string;
  kind?: string;
  isAnswer?: boolean;
  questionHtml?: string;
}

const { html, questionHtml } = Astro.props;

// Clean HTML defensively using central cardHtml pipeline
const { html: cleanHtml } = prepareCardHtml(html || '', questionHtml);

// Detect text direction from content independently of the site-wide language
const hasArabic = /[\u0600-\u06FF]/.test(cleanHtml.replace(/<[^>]+>/g, ''));
const direction = hasArabic ? 'rtl' : 'ltr';
---

<div
  class="card-content-wrapper prose dark:prose-invert max-w-none text-zinc-900 dark:text-zinc-100 text-center"
  dir={direction}
>
  <div class="card-html text-base sm:text-lg leading-relaxed select-text text-center" set:html={cleanHtml} />
</div>

<style is:global>
  .card-html {
    word-break: break-word;
    text-align: center;
    color: #18181b;
  }
  .dark .card-html {
    color: #f4f4f5;
  }
  .dark .card-html [style*="color: rgb(0, 0, 0)"],
  .dark .card-html [style*="color: #000"],
  .dark .card-html [style*="color:black"] {
    color: #f4f4f5 !important;
  }
  .card-html p {
    margin-bottom: 0.75rem;
    text-align: center;
  }
  .card-html p:last-child {
    margin-bottom: 0;
  }
  /* Hide dead hint button and empty sections */
  /* Image Occlusion Enhanced styles */
  .card-html #io-wrapper,
  .card-html .io-wrapper,
  .card-html #image-occlusion-container,
  .card-html .image-occlusion-container {
    position: relative;
    display: inline-block;
    max-width: 100%;
    margin: 0.5rem auto;
    vertical-align: middle;
  }
  .card-html #io-original,
  .card-html .io-original,
  .card-html #image-occlusion-original {
    position: relative;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1;
    display: block;
  }
  .card-html #io-original img,
  .card-html .io-original img,
  .card-html #image-occlusion-original img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 0.75rem;
  }
  .card-html #io-overlay,
  .card-html .io-overlay,
  .card-html #image-occlusion-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }
  .card-html #io-overlay img,
  .card-html #io-overlay svg,
  .card-html .io-overlay img,
  .card-html .io-overlay svg,
  .card-html #image-occlusion-overlay img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    margin: 0 !important;
    padding: 0 !important;
    border-radius: 0.75rem !important;
    box-shadow: none !important;
    border: none !important;
    background: transparent !important;
  }
  .card-html #io-overlay.is-hidden,
  .card-html .io-overlay.is-hidden,
  .card-html #image-occlusion-overlay.is-hidden {
    opacity: 0 !important;
    visibility: hidden !important;
    display: none !important;
  }
  .card-html #io-extra,
  .card-html .io-extra {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Hide dead hint button and empty sections */
  .card-html .hint_btn,
  .card-html #hint_btn,
  .card-html #snackbar,
  .card-html #io-revl-btn,
  .card-html #io-header,
  .card-html #io-footer,
  .card-html #images_section:not(:has(img)),
  .card-html #extra_section:not(:has(#extra:not(:empty))),
  .card-html #Etymology_section:not(:has(#Etymology:not(:empty))),
  .card-html #Mnemonics_section:not(:has(#Mnemonics:not(:empty))) {
    display: none !important;
  }
  .card-html strong,
  .card-html b {
    font-weight: 700;
  }
  .card-html em,
  .card-html i {
    font-style: italic;
  }
  .card-html u {
    text-decoration: underline;
  }
  .card-html ul {
    list-style-type: disc;
    padding-inline-start: 1.5rem;
    margin: 0.5rem 0;
  }
  .card-html ol {
    list-style-type: decimal;
    padding-inline-start: 1.5rem;
    margin: 0.5rem 0;
  }
  .card-html li {
    margin-bottom: 0.25rem;
  }
  .card-html table {
    width: 100%;
    max-width: 100%;
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.875rem;
    -webkit-overflow-scrolling: touch;
  }
  .card-html th,
  .card-html td {
    border: 1px solid #e4e4e7;
    padding: 0.5rem 0.75rem;
    text-align: inherit;
    white-space: nowrap;
  }
  .dark .card-html th,
  .dark .card-html td {
    border-color: #27272a;
  }
  .card-html th {
    background-color: #f4f4f5;
    font-weight: 600;
  }
  .dark .card-html th {
    background-color: #18181b;
  }
  .card-html img {
    max-width: 100%;
    max-height: 52vh;
    height: auto;
    object-fit: contain;
    border-radius: 0.75rem;
    margin: 0.75rem auto;
    cursor: zoom-in;
    display: block;
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
  }
  .card-html .cloze {
    color: #059669;
    font-weight: 700;
    background-color: rgba(5, 150, 105, 0.1);
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
    display: inline-block;
  }
  .dark .card-html .cloze {
    color: #34d399;
    background-color: rgba(52, 211, 153, 0.15);
  }
</style>
