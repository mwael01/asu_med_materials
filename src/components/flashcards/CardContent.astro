---
interface Props {
  html: string;
  kind?: string;
  isAnswer?: boolean;
}

const { html } = Astro.props;

// Detect text direction from content independently of the site-wide language
const hasArabic = /[\u0600-\u06FF]/.test(html.replace(/<[^>]+>/g, ''));
const direction = hasArabic ? 'rtl' : 'ltr';
---

<div
  class="card-content-wrapper prose dark:prose-invert max-w-none text-zinc-900 dark:text-zinc-100 text-center"
  dir={direction}
>
  <div class="card-html text-base sm:text-lg leading-relaxed select-text text-center" set:html={html} />
</div>

<style is:global>
  .card-html {
    word-break: break-word;
    text-align: center;
  }
  .card-html p {
    margin-bottom: 0.75rem;
    text-align: center;
  }
  .card-html p:last-child {
    margin-bottom: 0;
  }
  /* Hide dead hint button and empty sections */
  .card-html .hint_btn,
  .card-html #hint_btn,
  .card-html #snackbar,
  .card-html #images_section:not(:has(img)),
  .card-html #extra_section:not(:has(#extra:not(:empty))),
  .card-html #Etymology_section:not(:has(#Etymology:not(:empty))),
  .card-html #Mnemonics_section:not(:has(#Mnemonics:not(:empty))) {
    display: none !important;
  }
  .card-html strong,
  .card-html b {
    font-weight: 700;
  }
  .card-html em,
  .card-html i {
    font-style: italic;
  }
  .card-html u {
    text-decoration: underline;
  }
  .card-html ul {
    list-style-type: disc;
    padding-inline-start: 1.5rem;
    margin: 0.5rem 0;
  }
  .card-html ol {
    list-style-type: decimal;
    padding-inline-start: 1.5rem;
    margin: 0.5rem 0;
  }
  .card-html li {
    margin-bottom: 0.25rem;
  }
  .card-html table {
    width: 100%;
    max-width: 100%;
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.875rem;
    -webkit-overflow-scrolling: touch;
  }
  .card-html th,
  .card-html td {
    border: 1px solid #e4e4e7;
    padding: 0.5rem 0.75rem;
    text-align: inherit;
    white-space: nowrap;
  }
  .dark .card-html th,
  .dark .card-html td {
    border-color: #27272a;
  }
  .card-html th {
    background-color: #f4f4f5;
    font-weight: 600;
  }
  .dark .card-html th {
    background-color: #18181b;
  }
  .card-html img {
    max-width: 100%;
    max-height: 52vh;
    height: auto;
    object-fit: contain;
    border-radius: 0.75rem;
    margin: 0.75rem auto;
    cursor: zoom-in;
    display: block;
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
  }
  .card-html .cloze {
    color: #059669;
    font-weight: 700;
    background-color: rgba(5, 150, 105, 0.1);
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
    display: inline-block;
  }
  .dark .card-html .cloze {
    color: #34d399;
    background-color: rgba(52, 211, 153, 0.15);
  }
</style>
