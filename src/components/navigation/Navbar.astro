---
import type { NavCrumb } from '../../types/navigation';
import MobileMenu from './MobileMenu.astro';

interface Props {
  crumbs?: NavCrumb[];
  backHref?: string;
}

const { crumbs = [], backHref } = Astro.props;
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
const showBack = !isHome && (crumbs.length > 0 || Boolean(backHref));
const parentCrumb = crumbs.length > 1 ? crumbs[crumbs.length - 2] : null;
const effectiveBackFallback = backHref || parentCrumb?.href || '/';
---

<header class="sticky top-0 z-30 w-full border-b border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-950/90 backdrop-blur-md pt-[env(safe-area-inset-top,0px)]">
  <div class="max-w-6xl mx-auto px-3 sm:px-6 h-12 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Left Navigation: Back button + Unified Directory Breadcrumbs -->
    <div class="flex items-center gap-1.5 min-w-0 flex-1">
      {showBack && (
        <button
          type="button"
          id="nav-back-button"
          data-fallback-href={effectiveBackFallback}
          class="p-1.5 -ml-1 text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors cursor-pointer shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
          title="Go back"
          aria-label="Go back"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>
      )}

      <nav aria-label="Directory navigation" class="flex items-center gap-1 min-w-0 overflow-x-auto no-scrollbar py-1">
        <!-- Root Brand Link -->
        <a
          href="/"
          class="inline-flex items-center text-zinc-900 dark:text-zinc-100 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors shrink-0 font-bold text-xs sm:text-sm tracking-tight"
          aria-label="ASU Med Home"
        >
          {crumbs.length === 0 ? (
            <span>ASU <span class="text-emerald-500">Med</span> Materials</span>
          ) : (
            <span>ASU <span class="text-emerald-500">Med</span></span>
          )}
        </a>

        <!-- Breadcrumb segments with interactive dropdowns -->
        {crumbs.map((crumb, index) => {
          const isLast = index === crumbs.length - 1;
          const hasMenu = Boolean(crumb.menu && crumb.menu.length > 0);

          return (
            <div class="flex items-center gap-1 shrink-0">
              <span class="text-zinc-300 dark:text-zinc-700 select-none text-xs shrink-0" aria-hidden="true">/</span>

              {hasMenu ? (
                <div class="relative flex items-center shrink-0">
                  <div class="inline-flex items-center rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-colors">
                    {crumb.href && !isLast ? (
                      <a
                        href={crumb.href}
                        class="text-xs text-zinc-600 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 font-medium pl-1.5 pr-0.5 py-1 transition-colors max-w-[110px] sm:max-w-[160px] truncate"
                        title={crumb.title}
                      >
                        {crumb.title}
                      </a>
                    ) : (
                      <button
                        type="button"
                        class="nav-crumb-menu-trigger text-xs font-bold text-zinc-900 dark:text-zinc-100 pl-1.5 pr-0.5 py-1 text-left max-w-[120px] sm:max-w-[180px] truncate cursor-pointer"
                        title={crumb.title}
                        aria-haspopup="true"
                        aria-expanded="false"
                      >
                        <span class="truncate">{crumb.title}</span>
                      </button>
                    )}

                    <button
                      type="button"
                      class="nav-crumb-menu-trigger p-1 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 transition-colors cursor-pointer rounded"
                      aria-label={`Options for ${crumb.title}`}
                      aria-haspopup="true"
                      aria-expanded="false"
                    >
                      <svg class="w-3 h-3 transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                      </svg>
                    </button>
                  </div>

                  <!-- Dropdown Popover Menu -->
                  <div
                    class="nav-crumb-dropdown hidden absolute top-full left-0 mt-1 min-w-[200px] max-w-[280px] max-h-[60vh] overflow-y-auto overscroll-contain bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl shadow-xl z-50 p-1 text-xs text-start"
                  >
                    {crumb.menu!.map((item) => (
                      <a
                        href={item.href}
                        class:list={[
                          'flex items-center justify-between px-2.5 py-2 rounded-lg transition-colors',
                          item.active
                            ? 'bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 font-bold'
                            : 'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800'
                        ]}
                      >
                        <span class="truncate">{item.title}</span>
                        {item.active && (
                          <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                          </svg>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              ) : crumb.href && !isLast ? (
                <a
                  href={crumb.href}
                  class="text-xs text-zinc-600 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 font-medium px-1 py-0.5 transition-colors max-w-[110px] sm:max-w-[160px] truncate shrink-0"
                  title={crumb.title}
                >
                  {crumb.title}
                </a>
              ) : (
                <span
                  class="text-xs font-bold text-zinc-900 dark:text-zinc-100 px-1 py-0.5 max-w-[120px] sm:max-w-[180px] truncate shrink-0"
                  title={crumb.title}
                >
                  {crumb.title}
                </span>
              )}
            </div>
          );
        })}
      </nav>
    </div>

    <!-- Action Tools -->
    <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
      <!-- Search Link -->
      <a
        href="/search"
        class="p-1.5 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-md transition-colors"
        title="Search Materials & Subjects"
        aria-label="Search"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </a>

      <!-- Bookmarks Trigger -->
      <button
        type="button"
        class="open-bookmarks-trigger hidden sm:inline-flex relative p-1.5 text-zinc-600 dark:text-zinc-300 hover:text-amber-500 dark:hover:text-amber-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-md transition-colors cursor-pointer"
        title="Saved Bookmarks"
        aria-label="Saved Bookmarks"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
        </svg>
      </button>

      <!-- Account / Profile Icon Button -->
      <a
        href="/profile"
        id="nav-profile-link"
        class:list={[
          'p-1.5 rounded-md transition-colors flex items-center justify-center cursor-pointer',
          currentPath === '/profile'
            ? 'text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50'
            : 'text-zinc-600 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-zinc-100 dark:hover:bg-zinc-800'
        ]}
        title="Profile"
        aria-label="Profile"
      >
        <span
          class:list={[
            'w-5 h-5 rounded-full overflow-hidden flex items-center justify-center border transition-all',
            currentPath === '/profile'
              ? 'border-emerald-500 dark:border-emerald-400 ring-2 ring-emerald-500/20'
              : 'bg-zinc-100 dark:bg-zinc-800 border-zinc-200 dark:border-zinc-700'
          ]}
        >
          <img id="nav-profile-avatar" src="" alt="Profile" class="w-full h-full object-cover hidden" />
          <svg id="nav-profile-default-icon" class="w-3.5 h-3.5 text-zinc-500 dark:text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
        </span>
      </a>

      <!-- Mobile Burger Menu Trigger -->
      <button
        type="button"
        id="mobile-menu-trigger"
        class="lg:hidden p-1.5 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-md transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
        aria-label="Navigation Menu"
        title="Navigation Menu"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
      >
        <svg id="burger-menu-icon" class="w-5 h-5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="burger-close-icon" class="w-5 h-5 hidden transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Dropdown Menu -->
  <MobileMenu currentPath={currentPath} />
</header>

<script>
  import { onAuthChange, getCachedUserProfile } from '../../firebase/auth';

  let unsubscribeAuth: (() => void) | undefined;

  function syncNavAuthState(): void {
    const avatar = document.getElementById('nav-profile-avatar') as HTMLImageElement | null;
    const defaultIcon = document.getElementById('nav-profile-default-icon');
    const cached = getCachedUserProfile();

    if (cached) {
      if (cached.photoURL && avatar) {
        avatar.src = cached.photoURL;
        avatar.classList.remove('hidden');
        defaultIcon?.classList.add('hidden');
      } else {
        avatar?.classList.add('hidden');
        defaultIcon?.classList.remove('hidden');
      }
    } else {
      avatar?.classList.add('hidden');
      defaultIcon?.classList.remove('hidden');
    }
  }

  function initNavBackButton(): void {
    const backBtn = document.getElementById('nav-back-button');
    if (!backBtn || backBtn.dataset.bound) return;
    backBtn.dataset.bound = 'true';
    backBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const fallback = backBtn.getAttribute('data-fallback-href') || '/';
      if (window.history.length > 1 && document.referrer && new URL(document.referrer, location.href).origin === location.origin) {
        window.history.back();
      } else {
        window.location.href = fallback;
      }
    });
  }

  function initNavCrumbDropdowns(): void {
    const closeAll = () => {
      document.querySelectorAll<HTMLElement>('.nav-crumb-dropdown').forEach((d) => d.classList.add('hidden'));
      document.querySelectorAll<HTMLElement>('.nav-crumb-menu-trigger').forEach((t) => t.setAttribute('aria-expanded', 'false'));
    };

    document.querySelectorAll<HTMLElement>('.nav-crumb-menu-trigger').forEach((trigger) => {
      trigger.onclick = (e) => {
        e.stopPropagation();
        const parent = trigger.closest('.relative');
        const dropdown = parent?.querySelector<HTMLElement>('.nav-crumb-dropdown');
        if (!dropdown) return;
        const isOpen = !dropdown.classList.contains('hidden');
        closeAll();
        if (!isOpen) {
          dropdown.classList.remove('hidden');
          trigger.setAttribute('aria-expanded', 'true');
        }
      };
    });

    document.querySelectorAll<HTMLElement>('.nav-crumb-dropdown a').forEach((link) => {
      link.addEventListener('click', () => {
        closeAll();
      });
    });

    if (!(window as unknown as { _navCrumbDocBound?: boolean })._navCrumbDocBound) {
      (window as unknown as { _navCrumbDocBound?: boolean })._navCrumbDocBound = true;
      document.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement).closest('.nav-crumb-dropdown, .nav-crumb-menu-trigger')) {
          closeAll();
        }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeAll();
        }
      });
    }
  }

  function initAllNavbar(): void {
    syncNavAuthState();
    initNavBackButton();
    initNavCrumbDropdowns();
  }

  initAllNavbar();
  if (unsubscribeAuth) unsubscribeAuth();
  unsubscribeAuth = onAuthChange((_user) => {
    syncNavAuthState();
  });
  document.addEventListener('astro:after-swap', () => {
    initAllNavbar();
  });
</script>
