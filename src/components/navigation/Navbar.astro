---
import MobileMenu from './MobileMenu.astro';

const currentPath = Astro.url.pathname;
const links = [
  ['/', 'Home'],
  ['/modules', 'Modules'],
  ['/videos', 'Videos'],
  ['/pdfs', 'PDFs'],
  ['/flashcards', 'Flashcards'],
  ['/team', 'Team'],
];

---

<header class="sticky top-0 z-30 w-full border-b border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-950/90 backdrop-blur-md pt-[env(safe-area-inset-top,0px)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-12 flex items-center justify-between gap-4">
    <!-- Brand Title -->
    <a href="/" class="inline-flex items-center text-zinc-900 dark:text-zinc-100 hover:opacity-90 transition-opacity shrink-0" aria-label="mediX Home">
      <span class="font-extrabold text-sm sm:text-base tracking-tight shrink-0">medi<span class="text-emerald-500">X</span></span>
    </a>

    <nav class="hidden lg:flex items-center gap-1 text-xs font-medium" aria-label="Main navigation">
      {links.map(([href, title]) => <a href={href} aria-current={currentPath === href ? 'page' : undefined} class:list={['px-3 py-2 rounded-md hover:text-emerald-600', currentPath === href && 'text-emerald-600 font-bold']}>{title}</a>)}
      <a
        href="/contribute"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 ml-1 rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white transition-all shadow-2xs"
      >
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        <span>Contribute</span>
      </a>
    </nav>

    <!-- Action Tools -->
    <div class="flex items-center gap-1 sm:gap-1.5">
      <!-- Search Link -->
      <a
        href="/search"
        class="p-1.5 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-md transition-colors"
        title="Search Materials & Subjects"
        aria-label="Search"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </a>

      <!-- Bookmarks Trigger -->
      <button
        type="button"
        class="open-bookmarks-trigger inline-flex relative p-1.5 text-zinc-600 dark:text-zinc-300 hover:text-amber-500 dark:hover:text-amber-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-md transition-colors cursor-pointer"
        title="Saved Bookmarks"
        aria-label="Saved Bookmarks"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
        </svg>
      </button>

      <!-- Account / Profile Icon Button -->
      <a
        href="/profile"
        id="nav-profile-link"
        class:list={[
          'p-1.5 rounded-md transition-colors flex items-center justify-center cursor-pointer',
          currentPath === '/profile'
            ? 'text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50'
            : 'text-zinc-600 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-zinc-100 dark:hover:bg-zinc-800'
        ]}
        title="Profile"
        aria-label="Profile"
      >
        <span
          class:list={[
            'w-5 h-5 rounded-full overflow-hidden flex items-center justify-center border transition-all',
            currentPath === '/profile'
              ? 'border-emerald-500 dark:border-emerald-400 ring-2 ring-emerald-500/20'
              : 'bg-zinc-100 dark:bg-zinc-800 border-zinc-200 dark:border-zinc-700'
          ]}
        >
          <img id="nav-profile-avatar" src="" alt="Profile" class="w-full h-full object-cover hidden" />
          <svg id="nav-profile-default-icon" class="w-3.5 h-3.5 text-zinc-500 dark:text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
        </span>
      </a>

      <!-- Mobile Burger Menu Trigger -->
      <button
        type="button"
        id="mobile-menu-trigger"
        class="lg:hidden p-1.5 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-md transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
        aria-label="Navigation Menu"
        title="Navigation Menu"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
      >
        <svg id="burger-menu-icon" class="w-5 h-5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="burger-close-icon" class="w-5 h-5 hidden transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Dropdown Menu -->
  <MobileMenu currentPath={currentPath} />
</header>

<script>
  import { onAuthChange, getCachedUserProfile } from '../../firebase/auth';

  let unsubscribeAuth: (() => void) | undefined;

  function syncNavAuthState(): void {
    const avatar = document.getElementById('nav-profile-avatar') as HTMLImageElement | null;
    const defaultIcon = document.getElementById('nav-profile-default-icon');
    const cached = getCachedUserProfile();

    if (cached) {
      if (cached.photoURL && avatar) {
        avatar.src = cached.photoURL;
        avatar.classList.remove('hidden');
        defaultIcon?.classList.add('hidden');
      } else {
        avatar?.classList.add('hidden');
        defaultIcon?.classList.remove('hidden');
      }
    } else {
      avatar?.classList.add('hidden');
      defaultIcon?.classList.remove('hidden');
    }
  }

  syncNavAuthState();
  if (unsubscribeAuth) unsubscribeAuth();
  unsubscribeAuth = onAuthChange((_user) => {
    syncNavAuthState();
  });
  document.addEventListener('astro:after-swap', () => {
    syncNavAuthState();
  });
</script>
