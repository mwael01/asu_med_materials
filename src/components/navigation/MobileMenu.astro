---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const links = [
  ['/', 'Home'],
  ['/modules', 'Modules'],
  ['/videos', 'Videos'],
  ['/pdfs', 'PDFs'],
  ['/flashcards', 'Flashcards'],
  ['/search', 'Search'],
  ['/profile', 'Profile'],
  ['/team', 'Team'],
  ['/contribute', 'Contribute']
];
---

<!-- Mobile Backdrop Overlay -->
<div
  id="mobile-nav-backdrop"
  class="lg:hidden fixed inset-0 top-[calc(3rem+env(safe-area-inset-top,0px))] bg-black/50 backdrop-blur-xs z-35 hidden transition-opacity duration-200"
  aria-hidden="true"
></div>

<!-- Mobile Dropdown / Slide-down Menu -->
<div
  id="mobile-nav-panel"
  class="lg:hidden fixed top-[calc(3rem+env(safe-area-inset-top,0px))] inset-x-0 bg-white/98 dark:bg-zinc-950/98 backdrop-blur-md border-b border-zinc-200 dark:border-zinc-800 shadow-2xl z-40 hidden max-h-[calc(100dvh-3rem-env(safe-area-inset-top,0px))] overflow-y-auto overscroll-contain transition-all duration-200 pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))]"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation Menu"
>
  <div class="max-w-6xl mx-auto px-4 py-4 space-y-4">
    <nav aria-label="Mobile navigation" class="grid gap-1">
      {links.map(([href, title]) => <a href={href} aria-current={currentPath === href ? 'page' : undefined} class:list={['px-3 py-3 text-sm rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800', currentPath === href && 'text-emerald-600 font-bold']}>{title}</a>)}
      <button type="button" class="open-bookmarks-trigger mobile-menu-close-on-click text-left px-3 py-3 text-sm">Saved</button>
    </nav>
  </div>
</div>

<script>
  function initMobileMenu(): void {
    const trigger = document.getElementById('mobile-menu-trigger');
    const panel = document.getElementById('mobile-nav-panel');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    const burgerIcon = document.getElementById('burger-menu-icon');
    const closeIcon = document.getElementById('burger-close-icon');

    if (!trigger || !panel || !backdrop) return;

    let isOpen = false;

    function openMenu(): void {
      isOpen = true;
      panel?.classList.remove('hidden');
      backdrop?.classList.remove('hidden');
      burgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      trigger?.setAttribute('aria-expanded', 'true');
      document.body.classList.add('overflow-hidden', 'lg:overflow-auto');
    }

    function closeMenu(): void {
      isOpen = false;
      panel?.classList.add('hidden');
      backdrop?.classList.add('hidden');
      burgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      trigger?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden', 'lg:overflow-auto');
    }

    function toggleMenu(): void {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    trigger.onclick = (e) => {
      e.stopPropagation();
      toggleMenu();
    };

    backdrop.onclick = closeMenu;

    panel.querySelectorAll('a, .mobile-menu-close-on-click').forEach((el) => {
      (el as HTMLElement).onclick = () => {
        closeMenu();
      };
    });

    if (!mobileMenuGlobalInitialized) {
      mobileMenuGlobalInitialized = true;
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const p = document.getElementById('mobile-nav-panel');
          if (p && !p.classList.contains('hidden')) {
            closeMenu();
          }
        }
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024) {
          const p = document.getElementById('mobile-nav-panel');
          if (p && !p.classList.contains('hidden')) {
            closeMenu();
          }
        }
      });
    }


  }

  let mobileMenuGlobalInitialized = false;
  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
