---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isYear = (y: number) => currentPath.startsWith(`/year/${y}`);
---

<!-- Mobile Backdrop Overlay -->
<div
  id="mobile-nav-backdrop"
  class="md:hidden fixed inset-0 top-12 bg-black/50 backdrop-blur-xs z-35 hidden transition-opacity duration-200"
  aria-hidden="true"
></div>

<!-- Mobile Dropdown / Slide-down Menu -->
<div
  id="mobile-nav-panel"
  class="md:hidden fixed top-12 inset-x-0 bg-white/98 dark:bg-zinc-950/98 backdrop-blur-md border-b border-zinc-200 dark:border-zinc-800 shadow-2xl z-40 hidden max-h-[calc(100vh-3rem)] overflow-y-auto overscroll-contain transition-all duration-200"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation Menu"
>
  <div class="max-w-6xl mx-auto px-4 py-4 space-y-4">
    <!-- Contribute Action -->
    <a
      href="/contribute"
      class="flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl text-white font-bold text-sm bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] transition-colors shadow-2xs"
    >
      <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      <span data-i18n="nav.contribute">Contribute</span>
    </a>

    <!-- Academic Years Grid -->
    <div class="space-y-1.5">
      <div class="text-[11px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider px-1" data-i18n="nav.academicYears">
        Academic Years
      </div>
      <div class="grid grid-cols-5 gap-1.5">
        {[1, 2, 3, 4, 5].map((y) => (
          <a
            href={`/year/${y}`}
            class:list={[
              'flex flex-col items-center justify-center py-2 px-1 rounded-xl text-center transition-all',
              isYear(y)
                ? 'bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 font-bold border border-emerald-500/30'
                : 'bg-zinc-50 dark:bg-zinc-900/60 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200/60 dark:border-zinc-800'
            ]}
          >
            <span class="text-xs font-bold leading-none">{y}</span>
            <span class="text-[10px] text-zinc-400 dark:text-zinc-500 mt-1 leading-none" data-i18n="nav.year" data-i18n-params={JSON.stringify({ y })}>Year {y}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Core Pages List -->
    <div class="space-y-1">
      <a
        href="/"
        class:list={[
          'flex items-center gap-3 px-3 py-2 rounded-xl text-xs font-semibold transition-colors',
          currentPath === '/'
            ? 'bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 font-bold'
            : 'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800'
        ]}
      >
        <svg class="w-4 h-4 text-zinc-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
        <span data-i18n="nav.home">Home</span>
      </a>

      <a
        href="/search"
        class:list={[
          'flex items-center gap-3 px-3 py-2 rounded-xl text-xs font-semibold transition-colors',
          currentPath === '/search'
            ? 'bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 font-bold'
            : 'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800'
        ]}
      >
        <svg class="w-4 h-4 text-zinc-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span data-i18n="nav.search">Search</span>
      </a>

      <a
        href="/contributors"
        class:list={[
          'flex items-center gap-3 px-3 py-2 rounded-xl text-xs font-semibold transition-colors',
          currentPath === '/contributors'
            ? 'bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 font-bold'
            : 'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800'
        ]}
      >
        <svg class="w-4 h-4 text-zinc-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
        </svg>
        <span data-i18n="nav.contributors">Contributors</span>
      </a>
    </div>

    <!-- Quick Shortcuts: Change Year & Saved Bookmarks -->
    <div class="pt-2 border-t border-zinc-200 dark:border-zinc-800 grid grid-cols-2 gap-2">
      <button
        type="button"
        class="trigger-multistage-selector mobile-menu-close-on-click flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs font-semibold text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
        </svg>
        <span data-i18n="nav.changeYear">Change Year</span>
      </button>

      <button
        type="button"
        class="open-bookmarks-trigger mobile-menu-close-on-click flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs font-semibold text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:text-amber-500 dark:hover:text-amber-400 transition-colors cursor-pointer"
      >
        <svg class="w-4.5 h-4.5 text-zinc-500 hover:text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
        </svg>
        <span data-i18n="nav.savedResourcesTitle">Saved</span>
      </button>
    </div>
  </div>
</div>

<script>
  function initMobileMenu(): void {
    const trigger = document.getElementById('mobile-menu-trigger');
    const panel = document.getElementById('mobile-nav-panel');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    const burgerIcon = document.getElementById('burger-menu-icon');
    const closeIcon = document.getElementById('burger-close-icon');

    if (!trigger || !panel || !backdrop) return;

    let isOpen = false;

    function openMenu(): void {
      isOpen = true;
      panel?.classList.remove('hidden');
      backdrop?.classList.remove('hidden');
      burgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      trigger?.setAttribute('aria-expanded', 'true');
      document.body.classList.add('overflow-hidden', 'md:overflow-auto');
    }

    function closeMenu(): void {
      isOpen = false;
      panel?.classList.add('hidden');
      backdrop?.classList.add('hidden');
      burgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      trigger?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden', 'md:overflow-auto');
    }

    function toggleMenu(): void {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    trigger.onclick = (e) => {
      e.stopPropagation();
      toggleMenu();
    };

    backdrop.onclick = closeMenu;

    panel.querySelectorAll('a, .mobile-menu-close-on-click').forEach((el) => {
      (el as HTMLElement).onclick = () => {
        closeMenu();
      };
    });

    if (!mobileMenuGlobalInitialized) {
      mobileMenuGlobalInitialized = true;
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const p = document.getElementById('mobile-nav-panel');
          if (p && !p.classList.contains('hidden')) {
            closeMenu();
          }
        }
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) {
          const p = document.getElementById('mobile-nav-panel');
          if (p && !p.classList.contains('hidden')) {
            closeMenu();
          }
        }
      });
    }
  }

  let mobileMenuGlobalInitialized = false;
  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
