---
// src/components/pwa/PwaInstallToast.astro
---

<script>
  import {
    isPwaInstalledOrStandalone,
    isIosDevice,
    isHomePage,
    isPwaPromptDismissed,
    setPwaPromptDismissed,
    shouldShowPwaInstallPrompt
  } from '../../utils/pwa';

  declare global {
    interface Window {
      __PWA_DEFERRED_PROMPT?: any;
      __PWA_LISTENERS_INITIALIZED?: boolean;
    }
  }

  function cleanupActiveToast(): void {
    const toastEl = document.querySelector('[data-toast-id="pwa-install-toast"]');
    if (toastEl) toastEl.remove();
  }

  function showInstallToast(isIos = false): void {
    const currentPath = window.location.pathname || '/';
    if (!shouldShowPwaInstallPrompt(currentPath, isPwaInstalledOrStandalone(), isPwaPromptDismissed())) {
      cleanupActiveToast();
      return;
    }

    const showFn = (window as any).showToast;
    if (typeof showFn !== 'function') return;

    // Immediately record 24-hour dismissal so refreshing or closing does not repeatedly re-trigger
    setPwaPromptDismissed();

    if (isIos) {
      showFn({
        id: 'pwa-install-toast',
        type: 'pwa',
        title: 'Install mediX to Home Screen',
        message: 'Tap the Share button in Safari and choose "Add to Home Screen (+)".',
        duration: 10000
      });
    } else {
      showFn({
        id: 'pwa-install-toast',
        type: 'pwa',
        title: 'Install mediX Web App',
        message: 'Install mediX on your device for instant offline access and faster study materials.',
        duration: 0, // Keeps it visible until user action
        action: {
          label: 'Install Now',
          onClick: async () => {
            const promptEvent = window.__PWA_DEFERRED_PROMPT;
            if (promptEvent) {
              try {
                promptEvent.prompt();
                const choiceResult = await promptEvent.userChoice;
                if (choiceResult?.outcome === 'accepted') {
                  localStorage.setItem('asumed_pwa_installed', 'true');
                  cleanupActiveToast();
                } else {
                  setPwaPromptDismissed();
                }
              } catch {
                setPwaPromptDismissed();
              }
              window.__PWA_DEFERRED_PROMPT = null;
            }
          }
        }
      });
    }
  }

  function initPwaInstallPrompt(): void {
    const pathname = window.location.pathname || '/';

    // Strictly remove toast if user navigated away from the home page
    if (!isHomePage(pathname)) {
      cleanupActiveToast();
      return;
    }

    if (!shouldShowPwaInstallPrompt(pathname, isPwaInstalledOrStandalone(), isPwaPromptDismissed())) {
      cleanupActiveToast();
      return;
    }

    // If beforeinstallprompt was already captured
    if (window.__PWA_DEFERRED_PROMPT) {
      setTimeout(() => {
        showInstallToast(false);
      }, 2000);
      return;
    }

    // Handle iOS Safari guidance on the home page
    if (isIosDevice()) {
      setTimeout(() => {
        showInstallToast(true);
      }, 3500);
    }
  }

  // Register global listeners once across client router transitions
  if (typeof window !== 'undefined' && !window.__PWA_LISTENERS_INITIALIZED) {
    window.__PWA_LISTENERS_INITIALIZED = true;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      window.__PWA_DEFERRED_PROMPT = e;

      const pathname = window.location.pathname || '/';
      if (shouldShowPwaInstallPrompt(pathname, isPwaInstalledOrStandalone(), isPwaPromptDismissed())) {
        setTimeout(() => {
          showInstallToast(false);
        }, 2000);
      }
    });

    window.addEventListener('appinstalled', () => {
      try {
        localStorage.setItem('asumed_pwa_installed', 'true');
      } catch {}
      window.__PWA_DEFERRED_PROMPT = null;
      cleanupActiveToast();
    });
  }

  // Initialize on page load and on view transitions
  initPwaInstallPrompt();
  document.addEventListener('astro:after-swap', initPwaInstallPrompt);
</script>
