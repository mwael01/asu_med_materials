---
import '../styles/global.css';
import Navbar from '../components/navigation/Navbar.astro';
import Footer from '../components/navigation/Footer.astro';
import BookmarksDrawer from '../components/bookmarks/BookmarksDrawer.astro';
import MultistageSelector from '../components/selection/MultistageSelector.astro';
import Toast from '../components/common/Toast.astro';
import PwaInstallToast from '../components/pwa/PwaInstallToast.astro';
import Analytics from '@vercel/analytics/astro';
import { RECAPTCHA_ENTERPRISE_SITE_KEY } from '../firebase/app-check';
import { getMaterialsVersionFromFirestore } from '../firebase/firestore';
import { getAllModules } from '../data/modules';
import { ClientRouter } from 'astro:transitions';

import type { NavCrumb } from '../types/navigation';

interface Props {
  title?: string;
  description?: string;
  crumbs?: NavCrumb[];
  backHref?: string;
}

const {
  title = 'ASU Med - All-in-one Medical Study Hub',
  description = 'Batch drives, Telegram channels, YouTube lectures, and study notes for Ain Shams University Faculty of Medicine.',
  crumbs,
  backHref
} = Astro.props;

const catalogueVersion = await getMaterialsVersionFromFirestore();
const allModules = await getAllModules(catalogueVersion);
---

<!doctype html>
<html lang="en" dir="ltr" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/icons/icon-512.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ASU Med" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#09090b" />
    <meta name="generator" content={Astro.generator} />
    <meta name="catalogue-version" content={String(catalogueVersion)} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />

    <!-- Permanent Dark Mode -->
    <script is:inline>
      document.documentElement.classList.add('dark');
      try {
        localStorage.setItem('theme', 'dark');
      } catch (e) {}
    </script>

    <!-- Eager Cache & User Year Warmup for instant 0ms access -->
    <script is:inline>
      (function() {
        try {
          var y = localStorage.getItem('asumed_user_year');
          if (y && !isNaN(y)) window.__USER_STORED_YEAR = parseInt(y, 10);

          var m = localStorage.getItem('asumed_modules_snapshot');
          if (m) {
            var pm = JSON.parse(m);
            if (pm && pm.modules) window.__CACHED_MODULES = pm.modules;
          }
          var c = localStorage.getItem('asumed_catalogue_snapshot');
          if (c) {
            var pc = JSON.parse(c);
            if (pc && pc.materials) window.__CACHED_MATERIALS = pc.materials;
          }
          var l = localStorage.getItem('asumed_lessons_snapshot');
          if (l) {
            var pl = JSON.parse(l);
            if (pl && pl.lessons) window.__CACHED_LESSONS = pl.lessons;
          }
        } catch(e) {}
      })();
    </script>

    <!-- Google reCAPTCHA Enterprise for Firebase App Check -->
    {RECAPTCHA_ENTERPRISE_SITE_KEY && (
      <script src={`https://www.google.com/recaptcha/enterprise.js?render=${RECAPTCHA_ENTERPRISE_SITE_KEY}`} async defer></script>
    )}
  </head>
  <body class="min-h-dvh flex flex-col bg-zinc-950 text-zinc-100 antialiased selection:bg-emerald-500 selection:text-white">
    <!-- Global Top Progress Bar for Instant Route Feedback -->
    <div
      id="global-nav-progress"
      class="fixed top-0 left-0 right-0 h-[2px] z-[99999] pointer-events-none opacity-0 transition-opacity duration-200"
      aria-hidden="true"
    >
      <div
        id="global-nav-progress-bar"
        class="h-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.7)] w-0 transition-[width] duration-300 ease-out"
      ></div>
    </div>

    <Navbar crumbs={crumbs} backHref={backHref} allModules={allModules} />

    <main class="page-content flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-6 pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))]">
      <slot />
    </main>

    <BookmarksDrawer />
    <MultistageSelector />
    <Toast />
    <PwaInstallToast />
    <Footer />

    <!-- Service Worker registration, studied materials, App Check, catalogue cache & user library synchronization -->
    <script>
      import { registerServiceWorker } from '../utils/pwa';
      import { initStudiedMaterials } from '../utils/studied';
      import { initAppCheck } from '../firebase/app-check';
      import { initUserLibrarySync } from '../utils/userSync';
      import { warmupCatalogueCache } from '../utils/catalogueClient';

      initStudiedMaterials();
      registerServiceWorker();
      initAppCheck();
      initUserLibrarySync();
      warmupCatalogueCache();

      document.addEventListener('astro:after-swap', () => {
        initStudiedMaterials();
        initAppCheck();
        initUserLibrarySync();
        warmupCatalogueCache();
      });

      // Global navigation loading bar for instant feedback during page transitions
      (function() {
        let progressTimer: ReturnType<typeof setTimeout> | null = null;
        let finishTimer: ReturnType<typeof setTimeout> | null = null;

        function startNavProgress() {
          const container = document.getElementById('global-nav-progress');
          const bar = document.getElementById('global-nav-progress-bar');
          if (!container || !bar) return;

          if (finishTimer) clearTimeout(finishTimer);
          if (progressTimer) clearTimeout(progressTimer);

          bar.style.transition = 'width 250ms ease-out';
          bar.style.width = '35%';
          container.style.opacity = '1';

          progressTimer = setTimeout(() => {
            bar.style.transition = 'width 1200ms cubic-bezier(0.1, 0.5, 0.1, 1)';
            bar.style.width = '80%';
          }, 200);
        }

        function finishNavProgress() {
          const container = document.getElementById('global-nav-progress');
          const bar = document.getElementById('global-nav-progress-bar');
          if (!container || !bar) return;

          if (progressTimer) clearTimeout(progressTimer);

          bar.style.transition = 'width 150ms ease-out';
          bar.style.width = '100%';

          finishTimer = setTimeout(() => {
            container.style.opacity = '0';
            finishTimer = setTimeout(() => {
              bar.style.transition = 'none';
              bar.style.width = '0%';
            }, 250);
          }, 150);
        }

        document.addEventListener('astro:before-preparation', startNavProgress);
        document.addEventListener('astro:page-load', finishNavProgress);
      })();
    </script>

    <Analytics />
  </body>
</html>
