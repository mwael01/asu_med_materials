---
import '../styles/global.css';
import Navbar from '../components/navigation/Navbar.astro';
import Footer from '../components/navigation/Footer.astro';
import BookmarksDrawer from '../components/bookmarks/BookmarksDrawer.astro';
import MultistageSelector from '../components/selection/MultistageSelector.astro';
import Toast from '../components/common/Toast.astro';
import PwaInstallToast from '../components/pwa/PwaInstallToast.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ASU Med Materials - All-in-one Medical Study Hub',
  description = 'Batch drives, Telegram channels, YouTube lectures, and study notes for Ain Shams University Faculty of Medicine.'
} = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#059669" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Zero-flash Early Language & Direction Setter -->
    <script is:inline>
      (function () {
        try {
          var lang = localStorage.getItem('asumed_lang') || 'en';
          document.documentElement.lang = lang;
          document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
        } catch (e) {}
      })();
    </script>


    <!-- Default to White/Light Theme (Only activate dark if explicitly set to 'dark') -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
            if (!stored) {
              localStorage.setItem('theme', 'light');
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-zinc-50/60 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 antialiased selection:bg-emerald-500 selection:text-white">
    <Navbar />

    <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-6">
      <slot />
    </main>

    <BookmarksDrawer />
    <MultistageSelector />
    <Toast />
    <PwaInstallToast />
    <Footer />

    <!-- Service Worker registration, studied materials, & i18n client synchronization -->
    <script>
      import { registerServiceWorker } from '../utils/pwa';
      import { initLanguageClient } from '../utils/i18n';
      import { initStudiedMaterials } from '../utils/studied';

      initLanguageClient();
      initStudiedMaterials();
      registerServiceWorker();
      document.addEventListener('astro:after-swap', () => {
        initLanguageClient();
        initStudiedMaterials();
      });
    </script>

    <Analytics />
  </body>
</html>
