---
import '../styles/global.css';
import Navbar from '../components/navigation/Navbar.astro';
import Footer from '../components/navigation/Footer.astro';
import BookmarksDrawer from '../components/bookmarks/BookmarksDrawer.astro';
import MultistageSelector from '../components/selection/MultistageSelector.astro';
import Toast from '../components/common/Toast.astro';
import PwaInstallToast from '../components/pwa/PwaInstallToast.astro';
import Analytics from '@vercel/analytics/astro';
import { RECAPTCHA_ENTERPRISE_SITE_KEY } from '../firebase/app-check';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ASU Med Materials - All-in-one Medical Study Hub',
  description = 'Batch drives, Telegram channels, YouTube lectures, and study notes for Ain Shams University Faculty of Medicine.'
} = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/icons/icon-512.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ASU Med" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#059669" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Default to White/Light Theme (Only activate dark if explicitly set to 'dark') -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
            if (!stored) {
              localStorage.setItem('theme', 'light');
            }
          }
        } catch (e) {}
      })();
    </script>
    <!-- Google reCAPTCHA Enterprise for Firebase App Check -->
    {RECAPTCHA_ENTERPRISE_SITE_KEY && (
      <script src={`https://www.google.com/recaptcha/enterprise.js?render=${RECAPTCHA_ENTERPRISE_SITE_KEY}`} async defer></script>
    )}
  </head>
  <body class="min-h-dvh flex flex-col bg-zinc-50/60 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 antialiased selection:bg-emerald-500 selection:text-white">
    <Navbar />

    <main class="page-content flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-6 pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))]">
      <slot />
    </main>

    <BookmarksDrawer />
    <MultistageSelector />
    <Toast />
    <PwaInstallToast />
    <Footer />

    <!-- Service Worker registration, studied materials, App Check, & user library synchronization -->
    <script>
      import { registerServiceWorker } from '../utils/pwa';
      import { initStudiedMaterials } from '../utils/studied';
      import { initAppCheck } from '../firebase/app-check';
      import { initUserLibrarySync } from '../utils/userSync';

      initStudiedMaterials();
      registerServiceWorker();
      initAppCheck();
      initUserLibrarySync();

      document.addEventListener('astro:after-swap', () => {
        initStudiedMaterials();
        initAppCheck();
        initUserLibrarySync();
      });
    </script>

    <Analytics />
  </body>
</html>
