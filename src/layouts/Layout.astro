---
import '../styles/global.css';
import Navbar from '../components/navigation/Navbar.astro';
import Footer from '../components/navigation/Footer.astro';
import BookmarksDrawer from '../components/bookmarks/BookmarksDrawer.astro';
import MultistageSelector from '../components/selection/MultistageSelector.astro';
import Toast from '../components/common/Toast.astro';
import PwaInstallToast from '../components/pwa/PwaInstallToast.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ASU Med Materials - المنصة الشاملة لمصادر طب عين شمس',
  description = 'داتا ومصادر ودرايفات وقنوات وورق مذكرات كلية الطب جامعة عين شمس، مجمعة ومصنفة حسب السنين والموديولات.'
} = Astro.props;

const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#059669" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Auto-redirect students to their chosen year if visiting the homepage directly -->
    {isHomePage && (
      <script is:inline>
        (function () {
          try {
            var params = new URLSearchParams(window.location.search);
            var redirectFlag = params.get('redirect');
            var noRedirectFlag = params.get('noredirect');
            // If user explicitly asks to view homepage via ?redirect=false or ?noredirect=true
            if (redirectFlag === 'false' || redirectFlag === '0' || noRedirectFlag === 'true' || noRedirectFlag === '1') {
              return;
            }
            var savedYear = localStorage.getItem('asumed_user_year');
            if (savedYear && ['1', '2', '3', '4', '5'].indexOf(savedYear) !== -1) {
              window.location.replace('/year/' + savedYear);
            }
          } catch (e) {}
        })();
      </script>
    )}

    <!-- Default to White/Light Theme (Only activate dark if explicitly set to 'dark') -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
            if (!stored) {
              localStorage.setItem('theme', 'light');
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-zinc-50/60 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 antialiased selection:bg-emerald-500 selection:text-white">
    <Navbar />

    <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-6">
      <slot />
    </main>

    <BookmarksDrawer />
    <MultistageSelector />
    <Toast />
    <PwaInstallToast />
    <Footer />
  </body>
</html>
