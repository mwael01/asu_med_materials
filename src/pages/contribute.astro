---
import Layout from '../layouts/Layout.astro';
import { modulesData } from '../data/modules';
import QuickDumpForm from '../components/contribute/QuickDumpForm.astro';
import DetailedSubmitForm from '../components/contribute/DetailedSubmitForm.astro';
---

<Layout
  title="شارك مصادرك ومذكراتك - ASU Med Materials"
  description="شارك مصادر ودرايفات وقنوات ورسائل مجمعة لدعم زملائك الطلاب في كلية الطب جامعة عين شمس."
>
  <div class="max-w-2xl mx-auto py-4 text-right">
    <!-- Page Header -->
    <div class="mb-6">
      <h1 class="text-2xl font-extrabold text-zinc-900 dark:text-zinc-100 mb-1">
        شارك مصادرك ومذكراتك الدراسية
      </h1>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
        ساعد زملائك في طب عين شمس بمشاركة درايفات الدفعة، ورق ومذكرات المحاضرات، قنوات التليجرام، أو لصق رسائل الواتساب التجميعية كما هي!
      </p>
    </div>

    <!-- Contributor Recognition Banner -->
    <div class="mb-6 p-4 rounded-2xl bg-emerald-50/80 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 flex items-start gap-3">
      <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center shrink-0 mt-0.5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
        </svg>
      </div>
      <div>
        <h2 class="text-xs sm:text-sm font-bold text-zinc-900 dark:text-zinc-100">
          توثيق الإعداد والمساهمة 🌟
        </h2>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-0.5 leading-relaxed">
          أي مصادر تشاركها، بنحرص على كتابة اسمك أو أسماء فريق العمل كـ <strong>إعداد</strong> و <strong>مساهمة</strong> على كروت المصادر بالموقع تقديراً لمساعدتكم لزملائكم.
        </p>
      </div>
    </div>

    <!-- Submission Mode Tabs -->
    <div class="mb-5 flex p-1 bg-zinc-100 dark:bg-zinc-800/80 rounded-xl border border-zinc-200 dark:border-zinc-700/60">
      <button
        type="button"
        id="tab-btn-dump"
        class="flex-1 py-2 px-3 text-xs font-bold rounded-lg transition-all flex items-center justify-center gap-1.5 cursor-pointer bg-white dark:bg-zinc-900 text-emerald-700 dark:text-emerald-400 shadow-xs"
        aria-selected="true"
      >
        <span>⚡ تفريغ سريع (رسالة واتساب / نص مجمع)</span>
      </button>
      <button
        type="button"
        id="tab-btn-detailed"
        class="flex-1 py-2 px-3 text-xs font-medium rounded-lg transition-all flex items-center justify-center gap-1.5 cursor-pointer text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200"
        aria-selected="false"
      >
        <span>📝 مصدر فردي محدد</span>
      </button>
    </div>

    <!-- Mode 1: Quick Dump Form (Active by default) -->
    <div id="tab-panel-dump" class="transition-opacity duration-200">
      <QuickDumpForm modules={modulesData} />
    </div>

    <!-- Mode 2: Detailed Submit Form -->
    <div id="tab-panel-detailed" class="hidden transition-opacity duration-200">
      <DetailedSubmitForm modules={modulesData} />
    </div>

    <!-- Guidance and Permissive Policy Notice -->
    <div class="mt-8 bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-xl p-5 text-xs text-zinc-600 dark:text-zinc-400 space-y-3">
      <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 flex items-center gap-1.5">
        <span>💡 كيف تعمل مشاركة المصادر؟</span>
      </h3>
      <ul class="list-disc pr-5 space-y-2 leading-relaxed">
        <li>
          <strong>بكل بساطة ودون تعقيد:</strong> انسخ والصق رسائل الواتساب أو التليجرام كما هي، أو رابطاً مع وصف سريع، أو عشرات الروابط في نص واحد، وسنتولى استخراجها وتصنيفها.
        </li>
        <li>
          <strong>المصادر المفتوحة:</strong> نحرص على أن تكون الروابط متاحة لجميع طلاب الكلية بدون اشتراكات مدفوعة أو كلمات سر مغلقة.
        </li>
        <li>
          <strong>الإضافة للموقع:</strong> يتم تفريغ ومراجعة الرسائل وإدراجها في موديولات وسنوات الموقع تباعاً مع توثيق اسم المساهم.
        </li>
      </ul>
    </div>
  </div>
</Layout>

<script>
  function initContributeTabs(): void {
    const tabDump = document.getElementById('tab-btn-dump');
    const tabDetailed = document.getElementById('tab-btn-detailed');
    const panelDump = document.getElementById('tab-panel-dump');
    const panelDetailed = document.getElementById('tab-panel-detailed');

    if (!tabDump || !tabDetailed || !panelDump || !panelDetailed) return;

    function selectTab(tab: 'dump' | 'detailed'): void {
      if (tab === 'dump') {
        tabDump?.classList.remove('text-zinc-600', 'dark:text-zinc-400', 'font-medium');
        tabDump?.classList.add('bg-white', 'dark:bg-zinc-900', 'text-emerald-700', 'dark:text-emerald-400', 'font-bold', 'shadow-xs');
        tabDump?.setAttribute('aria-selected', 'true');

        tabDetailed?.classList.remove('bg-white', 'dark:bg-zinc-900', 'text-emerald-700', 'dark:text-emerald-400', 'font-bold', 'shadow-xs');
        tabDetailed?.classList.add('text-zinc-600', 'dark:text-zinc-400', 'font-medium');
        tabDetailed?.setAttribute('aria-selected', 'false');

        panelDump?.classList.remove('hidden');
        panelDetailed?.classList.add('hidden');
      } else {
        tabDetailed?.classList.remove('text-zinc-600', 'dark:text-zinc-400', 'font-medium');
        tabDetailed?.classList.add('bg-white', 'dark:bg-zinc-900', 'text-emerald-700', 'dark:text-emerald-400', 'font-bold', 'shadow-xs');
        tabDetailed?.setAttribute('aria-selected', 'true');

        tabDump?.classList.remove('bg-white', 'dark:bg-zinc-900', 'text-emerald-700', 'dark:text-emerald-400', 'font-bold', 'shadow-xs');
        tabDump?.classList.add('text-zinc-600', 'dark:text-zinc-400', 'font-medium');
        tabDump?.setAttribute('aria-selected', 'false');

        panelDetailed?.classList.remove('hidden');
        panelDump?.classList.add('hidden');
      }
    }

    tabDump.addEventListener('click', () => selectTab('dump'));
    tabDetailed.addEventListener('click', () => selectTab('detailed'));
  }

  initContributeTabs();
  document.addEventListener('astro:after-swap', initContributeTabs);
</script>
