---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/search/SearchBar.astro';
import PageHeading from '../components/common/PageHeading.astro';
import ResourceGrid from '../components/materials/ResourceGrid.astro';
import { getAllMaterials } from '../data/materials';
import { getAllModules } from '../data/modules';
import { getPublicLessons } from '../data/catalogue.server';
import { materialStudyPath } from '../utils/studyContent';
import { getMaterialEnglishTitle } from '../i18n/materialsTranslations';
const [rawMaterials, modules, lessons] = await Promise.all([getAllMaterials(), getAllModules(), getPublicLessons()]);
const materials = rawMaterials.map(item => ({ ...item, titleEn: item.titleEn || getMaterialEnglishTitle(item.id, item.title),
  tags: [...item.tags, ...lessons.filter(lesson => lesson.id === item.lessonId && lesson.active !== false && lesson.moduleId === item.moduleId).map(lesson => lesson.title)] }));
const hrefs = Object.fromEntries(materials.map(item => [item.id, materialStudyPath(item, lessons)]));
---
<Layout title="Search - ASU Med Materials">
  <PageHeading title="Search" />
  <section data-search-page>
    <script type="application/json" data-search-data set:html={JSON.stringify({ materials, modules }).replace(/</g, '\u003c')} />
    <form role="search" class="mb-6">
      <label for="site-search-input" class="sr-only">Search study materials</label>
      <SearchBar autofocus={true} enableSuggestions={false} placeholder="Search subjects, lessons, doctors, or materials" />
      <div class="flex items-center justify-between gap-4 mt-3 text-sm">
        <span data-search-year class="text-zinc-500"></span>
        <label class="inline-flex items-center gap-2"><input data-search-all type="checkbox" class="accent-emerald-600" />All years</label>
      </div>
    </form>
    <div data-search-results hidden><ResourceGrid materials={materials} hrefs={hrefs} showYear={true} /></div>
    <p data-search-empty role="status" class="text-sm text-zinc-500 py-6" hidden>No matching resources.</p>
  </section>
</Layout>
<script>
  import { initSearchPage } from '../scripts/search/page';
  initSearchPage();
  document.addEventListener('astro:after-swap', initSearchPage);
</script>
