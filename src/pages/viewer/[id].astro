---
import Layout from '../../layouts/Layout.astro';
import type { NavCrumb } from '../../types/navigation';
import TypeBadge from '../../components/materials/TypeBadge.astro';
import ResourceCard from '../../components/materials/ResourceCard.astro';
import DocumentImage from '../../components/study/DocumentImage.astro';
import StudyFolderDrawer from '../../components/study/StudyFolderDrawer.astro';
import PdfViewer from '../../components/study/PdfViewer.astro';
import { getMaterialById, getMaterialsByModule } from '../../data/materials';
import { getModuleById } from '../../data/modules';
import { getMaterialsVersionFromFirestore } from '../../firebase/firestore';
import { subjectToSlug } from '../../utils/slug';
import {
  getDocumentEmbedUrl,
  getDocumentExternalUrl,
  hasDiscreteDocuments,
  resolveDocumentItems,
  isEmbeddableDocument,
  isImageDocument,
  isPdfDocument,
  getDocumentDownloadUrl
} from '../../utils/documentViewer';

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/404');
}

const version = await getMaterialsVersionFromFirestore();
const material = await getMaterialById(id, version);
if (!material) {
  return Astro.redirect('/404');
}

// Redirect playlists to the dedicated playlist player
if (material.type === 'playlist' || material.playlistId || (material.videos && material.videos.length > 0)) {
  return Astro.redirect(`/playlist/${material.id}`);
}

const isBundle = hasDiscreteDocuments(material);
const documents = resolveDocumentItems(material);

// Parse all document items in the bundle
const parsedDocuments = documents.map((doc, idx) => {
  const extension = (doc.url || '').split('.').pop()?.split(/[?#]/)[0] || 'pdf';
  const rawTitle = doc.title || (documents.length === 1 ? material.title : `Document ${idx + 1}`);
  const cleanTitle = rawTitle.replace(/[/\\?%*:|"<>]/g, ' ').trim();
  const downloadName = cleanTitle.toLowerCase().endsWith(`.${extension}`) ? cleanTitle : `${cleanTitle}.${extension}`;

  return {
    id: doc.id || `doc_${idx + 1}`,
    title: rawTitle,
    downloadName,
    url: doc.url,
    embedUrl: getDocumentEmbedUrl(doc.url),
    externalUrl: getDocumentExternalUrl(doc.url),
    isEmbeddable: isEmbeddableDocument(doc.url),
    isPdf: isPdfDocument(doc.url),
    isImage: isImageDocument(doc.url)
  };
});

// Find initial document (first embeddable, PDF, or first document)
const initialDocIndex = Math.max(0, parsedDocuments.findIndex((d) => Boolean(d.embedUrl) || d.isPdf));
const initialDoc = parsedDocuments[initialDocIndex] || {
  id: material.id,
  title: material.title,
  downloadName: `${(material.title || 'Document').replace(/[/\\?%*:|"<>]/g, ' ').trim()}.pdf`,
  url: material.url,
  embedUrl: getDocumentEmbedUrl(material.url),
  externalUrl: getDocumentExternalUrl(material.url),
  isEmbeddable: isEmbeddableDocument(material.url),
  isPdf: isPdfDocument(material.url),
  isImage: isImageDocument(material.url)
};

const isInitialPdf = initialDoc.isPdf ?? isPdfDocument(material.url);
const embedUrl = initialDoc.embedUrl || getDocumentEmbedUrl(material.url);
if (!embedUrl && !isInitialPdf && !isBundle) {
  return Astro.redirect(material.url);
}

const externalUrl = initialDoc.externalUrl || getDocumentExternalUrl(material.url);
const initialDownloadUrl = getDocumentDownloadUrl(initialDoc.url, material.id, initialDoc.id);
const initialDownloadFilename = initialDoc.downloadName;
const [moduleInfo, relatedMaterials] = await Promise.all([
  material.moduleId ? getModuleById(material.moduleId, version) : Promise.resolve(undefined),
  material.moduleId
    ? getMaterialsByModule(material.moduleId, version).then((moduleMaterials) =>
        moduleMaterials
          .filter((m) => m.id !== material.id)
          .sort((a, b) => {
            if (a.subject === material.subject && b.subject !== material.subject) return -1;
            if (b.subject === material.subject && a.subject !== material.subject) return 1;
            return 0;
          })
          .slice(0, 3)
      )
    : Promise.resolve([])
]);

const titleEn = material.titleEn || material.title;
const descEn = material.descriptionEn || material.description;

// Authors list normalization (who prepared the material)
const rawAuthors = Array.isArray(material.author)
  ? material.author
  : material.author
    ? [material.author]
    : [];
const authorText = rawAuthors.join(', ');

const backFallbackUrl = material.moduleId
  ? material.subject
    ? `/module/${material.moduleId}/${subjectToSlug(material.subject)}`
    : `/module/${material.moduleId}`
  : `/year/${material.year}`;

const crumbs: NavCrumb[] = [];
if (material.year) {
  crumbs.push({
    title: `Year ${material.year}`,
    href: `/year/${material.year}`,
    isYear: true,
    year: material.year
  });
}
if (moduleInfo) {
  crumbs.push({
    title: moduleInfo.title,
    href: `/module/${moduleInfo.id}`,
    isModule: true,
    year: moduleInfo.year
  });
}
if (material.subject && moduleInfo) {
  const subjectMenu = moduleInfo.subjects.map((s) => ({
    title: s,
    href: `/module/${moduleInfo.id}/${subjectToSlug(s)}`,
    active: s === material.subject
  }));
  crumbs.push({
    title: material.subject,
    href: `/module/${moduleInfo.id}/${subjectToSlug(material.subject)}`,
    menu: subjectMenu
  });
}
crumbs.push({
  title: titleEn
});
---

<Layout
  title={`${titleEn} | Document Viewer | ASU Med`}
  description={descEn || `Read and study ${titleEn} online on ASU Med.`}
  crumbs={crumbs}
  backHref={backFallbackUrl}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 space-y-6">

    <!-- Document Info Card & Actions Header -->
    <header class="bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 rounded-2xl p-4 sm:p-5 shadow-xs space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
        <!-- Title and Badges -->
        <div class="space-y-2 min-w-0 flex-1">
          <div class="flex items-center gap-2 flex-wrap">
            <TypeBadge type={material.type} size="sm" />
            <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
              Year {material.year}
            </span>
            {material.subject && (
              <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300">
                {material.subject}
              </span>
            )}
            {authorText && (
              <span class="text-[11px] text-zinc-500 dark:text-zinc-400">
                By: <strong class="text-zinc-700 dark:text-zinc-300">{authorText}</strong>
              </span>
            )}
          </div>

          <h1 class="text-lg sm:text-2xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-snug">
            {titleEn}
          </h1>

          {descEn && (
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {descEn}
            </p>
          )}
        </div>

        <!-- Action Toolbar -->
        <div class="flex items-center gap-2 shrink-0 flex-wrap">
          <!-- Mark as Studied Button -->
          <button
            type="button"
            class="studied-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-semibold transition-all cursor-pointer shadow-2xs border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:border-emerald-500"
            data-id={material.id}
            role="checkbox"
            aria-checked="false"
            title="Mark as studied"
            aria-label="Mark as studied"
          >
            <span class="studied-box w-4 h-4 rounded border-2 border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 flex items-center justify-center transition-all">
              <svg class="studied-checkmark w-2.5 h-2.5 text-white hidden drop-shadow-2xs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
            <span class="studied-btn-text">Studied</span>
          </button>

          <!-- Bookmark Button -->
          <button
            type="button"
            class="bookmark-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-semibold transition-all cursor-pointer shadow-2xs border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:border-amber-400"
            data-material-id={material.id}
            title="Save to bookmarks"
            aria-label="Save to bookmarks"
          >
            <svg class="w-4 h-4 bookmark-icon-empty text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
            </svg>
            <svg class="w-4 h-4 bookmark-icon-filled hidden text-amber-500 fill-amber-500" viewBox="0 0 24 24">
              <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
            </svg>
            <span class="bookmark-btn-text">Save</span>
          </button>

          <!-- Copy Link Button -->
          <button
            type="button"
            id="viewer-copy-link-btn"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-semibold transition-all cursor-pointer shadow-2xs border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-700/60"
            title="Copy link to clipboard"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-3.003l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
            </svg>
            <span>Share</span>
          </button>

          <!-- Open in Google Drive External Link -->
          <a
            id="viewer-drive-btn"
            href={externalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer shadow-2xs bg-emerald-600 hover:bg-emerald-700 text-white"
            title="Open original file"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
            <span id="viewer-drive-btn-text">Open original</span>
          </a>
          <!-- Download / Open Local File Button -->
          <a
            id="viewer-download-btn"
            href={initialDownloadUrl || '#'}
            target="_blank"
            rel="noopener noreferrer"
            download={initialDownloadFilename}
            data-material-id={material.id}
            data-doc-id={initialDoc.id}
            data-year={material.year || 1}
            data-module={moduleInfo?.title || 'General'}
            data-subject={material.subject || 'General'}
            data-title={initialDoc.title}
            data-url={initialDoc.url}
            data-download-url={initialDownloadUrl || ''}
            data-download-name={initialDownloadFilename}
            hidden={!initialDownloadUrl}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-semibold transition-all cursor-pointer shadow-2xs border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:border-emerald-500 hover:text-emerald-600 dark:hover:text-emerald-400"
            title="Download document for offline reading"
          >
            <svg id="download-icon-dl" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            <svg id="download-icon-saved" class="w-3.5 h-3.5 hidden text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span id="viewer-download-btn-text">Download</span>
          </a>

          <!-- Study Folder Drawer Trigger -->
          <button
            type="button"
            id="viewer-folder-btn"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-semibold transition-all cursor-pointer shadow-2xs border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-700/60"
            title="Manage offline study folder"
            aria-label="Manage offline study folder"
          >
            <svg class="w-3.5 h-3.5 text-zinc-500 dark:text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z" />
            </svg>
            <span class="hidden sm:inline">Study Folder</span>
            <span id="folder-status-dot" class="w-1.5 h-1.5 rounded-full bg-zinc-300 dark:bg-zinc-600"></span>
          </button>

          <!-- Fullscreen Toggle -->
          <button
            type="button"
            id="viewer-fullscreen-btn"
            class="inline-flex items-center justify-center p-1.5 rounded-lg border border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-700/60 transition-colors cursor-pointer shadow-2xs"
            title="Toggle fullscreen reading mode"
            aria-label="Toggle fullscreen mode"
          >
            <svg id="fullscreen-enter-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
            </svg>
            <svg id="fullscreen-exit-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9L3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5l5.25 5.25" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    {/* Multi-Document Bundle Switcher */}
    {isBundle && parsedDocuments.length > 1 && (
      <div class="bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 rounded-2xl p-3 sm:p-4 shadow-xs space-y-3">
        <div class="flex items-center justify-between gap-2 flex-wrap pb-2 border-b border-zinc-100 dark:border-zinc-800/80">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-md bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-400 font-bold text-xs">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
            </span>
            <span class="text-xs font-bold text-zinc-900 dark:text-zinc-100">Bundle Documents</span>
            <span id="doc-counter-badge" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
              Document {initialDocIndex + 1} of {parsedDocuments.length}
            </span>
          </div>

          <!-- Prev / Next Document Buttons -->
          <div class="flex items-center gap-1.5">
            <button
              type="button"
              id="doc-prev-btn"
              class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-colors disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
              title="Previous Document"
              disabled={initialDocIndex === 0}
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
              </svg>
              <span class="hidden sm:inline">Previous</span>
            </button>
            <button
              type="button"
              id="doc-next-btn"
              class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-colors disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
              title="Next Document"
              disabled={initialDocIndex === parsedDocuments.length - 1}
            >
              <span class="hidden sm:inline">Next</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Document Tracklist Pills -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 max-w-full" id="doc-tracklist-container">
          {parsedDocuments.map((doc, idx) => (
            <button
              type="button"
              class:list={[
                'doc-track-item shrink-0 inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all cursor-pointer border text-start max-w-[280px]',
                idx === initialDocIndex
                  ? 'bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border-emerald-500/50 shadow-2xs font-bold'
                  : 'bg-zinc-50 dark:bg-zinc-800/60 text-zinc-700 dark:text-zinc-300 border-zinc-200/80 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800'
              ]}
              data-doc-index={idx}
              data-doc-id={doc.id}
              data-doc-title={doc.title}
              data-doc-url={doc.url}
              data-embed-url={doc.embedUrl || ''}
              data-is-image={doc.isImage ? 'true' : 'false'}
              data-is-pdf={doc.isPdf ? 'true' : 'false'}
              data-external-url={doc.externalUrl}
              data-download-url={getDocumentDownloadUrl(doc.url, material.id, doc.id) || ''}
              data-download-name={doc.downloadName}
              title={doc.title}
            >
              <span class="w-4 h-4 rounded-full bg-zinc-200 dark:bg-zinc-700 flex items-center justify-center text-[10px] font-bold shrink-0">
                {idx + 1}
              </span>
              <span class="truncate">{doc.title}</span>
            </button>
          ))}
        </div>
      </div>
    )}

    <!-- Document Viewer Container -->
    <main
      id="viewer-container"
      class="relative w-full h-[76vh] min-h-[520px] lg:h-[84vh] rounded-2xl overflow-hidden border border-zinc-200/80 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900 shadow-sm transition-all"
    >
      <!-- Exit Fullscreen Floating Button (visible only in fullscreen) -->
      <button
        type="button"
        id="fullscreen-close-floating-btn"
        class="hidden absolute top-4 right-4 z-40 items-center gap-1.5 px-3 py-1.5 rounded-xl bg-zinc-900/90 text-white text-xs font-semibold backdrop-blur-md shadow-lg hover:bg-zinc-800 transition-all cursor-pointer"
        title="Exit Fullscreen"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span>Exit Fullscreen</span>
      </button>

      <!-- Skeleton Loading Indicator -->
      <div
        id="viewer-skeleton"
        class:list={[
          'absolute inset-0 z-20 flex flex-col items-center justify-center bg-zinc-100 dark:bg-zinc-900 transition-opacity duration-300 pointer-events-none',
          initialDoc.isPdf && 'hidden'
        ]}
      >
        <div class="animate-pulse flex flex-col items-center gap-3 text-center p-6">
          <div class="w-12 h-12 rounded-2xl bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center text-zinc-400">
            <svg class="w-6 h-6 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
          </div>
          <div class="space-y-1">
            <p class="text-xs font-bold text-zinc-700 dark:text-zinc-300">Loading document preview...</p>
            <p class="text-[11px] text-zinc-400">Please wait while the PDF stream connects</p>
          </div>
        </div>
      </div>

      <!-- Embedded PDF.js Reader (Cloudflare R2, direct PDFs, and local offline blobs) -->
      <PdfViewer
        id="viewer-pdf"
        initialUrl={initialDoc.isPdf ? initialDoc.url : ''}
        title={initialDoc.title}
        hidden={!initialDoc.isPdf}
      />

      <!-- Embedded Iframe (Google Drive, Docs, Slides, and web embeds) -->
      <iframe
        id="viewer-iframe"
        src={!initialDoc.isImage && !initialDoc.isPdf ? embedUrl : undefined}
        hidden={initialDoc.isImage || initialDoc.isPdf}
        class="w-full h-full border-0 rounded-2xl"
        allow="autoplay; fullscreen"
        loading="eager"
        title={initialDoc.title || titleEn}
      ></iframe>
      <DocumentImage id="viewer-image" src={initialDoc.isImage ? initialDoc.url : undefined} alt={initialDoc.title} hidden={!initialDoc.isImage} />
    </main>

    <!-- Bottom Helper Note -->
    <div class="flex items-center justify-between text-[11px] text-zinc-500 dark:text-zinc-400 px-1">
      <div class="flex items-center gap-1.5">
        <span>Having trouble reading?</span>
        <a
          id="viewer-bottom-drive-link"
          href={externalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-emerald-600 dark:text-emerald-400 hover:underline inline-flex items-center gap-0.5"
        >
          <span>Open directly in Google Drive</span>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      </div>
      <span class="hidden sm:inline">Use the fullscreen icon or zoom controls for distraction-free reading</span>
    </div>

    <!-- Related Materials in Same Module/Subject -->
    {relatedMaterials.length > 0 && (
      <section class="pt-6 border-t border-zinc-200/80 dark:border-zinc-800 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-extrabold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Related Study Materials in this Module</span>
          </h2>
          {moduleInfo && (
            <a
              href={`/module/${moduleInfo.id}`}
              class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:underline"
            >
              View module →
            </a>
          )}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedMaterials.map((item) => (
            <ResourceCard material={item} showYear={false} />
          ))}
        </div>
      </section>
    )}
  </div>

  <StudyFolderDrawer />
</Layout>

<style>
  /* Fullscreen Viewport Mode (compatible with iOS Safari, Android, and Desktop) */
  #viewer-container.doc-viewer-fullscreen {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    max-width: 100vw !important;
    max-height: 100vh !important;
    z-index: 99999 !important;
    border-radius: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    background-color: #09090b !important;
  }

  #viewer-container.doc-viewer-fullscreen iframe {
    border-radius: 0 !important;
  }
</style>

<script>
  import { initBookmarkButtons, renderBookmarkButtons } from '../../utils/bookmarks';
  import { initStudiedMaterials, updateStudiedCardUI } from '../../utils/studied';
  import {
    isMaterialInLocalFolder,
    getStoredDirectoryHandle,
    verifyFolderPermission,
    readLocalFileBlobUrl,
    saveFileToCurriculumFolder
  } from '../../utils/localFolderManager';

  let viewerAbort: AbortController | null = null;

  function initDocumentViewer(): void {
    if (viewerAbort) viewerAbort.abort();
    viewerAbort = new AbortController();
    const { signal } = viewerAbort;

    initBookmarkButtons();
    initStudiedMaterials();

    const container = document.getElementById('viewer-container');
    const pdfRoot = document.getElementById('viewer-pdf');
    const iframe = document.getElementById('viewer-iframe') as HTMLIFrameElement | null;
    const image = document.getElementById('viewer-image') as HTMLImageElement | null;
    const skeleton = document.getElementById('viewer-skeleton');
    const fullscreenBtn = document.getElementById('viewer-fullscreen-btn');
    const fullscreenEnterIcon = document.getElementById('fullscreen-enter-icon');
    const fullscreenExitIcon = document.getElementById('fullscreen-exit-icon');
    const fullscreenFloatingCloseBtn = document.getElementById('fullscreen-close-floating-btn');
    const copyLinkBtn = document.getElementById('viewer-copy-link-btn');
    const backBtn = document.getElementById('viewer-back-btn');
    const downloadBtn = document.getElementById('viewer-download-btn') as HTMLAnchorElement | null;
    const downloadBtnText = document.getElementById('viewer-download-btn-text');
    const dlIcon = document.getElementById('download-icon-dl');
    const savedIcon = document.getElementById('download-icon-saved');

    let pdfViewer: any = null;
    if (pdfRoot) {
      import('../../scripts/study/pdfViewerController').then(({ createPdfViewer }) => {
        pdfViewer = createPdfViewer(pdfRoot);
      }).catch(err => console.error('Failed to init PDF viewer:', err));
    }

    signal.addEventListener('abort', () => {
      pdfViewer?.destroy();
    });

    const openLocalDocument = (blobUrl: string, title?: string, path?: string) => {
      const isPdf = path ? path.toLowerCase().endsWith('.pdf') : true;
      if (isPdf && pdfRoot) {
        if (image) image.hidden = true;
        if (iframe) {
          iframe.hidden = true;
          iframe.removeAttribute('src');
        }
        pdfRoot.hidden = false;
        skeleton?.classList.add('hidden');
        if (pdfViewer) {
          pdfViewer.load(blobUrl, title || 'Local Document');
        } else {
          import('../../scripts/study/pdfViewerController').then(({ createPdfViewer }) => {
            pdfViewer = createPdfViewer(pdfRoot);
            pdfViewer.load(blobUrl, title || 'Local Document');
          });
        }
      } else if (iframe) {
        if (image) image.hidden = true;
        if (pdfRoot) pdfRoot.hidden = true;
        iframe.hidden = false;
        iframe.src = blobUrl;
        iframe.title = title || 'Local Document';
        skeleton?.classList.add('hidden');
      }
    };

    // 1. Hide skeleton when iframe loads
    if (iframe && skeleton) {
      const hideSkeleton = () => {
        skeleton.classList.add('opacity-0');
        setTimeout(() => {
          skeleton.classList.add('hidden');
        }, 300);
      };

      iframe.addEventListener('load', hideSkeleton, { signal });
      image?.addEventListener('load', hideSkeleton, { signal });
      image?.addEventListener('error', hideSkeleton, { signal });
      if (image && !image.hidden && image.complete) hideSkeleton();
      // Fallback timeout in case load event was already fired
      setTimeout(hideSkeleton, 6000);
    }

    // 2. Fullscreen Toggle (CSS-based viewport expansion)
    let isFullscreen = false;
    function setFullscreen(active: boolean): void {
      isFullscreen = active;
      if (!container) return;

      container.classList.toggle('doc-viewer-fullscreen', isFullscreen);
      fullscreenEnterIcon?.classList.toggle('hidden', isFullscreen);
      fullscreenExitIcon?.classList.toggle('hidden', !isFullscreen);
      fullscreenFloatingCloseBtn?.classList.toggle('hidden', !isFullscreen);
      fullscreenFloatingCloseBtn?.classList.toggle('flex', isFullscreen);

      if (isFullscreen) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    }

    fullscreenBtn?.addEventListener('click', () => {
      setFullscreen(!isFullscreen);
    }, { signal });

    fullscreenFloatingCloseBtn?.addEventListener('click', () => {
      setFullscreen(false);
    }, { signal });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isFullscreen) {
        setFullscreen(false);
      }
    }, { signal });

    // 3. Copy Link
    copyLinkBtn?.addEventListener('click', async () => {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(window.location.href);
        } else {
          const input = document.createElement('textarea');
          input.value = window.location.href;
          input.style.position = 'fixed';
          input.style.opacity = '0';
          document.body.appendChild(input);
          input.focus();
          input.select();
          (document as any).execCommand?.('copy');
          document.body.removeChild(input);
        }
        const showFn = (window as any).showToast;
        if (typeof showFn === 'function') {
          showFn({
            type: 'success',
            message: 'Document link copied to clipboard!',
            duration: 2500
          });
        }
      } catch {}
    }, { signal });

    // 4. Back Button Navigation
    backBtn?.addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        const fallback = backBtn.getAttribute('data-fallback') || '/';
        window.location.href = fallback;
      }
    }, { signal });

    // 5. Download & Local Study Folder Integration
    async function syncDownloadBtnState(matId: string, docId: string, dlUrl: string | null): Promise<void> {
      if (!downloadBtn || !downloadBtnText || !dlIcon || !savedIcon) return;
      if (!dlUrl) {
        downloadBtn.hidden = true;
        return;
      }
      downloadBtn.hidden = false;
      downloadBtn.href = dlUrl;

      const localRecord = await isMaterialInLocalFolder(matId, docId);
      if (localRecord) {
        downloadBtn.dataset.isLocal = 'true';
        downloadBtn.dataset.localPath = localRecord.relativePath;
        downloadBtnText.textContent = 'Saved in Folder ✓';
        downloadBtn.title = 'Saved locally on your device (0 MB quota). Click to view local copy.';
        downloadBtn.classList.add('border-emerald-500/60', 'text-emerald-700', 'dark:text-emerald-300');
        dlIcon.classList.add('hidden');
        savedIcon.classList.remove('hidden');
      } else {
        downloadBtn.dataset.isLocal = 'false';
        downloadBtn.removeAttribute('data-local-path');
        downloadBtnText.textContent = 'Download';
        downloadBtn.title = 'Download document for offline reading';
        downloadBtn.classList.remove('border-emerald-500/60', 'text-emerald-700', 'dark:text-emerald-300');
        dlIcon.classList.remove('hidden');
        savedIcon.classList.add('hidden');
      }
    }

    downloadBtn?.addEventListener('click', async (e) => {
      if (downloadBtn.dataset.isLocal === 'true') {
        e.preventDefault();
        const localPath = downloadBtn.dataset.localPath;
        if (!localPath) return;
        const handle = await getStoredDirectoryHandle();
        if (!handle) return;
        const hasPerm = await verifyFolderPermission(handle, false);
        if (!hasPerm) return;
        const blobUrl = await readLocalFileBlobUrl(handle, localPath);
        if (blobUrl) {
          openLocalDocument(blobUrl, downloadBtn.dataset.title || 'Local Document', localPath);
          const showFn = (window as any).showToast;
          if (typeof showFn === 'function') {
            showFn({
              type: 'success',
              message: 'Opened local copy from Study Folder (0 MB quota used)',
              duration: 2500
            });
          }
        }
      } else {
        const dlUrl = downloadBtn.getAttribute('href');
        const isHosted = dlUrl && dlUrl.startsWith('/api/material-download');
        if (isHosted) {
          const handle = await getStoredDirectoryHandle();
          if (handle) {
            const hasWritePerm = await verifyFolderPermission(handle, true);
            if (hasWritePerm) {
              e.preventDefault();
              try {
                if (downloadBtnText) downloadBtnText.textContent = 'Saving...';
                const res = await fetch(dlUrl);
                if (res.ok) {
                  const blob = await res.blob();
                  const year = Number(downloadBtn.dataset.year) || 1;
                  const modTitle = downloadBtn.dataset.module || 'General';
                  const subj = downloadBtn.dataset.subject || 'General';
                  const docTitle = downloadBtn.dataset.title || 'document';
                  const matId = downloadBtn.dataset.materialId || '';
                  const docId = downloadBtn.dataset.docId || '';

                  await saveFileToCurriculumFolder(handle, year, modTitle, subj, docTitle, blob, matId, docId);
                  await syncDownloadBtnState(matId, docId, dlUrl);
                  window.dispatchEvent(new CustomEvent('study-folder-updated'));
                  const showFn = (window as any).showToast;
                  if (typeof showFn === 'function') {
                    showFn({
                      type: 'success',
                      message: `Saved to Study Folder: Year ${year} / ${modTitle}`,
                      duration: 3000
                    });
                  }
                  return;
                }
              } catch (err) {
                console.error('Failed to save to folder:', err);
              } finally {
                if (downloadBtnText) downloadBtnText.textContent = 'Download';
              }
            }
          }
        }
      }
    }, { signal });

    window.addEventListener('study-folder-load-document', (e: any) => {
      const { blobUrl, title, path } = e.detail || {};
      if (blobUrl) {
        openLocalDocument(blobUrl, title, path);
        const showFn = (window as any).showToast;
        if (typeof showFn === 'function') {
          showFn({
            type: 'success',
            message: `Viewing offline document: ${title || 'Document'}`,
            duration: 2500
          });
        }
      }
    }, { signal });

    window.addEventListener('study-folder-updated', () => {
      const currentDocId = downloadBtn?.dataset.docId || '';
      const currentMaterialId = downloadBtn?.dataset.materialId || '';
      const currentDlUrl = downloadBtn?.getAttribute('href') || null;
      syncDownloadBtnState(currentMaterialId, currentDocId, currentDlUrl);
    }, { signal });

    // 6. Multi-Document Bundle Switching
    const trackItems = document.querySelectorAll<HTMLButtonElement>('.doc-track-item');
    const prevBtn = document.getElementById('doc-prev-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('doc-next-btn') as HTMLButtonElement | null;
    const counterBadge = document.getElementById('doc-counter-badge');
    const driveBtn = document.getElementById('viewer-drive-btn') as HTMLAnchorElement | null;
    const bottomDriveLink = document.getElementById('viewer-bottom-drive-link') as HTMLAnchorElement | null;

    let activeDocIndex = 0;
    trackItems.forEach((btn, idx) => {
      if (btn.classList.contains('bg-emerald-50') || btn.classList.contains('dark:bg-emerald-950/60')) {
        activeDocIndex = idx;
      }
    });

    function switchDocument(idx: number): void {
      if (idx < 0 || idx >= trackItems.length) return;
      activeDocIndex = idx;
      const targetBtn = trackItems[idx];
      if (!targetBtn) return;

      const embed = targetBtn.getAttribute('data-embed-url');
      const external = targetBtn.getAttribute('data-external-url');
      const title = targetBtn.getAttribute('data-doc-title') || 'Document';
      const docId = targetBtn.getAttribute('data-doc-id') || '';
      const downloadUrl = targetBtn.getAttribute('data-download-url') || null;
      const isImage = targetBtn.getAttribute('data-is-image') === 'true';
      const isPdf = targetBtn.getAttribute('data-is-pdf') === 'true';
      const docUrl = targetBtn.getAttribute('data-doc-url') || '';

      if (image) {
        image.hidden = !isImage; image.removeAttribute('src');
        if (isImage && external) { image.src = external; image.alt = title; }
      }
      if (pdfRoot) {
        pdfRoot.hidden = !isPdf;
        if (isPdf && docUrl) {
          skeleton?.classList.add('hidden');
          if (pdfViewer) {
            pdfViewer.load(docUrl, title);
          } else {
            import('../../scripts/study/pdfViewerController').then(({ createPdfViewer }) => {
              pdfViewer = createPdfViewer(pdfRoot);
              pdfViewer.load(docUrl, title);
            });
          }
        }
      }
      if (iframe) {
        iframe.hidden = isImage || isPdf;
        if (!isImage && !isPdf) {
          if (embed) {
            if (skeleton) {
              skeleton.classList.remove('hidden', 'opacity-0');
            }
            iframe.src = embed;
            iframe.title = title;
          } else if (external) {
            window.open(external, '_blank');
          }
        } else {
          iframe.removeAttribute('src');
        }
      }

      // Update active pill classes
      trackItems.forEach((btn, i) => {
        const isActive = i === idx;
        btn.classList.toggle('bg-emerald-50', isActive);
        btn.classList.toggle('dark:bg-emerald-950/60', isActive);
        btn.classList.toggle('text-emerald-800', isActive);
        btn.classList.toggle('dark:text-emerald-300', isActive);
        btn.classList.toggle('border-emerald-500/50', isActive);
        btn.classList.toggle('shadow-2xs', isActive);
        btn.classList.toggle('font-bold', isActive);

        btn.classList.toggle('bg-zinc-50', !isActive);
        btn.classList.toggle('dark:bg-zinc-800/60', !isActive);
        btn.classList.toggle('text-zinc-700', !isActive);
        btn.classList.toggle('dark:text-zinc-300', !isActive);
        btn.classList.toggle('border-zinc-200/80', !isActive);
        btn.classList.toggle('dark:border-zinc-700', !isActive);
      });

      // Update counter and buttons
      if (counterBadge) {
        counterBadge.textContent = `Document ${idx + 1} of ${trackItems.length}`;
      }
      if (prevBtn) prevBtn.disabled = idx === 0;
      if (nextBtn) nextBtn.disabled = idx === trackItems.length - 1;

      // Update External Links & Download State
      if (external) {
        if (driveBtn) driveBtn.href = external;
        if (bottomDriveLink) bottomDriveLink.href = external;
      }
      if (downloadBtn) {
        downloadBtn.dataset.docId = docId;
        downloadBtn.dataset.title = title;
        const downloadName = targetBtn.getAttribute('data-download-name') || `${title.replace(/[/\\?%*:|"<>]/g, ' ').trim()}.pdf`;
        downloadBtn.setAttribute('download', downloadName);
        downloadBtn.dataset.downloadName = downloadName;
        syncDownloadBtnState(downloadBtn.dataset.materialId || '', docId, downloadUrl);
      }

      // Scroll active pill into view smoothly
      targetBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }

    trackItems.forEach((btn, idx) => {
      btn.addEventListener('click', () => switchDocument(idx), { signal });
    });

    prevBtn?.addEventListener('click', () => {
      if (activeDocIndex > 0) switchDocument(activeDocIndex - 1);
    }, { signal });

    nextBtn?.addEventListener('click', () => {
      if (activeDocIndex < trackItems.length - 1) switchDocument(activeDocIndex + 1);
    }, { signal });

    // Initial Local Download Button Status Check
    const initMatId = downloadBtn?.dataset.materialId || '';
    const initDocId = downloadBtn?.dataset.docId || '';
    const initDlUrl = downloadBtn?.dataset.downloadUrl || downloadBtn?.getAttribute('href') || null;
    syncDownloadBtnState(initMatId, initDocId, initDlUrl);

    // If offline on initial load, auto-load local copy if available
    if (!navigator.onLine) {
      isMaterialInLocalFolder(initMatId, initDocId).then(async (rec) => {
        if (rec) {
          const handle = await getStoredDirectoryHandle();
          if (handle) {
            const hasPerm = await verifyFolderPermission(handle, false);
            if (hasPerm) {
              const blobUrl = await readLocalFileBlobUrl(handle, rec.relativePath);
              if (blobUrl) {
                openLocalDocument(blobUrl, downloadBtn?.dataset.title || 'Local Document', rec.relativePath);
                const showFn = (window as any).showToast;
                if (typeof showFn === 'function') {
                  showFn({
                    type: 'info',
                    message: 'Offline mode: loaded local document from Study Folder',
                    duration: 3500
                  });
                }
              }
            }
          }
        }
      });
    }

    // Re-sync UI state for studied and bookmarks
    renderBookmarkButtons();
    updateStudiedCardUI();
  }

  initDocumentViewer();
  document.addEventListener('astro:after-swap', initDocumentViewer);
</script>
