---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/search/SearchBar.astro';
import GroupedResourceList from '../components/materials/GroupedResourceList.astro';
import { getAllMaterials } from '../data/materials';
import { getModulesByYear } from '../data/modules';

const allMaterials = getAllMaterials();
const recentMaterials = allMaterials.slice(0, 6);

const yearData = [
  { year: 1, titleAr: 'السنة الأولى', titleEn: 'Year 1', desc: 'قريباً' },
  { year: 2, titleAr: 'السنة الثانية', titleEn: 'Year 2', desc: 'Blood & Lymphatic System (MED201)' },
  { year: 3, titleAr: 'السنة الثالثة', titleEn: 'Year 3', desc: 'قريباً' },
  { year: 4, titleAr: 'السنة الرابعة', titleEn: 'Year 4', desc: 'قريباً' },
  { year: 5, titleAr: 'السنة الخامسة', titleEn: 'Year 5', desc: 'قريباً' }
];
---

<Layout>
  <!-- Welcome & Personalized Banner -->
  <section class="mb-8">
    <!-- Active Year Personalized Alert (Shown via client script when user has chosen a year) -->
    <div
      id="user-year-welcome-card"
      class="mb-6 p-4 rounded-2xl bg-emerald-50/80 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/50 hidden flex-col sm:flex-row items-start sm:items-center justify-between gap-3"
    >
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-bold text-base shadow-xs shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
          </svg>
        </div>
        <div>
          <h2 class="text-sm font-bold text-zinc-900 dark:text-zinc-100">
            <span data-i18n="home.welcomeTitle">Welcome! Your Selected Year:</span> <span id="welcome-year-name" class="text-emerald-700 dark:text-emerald-400 font-extrabold">Year 1</span>
          </h2>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-0.5" data-i18n="home.welcomeDesc">
            The site is configured to your year for direct access to your modules and drives.
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <a
          id="welcome-year-link"
          href="/year/1"
          class="text-xs font-bold px-3.5 py-1.5 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 transition-colors shadow-2xs"
        >
          <span data-i18n="home.openYearModules">Open Year Modules →</span>
        </a>
        <button
          type="button"
          class="trigger-multistage-selector text-xs font-semibold px-3 py-1.5 rounded-lg bg-white dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 hover:bg-zinc-100 transition-colors cursor-pointer"
        >
          <span data-i18n="home.change">Change</span>
        </button>
      </div>
    </div>

    <div class="mb-4">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50 mb-1.5" data-i18n="home.heroTitle">
        ASU Faculty of Medicine Materials Hub
      </h1>
      <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400" data-i18n="home.heroSubtitle">
        Batch drives, Telegram channels, YouTube lectures, and study notes across all five years.
      </p>
    </div>

    <!-- Quick Search Form -->
    <form action="/search" method="GET" class="w-full">
      <SearchBar />
    </form>

    <!-- Quick Access Chips -->
    <div class="flex items-center gap-2 mt-3 overflow-x-auto no-scrollbar">
      <a
        href="/playlists"
        class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-xl bg-red-50 text-red-700 dark:bg-red-950/50 dark:text-red-300 border border-red-200 dark:border-red-900/50 hover:bg-red-100 dark:hover:bg-red-900/40 transition-colors shadow-2xs shrink-0"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <span data-i18n="playlists.title">Playlists</span>
      </a>
      <a
        href="/module/year2-blood"
        class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 hover:bg-zinc-200/70 transition-colors shrink-0"
      >
        <span>Blood & Lymphatic System (MED201)</span>
      </a>
      <a
        href="/search?type=drive"
        class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 hover:bg-zinc-200/70 transition-colors shrink-0"
      >
        <span data-i18n="categories.central">Central Drives</span>
      </a>
    </div>
  </section>

  <!-- Academic Year Quick Navigator -->
  <section class="mb-10">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2">
        <h2 class="text-base font-bold text-zinc-900 dark:text-zinc-100" data-i18n="home.academicYears">
          Academic Years
        </h2>
        <button
          type="button"
          class="trigger-multistage-selector text-xs text-emerald-600 hover:underline font-semibold cursor-pointer"
        >
          (<span data-i18n="nav.chooseYear">Choose Year</span>)
        </button>
      </div>

      <a href="/search" class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">
        <span data-i18n="home.browseAll">Browse All Materials</span> &rarr;
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      {yearData.map((y) => {
        const moduleCount = getModulesByYear(y.year).length;
        return (
          <a
            href={`/year/${y.year}`}
            class="group bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 rounded-xl p-4 transition-all hover:border-emerald-500/70 hover:shadow-sm shadow-2xs flex flex-col justify-between text-start active:scale-[0.99]"
          >
            <div>
              <span class="text-xs font-extrabold text-emerald-600 dark:text-emerald-400">
                Level {y.year}
              </span>
              <h3
                class="font-bold text-sm text-zinc-900 dark:text-zinc-100 mt-0.5 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors"
                data-i18n="nav.year"
                data-i18n-params={JSON.stringify({ y: y.year })}
              >
                {y.titleEn}
              </h3>
              <p class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-1 line-clamp-2">
                {y.desc}
              </p>
            </div>
            <div class="mt-3 pt-2 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between text-[11px] text-zinc-400">
              <span data-i18n="year.modulesCount" data-i18n-params={JSON.stringify({ n: moduleCount })}>
                {moduleCount} Study Modules
              </span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 rtl:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Grouped Latest Materials -->
  {recentMaterials.length > 0 && (
    <section>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-base font-bold text-zinc-900 dark:text-zinc-100" data-i18n="home.recentMaterials">
          Recently Added Materials
        </h2>
        <a href="/search" class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">
          <span data-i18n="footer.searchCatalog">Search Catalog</span> &rarr;
        </a>
      </div>

      <GroupedResourceList materials={recentMaterials} showYear={true} />
    </section>
  )}
</Layout>

<script>
  function syncPersonalizedWelcome(): void {
    const card = document.getElementById('user-year-welcome-card');
    const yearName = document.getElementById('welcome-year-name');
    const yearLink = document.getElementById('welcome-year-link') as HTMLAnchorElement | null;

    try {
      const yearStr = localStorage.getItem('asumed_user_year');
      if (yearStr) {
        const y = parseInt(yearStr, 10);
        const isAr = document.documentElement.lang === 'ar';
        const namesAr: Record<number, string> = {
          1: 'السنة الأولى (Year 1)',
          2: 'السنة الثانية (Year 2)',
          3: 'السنة الثالثة (Year 3)',
          4: 'السنة الرابعة (Year 4)',
          5: 'السنة الخامسة (Year 5)'
        };
        const namesEn: Record<number, string> = {
          1: 'Year 1',
          2: 'Year 2',
          3: 'Year 3',
          4: 'Year 4',
          5: 'Year 5'
        };
        if (yearName) yearName.textContent = isAr ? (namesAr[y] || `السنة ${y}`) : (namesEn[y] || `Year ${y}`);
        if (yearLink) yearLink.href = `/year/${y}`;
        card?.classList.remove('hidden');
        card?.classList.add('flex');
      } else {
        card?.classList.add('hidden');
        card?.classList.remove('flex');
      }
    } catch {}
  }

  syncPersonalizedWelcome();
  window.addEventListener('user-preferences-updated', syncPersonalizedWelcome);
  window.addEventListener('asumed-language-changed', syncPersonalizedWelcome);
  document.addEventListener('astro:after-swap', syncPersonalizedWelcome);
</script>
