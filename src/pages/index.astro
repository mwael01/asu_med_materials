---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/search/SearchBar.astro';
import ModuleSubjectsGrid from '../components/materials/ModuleSubjectsGrid.astro';
import ModuleSavedShelf from '../components/materials/ModuleSavedShelf.astro';
import FeaturedCollections from '../components/materials/FeaturedCollections.astro';
import { getAllMaterials } from '../data/materials';
import { getAllModules } from '../data/modules';
import { getAllCollections } from '../data/collections';
import type { ModuleInfo } from '../types/materials';

const [allMaterials, allModules, allCollections] = await Promise.all([
  getAllMaterials(),
  getAllModules(),
  getAllCollections()
]);

// Separate curriculum modules from reference book modules
const curriculumModules = allModules.filter((m) => !m.id.includes('reference-books'));

// Group curriculum modules by academic year
const modulesByYear: Record<number, ModuleInfo[]> = { 1: [], 2: [], 3: [], 4: [], 5: [] };
for (const mod of curriculumModules) {
  if (modulesByYear[mod.year]) {
    modulesByYear[mod.year].push(mod);
  }
}
---

<Layout>
  <!-- Hero & Search Section -->
  <section class="mb-8">
    <div class="mb-4">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50 mb-1.5">
        ASU Faculty of Medicine Materials Hub
      </h1>
      <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">
        Batch drives, Telegram channels, YouTube lectures, and study notes across all five years.
      </p>
    </div>

    <!-- Search Form -->
    <form action="/search" method="GET" class="w-full">
      <SearchBar size="lg" />
    </form>
  </section>

  <!-- Active Module Hub (Student Module Subjects & Module Bookmarked Materials) -->
  <section class="mb-12" id="home-active-module-hub-section">
    <!-- Render Hub for each registered curriculum module -->
    {curriculumModules.map((mod) => {
      const modMaterials = allMaterials.filter((m) => m.moduleId === mod.id);
      const yearModules = modulesByYear[mod.year] || [];
      const hasMultipleYearModules = yearModules.length > 1;

      return (
        <div
          data-module-hub-id={mod.id}
          data-module-hub-year={mod.year}
          class:list={['home-module-hub space-y-8', (mod.year !== 2 || mod.id !== 'year2-blood') && 'hidden']}
        >
          <!-- Active Module Header Banner -->
          <div class="bg-white dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 rounded-2xl p-5 sm:p-6 text-start shadow-2xs">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
              <div class="flex items-center gap-2">
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
                  Year {mod.year}
                </span>
                <button
                  type="button"
                  class="trigger-multistage-selector text-xs text-emerald-600 dark:text-emerald-400 hover:underline font-semibold cursor-pointer"
                >
                  Change Year
                </button>
              </div>

              <a
                href={`/module/${mod.id}`}
                class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline inline-flex items-center gap-1"
              >
                <span>All {mod.title} Resources</span> ({modMaterials.length})
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>

            <h2 class="text-xl sm:text-2xl font-extrabold text-zinc-900 dark:text-zinc-100 mb-1">
              {mod.title}
            </h2>
            {mod.description && (
              <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 line-clamp-2 max-w-2xl leading-relaxed">
                {mod.description}
              </p>
            )}

            {/* Quick Module Switcher (if current academic year has multiple curriculum modules) */}
            {hasMultipleYearModules && (
              <div class="flex items-center gap-2 mt-4 pt-3.5 border-t border-zinc-100 dark:border-zinc-800/80 overflow-x-auto no-scrollbar">
                <span class="text-xs font-semibold text-zinc-400 dark:text-zinc-500 whitespace-nowrap">
                  Year {mod.year} Modules:
                </span>
                {yearModules.map((sibling) => (
                  <button
                    type="button"
                    data-module-switch-id={sibling.id}
                    class:list={[
                      'module-pill-btn px-3 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer whitespace-nowrap border',
                      sibling.id === mod.id
                        ? 'bg-zinc-900 text-white border-zinc-900 dark:bg-zinc-100 dark:text-zinc-900 dark:border-zinc-100 shadow-2xs'
                        : 'bg-white dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-800 hover:border-zinc-300'
                    ]}
                  >
                    {sibling.title}
                  </button>
                ))}
              </div>
            )}
          </div>

          <!-- 1. Direct Module Subjects View -->
          <ModuleSubjectsGrid
            module={mod}
            materials={modMaterials}
          />

          <!-- 2. Direct Module Bookmarked Materials Shelf -->
          <ModuleSavedShelf
            module={mod}
            materials={modMaterials}
          />
        </div>
      );
    })}

    <!-- Fallback when selected academic year has no active curriculum modules registered -->
    <div
      id="no-curriculum-modules-placeholder"
      class="hidden py-10 text-center border border-dashed border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 bg-white dark:bg-zinc-900/60"
    >
      <div class="w-12 h-12 mx-auto rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-3">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
        </svg>
      </div>
      <h3 class="text-sm font-bold text-zinc-800 dark:text-zinc-200 mb-1">
        No active curriculum modules for Year <span class="placeholder-year-num"></span> yet
      </h3>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-4 max-w-sm mx-auto leading-relaxed">
        Blood &amp; Lymphatic System (Year 2) and Introduction to Medicine (Year 1) are currently active.
      </p>
      <div class="flex items-center justify-center gap-2">
        <button
          type="button"
          class="btn-switch-to-year2 px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-700 transition-colors cursor-pointer shadow-2xs"
        >
          Switch to Year 2
        </button>
        <button
          type="button"
          class="trigger-multistage-selector px-4 py-2 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-xs font-bold hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors cursor-pointer"
        >
          Change Year
        </button>
      </div>
    </div>
  </section>

  <!-- Zero-Flash Early Pre-Paint Hub Setter -->
  <script is:inline>
    (function () {
      try {
        var y = parseInt(localStorage.getItem('asumed_user_year') || '2', 10);
        var storedMod = localStorage.getItem('asumed_user_module');
        var hubs = document.querySelectorAll('.home-module-hub');

        var candidates = [];
        hubs.forEach(function (hub) {
          var hubYear = parseInt(hub.getAttribute('data-module-hub-year') || '0', 10);
          if (hubYear === y) {
            candidates.push(hub);
          }
        });

        if (candidates.length > 0) {
          var targetHub = candidates[0];
          if (storedMod) {
            var found = candidates.find(function (c) {
              return c.getAttribute('data-module-hub-id') === storedMod;
            });
            if (found) targetHub = found;
          }

          hubs.forEach(function (hub) {
            if (hub === targetHub) {
              hub.classList.remove('hidden');
            } else {
              hub.classList.add('hidden');
            }
          });
        } else {
          hubs.forEach(function (hub) {
            hub.classList.add('hidden');
          });
          var placeholder = document.getElementById('no-curriculum-modules-placeholder');
          if (placeholder) {
            placeholder.classList.remove('hidden');
            var span = placeholder.querySelector('.placeholder-year-num');
            if (span) span.textContent = String(y);
          }
        }
      } catch (e) {}
    })();
  </script>

  <!-- Featured Collections Section -->
  <FeaturedCollections collections={allCollections} />

  <!-- Reference Books & Other Years Section -->
  <section class="border-t border-zinc-200/80 dark:border-zinc-800 pt-8 mt-12 mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
      <div>
        <h3 class="text-sm sm:text-base font-bold text-zinc-900 dark:text-zinc-100">
          Reference Books &amp; Other Academic Years
        </h3>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">
          Access core textbooks, atlases, and modules across all five years
        </p>
      </div>

      <a
        href="/search"
        class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline inline-flex items-center gap-1"
      >
        <span>Browse All Resources</span> &rarr;
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      {[1, 2, 3, 4, 5].map((y) => (
        <a
          href={`/year/${y}`}
          class="p-3.5 rounded-xl border border-zinc-200/90 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:border-emerald-500/80 hover:shadow-2xs text-start transition-all group"
        >
          <span class="text-xs font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors block">
            Year {y}
          </span>
          <span class="text-[11px] text-zinc-400 dark:text-zinc-500 block mt-0.5">
            Modules &amp; Books &rarr;
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>

<script>
  import {
    getUserStoredYear,
    setUserStoredYear,
    getUserStoredModule,
    setUserStoredModule,
    getStoredBookmarkIds,
    getStoredStudiedIds
  } from '../utils/storage';
  import { getCachedUserProfile, onAuthChange } from '../firebase/auth';

  let unsubscribeAuth: (() => void) | null = null;
  let homeAbortController: AbortController | null = null;
  let hideCompleted = true; // default: hide completed materials

  function initHomePage(): void {
    if (homeAbortController) {
      homeAbortController.abort();
    }
    homeAbortController = new AbortController();
    const { signal } = homeAbortController;

    const allHubs = document.querySelectorAll<HTMLElement>('.home-module-hub');
    const noModulesPlaceholder = document.getElementById('no-curriculum-modules-placeholder');
    const placeholderYearSpan = document.querySelector<HTMLElement>('.placeholder-year-num');
    const switchToYear2Btns = document.querySelectorAll('.btn-switch-to-year2');
    const featuredSection = document.getElementById('home-featured-collections-section');
    const featuredWrappers = document.querySelectorAll<HTMLElement>('.home-featured-collections-wrapper');

    function syncHubView(): void {
      const year = getUserStoredYear() || 2;
      const storedModuleId = getUserStoredModule();

      // Filter hubs for current year
      const matchingHubs: HTMLElement[] = [];
      allHubs.forEach((hub) => {
        const hubYear = parseInt(hub.getAttribute('data-module-hub-year') || '0', 10);
        if (hubYear === year) {
          matchingHubs.push(hub);
        }
      });

      if (matchingHubs.length > 0) {
        noModulesPlaceholder?.classList.add('hidden');

        // Pick matching hub or fallback to first
        let activeHub = matchingHubs[0];
        if (storedModuleId) {
          const found = matchingHubs.find(
            (h) => h.getAttribute('data-module-hub-id') === storedModuleId
          );
          if (found) activeHub = found;
        }

        const activeModuleId = activeHub.getAttribute('data-module-hub-id') || '';
        setUserStoredModule(activeModuleId);

        allHubs.forEach((hub) => {
          hub.classList.toggle('hidden', hub !== activeHub);
        });

        // Update module switcher pills inside activeHub
        activeHub.querySelectorAll<HTMLButtonElement>('[data-module-switch-id]').forEach((btn) => {
          const mId = btn.getAttribute('data-module-switch-id');
          const isSelected = mId === activeModuleId;
          if (isSelected) {
            btn.className =
              'module-pill-btn px-3 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer whitespace-nowrap border bg-zinc-900 text-white border-zinc-900 dark:bg-zinc-100 dark:text-zinc-900 dark:border-zinc-100 shadow-2xs';
          } else {
            btn.className =
              'module-pill-btn px-3 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer whitespace-nowrap border bg-white dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-800 hover:border-zinc-300';
          }
        });

        // Render saved shelf for this active module
        renderModuleSavedShelf(activeHub, activeModuleId);
      } else {
        // No curriculum modules for this year
        allHubs.forEach((hub) => hub.classList.add('hidden'));
        if (noModulesPlaceholder) {
          noModulesPlaceholder.classList.remove('hidden');
          if (placeholderYearSpan) placeholderYearSpan.textContent = String(year);
        }
      }

      // Sync Featured Collections for current year
      let featuredMatchCount = 0;
      featuredWrappers.forEach((el) => {
        const featYear = parseInt(el.getAttribute('data-featured-collections-year') || '0', 10);
        if (featYear === year) {
          if (el.getAttribute('data-has-items') === 'true') {
            el.classList.remove('hidden');
            featuredMatchCount++;
          } else {
            el.classList.add('hidden');
          }
        } else {
          el.classList.add('hidden');
        }
      });

      if (featuredSection) {
        featuredSection.classList.toggle('hidden', featuredMatchCount === 0);
      }
    }

    function renderModuleSavedShelf(activeHub: HTMLElement, moduleId: string): void {
      const shelf = activeHub.querySelector<HTMLElement>(`.module-saved-shelf[data-saved-shelf-module="${moduleId}"]`);
      if (!shelf) return;

      const bookmarks = getStoredBookmarkIds();
      const studiedIds = getStoredStudiedIds();

      const cardWrappers = shelf.querySelectorAll<HTMLElement>('.module-saved-card-wrapper');
      const emptyState = shelf.querySelector<HTMLElement>('.module-saved-empty');
      const filterEmptyState = shelf.querySelector<HTMLElement>('.module-saved-filter-empty');
      const countBadge = shelf.querySelector<HTMLElement>('.module-saved-count');
      const toggleBtn = shelf.querySelector<HTMLButtonElement>('.shelf-completed-toggle');
      const toggleDot = shelf.querySelector<HTMLElement>('.shelf-toggle-dot');
      const toggleText = shelf.querySelector<HTMLElement>('.shelf-toggle-text');

      let savedTotal = 0;
      let visibleTotal = 0;
      let completedInModule = 0;

      cardWrappers.forEach((wrapper) => {
        const cardId = wrapper.getAttribute('data-saved-card-id') || '';
        const isBookmarked = bookmarks.includes(cardId);
        const isStudied = studiedIds.includes(cardId);

        if (isBookmarked) {
          savedTotal++;
          if (isStudied) completedInModule++;

          const isVisible = !hideCompleted || !isStudied;
          wrapper.classList.toggle('hidden', !isVisible);
          if (isVisible) visibleTotal++;
        } else {
          wrapper.classList.add('hidden');
        }
      });

      if (countBadge) {
        countBadge.textContent = String(savedTotal);
      }

      if (toggleBtn) {
        toggleBtn.setAttribute('aria-pressed', hideCompleted ? 'true' : 'false');
        if (hideCompleted) {
          toggleBtn.className =
            'shelf-completed-toggle inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg border transition-all cursor-pointer bg-emerald-50 text-emerald-700 border-emerald-200/80 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800/60';
          if (toggleDot) toggleDot.className = 'shelf-toggle-dot w-1.5 h-1.5 rounded-full bg-emerald-500';
          if (toggleText) toggleText.textContent = 'Hide Completed';
        } else {
          toggleBtn.className =
            'shelf-completed-toggle inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg border transition-all cursor-pointer bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 border-zinc-200/80 dark:border-zinc-800 hover:border-zinc-300';
          if (toggleDot) toggleDot.className = 'shelf-toggle-dot w-1.5 h-1.5 rounded-full bg-zinc-400';
          if (toggleText) toggleText.textContent = `Show Completed (${completedInModule})`;
        }
      }

      if (emptyState) {
        emptyState.classList.toggle('hidden', savedTotal > 0);
      }

      if (filterEmptyState) {
        filterEmptyState.classList.toggle('hidden', savedTotal === 0 || visibleTotal > 0);
      }
    }

    // Module Switcher Pills inside hubs
    document.querySelectorAll<HTMLButtonElement>('[data-module-switch-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const modId = btn.getAttribute('data-module-switch-id');
        if (modId) {
          setUserStoredModule(modId);
          syncHubView();
        }
      }, { signal });
    });

    // Completed filter toggles
    document.querySelectorAll<HTMLButtonElement>('.shelf-completed-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        hideCompleted = !hideCompleted;
        syncHubView();
      }, { signal });
    });

    // Switch to Year 2 button
    switchToYear2Btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        setUserStoredYear(2);
        setUserStoredModule('year2-blood');
        syncHubView();
      }, { signal });
    });

    // Auth sync
    function syncAuthYear(): void {
      const profile = getCachedUserProfile();
      if (profile?.academicYear && !localStorage.getItem('asumed_user_year')) {
        setUserStoredYear(profile.academicYear);
        syncHubView();
      }
    }

    syncAuthYear();
    syncHubView();

    if (unsubscribeAuth) unsubscribeAuth();
    unsubscribeAuth = onAuthChange(() => {
      syncAuthYear();
      syncHubView();
    });

    window.addEventListener('user-preferences-updated', syncHubView, { signal });
    window.addEventListener('bookmarks-updated', syncHubView, { signal });
    window.addEventListener('studied-updated', syncHubView, { signal });
  }

  initHomePage();
  document.addEventListener('astro:after-swap', initHomePage);
</script>
