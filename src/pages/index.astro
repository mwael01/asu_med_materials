---
import Layout from '../layouts/Layout.astro';
import { getAllModules } from '../data/modules';

const shouldRedirect = Astro.url.searchParams.get('redirect') !== 'false';
const modules = await getAllModules();

---

<Layout
  title="ASU Med - Ain Shams University Faculty of Medicine Study Hub"
  description="All-in-one medical study hub for Ain Shams University Faculty of Medicine (ASU Med). Access curriculum modules, doctor lectures, YouTube playlists, PDFs, flashcards, and practical images across Years 1 to 5."
  keywords={['ASU Med', 'asumedmaterials', 'Ain Shams Medicine', 'Ain Shams University Faculty of Medicine', 'طب عين شمس', 'محاضرات طب عين شمس']}
>
  <section data-home-year-redirect data-auto-redirect={String(shouldRedirect)} class="mx-auto max-w-sm py-10 text-center">
    <h1 class="text-2xl font-bold tracking-tight">Your study materials</h1>
    <button type="button" class="trigger-multistage-selector mt-5 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-500 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500">Choose your year</button>
    <nav aria-label="Browse academic years" class="mt-6 flex flex-wrap justify-center gap-x-5 gap-y-3 text-sm">
      {[1, 2, 3, 4, 5].map(year => <a href={`/year/${year}`} class="text-zinc-600 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:underline">Year {year}</a>)}
    </nav>
    <p class="mt-6 text-sm">
      <a href="/modules" id="direct-active-link" class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
        Open my modules
      </a>
    </p>
  </section>

  <nav class="sr-only" aria-label="Curriculum directory">
    <h2>Academic Years</h2>
    <ul>
      {[1, 2, 3, 4, 5].map((y) => (
        <li><a href={`/year/${y}`}>Year {y} Medical Curriculum Modules</a></li>
      ))}
      <li><a href="/modules">All Modules</a></li>
      <li><a href="/search">Search Study Materials</a></li>
    </ul>
    <h2>Modules</h2>
    <ul>
      {modules.map((mod) => (
        <li>
          <a href={`/module/${mod.id}`}>{mod.title} (Year {mod.year})</a>
        </li>
      ))}
    </ul>
  </nav>

  <script>
    import { initHomeYearRedirect } from '../scripts/navigation/homeYearRedirect';
    initHomeYearRedirect();
    document.addEventListener('astro:page-load', initHomeYearRedirect);
  </script>
</Layout>
