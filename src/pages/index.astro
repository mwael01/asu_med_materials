---
import Layout from '../layouts/Layout.astro';
import ModuleDirectory from '../components/materials/ModuleDirectory.astro';
import SavedYearScope from '../components/materials/SavedYearScope.astro';
import { getAllModules } from '../data/modules';
const modules = await getAllModules();
---
<Layout title="My modules - mediX">
  <section data-saved-year-scope>
    <div class="flex items-center justify-between gap-4 mb-6">
      <h1 class="text-xl font-bold">My modules <span data-year-label class="text-sm font-normal text-zinc-500 ml-2"></span></h1>
      <button type="button" class="trigger-multistage-selector text-sm text-emerald-600 hover:underline">Change year</button>
    </div>
    {[1,2,3,4,5].map(year => <div data-scope-year={year} hidden><ModuleDirectory modules={modules.filter(module => module.year === year)} /></div>)}
    <p data-year-empty class="text-sm text-zinc-500">Choose your year to continue.</p>
  </section>
  <SavedYearScope />
</Layout>
