---
import Layout from '../../layouts/Layout.astro';
import ResourceGrid from '../../components/materials/ResourceGrid.astro';
import { getCollectionById } from '../../data/collections';
import { getModuleById } from '../../data/modules';

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/404');
}

const collection = await getCollectionById(id);
if (!collection) {
  return Astro.redirect('/404');
}

const moduleInfo = collection.moduleId ? await getModuleById(collection.moduleId) : undefined;
const pageTitle = `${collection.titleEn || collection.title} - ASU Med Materials`;
const pageDesc = collection.descriptionEn || collection.description || 'مجموعة دراسية منسقة لمواد كلية الطب جامعة عين شمس.';

const categoryBadgeClasses: Record<string, string> = {
  practical: 'bg-blue-100 text-blue-800 dark:bg-blue-950/80 dark:text-blue-300 border-blue-200 dark:border-blue-900/60',
  finals: 'bg-rose-100 text-rose-800 dark:bg-rose-950/80 dark:text-rose-300 border-rose-200 dark:border-rose-900/60',
  midterm: 'bg-amber-100 text-amber-800 dark:bg-amber-950/80 dark:text-amber-300 border-amber-200 dark:border-amber-900/60',
  revision: 'bg-purple-100 text-purple-800 dark:bg-purple-950/80 dark:text-purple-300 border-purple-200 dark:border-purple-900/60',
  general: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border-emerald-200 dark:border-emerald-900/60'
};

const badgeClass = categoryBadgeClasses[collection.category] || categoryBadgeClasses.general;
---

<Layout title={pageTitle} description={pageDesc}>
  <div class="max-w-6xl mx-auto space-y-6">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400 overflow-x-auto no-scrollbar py-1" aria-label="Breadcrumb navigation">
      <a href="/?redirect=false" data-i18n="nav.home" class="hover:text-emerald-600 dark:hover:text-emerald-400 whitespace-nowrap">الرئيسية</a>
      <span>/</span>
      <a
        href={`/?year=${collection.year}`}
        class="hover:text-emerald-600 dark:hover:text-emerald-400 whitespace-nowrap"
        data-i18n="nav.year"
        data-i18n-params={JSON.stringify({ y: collection.year })}
      >
        السنة {collection.year}
      </a>
      {moduleInfo && (
        <>
          <span>/</span>
          <a
            href={`/module/${moduleInfo.id}`}
            class="hover:text-emerald-600 dark:hover:text-emerald-400 whitespace-nowrap"
            data-i18n-mod-title-en={moduleInfo.title}
            data-i18n-mod-title-ar={moduleInfo.titleAr || moduleInfo.title}
          >
            {moduleInfo.titleAr || moduleInfo.title}
          </a>
        </>
      )}
      {collection.parent && (
        <>
          <span>/</span>
          <a
            href={`/collection/${collection.parent.id}`}
            class="hover:text-emerald-600 dark:hover:text-emerald-400 whitespace-nowrap font-medium"
            data-title-ar={collection.parent.title}
            data-title-en={collection.parent.titleEn || collection.parent.title}
          >
            {collection.parent.title}
          </a>
        </>
      )}
      <span>/</span>
      <span
        class="text-zinc-900 dark:text-zinc-100 font-bold truncate max-w-[200px] sm:max-w-xs"
        data-title-ar={collection.title}
        data-title-en={collection.titleEn || collection.title}
      >
        {collection.title}
      </span>
    </nav>

    <!-- Collection Header Card -->
    <header class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs" data-collection-id={collection.id}>
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-4">
        <div class="space-y-2.5">
          <!-- Metadata Badges -->
          <div class="flex items-center gap-2 flex-wrap">
            <span
              class:list={[
                'inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1 rounded-xl border',
                badgeClass
              ]}
              data-i18n={`collections.categories.${collection.category}`}
            >
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              <span>{collection.category}</span>
            </span>

            <span
              class="text-xs font-semibold px-3 py-1 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400"
              data-i18n="nav.year"
              data-i18n-params={JSON.stringify({ y: collection.year })}
            >
              السنة {collection.year}
            </span>

            {collection.parent && (
              <a
                href={`/collection/${collection.parent.id}`}
                class="text-xs font-semibold px-3 py-1 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 hover:underline inline-flex items-center gap-1"
              >
                <span>↳</span>
                <span data-i18n="collections.parentGroup">المجموعة الرئيسية</span>:
                <span>{collection.parent.title}</span>
              </a>
            )}

            {moduleInfo && (
              <a
                href={`/module/${moduleInfo.id}`}
                class="text-xs font-semibold px-3 py-1 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 hover:underline"
              >
                {moduleInfo.titleAr || moduleInfo.title}
              </a>
            )}

            {collection.subcollections && collection.subcollections.length > 0 ? (
              <>
                <span
                  class="text-xs font-semibold px-3 py-1 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300"
                  data-i18n="collections.subgroupsCount"
                  data-i18n-params={JSON.stringify({ n: collection.subcollections.length })}
                >
                  {collection.subcollections.length} مجموعات فرعية
                </span>
                <span
                  class="text-xs font-semibold px-3 py-1 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400"
                  data-i18n="collections.materialCount"
                  data-i18n-params={JSON.stringify({ count: collection.totalMaterialsCount ?? collection.materials.length })}
                >
                  {collection.totalMaterialsCount ?? collection.materials.length} مصدر
                </span>
              </>
            ) : (
              <span
                class="text-xs font-semibold px-3 py-1 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400"
                data-i18n="collections.materialCount"
                data-i18n-params={JSON.stringify({ count: collection.materials.length })}
              >
                {collection.materials.length} مصدر
              </span>
            )}
          </div>

          <!-- Collection Title -->
          <h1
            class="text-xl sm:text-2xl font-black text-zinc-900 dark:text-zinc-100 leading-tight"
            data-title-ar={collection.title}
            data-title-en={collection.titleEn || collection.title}
          >
            {collection.title}
          </h1>

          <!-- Collection Description -->
          {collection.description && (
            <p
              class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-3xl"
              data-desc-ar={collection.description}
              data-desc-en={collection.descriptionEn || collection.description}
            >
              {collection.description}
            </p>
          )}
        </div>

        <!-- Standard Bookmark Button -->
        <div class="shrink-0 flex items-center">
          <button
            type="button"
            class="bookmark-btn inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/80 hover:bg-amber-50/70 dark:hover:bg-amber-950/40 text-zinc-700 dark:text-zinc-200 hover:text-amber-600 dark:hover:text-amber-400 font-semibold text-xs transition-all shadow-2xs cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500"
            data-id={collection.id}
            data-i18n-attr="title:card.save,aria-label:card.save"
            title="Save to bookmarks"
            aria-label="Save to bookmarks"
          >
            <svg class="w-4.5 h-4.5 bookmark-icon-empty shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
            </svg>
            <svg class="w-4.5 h-4.5 bookmark-icon-filled hidden shrink-0 text-amber-500 fill-amber-500 drop-shadow-2xs" viewBox="0 0 24 24">
              <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
            </svg>
            <span class="text-xs font-semibold" data-i18n="collections.bookmarkCollection">حفظ المجموعة</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Direct Materials Section (if any direct materials exist) -->
    {collection.materials.length > 0 && (
      <section class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <span data-i18n={collection.subcollections && collection.subcollections.length > 0 ? "collections.directMaterialsTitle" : "collections.includedMaterials"}>
              {collection.subcollections && collection.subcollections.length > 0 ? 'المصادر العامة' : 'المصادر المتضمنة في المجموعة'}
            </span>
          </h2>
        </div>

        <ResourceGrid materials={collection.materials} showYear={false} />
      </section>
    )}

    <!-- Nested Subgroups / Doctor Series Section -->
    {collection.subcollections && collection.subcollections.length > 0 && (
      <section class="space-y-8 pt-4">
        <div class="pb-2 border-b-2 border-emerald-500/30">
          <h2 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-2" data-i18n="collections.subgroupsTitle">
            الأقسام والمجموعات الفرعية
          </h2>
        </div>

        <div class="space-y-8">
          {collection.subcollections.map((sub) => (
            <div class="space-y-3.5 p-4 sm:p-5 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2.5 border-b border-zinc-200/60 dark:border-zinc-800">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span>
                  <div>
                    <h3 class="text-sm sm:text-base font-bold text-zinc-900 dark:text-zinc-100">
                      <a href={`/collection/${sub.id}`} class="hover:text-emerald-600 dark:hover:text-emerald-400 hover:underline">
                        {sub.title}
                      </a>
                    </h3>
                    {sub.description && (
                      <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">{sub.description}</p>
                    )}
                  </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  <span class="text-xs font-semibold px-2.5 py-0.5 rounded-md bg-zinc-200/70 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                    {sub.materials.length} مصدر
                  </span>
                  <a href={`/collection/${sub.id}`} class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline inline-flex items-center gap-1">
                    <span data-i18n="collections.viewCollection">عرض الحزمة</span> &rarr;
                  </a>
                </div>
              </div>

              <ResourceGrid materials={sub.materials} showYear={false} />
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
