---
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/common/PageHeading.astro';
import ModuleDirectory from '../../components/materials/ModuleDirectory.astro';
import type { NavCrumb } from '../../types/navigation';
import { getModulesByYear } from '../../data/modules';
import { buildYearSeo } from '../../utils/seo';

const year = Number(Astro.params.year);
if (![1, 2, 3, 4, 5].includes(year)) return Astro.redirect('/404');
const modules = await getModulesByYear(year);
const seo = buildYearSeo(year, modules);

const yearMenu = ([1, 2, 3, 4, 5] as const).map(y => ({
  title: `Year ${y}`,
  href: `/year/${y}`,
  active: y === year
}));

const crumbs: NavCrumb[] = [
  {
    title: `Year ${year}`,
    isYear: true,
    year: year,
    menu: yearMenu
  },
  {
    title: 'Modules',
    isModule: true,
    year: year
  }
];
---
<Layout title={seo.title} description={seo.description} keywords={seo.keywords} crumbs={crumbs} backHref="/">
  <PageHeading title={`Year ${year}`} />
  <ModuleDirectory modules={modules} />
</Layout>
