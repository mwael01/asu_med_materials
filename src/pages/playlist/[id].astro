---
import Layout from '../../layouts/Layout.astro';
import type { NavCrumb } from '../../types/navigation';
import TypeBadge from '../../components/materials/TypeBadge.astro';
import { getPlaylistById } from '../../data/materials';
import { getModuleById } from '../../data/modules';
import { getMaterialsVersionFromFirestore } from '../../firebase/firestore';
import { subjectToSlug } from '../../utils/slug';
import {
  parseVideoSource,
  determinePrimaryPlaylistSource,
  getVideoDownloadUrl,
  type ParsedVideoSource
} from '../../utils/videoSources';

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/?redirect=false');
}

const version = await getMaterialsVersionFromFirestore();
const playlist = await getPlaylistById(id, version);
if (!playlist) {
  return Astro.redirect('/?redirect=false');
}

const moduleInfo = playlist.moduleId ? await getModuleById(playlist.moduleId, version) : undefined;

const titleEn = playlist.titleEn || playlist.title;
const descEn = playlist.descriptionEn || playlist.description;

// Authors list normalization (who prepared the material)
const rawAuthors = Array.isArray(playlist.author)
  ? playlist.author
  : playlist.author
    ? [playlist.author]
    : [];
const authorText = rawAuthors.join('، ');

// Discrete videos setup
const hasDiscreteVideos = Boolean(playlist.videos && playlist.videos.length > 0);
const videos = playlist.videos || [];

// Parse all video items with multi-source video resolver
const parsedVideos: ParsedVideoSource[] = videos.map((v) =>
  parseVideoSource(v.url, v.youtubeId, v.sourceType)
);

// Determine initial video playback state
let initialParsed: ParsedVideoSource;
if (hasDiscreteVideos) {
  initialParsed = parsedVideos[0];
} else if (playlist.playlistId) {
  initialParsed = {
    sourceType: 'youtube',
    embedType: 'iframe',
    embedUrl: `https://www.youtube-nocookie.com/embed/videoseries?list=${playlist.playlistId}&rel=0&enablejsapi=1&playsinline=1`,
    externalUrl: `https://www.youtube.com/playlist?list=${playlist.playlistId}`,
    sourceLabelEn: 'YouTube',
    sourceLabelAr: 'يوتيوب',
    icon: '/icons/youtube.svg'
  };
} else {
  initialParsed = parseVideoSource(playlist.url);
}

// Determine dominant source type for top badge
const dominantSource = determinePrimaryPlaylistSource(playlist);
const primaryBadgeType =
  playlist.type !== 'playlist'
    ? playlist.type
    : dominantSource === 'youtube'
      ? 'youtube'
      : dominantSource === 'drive'
        ? 'drive'
        : dominantSource === 'telegram'
          ? 'telegram'
          : 'playlist';

const initialTitle = hasDiscreteVideos ? videos[0].title : (titleEn || playlist.title);

const crumbs: NavCrumb[] = [];
let backHref = '/';

if (playlist.moduleId && moduleInfo) {
  crumbs.push({
    title: moduleInfo.title,
    href: `/module/${playlist.moduleId}`
  });
  backHref = `/module/${playlist.moduleId}`;
}

if (playlist.subject && playlist.moduleId) {
  crumbs.push({
    title: playlist.subject,
    href: `/module/${playlist.moduleId}/${subjectToSlug(playlist.subject)}`
  });
  backHref = `/module/${playlist.moduleId}/${subjectToSlug(playlist.subject)}`;
}

crumbs.push({
  title: titleEn || playlist.title
});
---

<Layout
  title={`${titleEn || playlist.title} - ASU Med`}
  description={`Playlists and lecture series for ${titleEn || playlist.title}.`}
  crumbs={crumbs}
  backHref={backHref}
>

  <!-- Playlist Header & Progress Banner -->
  <div class="bg-white dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 rounded-2xl p-4 sm:p-6 mb-6 text-start shadow-2xs" data-material-id={playlist.id}>
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <TypeBadge type={primaryBadgeType} size="sm" />
          {playlist.subject && (
            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
              {playlist.subject}
            </span>
          )}
          <span class="text-xs font-semibold px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/40">
            Year {playlist.year}
          </span>
          <!-- Done Checkbox Button -->
          <button
            type="button"
            class="studied-btn relative z-30 pointer-events-auto p-1.5 -m-1 rounded-lg text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-emerald-50/60 dark:hover:bg-emerald-950/40 active:scale-95 transition-all cursor-pointer flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
            data-id={playlist.id}
            role="checkbox"
            aria-checked="false"
            title="Mark as studied"
            aria-label="Mark as studied"
          >
            <span
              class="studied-box w-6 h-6 rounded-md border-2 border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 flex items-center justify-center transition-all duration-200 shadow-2xs"
            >
              <svg
                class="studied-checkmark w-3.5 h-3.5 text-white hidden pointer-events-none drop-shadow-2xs"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
          </button>
          <!-- Bookmark Button -->
          <button
            type="button"
            class="bookmark-btn relative z-30 pointer-events-auto inline-flex items-center justify-center p-2 -m-1 text-zinc-400 hover:text-amber-500 dark:hover:text-amber-400 rounded-lg hover:bg-amber-50/60 dark:hover:bg-amber-950/40 active:scale-95 transition-all cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500"
            data-id={playlist.id}
            title="Save to bookmarks"
            aria-label="Save to bookmarks"
          >
            <svg class="w-5 h-5 bookmark-icon-empty pointer-events-none shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
            </svg>
            <svg class="w-5 h-5 bookmark-icon-filled hidden pointer-events-none shrink-0 text-amber-500 fill-amber-500 drop-shadow-2xs" viewBox="0 0 24 24">
              <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
            </svg>
          </button>
        </div>

        <h1
          class="text-xl sm:text-2xl font-extrabold text-zinc-900 dark:text-zinc-100 mb-1"
        >
          {titleEn || playlist.title}
        </h1>

        {(descEn || playlist.description) && (
          <p
            class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-2xl mb-2"
          >
            {descEn || playlist.description}
          </p>
        )}

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-zinc-500 dark:text-zinc-400 font-medium">
          {authorText && (
            <p>
              <span>By:</span> <span class="text-zinc-800 dark:text-zinc-200 font-semibold">{authorText}</span>
            </p>
          )}
        </div>
      </div>

      <!-- Watch Progress Card -->
      <div class="w-full lg:w-72 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700/60 rounded-xl p-3.5 shrink-0">
        <div class="flex items-center justify-between text-xs font-bold mb-1.5">
          <span class="text-zinc-700 dark:text-zinc-300" id="progress-heading">Progress</span>
          <span id="progress-percent-label" class="text-emerald-600 dark:text-emerald-400">0%</span>
        </div>

        <!-- Progress bar track -->
        <div class="w-full h-2 rounded-full bg-zinc-200 dark:bg-zinc-700 overflow-hidden mb-2">
          <div
            id="progress-bar-fill"
            class="h-full rounded-full bg-emerald-600 transition-all duration-300"
            style="width: 0%"
          ></div>
        </div>

        <div class="flex items-center justify-between text-[11px] text-zinc-500 dark:text-zinc-400">
          <span id="progress-count-label">0 of {hasDiscreteVideos ? videos.length : 8} completed</span>
          <button
            type="button"
            id="reset-progress-btn"
            class="hover:text-red-500 dark:hover:text-red-400 transition-colors cursor-pointer underline"
          >
            <span id="reset-progress-text">Reset</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Player & Playlist Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Video Player Section -->
    <div class="lg:col-span-8 space-y-4">
      <!-- Player Container (Responsive 16:9) -->
      <div class="relative w-full aspect-video rounded-2xl overflow-hidden bg-black shadow-lg border border-zinc-800">
        <!-- 1. Iframe Embed (YouTube, Google Drive preview, Vimeo) -->
        <iframe
          id="embed-iframe-player"
          src={initialParsed.embedType === 'iframe' ? initialParsed.embedUrl : undefined}
          title={initialTitle}
          class:list={['w-full h-full border-0', initialParsed.embedType !== 'iframe' && 'hidden']}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
          allowfullscreen
        ></iframe>

        <!-- 2. Native HTML5 Video Player (Direct MP4, WebM) -->
        <video
          id="embed-video-player"
          controls
          playsinline
          preload="metadata"
          class:list={['w-full h-full object-contain bg-black', initialParsed.embedType !== 'video' && 'hidden']}
          src={initialParsed.embedType === 'video' && initialParsed.embedUrl ? initialParsed.embedUrl : undefined}
        ></video>

        <!-- 3. External Fallback Action Card (Telegram, External / Non-embeddable links) -->
        <div
          id="embed-external-card"
          class:list={[
            'w-full h-full flex flex-col items-center justify-center p-6 text-center bg-gradient-to-br from-zinc-900 via-zinc-900 to-zinc-800 text-white select-none',
            initialParsed.embedType !== 'none' && 'hidden'
          ]}
        >
          <!-- Source Provider Badge -->
          <div class="mb-3 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-zinc-800/90 border border-zinc-700/80 text-zinc-200">
            <img id="external-card-source-icon" src={initialParsed.icon} alt="" class="w-4 h-4 object-contain" />
            <span id="external-card-source-name">{initialParsed.sourceLabelEn}</span>
          </div>

          <!-- Video Title -->
          <h3 id="external-card-title" class="text-base sm:text-lg font-bold text-zinc-100 max-w-lg mb-2 line-clamp-2 leading-snug">
            {initialTitle}
          </h3>

          <!-- Explanatory note -->
          <p id="external-card-desc" class="text-xs sm:text-sm text-zinc-400 max-w-md mb-5 leading-relaxed">
            This video is hosted externally. Click below to open and watch, then mark it completed to track your progress.
          </p>

          <!-- Buttons -->
          <div class="flex flex-wrap items-center justify-center gap-3">
            <a
              id="external-card-action-btn"
              href={initialParsed.externalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-md transition-all active:scale-95 cursor-pointer"
            >
              <span id="external-card-btn-text">
                {initialParsed.sourceType === 'telegram' ? 'Open in Telegram' : `Open in ${initialParsed.sourceLabelEn}`}
              </span>
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </a>

            <button
              type="button"
              id="external-card-done-btn"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-zinc-700 bg-zinc-800/80 hover:bg-zinc-700/80 text-zinc-200 font-semibold text-sm transition-all active:scale-95 cursor-pointer"
            >
              <svg class="w-4 h-4 text-emerald-400 checkmark-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span id="external-card-done-text">Mark Completed</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Player Controls & Current Playing Bar -->
      <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-start">
        <div class="flex items-center gap-2.5 min-w-0">
          <span id="current-source-dot" class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span>
          <h2 id="current-video-title" class="text-sm font-bold text-zinc-900 dark:text-zinc-100 truncate max-w-md">
            {initialTitle}
          </h2>
        </div>

        <div class="flex items-center gap-2 shrink-0 flex-wrap">
          <!-- Mark Current Video Done Button -->
          <button
            type="button"
            id="toggle-current-done-btn"
            class="inline-flex items-center gap-1.5 text-xs font-bold px-3.5 py-1.5 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 active:scale-95 transition-all shadow-2xs cursor-pointer"
          >
            <svg class="w-4 h-4 check-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span id="toggle-done-text">Mark as Completed</span>
          </button>

          <!-- Dynamic External Link (Adapts to YouTube, Google Drive, Telegram, Direct, External) -->
          <a
            id="current-video-external-btn"
            href={initialParsed.externalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-700 transition-colors"
            title={`Open on ${initialParsed.sourceLabelEn}`}
          >
            <img id="current-source-icon" src={initialParsed.icon} alt="" class="w-3.5 h-3.5 object-contain" />
            <span id="current-source-name">{initialParsed.sourceLabelEn}</span>
          </a>

          <!-- Download Video Button (Direct / Google Drive) -->
          <a
            id="current-video-download-btn"
            href={getVideoDownloadUrl(initialParsed.externalUrl) || '#'}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-700 transition-colors',
              !getVideoDownloadUrl(initialParsed.externalUrl) && 'hidden'
            ]}
            title="Download Video"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            <span id="current-video-download-text">Download</span>
          </a>
        </div>
      </div>

      <!-- Quick Prev / Next Navigation for Multi-part -->
      {hasDiscreteVideos && videos.length > 1 && (
        <div class="flex items-center justify-between pt-1">
          <button
            type="button"
            id="prev-video-btn"
            class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer transition-colors"
          >
            <span class="inline-block">&larr;</span> <span>Previous Video</span>
          </button>
          <span class="text-xs text-zinc-400" id="video-stepper-label">1 of {videos.length}</span>
          <button
            type="button"
            id="next-video-btn"
            class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer transition-colors"
          >
            <span>Next Video</span> <span class="inline-block">&rarr;</span>
          </button>
        </div>
      )}
    </div>

    <!-- Playlist / Checkpoints Sidebar -->
    <div class="lg:col-span-4 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 text-start shadow-2xs">
      <div class="flex items-center justify-between pb-3 mb-3 border-b border-zinc-100 dark:border-zinc-800">
        <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100" id="lectures-sidebar-heading">
          Lectures
        </h3>
        <button
          type="button"
          id="mark-all-done-btn"
          class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:underline cursor-pointer"
        >
          <span id="mark-all-done-text">Mark All ✓</span>
        </button>
      </div>

      <!-- Items List -->
      <div class="space-y-2 max-h-[550px] overflow-y-auto pr-1" id="playlist-items-list">
        {hasDiscreteVideos ? (
          videos.map((vid, idx) => {
            const parsed = parsedVideos[idx];
            return (
              <div
                class="playlist-video-item group flex items-start justify-between gap-3 p-3 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/40 hover:border-emerald-500/80 transition-all cursor-pointer select-none"
                data-index={idx}
                data-video-id={vid.id}
                data-youtube-id={vid.youtubeId || ''}
                data-url={vid.url || ''}
                data-source-type={parsed.sourceType}
                data-embed-type={parsed.embedType}
                data-embed-url={parsed.embedUrl || ''}
                data-external-url={parsed.externalUrl}
                data-source-label={parsed.sourceLabelEn}
                data-source-icon={parsed.icon}
                data-title={vid.title}
              >
                <!-- Video Title & Number (Clicking opens and plays the video) -->
                <div class="video-select-trigger flex items-start gap-2.5 min-w-0 flex-1">
                  <span class="video-idx-badge w-6 h-6 rounded-md bg-zinc-200 dark:bg-zinc-700 text-zinc-700 dark:text-zinc-300 font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 transition-colors">
                    {idx + 1}
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-1.5 mb-0.5">
                      <h4
                        class="video-title text-xs font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 line-clamp-2 leading-relaxed transition-colors flex-1"
                        title={vid.title}
                      >
                        {vid.title}
                      </h4>
                      <img
                        src={parsed.icon}
                        alt={parsed.sourceLabelEn}
                        title={parsed.sourceLabelEn}
                        class="w-3.5 h-3.5 shrink-0 opacity-70 group-hover:opacity-100 transition-opacity"
                        loading="lazy"
                      />
                    </div>
                    <div class="now-playing-badge hidden items-center gap-1 text-[10px] font-bold text-emerald-600 dark:text-emerald-400 mt-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                      <span>Now Playing</span>
                    </div>
                  </div>
                </div>

                <!-- Done Checkbox (Clicking marks complete) -->
                <button
                  type="button"
                  role="checkbox"
                  aria-checked="false"
                  class="video-done-checkbox w-6 h-6 rounded-md border border-zinc-300 dark:border-zinc-600 hover:border-emerald-500 flex items-center justify-center text-white transition-all shrink-0 cursor-pointer mt-0.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/30"
                  data-video-id={vid.id}
                  title="Mark as completed"
                  aria-label={`Mark ${vid.title} as completed`}
                >
                  <svg class="w-3.5 h-3.5 hidden checkmark-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                </button>
              </div>
            );
          })
        ) : (
          // Pre-populated Checkpoint items for Full Playlists (e.g. Dr. Nagi, Wahdan, Faten)
          Array.from({ length: 8 }).map((_, idx) => (
            <div
              class="playlist-checkpoint-item group flex items-center justify-between p-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/40 hover:border-emerald-500/80 transition-all cursor-pointer"
              data-checkpoint-id={`chk-${playlist.id}-${idx + 1}`}
              data-index={idx}
            >
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="w-6 h-6 rounded-md bg-zinc-200 dark:bg-zinc-700 text-zinc-700 dark:text-zinc-300 font-bold text-xs flex items-center justify-center shrink-0">
                  {idx + 1}
                </span>
                <div>
                  <h4 class="text-xs font-bold text-zinc-900 dark:text-zinc-100">
                    <span>Lecture</span> {idx + 1}
                  </h4>
                </div>
              </div>

              <button
                type="button"
                class="checkpoint-done-checkbox w-6 h-6 rounded-md border border-zinc-300 dark:border-zinc-600 hover:border-emerald-500 flex items-center justify-center text-white transition-colors shrink-0 cursor-pointer"
                data-checkpoint-id={`chk-${playlist.id}-${idx + 1}`}
                title="Mark as completed"
                aria-label="Mark as completed"
              >
                <svg class="w-3.5 h-3.5 hidden checkmark-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              </button>
            </div>
          ))
        )}
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ playlistId: playlist.id, hasDiscreteVideos, totalItemsCount: hasDiscreteVideos ? videos.length : 8 }}>
  function initPlaylistViewer() {
    const storageKey = `asumed_playlist_${playlistId}`;
    let watchedMap = {};

    try {
      const saved = localStorage.getItem(storageKey);
      if (saved) watchedMap = JSON.parse(saved);
    } catch {}

    const playerIframe = document.getElementById('embed-iframe-player');
    const playerVideo = document.getElementById('embed-video-player');
    const externalCard = document.getElementById('embed-external-card');
    const extCardTitle = document.getElementById('external-card-title');
    const extCardActionBtn = document.getElementById('external-card-action-btn');
    const extCardBtnText = document.getElementById('external-card-btn-text');
    const extCardSourceIcon = document.getElementById('external-card-source-icon');
    const extCardSourceName = document.getElementById('external-card-source-name');
    const extCardDoneBtn = document.getElementById('external-card-done-btn');
    const extCardDoneText = document.getElementById('external-card-done-text');

    const currentTitleEl = document.getElementById('current-video-title');
    const currentSourceIcon = document.getElementById('current-source-icon');
    const currentSourceName = document.getElementById('current-source-name');
    const currentExternalBtn = document.getElementById('current-video-external-btn');

    const progressBarFill = document.getElementById('progress-bar-fill');
    const progressPercentLabel = document.getElementById('progress-percent-label');
    const progressCountLabel = document.getElementById('progress-count-label');
    const toggleCurrentDoneBtn = document.getElementById('toggle-current-done-btn');
    const toggleDoneText = document.getElementById('toggle-done-text');
    const resetProgressBtn = document.getElementById('reset-progress-btn');
    const markAllDoneBtn = document.getElementById('mark-all-done-btn');
    const prevBtn = document.getElementById('prev-video-btn');
    const nextBtn = document.getElementById('next-video-btn');
    const stepperLabel = document.getElementById('video-stepper-label');

    let currentIndex = 0;
    const videoItems = document.querySelectorAll('.playlist-video-item');
    const checkpointItems = document.querySelectorAll('.playlist-checkpoint-item');

    function saveState() {
      try {
        localStorage.setItem(storageKey, JSON.stringify(watchedMap));
      } catch {}
      updateProgressUI();
    }

    function updateProgressUI() {
      const watchedCount = Object.values(watchedMap).filter(Boolean).length;
      const percent = Math.round((watchedCount / totalItemsCount) * 100);

      if (progressBarFill) progressBarFill.style.width = `${percent}%`;
      if (progressPercentLabel) progressPercentLabel.textContent = `${percent}%`;
      if (progressCountLabel) {
        progressCountLabel.textContent = `${watchedCount} of ${totalItemsCount} completed`;
      }

      // Update checkboxes UI and completion text styles
      document.querySelectorAll('.video-done-checkbox, .checkpoint-done-checkbox').forEach((box) => {
        const id = box.getAttribute('data-video-id') || box.getAttribute('data-checkpoint-id');
        const isDone = Boolean(watchedMap[id]);
        const icon = box.querySelector('.checkmark-icon');
        const parentItem = box.closest('.playlist-video-item, .playlist-checkpoint-item');
        const titleEl = parentItem?.querySelector('.video-title');
        box.setAttribute('aria-checked', String(isDone));

        if (isDone) {
          box.classList.add('bg-emerald-600', 'border-emerald-600');
          box.classList.remove('border-zinc-300', 'dark:border-zinc-600');
          icon?.classList.remove('hidden');
          if (titleEl) {
            titleEl.classList.add('text-zinc-500', 'dark:text-zinc-400', 'line-through');
          }
        } else {
          box.classList.remove('bg-emerald-600', 'border-emerald-600');
          box.classList.add('border-zinc-300', 'dark:border-zinc-600');
          icon?.classList.add('hidden');
          if (titleEl) {
            titleEl.classList.remove('text-zinc-500', 'dark:text-zinc-400', 'line-through');
          }
        }
      });

      // Update current playing toggle button & card done button
      if (hasDiscreteVideos && videoItems.length > 0) {
        const currentId = videoItems[currentIndex]?.getAttribute('data-video-id');
        const isCurrentDone = Boolean(watchedMap[currentId]);
        const doneString = isCurrentDone ? 'Completed ✓' : 'Mark Completed';

        if (toggleDoneText) toggleDoneText.textContent = doneString;
        if (extCardDoneText) extCardDoneText.textContent = doneString;

        if (toggleCurrentDoneBtn) {
          if (isCurrentDone) {
            toggleCurrentDoneBtn.classList.add('bg-emerald-700');
          } else {
            toggleCurrentDoneBtn.classList.remove('bg-emerald-700');
          }
        }
        if (extCardDoneBtn) {
          if (isCurrentDone) {
            extCardDoneBtn.classList.add('bg-emerald-700/80', 'border-emerald-600');
          } else {
            extCardDoneBtn.classList.remove('bg-emerald-700/80', 'border-emerald-600');
          }
        }
      } else {
        // Full playlist mode
        const allDone = watchedCount === totalItemsCount;
        if (toggleDoneText) {
          toggleDoneText.textContent = allDone ? 'Series Completed ✓' : 'Mark Completed';
        }
      }
    }

    function switchVideo(idx, userInitiated = false) {
      if (idx < 0 || idx >= videoItems.length) return;
      currentIndex = idx;
      const activeItem = videoItems[idx];
      const embedType = activeItem.getAttribute('data-embed-type') || 'none';
      const embedUrl = activeItem.getAttribute('data-embed-url') || '';
      const externalUrl = activeItem.getAttribute('data-external-url') || '';
      const sourceType = activeItem.getAttribute('data-source-type') || 'external';
      const title = activeItem.getAttribute('data-title') || '';
      const isEn = document.documentElement.lang === 'en';
      const sourceLabel = isEn
        ? activeItem.getAttribute('data-source-label') || 'Video Source'
        : activeItem.getAttribute('data-source-label-ar') || 'مصدر الفيديو';
      const sourceIcon = activeItem.getAttribute('data-source-icon') || '/icons/other.svg';

      // 1. Hide / stop players that are not active
      if (embedType !== 'iframe') {
        if (playerIframe) {
          playerIframe.classList.add('hidden');
          playerIframe.src = 'about:blank';
        }
      }
      if (embedType !== 'video') {
        if (playerVideo) {
          playerVideo.classList.add('hidden');
          try {
            playerVideo.pause();
          } catch {}
          playerVideo.src = '';
        }
      }
      if (embedType !== 'none') {
        if (externalCard) {
          externalCard.classList.add('hidden');
        }
      }

      // 2. Activate the corresponding player
      if (embedType === 'iframe' && playerIframe) {
        playerIframe.classList.remove('hidden');
        let targetSrc = embedUrl;
        if (userInitiated && sourceType === 'youtube' && !targetSrc.includes('autoplay=1')) {
          targetSrc += (targetSrc.includes('?') ? '&' : '?') + 'autoplay=1';
        }
        if (playerIframe.src !== targetSrc) {
          playerIframe.src = targetSrc;
        }
      } else if (embedType === 'video' && playerVideo) {
        playerVideo.classList.remove('hidden');
        if (playerVideo.src !== embedUrl) {
          playerVideo.src = embedUrl;
          if (userInitiated) {
            playerVideo.play().catch(() => {});
          }
        }
      } else if (embedType === 'none' && externalCard) {
        externalCard.classList.remove('hidden');
        if (extCardTitle) extCardTitle.textContent = title;
        if (extCardActionBtn) extCardActionBtn.href = externalUrl;
        if (extCardSourceIcon) extCardSourceIcon.src = sourceIcon;
        if (extCardSourceName) extCardSourceName.textContent = sourceLabel;
        if (extCardBtnText) {
          extCardBtnText.textContent =
            sourceType === 'telegram'
              ? 'Open in Telegram'
              : `Open on ${sourceLabel}`;
        }
      }

      // 3. Update current playing bar metadata
      if (currentTitleEl) currentTitleEl.textContent = title;
      if (currentSourceIcon) currentSourceIcon.src = sourceIcon;
      if (currentSourceName) currentSourceName.textContent = sourceLabel;
      if (currentExternalBtn) {
        currentExternalBtn.href = externalUrl;
        currentExternalBtn.title = `Open on ${sourceLabel}`;
      }

      const downloadBtn = document.getElementById('current-video-download-btn');
      if (downloadBtn) {
        let dlUrl = null;
        if (sourceType === 'drive') {
          const driveMatch = externalUrl.match(/\/file\/d\/([a-zA-Z0-9_-]+)/) || externalUrl.match(/[?&]id=([a-zA-Z0-9_-]+)/);
          if (driveMatch) dlUrl = `https://drive.google.com/uc?export=download&id=${driveMatch[1]}`;
        } else if (embedType === 'video' && (embedUrl || externalUrl)) {
          dlUrl = embedUrl || externalUrl;
        }
        if (dlUrl) {
          downloadBtn.classList.remove('hidden');
          downloadBtn.href = dlUrl;
        } else {
          downloadBtn.classList.add('hidden');
        }
      }

      if (stepperLabel) {
        stepperLabel.textContent = `${idx + 1} of ${videoItems.length}`;
      }

      // 4. Update tracklist sidebar active states
      videoItems.forEach((item, i) => {
        const badge = item.querySelector('.video-idx-badge');
        const nowPlaying = item.querySelector('.now-playing-badge');
        if (i === idx) {
          item.classList.add('border-emerald-500', 'bg-emerald-50/70', 'dark:bg-emerald-950/40', 'shadow-xs');
          item.classList.remove('border-zinc-200', 'dark:border-zinc-800', 'bg-zinc-50/70', 'dark:bg-zinc-800/40');
          if (badge) {
            badge.classList.add('bg-emerald-600', 'text-white');
            badge.classList.remove('bg-zinc-200', 'dark:bg-zinc-700', 'text-zinc-700', 'dark:text-zinc-300');
          }
          if (nowPlaying) {
            nowPlaying.classList.remove('hidden');
            nowPlaying.classList.add('flex');
          }
          item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        } else {
          item.classList.remove('border-emerald-500', 'bg-emerald-50/70', 'dark:bg-emerald-950/40', 'shadow-xs');
          item.classList.add('border-zinc-200', 'dark:border-zinc-800', 'bg-zinc-50/70', 'dark:bg-zinc-800/40');
          if (badge) {
            badge.classList.remove('bg-emerald-600', 'text-white');
            badge.classList.add('bg-zinc-200', 'dark:bg-zinc-700', 'text-zinc-700', 'dark:text-zinc-300');
          }
          if (nowPlaying) {
            nowPlaying.classList.add('hidden');
            nowPlaying.classList.remove('flex');
          }
        }
      });

      if (prevBtn) prevBtn.disabled = idx === 0;
      if (nextBtn) nextBtn.disabled = idx === videoItems.length - 1;

      updateProgressUI();
    }

    // Attach click events to video items in multipart
    videoItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        if (e.target.closest('.video-done-checkbox')) return;
        const idx = parseInt(item.getAttribute('data-index') || '0', 10);
        switchVideo(idx, true);
      });
    });

    // Checkboxes toggle
    document.querySelectorAll('.video-done-checkbox').forEach((box) => {
      box.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        const id = box.getAttribute('data-video-id');
        if (id) {
          watchedMap[id] = !watchedMap[id];
          saveState();
        }
      });
    });

    document.querySelectorAll('.checkpoint-done-checkbox').forEach((box) => {
      box.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        const id = box.getAttribute('data-checkpoint-id');
        if (id) {
          watchedMap[id] = !watchedMap[id];
          saveState();
        }
      });
    });

    // Checkpoint item row click
    checkpointItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        if (e.target.closest('.checkpoint-done-checkbox')) return;
        const id = item.getAttribute('data-checkpoint-id');
        if (id) {
          watchedMap[id] = !watchedMap[id];
          saveState();
        }
      });
    });

    // Toggle current done button & external card done button
    function toggleCurrentVideo() {
      if (hasDiscreteVideos) {
        const currentId = videoItems[currentIndex]?.getAttribute('data-video-id');
        if (currentId) {
          watchedMap[currentId] = !watchedMap[currentId];
          saveState();
        }
      } else {
        const anyUnchecked = Object.values(watchedMap).filter(Boolean).length < totalItemsCount;
        for (let i = 1; i <= totalItemsCount; i++) {
          watchedMap[`chk-${playlistId}-${i}`] = anyUnchecked;
        }
        saveState();
      }
    }

    toggleCurrentDoneBtn?.addEventListener('click', toggleCurrentVideo);
    extCardDoneBtn?.addEventListener('click', toggleCurrentVideo);

    // Mark all done
    markAllDoneBtn?.addEventListener('click', () => {
      if (hasDiscreteVideos) {
        videoItems.forEach((item) => {
          const id = item.getAttribute('data-video-id');
          if (id) watchedMap[id] = true;
        });
      } else {
        for (let i = 1; i <= totalItemsCount; i++) {
          watchedMap[`chk-${playlistId}-${i}`] = true;
        }
      }
      saveState();
    });

    // Reset progress
    resetProgressBtn?.addEventListener('click', () => {
      if (confirm('Are you sure you want to reset watch progress for this playlist?')) {
        watchedMap = {};
        saveState();
      }
    });

    // Steppers
    prevBtn?.addEventListener('click', () => switchVideo(currentIndex - 1, true));
    nextBtn?.addEventListener('click', () => switchVideo(currentIndex + 1, true));

    // Initialize first video highlight & progress
    if (hasDiscreteVideos && videoItems.length > 0) {
      switchVideo(0, false);
    } else {
      updateProgressUI();
    }
  }

  initPlaylistViewer();
  document.addEventListener('astro:after-swap', initPlaylistViewer);
</script>
