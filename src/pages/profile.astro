        <div id="modal-username-status" class="hidden text-[11px] mt-1 font-semibold"></div>
      </div>

      <div class="pt-2 flex items-center justify-end gap-2">
        <button
          type="button"
          id="modal-btn-confirm-username"
          disabled
          class="w-full py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white text-xs font-bold transition-all shadow-xs disabled:opacity-50 cursor-pointer disabled:cursor-not-allowed"
        >
          تأكيد وتثبيت اسم المستخدم
        </button>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ allMaterialsSnapshot: allMaterials }}>
  window.__ALL_MATERIALS_SNAPSHOT = allMaterialsSnapshot;
</script>

<script>
  import {
    onAuthChange,
    signInWithGoogle,
    signInWithEmail,
    signUpWithEmail,
    signOutUser,
    setPermanentUsername,
    getCachedUserProfile
  } from '../firebase/auth';
  import { escapeHtml } from '../utils/sanitize';
  import type { User } from 'firebase/auth';

  let unsubscribeAuth: (() => void) | null = null;
  import {
    getUserProfileByUsername,
    getUserProfileByUid,
    upsertUserProfile,
    checkUsernameAvailable,
    getUserContributions,
    getUserSubmissions
  } from '../firebase/firestore';
  import type { UserProfile, UserContact, ContactPlatform } from '../types/profile';
  import { PLATFORM_REGISTRY, renderContactPillMarkup } from '../utils/contacts';
  import type { MaterialItem, AcademicYear } from '../types/materials';

  function initProfilePage(): void {
    const loadingSkeleton = document.getElementById('profile-loading-skeleton');
    const guestContainer = document.getElementById('guest-view-container');
    const myProfileContainer = document.getElementById('my-profile-container');
    const publicContainer = document.getElementById('public-profile-container');
    const breadcrumbTitle = document.getElementById('profile-breadcrumb-title');

    // Parse URL queries
    const urlParams = new URLSearchParams(window.location.search);
    const targetUsername = urlParams.get('u');
    const targetUid = urlParams.get('id');

    let currentUser: User | null = null;
    let currentProfile: UserProfile | null = getCachedUserProfile();

    function showSection(section: 'loading' | 'guest' | 'my-profile' | 'public'): void {
      loadingSkeleton?.classList.toggle('hidden', section !== 'loading');
      guestContainer?.classList.toggle('hidden', section !== 'guest');
      myProfileContainer?.classList.toggle('hidden', section !== 'my-profile');
      publicContainer?.classList.toggle('hidden', section !== 'public');
    }

    function notify(message: string, type: 'success' | 'error' | 'info' = 'info') {
      window.dispatchEvent(
        new CustomEvent('show-toast', { detail: { message, type } })
      );
    }

    // Helper: render initials
    function getInitials(name: string): string {
      const parts = name.trim().split(/\s+/);
      if (parts.length >= 2) {
        return (parts[0][0] + parts[1][0]).toUpperCase();
      }
      return name.slice(0, 2).toUpperCase();
    }

    // ─── 1. Public Profile View ──────────────────────────────────────────
    async function renderPublicProfile(identifier: string, isUid: boolean) {
      showSection('loading');
      try {
        const fetchPromise = isUid
          ? getUserProfileByUid(identifier)
          : getUserProfileByUsername(identifier);
        const timeoutPromise = new Promise<null>((resolve) => setTimeout(() => resolve(null), 3000));
        let profile: UserProfile | null = await Promise.race([fetchPromise, timeoutPromise]);

        // Fallback for author names or non-registered contributors
        if (!profile && !isUid) {
          profile = {
            uid: 'guest_' + identifier,
            username: identifier.toLowerCase().replace(/\s+/g, '_'),
            displayName: identifier,
            bio: 'Contributor to ASU Med Materials community',
            createdAt: new Date().toISOString()
          };
        }

        if (!profile) {
          notify('Profile not found', 'error');
          showSection('guest');
          return;
        }

        // Set breadcrumb
        if (breadcrumbTitle) {
          breadcrumbTitle.textContent = `@${profile.username}`;
        }

        // Fill public card
        const nameEl = document.getElementById('public-profile-name');
        const handleEl = document.getElementById('public-profile-handle');
        const bioEl = document.getElementById('public-profile-bio');
        const yearBadgeEl = document.getElementById('public-profile-year-badge');
        const avatarImg = document.getElementById('public-avatar-img') as HTMLImageElement | null;
        const avatarInitials = document.getElementById('public-avatar-initials');

        if (nameEl) nameEl.textContent = profile.displayName || profile.username;
        if (handleEl) handleEl.textContent = `@${profile.username}`;
        if (bioEl) bioEl.textContent = profile.bio || 'ASU Faculty of Medicine student.';

        if (yearBadgeEl) {
          if (profile.academicYear) {
            yearBadgeEl.textContent = `Year ${profile.academicYear}`;
            yearBadgeEl.classList.remove('hidden');
          } else {
            yearBadgeEl.classList.add('hidden');
          }
        }

        if (profile.photoURL && avatarImg) {
          avatarImg.src = profile.photoURL;
          avatarImg.classList.remove('hidden');
          avatarInitials?.classList.add('hidden');
        } else {
          avatarImg?.classList.add('hidden');
          if (avatarInitials) {
            avatarInitials.textContent = getInitials(profile.displayName || profile.username);
            avatarInitials.classList.remove('hidden');
          }
        }

        // Admin role description (if admin)
        const publicAdminRoleEl = document.getElementById('public-profile-admin-role');
        if (publicAdminRoleEl) {
          if (profile.role === 'admin' && profile.adminRoleDescription) {
            publicAdminRoleEl.textContent = profile.adminRoleDescription;
            publicAdminRoleEl.classList.remove('hidden');
          } else {
            publicAdminRoleEl.classList.add('hidden');
          }
        }

        // Contact pills
        const publicContactsContainer = document.getElementById('public-profile-contacts-container');
        if (publicContactsContainer) {
          publicContactsContainer.innerHTML = '';
          if (profile.contacts && profile.contacts.length > 0) {
            const validContacts = profile.contacts.filter((c) => c.url && c.url.trim());
            if (validContacts.length > 0) {
              publicContactsContainer.innerHTML = validContacts
                .map((c) => renderContactPillMarkup(c, true))
                .join('');
              publicContactsContainer.classList.remove('hidden');
            } else {
              publicContactsContainer.classList.add('hidden');
            }
          } else {
            publicContactsContainer.classList.add('hidden');
          }
        }

        // Fetch contributions
        const contribBadge = document.getElementById('public-profile-contrib-badge');
        const rawMaterials: MaterialItem[] = (window as any).__ALL_MATERIALS_SNAPSHOT || [];
        const targetSlug = profile.username.toLowerCase();
        const targetName = (profile.displayName || '').toLowerCase();

        // Query both firestore and fallback materials
        let firestoreByUid: MaterialItem[] = [];
        let firestoreByUsername: MaterialItem[] = [];
        try {
          if (profile.uid) firestoreByUid = await getUserContributions(profile.uid);
          if (profile.username) firestoreByUsername = await getUserContributions(profile.username);
        } catch (e) {
          console.warn('Failed to query user contributions from Firestore:', e);
        }

        const seenIds = new Set<string>();
        const userMaterials: MaterialItem[] = [];

        for (const m of [...firestoreByUid, ...firestoreByUsername]) {
          if (!seenIds.has(m.id)) {
            seenIds.add(m.id);
            userMaterials.push(m);
          }
        }

        for (const m of rawMaterials) {
          if (seenIds.has(m.id)) continue;
          if (m.added_by_username && m.added_by_username.toLowerCase() === targetSlug) {
            seenIds.add(m.id);
            userMaterials.push(m);
            continue;
          }
          if (m.creator_username && m.creator_username.toLowerCase() === targetSlug) {
            seenIds.add(m.id);
            userMaterials.push(m);
            continue;
          }
          if ((profile.uid && m.contributorUid === profile.uid) || (m.contributorUsername && m.contributorUsername.toLowerCase() === targetSlug)) {
            seenIds.add(m.id);
            userMaterials.push(m);
            continue;
          }
          const addedByArr = Array.isArray(m.addedBy) ? m.addedBy : m.addedBy ? [m.addedBy] : [];
          const authorArr = Array.isArray(m.author) ? m.author : m.author ? [m.author] : [];
          const allNames = [...addedByArr, ...authorArr].map((n) => n.toLowerCase().trim());
          if (allNames.some((n) => n === targetSlug || (targetName && n === targetName))) {
            seenIds.add(m.id);
            userMaterials.push(m);
          }
        }

        const grid = document.getElementById('public-contributions-grid');
        const emptyState = document.getElementById('public-contributions-empty');
        const countEl = document.getElementById('public-contributions-count');

        if (countEl) countEl.textContent = `${userMaterials.length} materials`;

        if (contribBadge) {
          if (userMaterials.length > 0) {
            contribBadge.textContent = `🌟 ${userMaterials.length} مساهمة`;
            contribBadge.classList.remove('hidden');
          } else {
            contribBadge.classList.add('hidden');
          }
        }

        if (grid) {
          grid.innerHTML = '';
          if (userMaterials.length === 0) {
            emptyState?.classList.remove('hidden');
          } else {
            emptyState?.classList.add('hidden');
            for (const item of userMaterials) {
              const cardDiv = document.createElement('div');
              const isInternal = item.type === 'flashcards' || (item.url && item.url.startsWith('/'));
              const targetAttr = isInternal ? '_self' : '_blank';
              const relAttr = isInternal ? '' : 'rel="noopener noreferrer"';
              cardDiv.innerHTML = `
                <div class="flex items-center justify-between mb-2">
                  <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300">${escapeHtml(item.type)}</span>
                  <span class="text-xs text-zinc-400 font-medium">Year ${escapeHtml(String(item.year))}</span>
                </div>
                <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 line-clamp-2 mb-1">
                  <a href="${escapeHtml(item.url)}" target="${targetAttr}" ${relAttr} class="hover:text-emerald-600 dark:hover:text-emerald-400">
                    ${escapeHtml(item.title)}
                  </a>
                </h3>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2 mb-3">
                  ${escapeHtml(item.description || item.subject || '')}
                </p>
                <div class="flex items-center justify-between text-[11px] pt-2 border-t border-zinc-100 dark:border-zinc-800">
                  <span class="text-emerald-600 dark:text-emerald-400 font-semibold">${escapeHtml(item.subject || '')}</span>
                  <a href="${escapeHtml(item.url)}" target="${targetAttr}" ${relAttr} class="font-bold text-emerald-600 dark:text-emerald-400 hover:underline">Open &rarr;</a>
                </div>
              `;
              grid.appendChild(cardDiv);
            }
          }
        }

        // Share public profile button
        const shareBtn = document.getElementById('btn-share-public-profile');
        shareBtn?.addEventListener('click', async () => {
          const shareUrl = window.location.href;
          if (navigator.share) {
            try {
              await navigator.share({
                title: `${profile.displayName} (@${profile.username}) - ASU Med Materials`,
                text: `Check out ${profile.displayName}'s contributions on ASU Med Materials.`,
                url: shareUrl
              });
              return;
            } catch {}
          }
          await navigator.clipboard.writeText(shareUrl);
          notify('Profile link copied to clipboard!', 'success');
        });

        showSection('public');
      } catch (err: any) {
        console.error(err);
        showSection('guest');
      }
    }

    // ─── 2. My Profile Dashboard View ────────────────────────────────────
    function renderMyProfile(profile: UserProfile) {
      if (breadcrumbTitle) {
        breadcrumbTitle.textContent = 'My Profile';
      }

      const nameEl = document.getElementById('my-profile-name');
      const handleEl = document.getElementById('my-profile-handle');
      const bioEl = document.getElementById('my-profile-bio-text');
      const yearBadgeEl = document.getElementById('my-profile-year-badge');
      const avatarImg = document.getElementById('my-avatar-img') as HTMLImageElement | null;
      const avatarInitials = document.getElementById('my-avatar-initials');

      const editName = document.getElementById('edit-display-name') as HTMLInputElement | null;
      const editHandle = document.getElementById('edit-username') as HTMLInputElement | null;
      const editYear = document.getElementById('edit-academic-year') as HTMLSelectElement | null;
      const editBio = document.getElementById('edit-bio') as HTMLTextAreaElement | null;
      const shareUrlInput = document.getElementById('my-share-url-preview') as HTMLInputElement | null;

      if (nameEl) nameEl.textContent = profile.displayName || 'ASU Student';
      if (handleEl) handleEl.textContent = `@${profile.username}`;
      if (bioEl) bioEl.textContent = profile.bio || 'Add a bio below to tell other med students about your study goals.';

      if (yearBadgeEl) {
        if (profile.academicYear) {
          yearBadgeEl.textContent = `Year ${profile.academicYear}`;
          yearBadgeEl.classList.remove('hidden');
        } else {
          yearBadgeEl.classList.add('hidden');
        }
      }

      // Sync Admin Dashboard button visibility
      const adminBtn = document.getElementById('btn-profile-admin-dashboard');
      if (adminBtn) {
        if (profile.role === 'admin') {
          adminBtn.classList.remove('hidden');
          adminBtn.classList.add('inline-flex');
        } else {
          adminBtn.classList.add('hidden');
          adminBtn.classList.remove('inline-flex');
        }
      }

      if (profile.photoURL && avatarImg) {
        avatarImg.src = profile.photoURL;
        avatarImg.classList.remove('hidden');
        avatarInitials?.classList.add('hidden');
      } else {
        avatarImg?.classList.add('hidden');
        if (avatarInitials) {
          avatarInitials.textContent = getInitials(profile.displayName || profile.username);
          avatarInitials.classList.remove('hidden');
        }
      }

      // Admin role description (if admin)
      const myAdminRoleEl = document.getElementById('my-profile-admin-role');
      if (myAdminRoleEl) {
        if (profile.role === 'admin' && profile.adminRoleDescription) {
          myAdminRoleEl.textContent = profile.adminRoleDescription;
          myAdminRoleEl.classList.remove('hidden');
        } else {
          myAdminRoleEl.classList.add('hidden');
        }
      }

      // Contact pills in header
      const myContactsContainer = document.getElementById('my-profile-contacts-container');
      if (myContactsContainer) {
        myContactsContainer.innerHTML = '';
        if (profile.contacts && profile.contacts.length > 0) {
          const validContacts = profile.contacts.filter((c) => c.url && c.url.trim());
          if (validContacts.length > 0) {
            myContactsContainer.innerHTML = validContacts
              .map((c) => renderContactPillMarkup(c, true))
              .join('');
            myContactsContainer.classList.remove('hidden');
          } else {
            myContactsContainer.classList.add('hidden');
          }
        } else {
          myContactsContainer.classList.add('hidden');
        }
      }

      // Populate edit fields
      if (editName) editName.value = profile.displayName || '';
      if (editHandle) editHandle.value = profile.username || '';
      if (editYear) editYear.value = profile.academicYear ? String(profile.academicYear) : '';
      if (editBio) editBio.value = profile.bio || '';

      // Admin role field in form
      const groupAdminRoleDesc = document.getElementById('group-admin-role-desc');
      const editAdminRoleDesc = document.getElementById('edit-admin-role-desc') as HTMLInputElement | null;
      if (groupAdminRoleDesc) {
        if (profile.role === 'admin') {
          groupAdminRoleDesc.classList.remove('hidden');
          if (editAdminRoleDesc) {
            editAdminRoleDesc.value = profile.adminRoleDescription || '';
          }
        } else {
          groupAdminRoleDesc.classList.add('hidden');
        }
      }

      // Populate contacts editor list
      renderContactsEditor(profile.contacts || []);

      const publicShareUrl = `${window.location.origin}/profile?u=${encodeURIComponent(profile.username)}`;
      if (shareUrlInput) shareUrlInput.value = publicShareUrl;

      // Check if user needs to choose their permanent custom username
      const modal = document.getElementById('modal-set-username');
      const modalInput = document.getElementById('modal-input-username') as HTMLInputElement | null;
      if (!profile.hasCustomUsername && modal && modalInput) {
        modal.classList.remove('hidden');
        modalInput.value = (profile.username || '').replace(/_[a-z0-9]{4}$/, '');
        modalInput.dispatchEvent(new Event('input'));
        modalInput.focus();
      } else {
        modal?.classList.add('hidden');
      }

      // Populate user contributions & pending submissions
      loadMyContributions(profile);

      showSection('my-profile');
    }

    async function loadMyContributions(profile: UserProfile): Promise<void> {
      const grid = document.getElementById('my-contributions-grid');
      const emptyState = document.getElementById('my-contributions-empty');
      const countEl = document.getElementById('my-contributions-count');
      const contribBadge = document.getElementById('my-profile-contrib-badge');
      const pendingContainer = document.getElementById('my-pending-submissions-container');
      const pendingList = document.getElementById('my-pending-submissions-list');
      const pendingCountEl = document.getElementById('my-pending-submissions-count');

      // 1. Published Materials
      const rawMaterials: MaterialItem[] = (window as any).__ALL_MATERIALS_SNAPSHOT || [];
      const targetSlug = (profile.username || '').toLowerCase();
      const targetName = (profile.displayName || '').toLowerCase();

      let firestoreByUid: MaterialItem[] = [];
      let firestoreByUsername: MaterialItem[] = [];
      try {
        if (profile.uid) firestoreByUid = await getUserContributions(profile.uid);
        if (profile.username) firestoreByUsername = await getUserContributions(profile.username);
      } catch (e) {
        console.warn('Failed to load user contributions from Firestore:', e);
      }

      const seenIds = new Set<string>();
      const userMaterials: MaterialItem[] = [];

      for (const m of [...firestoreByUid, ...firestoreByUsername]) {
        if (!seenIds.has(m.id)) {
          seenIds.add(m.id);
          userMaterials.push(m);
        }
      }

      for (const m of rawMaterials) {
        if (seenIds.has(m.id)) continue;
        if ((profile.uid && m.contributorUid === profile.uid) || (m.contributorUsername && m.contributorUsername.toLowerCase() === targetSlug)) {
          seenIds.add(m.id);
          userMaterials.push(m);
          continue;
        }
        const addedByArr = Array.isArray(m.addedBy) ? m.addedBy : m.addedBy ? [m.addedBy] : [];
        const authorArr = Array.isArray(m.author) ? m.author : m.author ? [m.author] : [];
        const allNames = [...addedByArr, ...authorArr].map((n) => n.toLowerCase().trim());
        if (allNames.some((n) => n.includes(targetSlug) || (targetName && n.includes(targetName)))) {
          seenIds.add(m.id);
          userMaterials.push(m);
        }
      }

      if (countEl) countEl.textContent = `${userMaterials.length} materials`;

      if (contribBadge) {
        if (userMaterials.length > 0) {
          contribBadge.textContent = `🌟 ${userMaterials.length} مساهمة`;
          contribBadge.classList.remove('hidden');
        } else {
          contribBadge.classList.add('hidden');
        }
      }

      if (grid) {
        grid.innerHTML = '';
        if (userMaterials.length === 0) {
          emptyState?.classList.remove('hidden');
        } else {
          emptyState?.classList.add('hidden');
          for (const item of userMaterials) {
            const cardDiv = document.createElement('div');
            const isInternal = item.type === 'flashcards' || (item.url && item.url.startsWith('/'));
            const targetAttr = isInternal ? '_self' : '_blank';
            const relAttr = isInternal ? '' : 'rel="noopener noreferrer"';
            cardDiv.className = 'p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-2xs hover:border-emerald-500/50 transition-all';
            cardDiv.innerHTML = `
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300">${escapeHtml(item.type)}</span>
                <span class="text-xs text-zinc-400 font-medium">Year ${escapeHtml(String(item.year))}</span>
              </div>
              <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 line-clamp-2 mb-1">
                <a href="${escapeHtml(item.url)}" target="${targetAttr}" ${relAttr} class="hover:text-emerald-600 dark:hover:text-emerald-400">
                  ${escapeHtml(item.title)}
                </a>
              </h3>
              <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2 mb-3">
                ${escapeHtml(item.description || item.subject || '')}
              </p>
              <div class="flex items-center justify-between text-[11px] pt-2 border-t border-zinc-100 dark:border-zinc-800">
                <span class="text-emerald-600 dark:text-emerald-400 font-semibold">${escapeHtml(item.subject || '')}</span>
                <a href="${escapeHtml(item.url)}" target="${targetAttr}" ${relAttr} class="font-bold text-emerald-600 dark:text-emerald-400 hover:underline">Open &rarr;</a>
              </div>
            `;
            grid.appendChild(cardDiv);
          }
        }
      }

      // 2. Pending Submissions
      if (profile.uid) {
        try {
          const allUserSubmissions = await getUserSubmissions(profile.uid);
          const pendingSubs = allUserSubmissions.filter((s) => s.status === 'pending');

          if (pendingSubs.length > 0 && pendingContainer && pendingList) {
            pendingContainer.classList.remove('hidden');
            if (pendingCountEl) pendingCountEl.textContent = `${pendingSubs.length} قيد المراجعة`;

            pendingList.innerHTML = pendingSubs
              .map((sub) => {
                const dateStr = sub.timestamp ? new Date(sub.timestamp).toLocaleDateString('ar-EG', { dateStyle: 'medium' }) : '';
                const displayYear = sub.year && sub.year !== 'general' ? `سنة ${sub.year}` : 'عام';
                const displayModule = sub.moduleId && sub.moduleId !== 'general' ? `• ${sub.moduleId}` : '';
                return `
                  <div class="p-3 rounded-xl bg-amber-50/50 dark:bg-amber-950/20 border border-amber-200/60 dark:border-amber-800/40 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
                    <div>
                      <div class="font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-1.5">
                        <span>${sub.title || 'مساهمة قيد المراجعة'}</span>
                      </div>
                      <div class="text-[11px] text-zinc-400 mt-0.5 flex items-center gap-1.5">
                        <span>${displayYear} ${displayModule}</span>
                        <span>•</span>
                        <span>${dateStr}</span>
                      </div>
                    </div>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[10px] font-bold bg-amber-100 dark:bg-amber-900/60 text-amber-800 dark:text-amber-200 shrink-0 self-start sm:self-center">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                      قيد المراجعة
                    </span>
                  </div>
                `;
              })
              .join('');
          } else {
            pendingContainer?.classList.add('hidden');
          }
        } catch (err) {
          console.warn('Failed to load pending submissions:', err);
        }
      }
    }

    // ─── 3. Event Listeners for Dashboard ───────────────────────────────
    // Copy Share Links
    const copyMyShareBtn = document.getElementById('btn-copy-my-share-link');
    const copyPreviewBtn = document.getElementById('btn-copy-preview-link');

    async function copyMyProfileLink() {
      if (!currentProfile) return;
      const shareUrl = `${window.location.origin}/profile?u=${encodeURIComponent(currentProfile.username)}`;
      try {
        await navigator.clipboard.writeText(shareUrl);
        notify('Shareable profile link copied!', 'success');
      } catch {
        notify('Could not copy link', 'error');
      }
    }

    copyMyShareBtn?.addEventListener('click', copyMyProfileLink);
    copyPreviewBtn?.addEventListener('click', copyMyProfileLink);

    // Pre-fill avatar URL input with current value
    const avatarUrlInput = document.getElementById('edit-avatar-url') as HTMLInputElement | null;
    if (avatarUrlInput && currentProfile?.photoURL) {
      avatarUrlInput.value = currentProfile.photoURL;
    }

    // ─── Contact Links Editor Helpers ─────────────────────────────────
    function createContactRowElement(contact?: UserContact): HTMLElement {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-2 contact-row';

      const platform = contact?.platform || 'whatsapp';
      const url = contact?.url || '';
      const label = contact?.label || '';

      const platformOptions = Object.values(PLATFORM_REGISTRY)
        .map(
          (p) =>
            `<option value="${p.id}" ${p.id === platform ? 'selected' : ''}>${p.label} (${p.labelAr})</option>`
        )
        .join('');

      row.innerHTML = `
        <select class="contact-platform-select text-xs px-2.5 py-2 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-zinc-100 shrink-0 cursor-pointer">
          ${platformOptions}
        </select>
        <input
          type="text"
          class="contact-url-input flex-1 text-xs px-3 py-2 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-zinc-100"
          placeholder="رابط أو معرف الحساب (e.g. +2010... or link)"
          value="${url}"
        />
        <input
          type="text"
          class="contact-label-input w-24 sm:w-28 text-xs px-2.5 py-2 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-zinc-100"
          placeholder="اسم اختياري"
          value="${label}"
        />
        <button
          type="button"
          class="btn-remove-contact-row p-2 rounded-xl text-zinc-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors shrink-0 cursor-pointer"
          title="حذف"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </button>
      `;

      row.querySelector('.btn-remove-contact-row')?.addEventListener('click', () => {
        row.remove();
      });

      return row;
    }

    function renderContactsEditor(contacts?: UserContact[]) {
      const list = document.getElementById('contacts-editor-list');
      if (!list) return;
      list.innerHTML = '';
      if (contacts && contacts.length > 0) {
        contacts.forEach((c) => {
          list.appendChild(createContactRowElement(c));
        });
      }
    }

    function getEnteredContacts(): UserContact[] {
      const list = document.getElementById('contacts-editor-list');
      if (!list) return [];
      const rows = list.querySelectorAll<HTMLElement>('.contact-row');
      const contacts: UserContact[] = [];

      rows.forEach((row) => {
        const platformSelect = row.querySelector<HTMLSelectElement>('.contact-platform-select');
        const urlInput = row.querySelector<HTMLInputElement>('.contact-url-input');
        const labelInput = row.querySelector<HTMLInputElement>('.contact-label-input');

        const platform = (platformSelect?.value || 'other') as ContactPlatform;
        const url = urlInput?.value.trim() || '';
        const label = labelInput?.value.trim() || undefined;

        if (url) {
          contacts.push({ platform, url, label });
        }
      });

      return contacts;
    }

    const addContactBtn = document.getElementById('btn-add-contact-row');
    addContactBtn?.addEventListener('click', () => {
      const list = document.getElementById('contacts-editor-list');
      if (list) {
        list.appendChild(createContactRowElement());
      }
    });

    // Save Profile Form (Updates name, year, bio, contacts, admin role description)
    const editForm = document.getElementById('edit-profile-form');
    editForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentProfile || !currentUser) return;

      const editName = (document.getElementById('edit-display-name') as HTMLInputElement)?.value.trim();
      const editYearVal = (document.getElementById('edit-academic-year') as HTMLSelectElement)?.value;
      const editBio = (document.getElementById('edit-bio') as HTMLTextAreaElement)?.value.trim();
      const avatarUrl = (document.getElementById('edit-avatar-url') as HTMLInputElement)?.value.trim() || '';

      if (!editName) {
        notify('Full Name is required', 'error');
        return;
      }

      // Validate avatar URL if provided
      if (avatarUrl) {
        try {
          const parsed = new URL(avatarUrl);
          if (!['http:', 'https:'].includes(parsed.protocol)) {
            throw new Error('Invalid URL');
          }
        } catch {
          notify('Please enter a valid image URL (starting with http:// or https://)', 'error');
          return;
        }
      }

      const saveBtn = document.getElementById('btn-save-profile') as HTMLButtonElement | null;
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
      }

      try {
        currentProfile.displayName = editName;
        currentProfile.academicYear = editYearVal ? (parseInt(editYearVal, 10) as AcademicYear) : undefined;
        currentProfile.bio = editBio;
        currentProfile.photoURL = avatarUrl || undefined;
        currentProfile.contacts = getEnteredContacts();

        if (currentProfile.role === 'admin') {
          const roleInput = document.getElementById('edit-admin-role-desc') as HTMLInputElement | null;
          currentProfile.adminRoleDescription = roleInput?.value.trim() || undefined;
        }

        await upsertUserProfile(currentProfile);

        // Conserve user's updated academic year in localStorage and notify site components
        if (currentProfile.academicYear) {
          localStorage.setItem('asumed_user_year', String(currentProfile.academicYear));
          window.dispatchEvent(
            new CustomEvent('user-preferences-updated', {
              detail: { year: currentProfile.academicYear }
            })
          );
        }

        notify('Profile updated successfully!', 'success');
        renderMyProfile(currentProfile);
      } catch (err: any) {
        notify(err?.message || 'Failed to update profile', 'error');
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Changes';
        }
      }
    });

    // ─── Live Username Validation for Registration ───────────────────────
    const authUsernameInput = document.getElementById('auth-username') as HTMLInputElement | null;
    const authUsernameStatus = document.getElementById('auth-username-status');
    let authCheckTimer: any = null;

    authUsernameInput?.addEventListener('input', () => {
      clearTimeout(authCheckTimer);
      const val = authUsernameInput.value.trim().toLowerCase().replace(/^@/, '');
      if (!val) {
        authUsernameStatus?.classList.add('hidden');
        return;
      }

      if (val.length < 3 || val.length > 25 || !/^[a-z0-9_-]+$/.test(val)) {
        if (authUsernameStatus) {
          authUsernameStatus.textContent = '❌ يجب أن يتكون من 3 إلى 25 حرفاً أو رقماً أو _';
          authUsernameStatus.className = 'text-[11px] mt-1 font-semibold text-rose-600 dark:text-rose-400';
          authUsernameStatus.classList.remove('hidden');
        }
        return;
      }

      if (authUsernameStatus) {
        authUsernameStatus.textContent = 'جاري التحقق من التوفر...';
        authUsernameStatus.className = 'text-[11px] mt-1 font-semibold text-zinc-400';
        authUsernameStatus.classList.remove('hidden');
      }

      authCheckTimer = setTimeout(async () => {
        try {
          const isAvail = await checkUsernameAvailable(val);
          if (authUsernameStatus) {
            if (isAvail) {
              authUsernameStatus.textContent = '✅ اسم المستخدم متاح ويمكنك استخدامه!';
              authUsernameStatus.className = 'text-[11px] mt-1 font-semibold text-emerald-600 dark:text-emerald-400';
            } else {
              authUsernameStatus.textContent = '❌ اسم المستخدم مأخوذ بالفعل، يرجى اختيار اسم آخر';
              authUsernameStatus.className = 'text-[11px] mt-1 font-semibold text-rose-600 dark:text-rose-400';
            }
            authUsernameStatus.classList.remove('hidden');
          }
        } catch {
          authUsernameStatus?.classList.add('hidden');
        }
      }, 350);
    });

    // ─── Modal Set Permanent Username Logic ──────────────────────────────
    const modalInput = document.getElementById('modal-input-username') as HTMLInputElement | null;
    const modalStatus = document.getElementById('modal-username-status');
    const modalConfirmBtn = document.getElementById('modal-btn-confirm-username') as HTMLButtonElement | null;
    let modalCheckTimer: any = null;

    modalInput?.addEventListener('input', () => {
      clearTimeout(modalCheckTimer);
      const val = modalInput.value.trim().toLowerCase().replace(/^@/, '');
      if (!val) {
        modalStatus?.classList.add('hidden');
        if (modalConfirmBtn) modalConfirmBtn.disabled = true;
        return;
      }

      if (val.length < 3 || val.length > 25 || !/^[a-z0-9_-]+$/.test(val)) {
        if (modalStatus) {
          modalStatus.textContent = '❌ يجب أن يتكون من 3 إلى 25 حرفاً أو رقماً أو _';
          modalStatus.className = 'text-[11px] mt-1 font-semibold text-rose-600 dark:text-rose-400';
          modalStatus.classList.remove('hidden');
        }
        if (modalConfirmBtn) modalConfirmBtn.disabled = true;
        return;
      }

      if (modalStatus) {
        modalStatus.textContent = 'جاري التحقق من التوفر...';
        modalStatus.className = 'text-[11px] mt-1 font-semibold text-zinc-400';
        modalStatus.classList.remove('hidden');
      }

      modalCheckTimer = setTimeout(async () => {
        try {
          const avail = await checkUsernameAvailable(val, currentUser?.uid);
          if (modalStatus) {
            if (avail) {
              modalStatus.textContent = '✅ اسم المستخدم متاح!';
              modalStatus.className = 'text-[11px] mt-1 font-semibold text-emerald-600 dark:text-emerald-400';
              if (modalConfirmBtn) modalConfirmBtn.disabled = false;
            } else {
              modalStatus.textContent = '❌ اسم المستخدم مأخوذ بالفعل، يرجى اختيار اسم آخر';
              modalStatus.className = 'text-[11px] mt-1 font-semibold text-rose-600 dark:text-rose-400';
              if (modalConfirmBtn) modalConfirmBtn.disabled = true;
            }
            modalStatus.classList.remove('hidden');
          }
        } catch {
          modalStatus?.classList.add('hidden');
        }
      }, 350);
    });

    modalConfirmBtn?.addEventListener('click', async () => {
      if (!currentUser || !modalInput) return;
      const desired = modalInput.value.trim().toLowerCase().replace(/^@/, '');
      if (!desired) return;

      modalConfirmBtn.disabled = true;
      modalConfirmBtn.textContent = 'جاري التثبيت...';

      try {
        const res = await setPermanentUsername(currentUser.uid, desired);
        if (res.success && res.profile) {
          currentProfile = res.profile;
          document.getElementById('modal-set-username')?.classList.add('hidden');
          notify('تم تثبيت اسم المستخدم بنجاح! هذا الاسم دائم الآن.', 'success');
          renderMyProfile(res.profile);
        } else {
          notify(res.error || 'تعذر تثبيت اسم المستخدم', 'error');
          modalConfirmBtn.disabled = false;
          modalConfirmBtn.textContent = 'تأكيد وتثبيت اسم المستخدم';
        }
      } catch (err: any) {
        notify(err?.message || 'حدث خطأ غير متوقع', 'error');
        modalConfirmBtn.disabled = false;
        modalConfirmBtn.textContent = 'تأكيد وتثبيت اسم المستخدم';
      }
    });

    // Focus trap and Escape key handling for username modal
    const modalEl = document.getElementById('modal-set-username');
    if (modalEl) {
      modalEl.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          modalEl.classList.add('hidden');
          return;
        }
        if (e.key === 'Tab') {
          const focusable = modalEl.querySelectorAll<HTMLElement>('button, input, [tabindex]:not([tabindex="-1"])');
          if (focusable.length === 0) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    }

    // Sign Out
    document.getElementById('btn-signout')?.addEventListener('click', async () => {
      await signOutUser();
      notify('Signed out successfully', 'info');
      showSection('guest');
    });

    // ─── 4. Auth Handlers for Guest View ────────────────────────────────
    // Google Sign-In
    document.getElementById('btn-google-signin')?.addEventListener('click', async () => {
      try {
        const res = await signInWithGoogle();
        if (res) {
          currentUser = res.user;
          currentProfile = res.profile;
          notify(`Welcome back, ${res.profile.displayName}!`, 'success');
          renderMyProfile(res.profile);
        }
      } catch (err: any) {
        notify(err?.message || 'Google sign in failed', 'error');
      }
    });

    // Toggle Sign In vs Register Tabs
    const tabLogin = document.getElementById('tab-auth-login');
    const tabRegister = document.getElementById('tab-auth-register');
    const registerFields = document.getElementById('auth-register-fields');
    const authSubmitBtn = document.getElementById('auth-submit-btn');
    let isRegisterMode = false;

    tabLogin?.addEventListener('click', () => {
      isRegisterMode = false;
      registerFields?.classList.add('hidden');
      tabLogin.className = 'flex-1 pb-2 text-xs font-bold text-emerald-600 dark:text-emerald-400 border-b-2 border-emerald-600 dark:border-emerald-400 cursor-pointer';
      tabRegister!.className = 'flex-1 pb-2 text-xs font-semibold text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 cursor-pointer';
      if (authSubmitBtn) authSubmitBtn.textContent = 'Sign In';
    });

    tabRegister?.addEventListener('click', () => {
      isRegisterMode = true;
      registerFields?.classList.remove('hidden');
      tabRegister.className = 'flex-1 pb-2 text-xs font-bold text-emerald-600 dark:text-emerald-400 border-b-2 border-emerald-600 dark:border-emerald-400 cursor-pointer';
      tabLogin!.className = 'flex-1 pb-2 text-xs font-semibold text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 cursor-pointer';
      if (authSubmitBtn) authSubmitBtn.textContent = 'Create Account';
    });

    // Email Form Submission
    const emailForm = document.getElementById('email-auth-form');
    const authErrorMsg = document.getElementById('auth-error-msg');

    emailForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      authErrorMsg?.classList.add('hidden');

      const email = (document.getElementById('auth-email') as HTMLInputElement)?.value.trim();
      const pass = (document.getElementById('auth-password') as HTMLInputElement)?.value;

      if (!email || !pass) {
        if (authErrorMsg) {
          authErrorMsg.textContent = 'Please enter both email and password.';
          authErrorMsg.classList.remove('hidden');
        }
        return;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        if (authErrorMsg) {
          authErrorMsg.textContent = 'Please enter a valid email address.';
          authErrorMsg.classList.remove('hidden');
        }
        return;
      }

      if (pass.length < 6) {
        if (authErrorMsg) {
          authErrorMsg.textContent = 'Password must be at least 6 characters.';
          authErrorMsg.classList.remove('hidden');
        }
        return;
      }

      if (authSubmitBtn) {
        authSubmitBtn.setAttribute('disabled', 'true');
        authSubmitBtn.textContent = isRegisterMode ? 'Creating Account...' : 'Signing In...';
      }

      try {
        if (isRegisterMode) {
          const dName = (document.getElementById('auth-display-name') as HTMLInputElement)?.value.trim() || 'ASU Student';
          const uName = (document.getElementById('auth-username') as HTMLInputElement)?.value.trim().toLowerCase().replace(/^@/, '');
          if (!uName || uName.length < 3) {
            if (authErrorMsg) {
              authErrorMsg.textContent = 'يرجى إدخال اسم مستخدم فريد لحسابك (3 أحرف على الأقل).';
              authErrorMsg.classList.remove('hidden');
            }
            if (authSubmitBtn) {
              authSubmitBtn.removeAttribute('disabled');
              authSubmitBtn.textContent = 'Create Account';
            }
            return;
          }
          const res = await signUpWithEmail(email, pass, dName, uName);
          currentUser = res.user;
          currentProfile = res.profile;
          notify(`Account created! Welcome, ${res.profile.displayName}!`, 'success');
          renderMyProfile(res.profile);
        } else {
          const res = await signInWithEmail(email, pass);
          currentUser = res.user;
          currentProfile = res.profile;
          if (res.profile) {
            notify(`Welcome back, ${res.profile.displayName}!`, 'success');
            renderMyProfile(res.profile);
          }
        }
      } catch (err: any) {
        console.error(err);
        if (authErrorMsg) {
          authErrorMsg.textContent = err?.message || 'Authentication error occurred.';
          authErrorMsg.classList.remove('hidden');
        }
      } finally {
        if (authSubmitBtn) {
          authSubmitBtn.removeAttribute('disabled');
          authSubmitBtn.textContent = isRegisterMode ? 'Create Account' : 'Sign In';
        }
      }
    });

    // ─── 5. Initial State Detection ─────────────────────────────────────
    if (targetUsername) {
      renderPublicProfile(targetUsername, false);
      return;
    }

    if (targetUid) {
      renderPublicProfile(targetUid, true);
      return;
    }

    // Fast initial render from local cached profile if available
    if (currentProfile) {
      renderMyProfile(currentProfile);
    }

    let hasShownProfile = false;

    // Safety fallback: if Firebase Auth takes more than 2.5s (e.g. storage access blocked), never stay stuck on loading skeleton
    const safetyTimer = setTimeout(() => {
      if (!loadingSkeleton?.classList.contains('hidden')) {
        if (currentProfile) {
          hasShownProfile = true;
          renderMyProfile(currentProfile);
        } else {
          showSection('guest');
        }
      }
    }, 2500);

    // Subscribe to Auth state
    if (unsubscribeAuth) unsubscribeAuth();
    unsubscribeAuth = onAuthChange((user, profile) => {
      clearTimeout(safetyTimer);
      currentUser = user;
      currentProfile = profile;

      if (user && profile) {
        hasShownProfile = true;
        renderMyProfile(profile);
      } else if (!hasShownProfile) {
        showSection('guest');
      }
    });
  }

  initProfilePage();
  document.addEventListener('astro:after-swap', initProfilePage);
</script>
