    <!-- 3. PUBLIC SHAREABLE PROFILE CONTAINER (Viewing Someone's Profile) -->
    <div id="public-profile-container" class="hidden space-y-8">
      <!-- Public Profile Header Card -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 text-center sm:text-start">
          <!-- Avatar -->
          <div class="w-24 h-24 rounded-2xl overflow-hidden bg-emerald-100 dark:bg-zinc-800 border-2 border-emerald-500/40 flex items-center justify-center shrink-0 shadow-sm">
            <img
              id="public-avatar-img"
              src=""
              alt="Avatar"
              class="w-full h-full object-cover hidden"
            />
            <span id="public-avatar-initials" class="text-2xl font-black text-emerald-700 dark:text-emerald-400"></span>
          </div>

          <!-- Info -->
          <div class="flex-1 space-y-1.5">
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
              <h1 id="public-profile-name" class="text-xl sm:text-2xl font-extrabold text-zinc-900 dark:text-zinc-100"></h1>
              <span id="public-profile-year-badge" class="hidden px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400"></span>
              <span id="public-profile-contrib-badge" class="hidden px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-400 border border-amber-200/60 dark:border-amber-800/40"></span>
            </div>
            <p id="public-profile-handle" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400"></p>
            <p id="public-profile-admin-role" class="hidden text-xs font-semibold text-emerald-700 dark:text-emerald-400 bg-emerald-50/70 dark:bg-emerald-950/30 px-2.5 py-0.5 rounded-lg border border-emerald-200/50 dark:border-emerald-800/40 inline-block"></p>
            <p id="public-profile-bio" class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 max-w-xl leading-relaxed pt-1"></p>
            <div id="public-profile-contacts-container" class="mt-3 flex flex-wrap gap-1.5 justify-center sm:justify-start"></div>
          </div>

          <!-- Share Button -->
          <button
            type="button"
            id="btn-share-public-profile"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-all cursor-pointer shadow-2xs shrink-0"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
            </svg>
            <span>Share Profile</span>
          </button>
        </div>
      </div>

      <!-- Public Contributions Section -->
      <div class="space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-zinc-200 dark:border-zinc-800">
          <h2 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100">
            Contributions & Study Materials
          </h2>
          <span id="public-contributions-count" class="text-xs font-semibold text-zinc-400"></span>
        </div>

        <div id="public-contributions-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Populated by client script -->
        </div>

        <div id="public-contributions-empty" class="hidden py-10 text-center border border-dashed border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 bg-white dark:bg-zinc-900/40">
          <p class="text-xs text-zinc-400 dark:text-zinc-500">
            No public contributions shared by this student yet.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Choose Permanent Username Modal (Shown for accounts without custom username) -->
  <div id="modal-set-username" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-900/60 backdrop-blur-xs" role="dialog" aria-modal="true" aria-labelledby="modal-username-title">
    <div class="w-full max-w-md p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xl space-y-4 text-start">
      <div class="flex items-center gap-2.5">
        <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 flex items-center justify-center text-lg font-bold">
          👤
        </div>
        <div>
          <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100">
            اختر اسم المستخدم الخاص بك (Username)
          </h3>
          <p class="text-[11px] text-zinc-500 dark:text-zinc-400">
            هذا الاسم سيكون معرّف حسابك ورابط ملفك الشخصي الدائم.
          </p>
        </div>
      </div>

      <div class="p-3 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/40 text-[11px] text-amber-800 dark:text-amber-300 flex items-center gap-2">
        <span class="text-base shrink-0">⚠️</span>
        <span>
          <strong>تنبيه هام:</strong> اسم المستخدم يُختار مرة واحدة فقط، ولا يمكن تغييره لاحقاً لحماية هويتك ومساهماتك.
        </span>
      </div>

      <div class="space-y-1.5">
        <label for="modal-input-username" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300">
          اسم المستخدم المرغوب <span class="text-emerald-600">*</span>
        </label>
        <div class="relative flex items-center">
          <span class="absolute left-3 text-zinc-400 text-xs font-mono">@</span>
          <input
            type="text"
            id="modal-input-username"
            placeholder="e.g. mohamed_wael"
            class="w-full text-xs pl-7 pr-3 py-2 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-zinc-100 font-mono"
          />
