---
import Layout from '../layouts/Layout.astro';
import { getAllMaterials } from '../data/materials';

const allMaterials = await getAllMaterials();
---

<Layout
  title="Student Profile - ASU Med Materials"
  description="Manage your medical student profile, customize your avatar and bio, and share your contributions at ASU Faculty of Medicine."
>
  <div class="max-w-4xl mx-auto py-4 text-start">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400 mb-6">
      <a href="/" data-i18n="nav.home" class="hover:text-emerald-600 dark:hover:text-emerald-400">Home</a>
      <span>/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-bold" id="profile-breadcrumb-title" data-i18n="nav.profile">Profile</span>
    </div>

    <!-- Loading State Skeleton -->
    <div id="profile-loading-skeleton" class="py-12 flex flex-col items-center justify-center text-center">
      <div class="w-10 h-10 border-3 border-emerald-500 border-t-transparent rounded-full animate-spin mb-3"></div>
      <p class="text-xs text-zinc-500 dark:text-zinc-400">Loading student profile...</p>
    </div>

    <!-- 1. GUEST VIEW CONTAINER -->
    <div id="guest-view-container" class="hidden space-y-6">
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm text-center max-w-xl mx-auto">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
        </div>

        <h1 class="text-xl sm:text-2xl font-extrabold text-zinc-900 dark:text-zinc-100 mb-2">
          Medical Student Profile
        </h1>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed mb-6">
          Sign in to customize your profile, upload your avatar, track your material contributions, and get a shareable public link.
        </p>

        <!-- Offline/Guest Notice -->
        <div class="p-3.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200/80 dark:border-zinc-700/60 text-xs text-zinc-600 dark:text-zinc-300 text-start mb-6 flex items-start gap-2.5">
          <span class="text-base shrink-0 mt-0.5">ℹ️</span>
          <span><strong>Guest Mode:</strong> You can continue using the site without an account. All study materials, search, and bookmarks work 100% offline without signing in.</span>
        </div>

        <!-- Google Sign-In Button -->
        <button
          type="button"
          id="btn-google-signin"
          class="w-full flex items-center justify-center gap-3 py-2.5 px-4 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 hover:bg-zinc-50 dark:hover:bg-zinc-700/60 text-zinc-800 dark:text-zinc-200 text-xs sm:text-sm font-bold transition-all shadow-2xs cursor-pointer mb-4"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
          </svg>
          <span>Continue with Google</span>
        </button>

        <div class="relative flex py-2 items-center mb-4">
          <div class="flex-grow border-t border-zinc-200 dark:border-zinc-800"></div>
          <span class="flex-shrink mx-3 text-zinc-400 text-xs uppercase font-medium">Or with Email</span>
          <div class="flex-grow border-t border-zinc-200 dark:border-zinc-800"></div>
        </div>

        <!-- Email Sign In / Sign Up Form -->
        <div class="text-start">
          <div class="flex border-b border-zinc-200 dark:border-zinc-800 mb-4">
            <button
              type="button"
              id="tab-auth-login"
              class="flex-1 pb-2 text-xs font-bold text-emerald-600 dark:text-emerald-400 border-b-2 border-emerald-600 dark:border-emerald-400 cursor-pointer"
            >
              Sign In
            </button>
            <button
              type="button"
              id="tab-auth-register"
              class="flex-1 pb-2 text-xs font-semibold text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 cursor-pointer"
            >
              Create Account
            </button>
          </div>

          <form id="email-auth-form" class="space-y-3">
            <div id="auth-register-fields" class="space-y-3 hidden">
              <div>
                <label for="auth-display-name" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">Full Name</label>
                <input
                  type="text"
                  id="auth-display-name"
                  placeholder="e.g. Mohamed Wael"
                  class="w-full text-xs px-3 py-2 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-zinc-100"
                />
              </div>

              <div>
                <div class="flex items-center justify-between mb-1">
                  <label for="auth-username" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300">
                    Username Handle <span class="text-emerald-600">*</span>
                  </label>
                  <span class="text-[10px] text-zinc-400 dark:text-zinc-500">Permanent 🔒</span>
                </div>
                <div class="relative flex items-center">
                  <span class="absolute left-3 text-zinc-400 text-xs font-mono">@</span>
                  <input
                    type="text"
                    id="auth-username"
                    placeholder="e.g. ahmed_wael"
                    class="w-full text-xs pl-7 pr-3 py-2 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-zinc-100 font-mono"
                  />
                </div>
                <div id="auth-username-status" class="hidden text-[11px] mt-1 font-semibold"></div>
              </div>
            </div>

            <div>
              <label for="auth-email" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">Email</label>
              <input
                type="email"
                id="auth-email"
                required
                placeholder="name@std.asu.edu.eg or personal email"
                class="w-full text-xs px-3 py-2 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-zinc-100"
              />
            </div>

            <div>
              <label for="auth-password" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">Password</label>
              <input
                type="password"
                id="auth-password"
                required
                placeholder="••••••••"
                class="w-full text-xs px-3 py-2 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-zinc-100"
              />
            </div>

            <div id="auth-error-msg" class="hidden text-xs text-rose-600 dark:text-rose-400 font-semibold p-2 rounded-lg bg-rose-50 dark:bg-rose-950/40"></div>

            <button
              type="submit"
              id="auth-submit-btn"
              class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-colors cursor-pointer shadow-2xs"
            >
              Sign In
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- 2. MY PROFILE DASHBOARD CONTAINER (Logged In) -->
    <div id="my-profile-container" class="hidden space-y-8">
      <!-- Profile Header Card -->
      <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6">
          <!-- Avatar with Upload Overlay -->
          <div class="relative group">
            <div class="w-24 h-24 rounded-2xl overflow-hidden bg-emerald-100 dark:bg-zinc-800 border-2 border-emerald-500/40 flex items-center justify-center shadow-sm">
              <img
                id="my-avatar-img"
                src=""
                alt="Avatar"
                class="w-full h-full object-cover hidden"
              />
              <span id="my-avatar-initials" class="text-2xl font-black text-emerald-700 dark:text-emerald-400"></span>
            </div>

            <!-- Avatar URL edit hint -->
            <div class="absolute -bottom-2 -right-2 p-2 rounded-xl bg-emerald-600 text-white shadow-md" title="Set avatar via URL in the edit section below">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
              </svg>
            </div>
          </div>

          <!-- Profile Details Header -->
          <div class="flex-1 text-center sm:text-start space-y-1">
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
              <h2 id="my-profile-name" class="text-xl font-extrabold text-zinc-900 dark:text-zinc-100"></h2>
              <span id="my-profile-year-badge" class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400"></span>
              <span id="my-profile-contrib-badge" class="hidden px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-400 border border-amber-200/60 dark:border-amber-800/40"></span>
            </div>
            <p id="my-profile-handle" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400"></p>
            <p id="my-profile-admin-role" class="hidden text-xs font-semibold text-emerald-700 dark:text-emerald-400 bg-emerald-50/70 dark:bg-emerald-950/30 px-2.5 py-0.5 rounded-lg border border-emerald-200/50 dark:border-emerald-800/40 inline-block"></p>
            <p id="my-profile-bio-text" class="text-xs text-zinc-500 dark:text-zinc-400 max-w-lg mt-2 leading-relaxed"></p>
            <div id="my-profile-contacts-container" class="mt-3 flex flex-wrap gap-1.5 justify-center sm:justify-start"></div>
          </div>

          <!-- Profile Actions -->
          <div class="flex flex-wrap items-center gap-2 shrink-0">
            <button
              type="button"
              id="btn-copy-my-share-link"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 hover:bg-zinc-50 dark:hover:bg-zinc-700/60 text-xs font-bold text-zinc-700 dark:text-zinc-200 transition-all cursor-pointer shadow-2xs"
            >
              <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
              </svg>
              <span>Share Profile</span>
            </button>

            <!-- Admin Dashboard button (Shown if profile.role === 'admin') -->
            <a
              href="/admin"
              id="btn-profile-admin-dashboard"
              class="hidden items-center gap-1.5 px-3 py-1.5 rounded-xl border border-amber-300 dark:border-amber-700/60 bg-amber-50 dark:bg-amber-950/60 hover:bg-amber-100 dark:hover:bg-amber-900/60 text-xs font-bold text-amber-800 dark:text-amber-300 transition-all cursor-pointer shadow-2xs"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
              </svg>
              <span data-i18n="admin.badge">لوحة الإدارة</span>
            </a>

            <button
              type="button"
              id="btn-signout"
              class="px-3 py-1.5 rounded-xl text-xs font-bold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer"
            >
              Sign Out
            </button>
          </div>
        </div>

        <div id="avatar-upload-status" class="hidden mt-3 text-xs text-emerald-600 dark:text-emerald-400 font-semibold text-center sm:text-start">
          Uploading image to Firebase Storage...
        </div>
      </div>

      <!-- Edit Profile Section -->
      <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm">
        <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 mb-4 pb-2 border-b border-zinc-100 dark:border-zinc-800">
          Edit Profile Information
        </h3>

        <form id="edit-profile-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="edit-display-name" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">Display Name</label>
              <input
                type="text"
                id="edit-display-name"
                required
                class="w-full text-xs px-3 py-2 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-zinc-100"
              />
            </div>

            <div>
              <div class="flex items-center justify-between mb-1">
                <label for="edit-username" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300">
                  Username Handle (Public URL)
                </label>
                <span class="text-[10px] text-zinc-400 dark:text-zinc-500 font-semibold flex items-center gap-1">
                  <span>Permanent</span>
                  <span>🔒</span>
                </span>
              </div>
              <div class="relative flex items-center">
                <span class="absolute left-3 text-zinc-400 text-xs font-mono">@</span>
                <input
                  type="text"
                  id="edit-username"
                  disabled
                  readonly
                  class="w-full text-xs pl-7 pr-3 py-2 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-100/80 dark:bg-zinc-800/60 text-zinc-500 dark:text-zinc-400 cursor-not-allowed select-all font-mono"
                />
              </div>
              <p class="text-[10px] text-zinc-400 dark:text-zinc-500 mt-1">
                اسم المستخدم دائم ويمثل هويتك ورابط ملفك الشخصي العام ولا يمكن تغييره.
              </p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="edit-academic-year" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">Academic Year</label>
              <select
                id="edit-academic-year"
                class="w-full text-xs px-3 py-2 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-zinc-100 cursor-pointer"
              >
                <option value="">Not selected</option>
                <option value="1">Year 1 - Foundation & Musculoskeletal</option>
                <option value="2">Year 2 - Blood, Endocrine, CVS, RS</option>
                <option value="3">Year 3 - GIT, Renal, CNS</option>
                <option value="4">Year 4 - Clinical Rotations</option>
                <option value="5">Year 5 - Surgery, Obs & Gyn, Paediatrics</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">Public Profile Link</label>
              <div class="flex items-center gap-1.5">
                <input
                  type="text"
                  id="my-share-url-preview"
                  readonly
                  class="w-full text-xs px-3 py-2 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/50 text-zinc-500 dark:text-zinc-400 select-all"
                />
                <button
                  type="button"
                  id="btn-copy-preview-link"
                  class="px-3 py-2 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-xs font-bold text-zinc-700 dark:text-zinc-300 shrink-0 cursor-pointer"
                >
                  Copy
                </button>
              </div>
            </div>
          </div>

          <div>
            <label for="edit-bio" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">About Me (Bio)</label>
            <textarea
              id="edit-bio"
              rows="3"
              placeholder="e.g. Ain Shams Med Student | Contributing materials for Blood & CVS modules"
              class="w-full text-xs px-3 py-2 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-zinc-100 leading-relaxed"
            ></textarea>
          </div>

          <div>
            <label for="edit-avatar-url" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">Profile Picture URL</label>
            <input
              type="url"
              id="edit-avatar-url"
              placeholder="https://example.com/your-image.jpg"
              class="w-full text-xs px-3 py-2 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-zinc-100"
            />
            <p class="text-[10px] text-zinc-400 dark:text-zinc-500 mt-1">
              Upload your image to any hosting service (Imgur, Google Drive, etc.) and paste the direct link here.
            </p>
          </div>

          <!-- Admin Role Description (Displayed on Core Team Card) -->
          <div id="group-admin-role-desc" class="hidden">
            <label for="edit-admin-role-desc" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-1">
              Admin Role Description (الدور في الفريق)
            </label>
            <input
              type="text"
              id="edit-admin-role-desc"
              placeholder="e.g. مطور المنصة ومسؤول المواد الدراسية"
              class="w-full text-xs px-3 py-2 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-zinc-100"
            />
            <p class="text-[10px] text-zinc-400 dark:text-zinc-500 mt-1">
              يظهر هذا المسمى أسفل اسمك في بطاقتك بقسم الفريق الأساسي (Core Team).
            </p>
          </div>

          <!-- Social / Contact Links for all users -->
          <div class="space-y-3 pt-3 border-t border-zinc-100 dark:border-zinc-800">
            <div class="flex items-center justify-between">
              <div>
                <label class="block text-xs font-bold text-zinc-700 dark:text-zinc-300">
                  Social & Contact Links (وسائل التواصل والروابط)
                </label>
                <p class="text-[10px] text-zinc-400 dark:text-zinc-500">
                  تظهر روابطك في ملفك الشخصي وفي بطاقة الفريق إذا كنت مسؤولاً.
                </p>
              </div>
              <button
                type="button"
                id="btn-add-contact-row"
                class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/40 text-xs font-bold transition-all cursor-pointer"
              >
                <span>+ إضافة رابط</span>
              </button>
            </div>
            <div id="contacts-editor-list" class="space-y-2">
              <!-- Contact rows dynamically added by script -->
            </div>
          </div>

          <div class="flex justify-end pt-2">
            <button
              type="submit"
              id="btn-save-profile"
              class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-all shadow-2xs cursor-pointer active:scale-95"
            >
              Save Changes
            </button>
          </div>
        </form>
      </div>

      <!-- My Contributions Section -->
      <div class="space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-zinc-200 dark:border-zinc-800">
          <div class="flex items-center gap-2">
            <h3 class="text-base font-bold text-zinc-900 dark:text-zinc-100">
              My Material Contributions
            </h3>
            <span id="my-contributions-count" class="text-xs font-semibold text-zinc-400"></span>
          </div>
          <a href="/contribute" class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">
            + Share More Materials
          </a>
        </div>

        <div id="my-contributions-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Populated by client script -->
        </div>

        <div id="my-contributions-empty" class="hidden py-8 text-center border border-dashed border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 bg-white dark:bg-zinc-900/40">
          <p class="text-xs text-zinc-400 dark:text-zinc-500">
            You haven't contributed any materials yet. Share your study drives or notes to help fellow med students!
          </p>
          <a
            href="/contribute"
            class="inline-block mt-3 px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-700 transition-colors shadow-2xs"
          >
            Contribute Material
          </a>
        </div>

        <!-- My Pending Submissions (Shown when user has submissions under review) -->
        <div id="my-pending-submissions-container" class="hidden mt-6 pt-4 border-t border-zinc-200 dark:border-zinc-800 space-y-3">
          <div class="flex items-center justify-between">
