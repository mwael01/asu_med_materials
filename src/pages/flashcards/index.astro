---
import Layout from '../../layouts/Layout.astro';
import DeckList from '../../components/flashcards/DeckList.astro';
import { getPublishedFlashcardDecks } from '../../firebase/flashcards';
import { getAllModules } from '../../data/modules';

const [decks, modules] = await Promise.all([
  getPublishedFlashcardDecks(),
  getAllModules()
]);
---

<Layout
  title="البطاقات الاستذكارية (Flashcards) | طب عين شمس"
  description="بطاقات المذاكرة والأسئلة التفاعلية المحفوظة تلقائياً لمذاكرة كاملة أوفلاين بدون إنترنت."
>
  <div class="space-y-6">
    <!-- Breadcrumb & Page Header -->
    <div class="flex items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400">
      <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors" data-i18n="flashcards.breadcrumbHome">
        الرئيسية
      </a>
      <span class="rtl:rotate-180 text-zinc-300 dark:text-zinc-700">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold" data-i18n="flashcards.breadcrumbFlashcards">
        البطاقات الاستذكارية
      </span>
    </div>

    <!-- Header Banner -->
    <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-2xs space-y-2 text-start">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-[11px] font-bold bg-emerald-50 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/40">
        ✨ ميزة جديدة
      </div>
      <h1 class="text-xl sm:text-2xl font-extrabold text-zinc-900 dark:text-zinc-100" data-i18n="flashcards.title">
        البطاقات الاستذكارية (Flashcards)
      </h1>
      <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 max-w-2xl leading-relaxed" data-i18n="flashcards.subtitle">
        مجموعات بطاقات المذاكرة التفاعلية المحفوظة تلقائياً على جهازك للمذاكرة والمراجعة السريعة بدون اتصال بالإنترنت.
      </p>
    </div>

    <!-- Main Decks Catalog -->
    <DeckList decks={decks} modules={modules} selectedYear={2} />
  </div>
</Layout>
