---
import Layout from '../layouts/Layout.astro';
import ModuleDirectory from '../components/materials/ModuleDirectory.astro';
import SavedYearScope from '../components/materials/SavedYearScope.astro';
import { getAllModules } from '../data/modules';

const modules = await getAllModules();
---

<Layout
  title="All Medical Modules (Years 1–5) | ASU Med"
  description="Browse all curriculum modules across Years 1 to 5 for Ain Shams University Faculty of Medicine (ASU Med), including lectures, PDFs, flashcards, and revisions."
  crumbs={[{ title: 'Modules' }]}
  backHref="/"
>
  <section data-saved-year-scope>
    <div class="flex items-center justify-between gap-4 mb-6">
      <h1 class="text-xl font-bold">Modules <span data-year-label class="text-sm font-normal text-zinc-500 ml-2"></span></h1>
      <button type="button" class="trigger-multistage-selector text-sm text-emerald-600 hover:underline cursor-pointer">Change year</button>
    </div>
    {[1, 2, 3, 4, 5].map((year) => (
      <div data-scope-year={year} hidden>
        <ModuleDirectory modules={modules.filter((module) => module.year === year)} />
      </div>
    ))}
    <p data-year-empty class="text-sm text-zinc-500" hidden>Choose your year to continue.</p>
  </section>
  <SavedYearScope />
</Layout>
