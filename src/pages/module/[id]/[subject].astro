---
import Layout from '../../../layouts/Layout.astro';
import PageHeading from '../../../components/common/PageHeading.astro';
import NavigationCards from '../../../components/common/NavigationCards.astro';
import ResourceGrid from '../../../components/materials/ResourceGrid.astro';
import type { NavCrumb } from '../../../types/navigation';
import { getModuleById, getAllModules } from '../../../data/modules';
import { getMaterialsByModuleAndSubject } from '../../../data/materials';
import { getPublicLessons } from '../../../data/catalogue.server';
import { getMaterialsVersionFromFirestore } from '../../../firebase/firestore';
import { subjectToSlug } from '../../../utils/slug';
import { lessonsForSubject, lessonPath, isRevisionLesson } from '../../../utils/lessons';
import { studyEntries } from '../../../utils/studyContent';
import { isMaterialAssignedToLesson } from '../../../utils/materialLessonLinks';
import { buildSubjectSeo, buildSubjectJsonLd, resolveSiteOrigin } from '../../../utils/seo';

const version = await getMaterialsVersionFromFirestore();
const module = await getModuleById(Astro.params.id || '', version);
if (!module) return Astro.redirect('/404');
const subject = module.subjects.find(item => subjectToSlug(item) === Astro.params.subject);
if (!subject) return Astro.redirect('/404');

const [materials, allLessons, allModules] = await Promise.all([
  getMaterialsByModuleAndSubject(module.id, subject, version),
  getPublicLessons(version),
  getAllModules(version)
]);

const siblingModules = allModules.filter(m => m.year === module.year);
const subjectSlug = subjectToSlug(subject);

const moduleMenu = siblingModules.map(m => ({
  title: m.title,
  href: `/module/${m.id}`,
  active: m.id === module.id
}));

const subjectMenu = module.subjects.map(s => ({
  title: s,
  href: `/module/${module.id}/${subjectToSlug(s)}`,
  active: subjectToSlug(s) === subjectSlug
}));

const yearMenu = ([1, 2, 3, 4, 5] as const).map(y => ({
  title: `Year ${y}`,
  href: `/year/${y}`,
  active: y === module.year
}));

const crumbs: NavCrumb[] = [
  {
    title: `Year ${module.year}`,
    href: `/year/${module.year}`,
    isYear: true,
    year: module.year,
    menu: yearMenu
  },
  {
    title: module.title,
    href: `/module/${module.id}`,
    isModule: true,
    year: module.year,
    menu: moduleMenu
  },
  {
    title: subject,
    menu: subjectMenu
  }
];

const subjectLessons = lessonsForSubject(allLessons, module.id, subject);

// Regular syllabus lessons are always visible to preserve complete curriculum structure
const regularLessons = subjectLessons.filter(l => !isRevisionLesson(l));

// Revision lessons (Practical, Assessments, Finals) are displayed only if they contain materials
const revisionLessons = subjectLessons.filter(l => isRevisionLesson(l) && materials.some(m => isMaterialAssignedToLesson(m, l)));

const unassigned = materials.filter(item => !subjectLessons.some(lesson => isMaterialAssignedToLesson(item, lesson)));
const isGeneralLink = (item: typeof materials[number]) => {
  const entries = studyEntries([item]);
  return entries.length > 0 && entries.every(entry => entry.tab === 'links');
};
const links = unassigned.filter(isGeneralLink);
const resources = unassigned.filter(item => !isGeneralLink(item));
const visibleLessons = [...regularLessons, ...revisionLessons];
const seo = buildSubjectSeo(module, subject, visibleLessons, materials.length);
const subjectJsonLd = buildSubjectJsonLd(resolveSiteOrigin(import.meta.env.PUBLIC_SITE_URL), module, subject, visibleLessons);
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  jsonLd={subjectJsonLd}
  crumbs={crumbs}
  backHref={`/module/${module.id}`}
>
  <PageHeading title={subject} />

  <!-- Regular Lessons (always shown, even if empty) -->
  <section>
    <h2 class="text-base font-semibold mb-4">Lessons</h2>
    <NavigationCards
      items={regularLessons.map(lesson => ({
        title: lesson.title,
        href: lessonPath(lesson),
        subject
      }))}
      emptyMessage="No lessons available yet."
    />
  </section>

  <!-- Revision Lessons (hidden if empty) -->
  {revisionLessons.length > 0 && (
    <section class="mt-8">
      <h2 class="text-base font-semibold mb-4">Revisions</h2>
      <NavigationCards
        items={revisionLessons.map(lesson => ({
          title: lesson.title,
          href: lessonPath(lesson),
          subject
        }))}
      />
    </section>
  )}

  {resources.length > 0 && (
    <section class="mt-8">
      <h2 class="text-base font-semibold mb-4">Subject resources</h2>
      <ResourceGrid materials={resources} />
    </section>
  )}

  {links.length > 0 && (
    <section class="mt-8">
      <h2 class="text-base font-semibold mb-4">Links</h2>
      <ResourceGrid materials={links} />
    </section>
  )}
</Layout>
