---
import Layout from '../../../../../../../layouts/Layout.astro';
import PageHeading from '../../../../../../../components/common/PageHeading.astro';
import DoctorPlayer from '../../../../../../../components/study/DoctorPlayer.astro';
import type { NavCrumb } from '../../../../../../../types/navigation';
import { loadLessonPage } from '../../../../../../../data/lessons';
import { getAllModules } from '../../../../../../../data/modules';
import { getPublicLessons } from '../../../../../../../data/catalogue.server';
import { getMaterialsVersionFromFirestore } from '../../../../../../../firebase/firestore';
import { findLessonDoctor, lessonDoctors, lessonPath, lessonsForSubject } from '../../../../../../../utils/lessons';
import { studyEntries, isFlashcards } from '../../../../../../../utils/studyContent';
import { isPracticalImageMaterial, practicalImagePath } from '../../../../../../../utils/practicalImages';
import { subjectToSlug } from '../../../../../../../utils/slug';
import { buildDoctorSeo, buildDoctorJsonLd, resolveSiteOrigin } from '../../../../../../../utils/seo';

const version = await getMaterialsVersionFromFirestore();
const context = await loadLessonPage(Astro.params.id || '', Astro.params.subject || '', Astro.params.lessonId || '', version);
if (!context) return Astro.redirect('/404');
const { module, lesson, materials } = context;

const requestedImage = Astro.url.searchParams.get('item');
const imageMaterial = materials.find(material => isPracticalImageMaterial(material) &&
  material.documents?.some(document => JSON.stringify([material.id, 'documents', document.id]) === requestedImage));
if (imageMaterial) {
  const document = imageMaterial.documents!.find(document => JSON.stringify([imageMaterial.id, 'documents', document.id]) === requestedImage);
  const path = practicalImagePath(imageMaterial, [lesson], document?.id);
  if (path) return Astro.redirect(path, 302);
}
const allDoctors = lessonDoctors(materials.filter(item => !isFlashcards(item) && !isPracticalImageMaterial(item)));
const doctor = findLessonDoctor(allDoctors, Astro.params.doctorKey || '');
if (doctor && doctor.key !== Astro.params.doctorKey) {
  return Astro.redirect(`${lessonPath(lesson)}/doctor/${doctor.key}${Astro.url.search}`, 302);
}
if (!doctor) {
  const previous = lessonDoctors(materials).find(item => item.key === Astro.params.doctorKey);
  const path = previous?.items[0] && practicalImagePath(previous.items[0], [lesson]);
  return Astro.redirect(path || '/404', 302);
}

const [allModules, allLessons] = await Promise.all([
  getAllModules(version),
  getPublicLessons(version)
]);
const siblingModules = allModules.filter(item => item.year === module.year && item.active !== false);
const siblingLessons = lessonsForSubject(allLessons, module.id, lesson.subject);

const subjectSlug = subjectToSlug(lesson.subject);
const moduleMenu = siblingModules.map(m => ({
  title: m.title,
  href: `/module/${m.id}`,
  active: m.id === module.id
}));
const subjectMenu = module.subjects.map(s => ({
  title: s,
  href: `/module/${module.id}/${subjectToSlug(s)}`,
  active: subjectToSlug(s) === subjectSlug
}));
const lessonMenu = siblingLessons.map(l => ({
  title: l.title,
  href: lessonPath(l),
  active: l.id === lesson.id
}));
const doctorMenu = allDoctors.map(d => ({
  title: d.name,
  href: `${lessonPath(lesson)}/doctor/${d.key}`,
  active: d.key === doctor.key
}));

const yearMenu = ([1, 2, 3, 4, 5] as const).map(y => ({
  title: `Year ${y}`,
  href: `/year/${y}`,
  active: y === module.year
}));

const crumbs: NavCrumb[] = [
  {
    title: `Year ${module.year}`,
    href: `/year/${module.year}`,
    isYear: true,
    year: module.year,
    menu: yearMenu
  },
  {
    title: module.title,
    href: `/module/${module.id}`,
    isModule: true,
    year: module.year,
    menu: moduleMenu
  },
  {
    title: lesson.subject,
    href: `/module/${module.id}/${subjectSlug}`,
    menu: subjectMenu
  },
  {
    title: lesson.title,
    href: lessonPath(lesson),
    menu: lessonMenu
  },
  {
    title: doctor.name,
    menu: doctorMenu
  }
];

const backHref = lessonPath(lesson);
const entries = studyEntries(doctor.items);
const seo = buildDoctorSeo(module, lesson, doctor, entries);
const doctorJsonLd = buildDoctorJsonLd(resolveSiteOrigin(import.meta.env.PUBLIC_SITE_URL), module, lesson, doctor, entries);
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  jsonLd={doctorJsonLd}
  crumbs={crumbs}
  backHref={backHref}
>
  <PageHeading title={doctor.name} />
  <DoctorPlayer entries={entries} materials={doctor.items} />
</Layout>
