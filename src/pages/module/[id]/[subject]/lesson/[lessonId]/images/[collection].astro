---
import Layout from '../../../../../../../layouts/Layout.astro';
import PageHeading from '../../../../../../../components/common/PageHeading.astro';
import PracticalImageViewer from '../../../../../../../components/study/PracticalImageViewer.astro';
import { loadLessonPage } from '../../../../../../../data/lessons';
import { lessonPath } from '../../../../../../../utils/lessons';
import { practicalFolderImages } from '../../../../../../../utils/practicalImages';
const { id, subject, lessonId, collection } = Astro.params;
const context = await loadLessonPage(id || '', subject || '', lessonId || '');
if (!context) return Astro.redirect('/404');
const folders = context.lesson.practicalImageFolders || [];
const folder = folders.find(folder => folder.id === collection);
if (!folder) {
  if (collection === 'slides' || collection === 'gross') return Astro.redirect(folders.length === 1 ? `${lessonPath(context.lesson)}/images/${folders[0].id}` : lessonPath(context.lesson), 302);
  return Astro.redirect('/404');
}
const images = practicalFolderImages(context.materials, context.lesson, folder.id);
---
<Layout title={`${folder.title} - ASU Med`} backHref={lessonPath(context.lesson)}>
  <PageHeading title={folder.title} />
  <PracticalImageViewer images={images} />
</Layout>
