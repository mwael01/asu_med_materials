---
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/common/PageHeading.astro';
import NavigationCards from '../../components/common/NavigationCards.astro';
import SubjectIcon from '../../components/materials/SubjectIcon.astro';
import type { NavCrumb } from '../../types/navigation';
import { getModuleById, getAllModules } from '../../data/modules';
import { getPublicLessons } from '../../data/catalogue.server';
import { getMaterialsVersionFromFirestore } from '../../firebase/firestore';
import { getModuleAppearance } from '../../utils/subjectAppearance';
import { subjectToSlug } from '../../utils/slug';
import { lessonsForSubject } from '../../utils/lessons';
import { buildModuleSeo, buildModuleJsonLd, resolveSiteOrigin } from '../../utils/seo';

const version = await getMaterialsVersionFromFirestore();
const module = await getModuleById(Astro.params.id || '', version);
if (!module) return Astro.redirect('/404');

const [allLessons, allModules] = await Promise.all([
  getPublicLessons(version),
  getAllModules(version)
]);

// Filter out unlessoned subjects
const activeSubjects = module.subjects.filter(subject => {
  return lessonsForSubject(allLessons, module.id, subject).length > 0;
});

const siblingModules = allModules.filter(m => m.year === module.year && m.active !== false);

const yearMenu = ([1, 2, 3, 4, 5] as const).map(y => ({
  title: `Year ${y}`,
  href: `/year/${y}`,
  active: y === module.year
}));

const moduleMenu = siblingModules.map(m => ({
  title: m.title,
  href: `/module/${m.id}`,
  active: m.id === module.id
}));

const crumbs: NavCrumb[] = [
  {
    title: `Year ${module.year}`,
    href: `/year/${module.year}`,
    isYear: true,
    year: module.year,
    menu: yearMenu
  },
  {
    title: module.title,
    isModule: true,
    year: module.year,
    menu: moduleMenu
  }
];

const appearance = getModuleAppearance(module);
const visibleSubjects = activeSubjects.length > 0 ? activeSubjects : module.subjects;
const seo = buildModuleSeo(module, visibleSubjects);
const moduleJsonLd = buildModuleJsonLd(resolveSiteOrigin(import.meta.env.PUBLIC_SITE_URL), module, visibleSubjects);
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  jsonLd={moduleJsonLd}
  crumbs={crumbs}
  backHref={`/year/${module.year}`}
>
  <PageHeading title={module.title}>
    <div class="flex items-center gap-2">
      <a
        href="/modules"
        class="hidden sm:inline-flex items-center px-2.5 py-1.5 rounded-lg text-xs font-medium text-zinc-600 dark:text-zinc-300 hover:text-emerald-500 border border-zinc-200 dark:border-zinc-800 transition-colors"
      >
        All Modules
      </a>
      <span class:list={['w-10 h-10 rounded-xl flex items-center justify-center shrink-0 shadow-2xs', appearance.colors]} title={module.title}>
        <SubjectIcon name={appearance.icon} />
      </span>
    </div>
  </PageHeading>

  <NavigationCards
    items={(activeSubjects.length > 0 ? activeSubjects : module.subjects).map(subject => ({
      title: subject,
      href: `/module/${module.id}/${subjectToSlug(subject)}`,
      subject
    }))}
    emptyMessage="No subjects available yet."
  />
</Layout>
