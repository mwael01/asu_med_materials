---
import Layout from '../layouts/Layout.astro';
import AuthorCard from '../components/contributors/AuthorCard.astro';
import ContributorCard from '../components/contributors/ContributorCard.astro';
import { getAllContributors, getAuthors, getResourceContributors } from '../utils/contributors';

const contributors = getAllContributors();
const resourceContributors = getResourceContributors();
const authors = getAuthors();
const CREATORS_INITIAL_LIMIT = 12;
---

<Layout
  title="Team & Contributors - ASU Med Materials"
  description="The platform team, resource contributors, and educational content creators from professors, doctors, and educational channels."
>
  <div class="mb-6 text-start">
    <div class="flex items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400 mb-2">
      <a href="/?redirect=false" data-i18n="nav.home" class="hover:text-emerald-600 dark:hover:text-emerald-400">Home</a>
      <span>/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-bold" data-i18n="contributors.breadcrumbCurrent">Team & Contributors</span>
    </div>
    <h1 class="text-2xl font-extrabold text-zinc-900 dark:text-zinc-100 mb-1" data-i18n="contributors.title">
      Team & Contributors
    </h1>
    <p
      class="text-xs text-zinc-500 dark:text-zinc-400"
      data-i18n="contributors.subtitle"
      data-i18n-params={JSON.stringify({ a: authors.length, r: resourceContributors.length, c: contributors.length })}
    >
      Platform team ({authors.length}), resource contributors ({resourceContributors.length}), and content creators from doctors and educational channels ({contributors.length}).
    </p>
  </div>

  <!-- Website team first, manual order from JSON -->
  <section class="mb-10" aria-labelledby="authors-heading">
    <div class="flex items-center justify-between mb-3">
      <h2 id="authors-heading" class="text-base font-bold text-zinc-900 dark:text-zinc-100" data-i18n="contributors.teamTitle">
        Core Team
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {authors.map((author) => (
        <AuthorCard author={author} />
      ))}
    </div>
  </section>

  <!-- Resource contributors: students & community members who added materials -->
  <section class="mb-10" aria-labelledby="resources-heading">
    <div class="flex items-center justify-between mb-3">
      <h2 id="resources-heading" class="text-base font-bold text-zinc-900 dark:text-zinc-100" data-i18n="contributors.resourceTitle">
        Resource Contributors
      </h2>
      <span class="text-[11px] text-zinc-500 dark:text-zinc-400" data-i18n="contributors.resourceRankNote">
        Ranked by uploaded materials • Click any card for details
      </span>
    </div>

    {resourceContributors.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {resourceContributors.map((contributor, index) => (
          <ContributorCard
            contributor={contributor}
            dialogId={`resource-dialog-${index}`}
            rank={index + 1}
            roleType="resource"
          />
        ))}
      </div>
    ) : (
      <p class="text-xs text-zinc-500 dark:text-zinc-400 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl p-4" data-i18n="contributors.noContributors">
        No contributors registered yet.
      </p>
    )}
  </section>

  <!-- Content creators, ordered by contribution amount with preview limit -->
  <section aria-labelledby="contributors-heading">
    <div class="flex items-center justify-between mb-3">
      <h2 id="contributors-heading" class="text-base font-bold text-zinc-900 dark:text-zinc-100" data-i18n="contributors.creatorsTitle">
        Content Creators
      </h2>
      <span class="text-[11px] text-zinc-500 dark:text-zinc-400" data-i18n="contributors.creatorsRankNote">
        Ranked by resource count • Click any card for details
      </span>
    </div>

    {contributors.length > 0 ? (
      <>
        <div id="creators-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {contributors.map((contributor, index) => (
            <div class={index >= CREATORS_INITIAL_LIMIT ? 'creator-card-extra hidden' : ''}>
              <ContributorCard
                contributor={contributor}
                dialogId={`creator-dialog-${index}`}
                rank={index + 1}
                roleType="creator"
              />
            </div>
          ))}
        </div>

        {contributors.length > CREATORS_INITIAL_LIMIT && (
          <div class="mt-6 flex justify-center">
            <button
              type="button"
              id="toggle-creators-btn"
              data-state="collapsed"
              data-total={contributors.length}
              class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl border border-zinc-200/90 dark:border-zinc-700/80 bg-white dark:bg-zinc-900 text-xs sm:text-sm font-bold text-zinc-800 dark:text-zinc-200 hover:border-emerald-500/70 hover:text-emerald-600 dark:hover:border-emerald-500/70 dark:hover:text-emerald-400 shadow-2xs hover:shadow-xs active:scale-[0.99] transition-all cursor-pointer"
              aria-expanded="false"
              aria-controls="creators-grid"
            >
              <span
                id="toggle-creators-text"
                data-i18n="contributors.showAllCreators"
                data-i18n-params={JSON.stringify({ n: contributors.length })}
              >
                عرض كل صناع المحتوى ({contributors.length})
              </span>
              <svg
                id="toggle-creators-icon"
                class="w-4 h-4 text-zinc-400 transition-transform duration-200"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
        )}
      </>
    ) : (
      <p class="text-xs text-zinc-500 dark:text-zinc-400 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl p-4" data-i18n="contributors.noContributors">
        No contributors registered yet.
      </p>
    )}
  </section>
</Layout>

<script>
  import { t, getCurrentLanguage } from '../utils/i18n';

  function initContributorPopups(): void {
    const triggers = document.querySelectorAll<HTMLButtonElement>('[data-contributor-trigger]');
    const popups = document.querySelectorAll<HTMLElement>('[data-contributor-popup]');
    const containers = document.querySelectorAll<HTMLElement>('.contributor-card-container');

    function closeAll(): void {
      popups.forEach((p) => p.classList.add('hidden'));
      triggers.forEach((t) => {
        t.setAttribute('aria-expanded', 'false');
        t.classList.remove('border-emerald-500', 'ring-2', 'ring-emerald-500/30', 'dark:border-emerald-500');
        const chevron = t.querySelector('.contributor-chevron');
        if (chevron) {
          chevron.classList.remove('-rotate-90');
          chevron.classList.add('rotate-180');
        }
      });
      containers.forEach((c) => c.classList.remove('z-40'));
    }

    function togglePopup(id: string, trigger: HTMLButtonElement): void {
      const popup = document.getElementById(id);
      if (!popup) return;

      const isCurrentlyOpen = !popup.classList.contains('hidden');

      // Close all open popups
      closeAll();

      // If it was not open, open it
      if (!isCurrentlyOpen) {
        popup.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
        trigger.classList.add('border-emerald-500', 'ring-2', 'ring-emerald-500/30', 'dark:border-emerald-500');

        const chevron = trigger.querySelector('.contributor-chevron');
        if (chevron) {
          chevron.classList.remove('rotate-180');
          chevron.classList.add('-rotate-90');
        }

        const container = trigger.closest<HTMLElement>('.contributor-card-container');
        if (container) {
          container.classList.add('z-40');
        }

        // Smooth scroll if popup extends below visible window
        requestAnimationFrame(() => {
          const rect = popup.getBoundingClientRect();
          if (rect.bottom > window.innerHeight) {
            popup.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      }
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = trigger.getAttribute('data-contributor-trigger');
        if (id) togglePopup(id, trigger);
      });
    });

    // Close button inside popup
    document.querySelectorAll<HTMLElement>('[data-contributor-close]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeAll();
      });
    });

    // Prevent clicks inside popup from closing it
    popups.forEach((popup) => {
      popup.addEventListener('click', (e) => {
        e.stopPropagation();
      });
    });

    // Close on click outside
    document.addEventListener('click', () => {
      closeAll();
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAll();
      }
    });

    // Toggle Content Creators Show All / Show Less
    const toggleBtn = document.getElementById('toggle-creators-btn') as HTMLButtonElement | null;
    const toggleText = document.getElementById('toggle-creators-text');
    const toggleIcon = document.getElementById('toggle-creators-icon');
    const extraCards = document.querySelectorAll<HTMLElement>('.creator-card-extra');

    if (toggleBtn && toggleText && toggleIcon && extraCards.length > 0) {
      const btnEl = toggleBtn;
      const textEl = toggleText;
      const iconEl = toggleIcon;
      const totalCount = btnEl.getAttribute('data-total') || '0';

      function updateToggleText(isExpanded: boolean): void {
        const lang = getCurrentLanguage();
        if (isExpanded) {
          textEl.textContent = t('contributors.showLess', lang);
          textEl.setAttribute('data-i18n', 'contributors.showLess');
          textEl.removeAttribute('data-i18n-params');
        } else {
          textEl.textContent = t('contributors.showAllCreators', lang, { n: totalCount });
          textEl.setAttribute('data-i18n', 'contributors.showAllCreators');
          textEl.setAttribute('data-i18n-params', JSON.stringify({ n: totalCount }));
        }
      }

      btnEl.addEventListener('click', () => {
        const isCollapsed = btnEl.getAttribute('data-state') === 'collapsed';

        if (isCollapsed) {
          extraCards.forEach((card) => card.classList.remove('hidden'));
          btnEl.setAttribute('data-state', 'expanded');
          btnEl.setAttribute('aria-expanded', 'true');
          iconEl.classList.add('rotate-180');
          updateToggleText(true);
        } else {
          closeAll();
          extraCards.forEach((card) => card.classList.add('hidden'));
          btnEl.setAttribute('data-state', 'collapsed');
          btnEl.setAttribute('aria-expanded', 'false');
          iconEl.classList.remove('rotate-180');
          updateToggleText(false);

          const heading = document.getElementById('contributors-heading');
          if (heading) {
            heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });

      // Keep button text in sync when language changes
      window.addEventListener('asumed-language-changed', () => {
        const isExpanded = btnEl.getAttribute('data-state') === 'expanded';
        updateToggleText(isExpanded);
      });
    }
  }

  initContributorPopups();
  document.addEventListener('astro:after-swap', initContributorPopups);
</script>
