---
import Layout from '../layouts/Layout.astro';
import AuthorCard from '../components/contributors/AuthorCard.astro';
import ContributorCard from '../components/contributors/ContributorCard.astro';
import { getAllContributors, getAuthors } from '../utils/contributors';

const contributors = getAllContributors();
const authors = getAuthors();
---

<Layout
  title="فريق العمل والمساهمون - ASU Med Materials"
  description="فريق عمل منصة مصادر طب عين شمس وصناع المحتوى من الدكاترة والقنوات التعليمية."
>
  <div class="mb-6 text-right">
    <div class="flex items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400 mb-2">
      <a href="/?redirect=false" class="hover:text-emerald-600 dark:hover:text-emerald-400">الرئيسية</a>
      <span>/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-bold">فريق العمل والمساهمون</span>
    </div>
    <h1 class="text-2xl font-extrabold text-zinc-900 dark:text-zinc-100 mb-1">
      فريق العمل والمساهمون
    </h1>
    <p class="text-xs text-zinc-500 dark:text-zinc-400">
      فريق عمل المنصة ({authors.length}) وصناع المحتوى من الدكاترة والقنوات ({contributors.length}).
    </p>
  </div>

  <!-- Website team first, manual order from JSON -->
  <section class="mb-10" aria-labelledby="authors-heading">
    <div class="flex items-center justify-between mb-3">
      <h2 id="authors-heading" class="text-base font-bold text-zinc-900 dark:text-zinc-100">
        فريق العمل
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {authors.map((author) => (
        <AuthorCard author={author} />
      ))}
    </div>
  </section>

  <!-- Content makers, ordered by contribution amount -->
  <section aria-labelledby="contributors-heading">
    <div class="flex items-center justify-between mb-3">
      <h2 id="contributors-heading" class="text-base font-bold text-zinc-900 dark:text-zinc-100">
        صناع المحتوى
      </h2>
      <span class="text-[11px] text-zinc-500 dark:text-zinc-400">مرتبون حسب عدد المصادر • اضغط على أي بطاقة للتفاصيل</span>
    </div>

    {contributors.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {contributors.map((contributor, index) => (
          <ContributorCard contributor={contributor} dialogId={`contributor-dialog-${index}`} rank={index + 1} />
        ))}
      </div>
    ) : (
      <p class="text-xs text-zinc-500 dark:text-zinc-400 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl p-4">
        لا توجد مساهمات بعد. شارك أول مصدر من صفحة المساهمة.
      </p>
    )}
  </section>
</Layout>

<script>
  function initContributorPopups(): void {
    const triggers = document.querySelectorAll<HTMLButtonElement>('[data-contributor-trigger]');
    const popups = document.querySelectorAll<HTMLElement>('[data-contributor-popup]');
    const containers = document.querySelectorAll<HTMLElement>('.contributor-card-container');

    function closeAll(): void {
      popups.forEach((p) => p.classList.add('hidden'));
      triggers.forEach((t) => {
        t.setAttribute('aria-expanded', 'false');
        t.classList.remove('border-emerald-500', 'ring-2', 'ring-emerald-500/30', 'dark:border-emerald-500');
        const chevron = t.querySelector('.contributor-chevron');
        if (chevron) {
          chevron.classList.remove('-rotate-90');
          chevron.classList.add('rotate-180');
        }
      });
      containers.forEach((c) => c.classList.remove('z-40'));
    }

    function togglePopup(id: string, trigger: HTMLButtonElement): void {
      const popup = document.getElementById(id);
      if (!popup) return;

      const isCurrentlyOpen = !popup.classList.contains('hidden');

      // Close all open popups
      closeAll();

      // If it was not open, open it
      if (!isCurrentlyOpen) {
        popup.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
        trigger.classList.add('border-emerald-500', 'ring-2', 'ring-emerald-500/30', 'dark:border-emerald-500');

        const chevron = trigger.querySelector('.contributor-chevron');
        if (chevron) {
          chevron.classList.remove('rotate-180');
          chevron.classList.add('-rotate-90');
        }

        const container = trigger.closest<HTMLElement>('.contributor-card-container');
        if (container) {
          container.classList.add('z-40');
        }

        // Smooth scroll if popup extends below visible window
        requestAnimationFrame(() => {
          const rect = popup.getBoundingClientRect();
          if (rect.bottom > window.innerHeight) {
            popup.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      }
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = trigger.getAttribute('data-contributor-trigger');
        if (id) togglePopup(id, trigger);
      });
    });

    // Close button inside popup
    document.querySelectorAll<HTMLElement>('[data-contributor-close]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeAll();
      });
    });

    // Prevent clicks inside popup from closing it
    popups.forEach((popup) => {
      popup.addEventListener('click', (e) => {
        e.stopPropagation();
      });
    });

    // Close on click outside
    document.addEventListener('click', () => {
      closeAll();
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAll();
      }
    });
  }

  initContributorPopups();
  document.addEventListener('astro:after-swap', initContributorPopups);
</script>
