---
import Layout from '../layouts/Layout.astro';
import { getAllModulesIncludingInactive } from '../data/modules';
import AdminDashboard from '../components/admin/AdminDashboard.astro';

const modules = await getAllModulesIncludingInactive();
---

<Layout
  title="Admin Dashboard - ASU Med Materials"
  description="Administration and content management portal for Ain Shams University Faculty of Medicine study materials."
>
  <div class="max-w-4xl mx-auto py-4">
    <!-- Admin Content Container (Active when user.role === 'admin') -->
    <div id="admin-page-container" class="hidden">
      <AdminDashboard modules={modules} />
    </div>

    <!-- Access Denied State (Active for guests & non-admin users) -->
    <div id="admin-access-denied" class="hidden max-w-md mx-auto py-12 text-center space-y-4">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center shadow-2xs">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
        </svg>
      </div>
      
      <h1 class="text-xl font-extrabold text-zinc-900 dark:text-zinc-100">
        صلاحية المسؤول مطلوبة
      </h1>
      
      <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
        هذه الصفحة مخصصة لمسؤولي ومحرري المنصة لإدارة المواد ومراجعة المساهمات. يرجى تسجيل الدخول بحساب مسؤول للمتابعة.
      </p>

      <div class="pt-2 flex items-center justify-center gap-2.5">
        <a
          href="/profile"
          class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-all shadow-2xs"
        >
          تسجيل الدخول / الملف الشخصي
        </a>
        <a
          href="/"
          class="px-4 py-2 rounded-xl border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 text-xs font-semibold hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all"
        >
          الرئيسية
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { onAuthChange, getCachedUserProfile } from '../firebase/auth';

  function initAdminPageRouting(): void {
    const adminContainer = document.getElementById('admin-page-container');
    const deniedContainer = document.getElementById('admin-access-denied');

    function applyRole(role?: string): void {
      const isAdmin = role === 'admin';
      adminContainer?.classList.toggle('hidden', !isAdmin);
      deniedContainer?.classList.toggle('hidden', isAdmin);
    }

    // 1. Check local cached profile immediately for instant zero-flash render
    const cached = getCachedUserProfile();
    if (cached) {
      applyRole(cached.role);
    } else {
      applyRole(undefined);
    }

    // 2. React to live auth / Firestore updates
    onAuthChange((_user, profile) => {
      applyRole(profile?.role);
    });
  }

  initAdminPageRouting();
  document.addEventListener('astro:after-swap', initAdminPageRouting);
</script>
