# ==============================================================================
# ASU Med Materials - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production, add these variables in your Vercel Project Settings:
#   Project Settings -> Environment Variables
# ==============================================================================

# ==============================================================================
# 1. Firebase Web Configuration (Cloud Firestore, Auth, Storage)
# ==============================================================================
# In Astro, variables accessed in browser client scripts MUST begin with PUBLIC_.
# Obtain these from:
#   Firebase Console -> Project Settings -> General -> Your apps -> Web app
# Note: If left unset in local dev, the website gracefully falls back to offline/guest mode.
PUBLIC_FIREBASE_API_KEY=""
PUBLIC_FIREBASE_AUTH_DOMAIN=""
PUBLIC_FIREBASE_PROJECT_ID=""
PUBLIC_FIREBASE_STORAGE_BUCKET=""
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
PUBLIC_FIREBASE_APP_ID=""
PUBLIC_FIREBASE_MEASUREMENT_ID=""

# ==============================================================================
# 2. Firebase App Check (reCAPTCHA Enterprise)
# ==============================================================================
# Obtain from Firebase Console -> App Check -> Apps -> reCAPTCHA Enterprise
PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=""

# (Optional) Local development App Check debug token
# Set this to a UUID registered under Firebase Console -> App Check -> Manage debug tokens
# PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=""

# (Optional) Set to "true" to completely bypass App Check initialization during local debugging
# PUBLIC_DISABLE_APP_CHECK="true"

# ==============================================================================
# 3. (Optional) GitHub Personal Access Token
# ==============================================================================
# Only required if using the CLI helper tool: node scripts/parse-materials-dump.js --issue <number>
# GITHUB_TOKEN=""
