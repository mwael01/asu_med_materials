# ==============================================================================
# ASU Med Materials - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production, add these variables in your Vercel Project Settings:
#   Project Settings -> Environment Variables
# ==============================================================================

# ==============================================================================
# 1. Firebase Web Configuration (Cloud Firestore, Auth, Storage)
# ==============================================================================
# In Astro, variables accessed in browser client scripts MUST begin with PUBLIC_.
# Obtain these from:
#   Firebase Console -> Project Settings -> General -> Your apps -> Web app
# Note: If left unset in local dev, the website gracefully falls back to offline/guest mode.
PUBLIC_FIREBASE_API_KEY=""
PUBLIC_FIREBASE_AUTH_DOMAIN=""
PUBLIC_FIREBASE_PROJECT_ID=""
PUBLIC_FIREBASE_STORAGE_BUCKET=""
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
PUBLIC_FIREBASE_APP_ID=""

# ==============================================================================
# 2. (Optional) Firebase Admin SDK (Serverless Functions only)
# ==============================================================================
# NEVER prefix with PUBLIC_. These are sensitive secrets intended strictly
# for server-side endpoints (Node.js/Vercel functions) and must never be exposed to the client.
# FIREBASE_ADMIN_PROJECT_ID=""
# FIREBASE_ADMIN_CLIENT_EMAIL=""
# FIREBASE_ADMIN_PRIVATE_KEY=""

# ==============================================================================
# 3. Google Sheets Submissions Webhook URL (Required for live submissions)
# ==============================================================================
# The Web App URL generated after deploying scripts/google-sheets-submissions.js
# with "Execute as: Me" and "Who has access: Anyone".
# Note: If left unset during local development, /api/submit-material operates in mock mode.
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_APPS_SCRIPT_ID/exec"

# (Optional) Feedback Webhook URL (if using a separate sheet for feedback)
# GOOGLE_SHEETS_FEEDBACK_WEBHOOK_URL=""

# ==============================================================================
# 4. (Optional) GitHub Personal Access Token
# ==============================================================================
# Only required if using the CLI helper tool: node scripts/parse-materials-dump.js --issue <number>
# GITHUB_TOKEN=""
