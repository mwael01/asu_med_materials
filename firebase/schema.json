        },
        "role": {
          "type": "string",
          "required": false,
          "enum": [
            "student",
            "contributor",
            "admin"
          ],
          "default": "student"
        },
        "contributionsCount": {
          "type": "integer",
          "required": false,
          "default": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "required": true
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "required": false
        }
      },
      "totalDocuments": 1
    },
