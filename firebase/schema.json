    "material_asset_index": {
      "collectionName": "material_asset_index",
      "idField": "id",
      "description": "Admin-only hashed identity lookup: content SHA-256 takes priority, Telegram media identity for oversized attachments, or canonical URL for links. materials maps material IDs to module IDs; uploadedUrl is an immutable verified R2 object. Provenance post URLs do not identify distinct file editions. catalogue-state is the resumable version/generation/cursor checkpoint; identity associations from stale generations are ignored. Inbox publication advances index and catalogue versions atomically.",
      "fields": {
        "key": {
          "type": "string",
          "required": false
