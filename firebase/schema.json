{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASU Med Materials Firestore Schema",
  "version": "1.0.0",
  "projectId": "medmaterials",
  "database": "(default)",
  "lastSyncedAt": "2026-09-28T23:25:34.274Z",
  "collections": {
    "materials": {
      "collectionName": "materials",
      "description": "Comprehensive catalog of medical study materials, batch drives, playlists, exam papers, and textbooks across all five academic years.",
      "idField": "id",
      "totalDocuments": 163,
      "indexes": [
        {
          "fields": [
            "year",
            "moduleId"
          ]
        },
        {
          "fields": [
            "moduleId",
            "subject"
          ]
        },
        {
          "fields": [
            "type"
          ]
        }
      ],
      "fields": {
        "id": {
          "type": "string",
          "required": true,
          "description": "Unique identifier for the study material (e.g. bld-anat-wahdan)"
        },
        "title": {
          "type": "string",
          "required": true,
          "description": "Primary resource title in Arabic or English"
        },
        "titleEn": {
          "type": "string",
          "required": false,
          "description": "English translation or transliteration of the title"
        },
        "description": {
          "type": "string",
          "required": false,
          "description": "Contextual description, topics covered, or playlist details"
        },
        "descriptionEn": {
          "type": "string",
          "required": false,
          "description": "English translated description"
        },
        "url": {
          "type": "string",
          "required": true,
          "format": "uri",
          "description": "Direct external URL (Google Drive, Telegram, YouTube, etc.)"
        },
        "type": {
          "type": "string",
          "required": true,
          "enum": [
            "drive",
            "telegram",
            "youtube",
            "playlist",
            "whatsapp",
            "book",
            "summary",
            "exam",
            "website",
            "other"
          ],
          "description": "Format and platform category of the resource"
        },
        "category": {
          "type": "string",
          "required": false,
          "enum": [
            "central",
            "lectures",
            "practical",
            "summaries",
            "exams",
            "references"
          ],
          "description": "Learning phase or curriculum categorization"
        },
        "year": {
          "type": "integer",
          "required": true,
          "enum": [
            1,
            2,
            3,
            4,
            5
          ],
          "description": "Faculty of Medicine academic year"
        },
        "moduleId": {
          "type": "string",
          "required": false,
          "description": "Associated module code (e.g. year2-blood, year1-foundation, year2-reference-books)"
        },
        "subject": {
          "type": "string",
          "required": false,
          "description": "Academic discipline (e.g. Anatomy, Physiology, Histology, Biochemistry)"
        },
        "author": {
          "type": [
            "string",
            "array"
          ],
          "required": false,
          "description": "Professor, doctor, or channel author who created the material"
        },
        "addedBy": {
          "type": [
            "string",
            "array"
          ],
          "required": false,
          "description": "Student or contributor username/name who submitted it"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "required": true,
          "description": "Search keyword tags"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "required": false,
          "description": "ISO timestamp of addition"
        },
        "playlistId": {
          "type": "string",
          "required": false,
          "description": "YouTube playlist ID if multi-video collection"
        },
        "videos": {
          "type": "array",
          "required": false,
          "description": "Discrete chapter videos in playlist",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "youtubeId": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "duration": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title"
            ]
          }
        }
      }
    },
    "users": {
