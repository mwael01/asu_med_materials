        {
          "fields": [
            "moduleId",
            "subject"
          ]
        },
        {
          "fields": [
            "moduleId",
            "category"
          ]
        },
        {
          "fields": [
            "moduleId",
            "type"
          ]
        },
        {
          "fields": [
            "year",
            "category"
          ]
        },
        {
          "fields": [
            "year",
            "type"
          ]
        },
        {
          "fields": [
            "moduleId",
            "subject",
            "category"
          ]
        },
        {
