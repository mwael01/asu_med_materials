      ],
      "fields": {
        "id": {
          "type": "string",
          "required": true,
          "description": "Unique identifier for the study material (e.g. bld-anat-wahdan)"
        },
        "title": {
          "type": "string",
          "required": true,
          "description": "Primary resource title in Arabic or English"
        },
        "titleEn": {
          "type": "string",
          "required": false,
          "description": "English translation or transliteration of the title"
        },
        "description": {
          "type": "string",
          "required": false,
          "description": "Contextual description, topics covered, or playlist details"
        },
        "descriptionEn": {
          "type": "string",
          "required": false,
          "description": "English translated description"
        },
        "url": {
          "type": "string",
          "required": true,
          "format": "uri",
          "description": "Direct external URL (Google Drive, Telegram, YouTube, etc.)"
        },
        "type": {
          "type": "string",
          "required": true,
          "enum": [
            "drive",
            "telegram",
            "youtube",
            "playlist",
            "whatsapp",
            "book",
            "summary",
            "exam",
            "website",
            "other"
          ],
          "description": "Format and platform category of the resource"
        },
        "category": {
          "type": "string",
          "required": false,
          "enum": [
            "central",
            "lectures",
            "practical",
            "summaries",
            "exams",
            "references"
          ],
          "description": "Learning phase or curriculum categorization"
        },
        "year": {
          "type": "integer",
          "required": true,
          "enum": [
            1,
            2,
            3,
            4,
            5
          ],
          "description": "Faculty of Medicine academic year"
        },
        "moduleId": {
          "type": "string",
          "required": false,
          "description": "Associated module code (e.g. year2-blood, year1-foundation, year2-reference-books)"
        },
        "subject": {
          "type": "string",
          "required": false,
          "description": "Academic discipline (e.g. Anatomy, Physiology, Histology, Biochemistry)"
        },
        "author": {
          "type": [
            "string",
            "array"
          ],
          "required": false,
          "description": "Professor, doctor, or channel author who created the material"
        },
        "addedBy": {
          "type": [
            "string",
            "array"
          ],
          "required": false,
          "description": "Student or contributor username/name who submitted it"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "required": true,
          "description": "Search keyword tags"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "required": false,
          "description": "ISO timestamp of addition"
        },
        "playlistId": {
          "type": "string",
          "required": false,
          "description": "YouTube playlist ID if multi-video collection"
        },
        "videos": {
          "type": "array",
          "required": false,
          "description": "Ordered video or audio tracks, using the existing playlist player",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "youtubeId": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "duration": {
                "type": "string"
              },
              "mediaKind": {
                "type": "string",
                "enum": [
                  "audio",
                  "video"
                ],
                "description": "Optional; older tracks default to video"
              }
            },
            "required": [
              "id",
              "title"
            ]
          }
        },
        "lessonId": {
          "type": "string",
          "required": false,
          "description": "Optional reference to a lesson in the same module and subject"
        },
        "contentSha256": {
          "type": "string",
          "required": false,
          "description": "SHA-256 of a single imported file"
        },
        "importSources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "required": false
        },
        "importRunId": {
          "type": "string",
          "required": false
        },
        "importReviewStatus": {
          "type": "string",
          "required": false,
          "description": "pending or reviewed; import audit marker without student-facing badges"
        },
        "documents": {
          "type": "array",
          "required": false,
          "description": "Ordered PDF, image or external resource items; optional mimeType supports Telegram-hosted file classification",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "url"
            ]
          }
        }
      }
    },
    "users": {
