rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Study Materials: Anyone can read, anyone can update bookmarksCount (likes/bookmarks), authenticated users write
    match /materials/{materialId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookmarksCount']) || request.auth != null;
      allow create, delete: if request.auth != null;
    }

    // 2. User Profiles: Anyone can view public profile, owner or admin can edit
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null;
    }

    // 3. Submissions: Any authenticated or guest user can submit, authenticated admins manage
    match /submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 4. Student Feedback: Any user can submit, authenticated admins manage
    match /feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 5. Admin Activity Audit Logs: Authenticated admins can read and create, immutable
    match /admin_logs/{logId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // 6. Curriculum Modules: Public read for guests and offline cache, authenticated write
    match /modules/{moduleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 7. Contributors & Team: Public read, authenticated write
    match /contributors/{contributorId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 8. Flashcard Decks & Revisions: Public read for published decks, authenticated admins write
    match /flashcard_decks/{deckId} {
      allow read: if resource.data.publicationStatus == 'published' || request.auth != null;
      allow write: if request.auth != null;

      match /revisions/{revisionId} {
        allow read: if resource.data.status == 'published' || request.auth != null;
        allow write: if request.auth != null;

        match /cards/{cardId} {
          allow read: if true;
          allow write: if request.auth != null;
        }
      }
    }

    // 9. Flashcard Imports: Authenticated admins only
    match /flashcard_imports/{importId} {
      allow read, write: if request.auth != null;
    }

    // 10. Student Flashcard Progress: Private owner-only access
    match /users/{userId}/flashcard_progress/{deckId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
