rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User profile avatar images
    match /avatars/{fileName} {
      // Allow public read for profile pictures
      allow read: if true;
      
      // Allow write if authenticated, uploading own image, size <= 2.5MB, and valid image type
      allow write: if request.auth != null
        && request.resource.size < 2.5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      
      // Allow delete if authenticated
      allow delete: if request.auth != null;
    }
  }
}
